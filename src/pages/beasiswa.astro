---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import TopicIcon from '../components/TopicIcon.astro';
import InstitutionMark from '../components/InstitutionMark.astro';
import { withBase } from '../utils/paths';
import {
  scholarships,
  scholarshipStats,
  scholarshipLevelLabels,
  scholarshipCampusLabels
} from '../data/scholarships';

const campusOptions = Object.entries(scholarshipCampusLabels);
const levelOptions = Object.entries(scholarshipLevelLabels);

const routeLabels = {
  school: 'Lewat kampus',
  foundation: 'Apply langsung',
  embassy: 'Lewat embassy',
  varies: 'Tergantung jalur'
};

const fundingLabels = {
  stipend: 'Stipend',
  tuition: 'Tuition support',
  'full-support': 'Full support',
  mixed: 'Mixed support'
};

const campusScopeLabels = {
  'all-japan': 'Terbuka lintas kampus',
  listed: 'Kampus terkonfirmasi',
  'designated-unknown': 'Cek designated school',
  'program-specific': 'Tergantung program'
};

const stageLabels = {
  'before-arrival': 'Sebelum datang',
  'after-enrollment': 'Setelah enrollment',
  both: 'Sebelum & sesudah'
};

const monthsSince = (isoDate: string) => {
  const checked = new Date(isoDate);
  const now = new Date();
  return (now.getFullYear() - checked.getFullYear()) * 12 + (now.getMonth() - checked.getMonth());
};

const needsReview = (item: (typeof scholarships)[number]) =>
  monthsSince(item.verifiedDate) >= (item.reviewAfterMonths ?? 9);

const staleCount = scholarships.filter(needsReview).length;
---

<BaseLayout
  title="Beasiswa"
  description="Scholarship Hub PPI Ishikawa untuk membantu pelajar Indonesia menemukan beasiswa berdasarkan kampus, jenjang, dan tahap studi."
>
  <PageIntro
    title="Scholarship Hub"
    description="Cari jalur beasiswa yang relevan untuk pelajar Indonesia di Ishikawa. Mulai dari status Anda, lalu cek eligibility, jalur aplikasi, dan sumber resmi sebelum mendaftar."
  />

  <section class="mx-auto max-w-7xl px-5 pb-8 lg:px-8">
    <div class="grid gap-4 md:grid-cols-3">
      <a href="#finder" data-stage-jump="before-arrival" class="group rounded-3xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-amber-200 hover:shadow-sm">
        <TopicIcon name="arrival" class="size-7 text-brand" />
        <h2 class="mt-4 text-xl font-bold text-slate-950">Saya belum berangkat</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Mulai dari MEXT dan scholarship yang memang menerima aplikasi sebelum Anda tiba di Jepang.</p>
        <span class="mt-4 inline-flex text-sm font-bold text-brand">Tampilkan opsi →</span>
      </a>

      <a href="#finder" data-stage-jump="after-enrollment" class="group rounded-3xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-amber-200 hover:shadow-sm">
        <TopicIcon name="campus" class="size-7 text-brand" />
        <h2 class="mt-4 text-xl font-bold text-slate-950">Saya sudah kuliah di Ishikawa</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Cari JASSO, Ishikawa Prefectural Scholarship, foundation scholarship, dan jalur nominasi kampus.</p>
        <span class="mt-4 inline-flex text-sm font-bold text-brand">Tampilkan opsi →</span>
      </a>

      <a href="#kampus" class="group rounded-3xl border border-amber-200 bg-amber-50 p-6 transition hover:-translate-y-0.5 hover:shadow-sm">
        <TopicIcon name="scholarship" class="size-7 text-accent-dark" />
        <h2 class="mt-4 text-xl font-bold text-slate-950">Pilih kampus saya</h2>
        <p class="mt-2 text-sm leading-6 text-slate-700">Gunakan kampus sebagai titik awal, lalu filter lagi berdasarkan jenjang dan tahap studi.</p>
        <span class="mt-4 inline-flex text-sm font-bold text-brand">Pilih kampus →</span>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-8 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-3xl font-bold text-slate-950">{scholarshipStats.total}</p>
        <p class="mt-1 text-sm text-slate-600">beasiswa terdata</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-3xl font-bold text-slate-950">{scholarshipStats.indonesiaSpecific}</p>
        <p class="mt-1 text-sm text-slate-600">secara eksplisit mencantumkan Indonesia</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-3xl font-bold text-slate-950">{scholarshipStats.beforeArrival}</p>
        <p class="mt-1 text-sm text-slate-600">punya jalur sebelum tiba di Jepang</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-3xl font-bold text-slate-950">{scholarshipStats.ishikawaDirect}</p>
        <p class="mt-1 text-sm text-slate-600">sudah terhubung langsung ke kampus Ishikawa</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-3xl font-bold text-slate-950">{staleCount}</p>
        <p class="mt-1 text-sm text-slate-600">perlu verifikasi ulang saat ini</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-8 lg:px-8">
    <div class="rounded-3xl border border-red-200 bg-red-50 p-6 sm:p-8">
      <div class="flex gap-4">
        <TopicIcon name="info" class="mt-1 size-6 shrink-0 text-brand" />
        <div>
          <h2 class="text-xl font-bold text-slate-950">Gunakan hub ini untuk menemukan kandidat, bukan sebagai pengganti guideline resmi.</h2>
          <p class="mt-3 max-w-4xl text-sm leading-6 text-slate-700">
            Scholarship dapat berubah berdasarkan intake, kuota, designated school, study year, nationality, visa, bidang studi, dan aturan double funding.
            Jika sebuah card bertuliskan “cek kampus”, hubungi international/student office sebelum menyiapkan aplikasi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="indonesia" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-10 lg:px-8">
    <div class="rounded-[2rem] border border-red-200 bg-red-50 p-6 sm:p-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Khusus mahasiswa Indonesia</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Scholarship yang secara eksplisit mencantumkan Indonesia.</h2>
          <p class="mt-3 max-w-3xl leading-7 text-slate-700">
            Prioritaskan daftar ini jika nationality adalah filter utama Anda. Tetap cek kampus, jenjang, bidang, study year, bahasa Jepang, dan jalur rekomendasi sebelum menyiapkan dokumen.
          </p>
        </div>
        <a href="#finder" data-indonesia-jump="yes" class="inline-flex rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Tampilkan semuanya di Finder →</a>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {scholarships
          .filter((item) => item.nationality.includes('Indonesia'))
          .slice(0, 6)
          .map((item) => (
            <article class="rounded-2xl bg-white p-5 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.1em] text-brand">{item.provider}</p>
                  <h3 class="mt-2 font-bold leading-snug text-slate-950">{item.name}</h3>
                </div>
                <span class="rounded-full bg-red-50 px-2.5 py-1 text-[11px] font-bold text-red-700">Indonesia</span>
              </div>
              <p class="mt-3 text-sm leading-6 text-slate-600">{item.summary}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {item.studyLevels.map((level) => (
                  <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-600">{scholarshipLevelLabels[level]}</span>
                ))}
              </div>
              <div class="mt-4 border-t border-slate-100 pt-4">
                <p class="text-xs text-slate-500">Cara mendaftar</p>
                <p class="mt-1 text-sm font-bold text-slate-900">{routeLabels[item.applicationRoute]}</p>
              </div>
            </article>
          ))}
      </div>

      <p class="mt-5 text-xs leading-5 text-slate-600">
        Daftar Indonesia bukan berarti otomatis eligible untuk semua mahasiswa Indonesia. Beberapa foundation mensyaratkan designated school, study year tertentu, bidang studi tertentu, atau nominasi kampus.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 sm:p-6">
      <div class="flex gap-3">
        <TopicIcon name="info" class="mt-0.5 size-5 shrink-0 text-brand" />
        <div>
          <p class="font-bold text-slate-950">Perhatikan periode beasiswa dan tanggal verifikasi.</p>
          <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-600">Sebelum mendaftar, cek pengumuman resmi terbaru untuk memastikan tenggat, nominal, kuota, eligibility, dan daftar kampus yang memenuhi syarat.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="kampus" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Cari berdasarkan kampus</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Mulai dari institusi Anda.</h2>
    <p class="mt-3 max-w-3xl leading-7 text-slate-600">Beberapa beasiswa hanya tersedia melalui kampus tertentu; lainnya terbuka lebih luas tetapi tetap perlu dikonfirmasi ke kampus.</p>

    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {campusOptions.map(([slug, label]) => (
        <a href="#finder" data-campus-jump={slug} class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-amber-200 hover:bg-amber-50">
          <InstitutionMark id={slug as any} size="sm" class="shrink-0" />
          <div>
            <p class="font-bold text-slate-950">{label}</p>
            <p class="mt-1 text-xs text-slate-500">Saring beasiswa →</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="rounded-[2rem] border border-amber-200 bg-amber-50 p-6 sm:p-8">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-dark">Paling relevan untuk Ishikawa</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Mulai dari dua jalur ini sebelum membuka daftar yang lebih luas.</h2>
        </div>
        <a href="#finder" class="text-sm font-bold text-brand hover:underline">Lihat semua beasiswa →</a>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {scholarships.filter((item) => ['ishikawa-prefectural-scholarship','mitani-scholarship'].includes(item.slug)).map((item) => (
          <article class="rounded-2xl bg-white p-5 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-[0.1em] text-brand">{item.provider}</p>
            <h3 class="mt-2 text-lg font-bold text-slate-950">{item.name}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.summary}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {item.studyLevels.map((level) => (
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-600">{scholarshipLevelLabels[level]}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="finder" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-10 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Pencarian Beasiswa</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Saring yang relevan untuk kondisi Anda.</h2>
      </div>
      <p id="scholarship-count" class="text-sm font-semibold text-slate-500">{scholarships.length} beasiswa ditampilkan</p>
    </div>

    <div class="mt-6 grid gap-3 rounded-3xl border border-slate-200 bg-white p-5 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7">
      <label class="block">
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Kampus</span>
        <select id="filter-campus" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-800">
          <option value="">Semua kampus</option>
          {campusOptions.map(([slug,label]) => <option value={slug}>{label}</option>)}
        </select>
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Jenjang</span>
        <select id="filter-level" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-800">
          <option value="">Semua jenjang</option>
          {levelOptions.map(([code,label]) => <option value={code}>{label}</option>)}
        </select>
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Status</span>
        <select id="filter-stage" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-800">
          <option value="">Semua status</option>
          <option value="before-arrival">Belum datang ke Jepang</option>
          <option value="after-enrollment">Sudah terdaftar sebagai mahasiswa</option>
        </select>
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Cara mendaftar</span>
        <select id="filter-route" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-800">
          <option value="">Semua jalur</option>
          <option value="school">Lewat kampus</option>
          <option value="foundation">Apply langsung</option>
          <option value="varies">Tergantung jalur</option>
        </select>
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Status data</span>
        <select id="filter-freshness" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-800">
          <option value="">Semua status</option>
          <option value="fresh">Terverifikasi</option>
          <option value="stale">Perlu verifikasi ulang</option>
        </select>
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Kepastian kampus</span>
        <select id="filter-campus-scope" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-800">
          <option value="">Semua</option>
          <option value="listed">Kampus terkonfirmasi</option>
          <option value="all-japan">Terbuka lintas kampus</option>
          <option value="designated-unknown">Cek designated school</option>
          <option value="program-specific">Tergantung program</option>
        </select>
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Khusus Indonesia</span>
        <select id="filter-indonesia" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-800">
          <option value="">Semua</option>
          <option value="yes">Mencantumkan Indonesia</option>
        </select>
      </label>

      <div class="sm:col-span-2 lg:col-span-4 xl:col-span-7">
        <button id="filter-reset" type="button" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50">
          Reset filter
        </button>
      </div>
    </div>

    <div id="scholarship-empty" class="mt-6 hidden rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
      <p class="font-bold text-slate-950">Belum ada beasiswa dalam daftar saat ini yang cocok dengan semua filter.</p>
      <p class="mt-2 text-sm text-slate-600">Coba longgarkan filter atau periksa kembali setelah informasi diperbarui.</p>
    </div>

    <div id="scholarship-grid" class="mt-6 grid gap-5 lg:grid-cols-2">
      {scholarships.map((item) => (
        <article
          class="scholarship-card rounded-3xl border border-slate-200 bg-white p-6 shadow-sm"
          data-campus={item.campusSlugs.join(',')}
          data-campus-scope={item.campusScope}
          data-level={item.studyLevels.join(',')}
          data-stage={item.stages.join(',')}
          data-indonesia={item.nationality.includes('Indonesia') ? 'yes' : 'no'}
          data-route={item.applicationRoute}
          data-freshness={needsReview(item) ? 'stale' : 'fresh'}
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand">{item.provider}</p>
              <h3 class="mt-2 text-xl font-bold leading-snug text-slate-950">{item.name}</h3>
            </div>
            <div class="flex flex-wrap justify-end gap-2">
              {item.featured && <span class="rounded-full bg-amber-100 px-3 py-1 text-[11px] font-bold text-amber-800">Prioritas</span>}
              <span class={`rounded-full px-3 py-1 text-[11px] font-bold ${needsReview(item) ? 'bg-red-100 text-red-700' : 'bg-green-50 text-green-700'}`}>
                {needsReview(item) ? 'Perlu verifikasi ulang' : 'Terverifikasi'}
              </span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-700">
                {campusScopeLabels[item.campusScope]}
              </span>
            </div>
          </div>

          <p class="mt-4 text-sm leading-6 text-slate-600">{item.summary}</p>

          <div class="mt-4 flex flex-wrap gap-2">
            {item.studyLevels.map((level) => (
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-600">{scholarshipLevelLabels[level]}</span>
            ))}
            {item.stages.map((stage) => (
              <span class="rounded-full bg-blue-50 px-2.5 py-1 text-[11px] font-bold text-blue-700">{stageLabels[stage]}</span>
            ))}
            {item.nationality.includes('Indonesia') && (
              <span class="rounded-full bg-red-50 px-2.5 py-1 text-[11px] font-bold text-red-700">Indonesia</span>
            )}
          </div>

          <dl class="mt-5 grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl bg-slate-50 p-4">
              <dt class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500">Bantuan</dt>
              <dd class="mt-1 text-sm font-semibold leading-6 text-slate-900">{item.amount}</dd>
            </div>
            <div class="rounded-xl bg-slate-50 p-4">
              <dt class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500">Pola waktu</dt>
              <dd class="mt-1 text-sm font-semibold leading-6 text-slate-900">{item.typicalWindow ?? item.applicationPeriod}</dd>
            </div>
            <div class="rounded-xl bg-slate-50 p-4">
              <dt class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500">Cara mendaftar</dt>
              <dd class="mt-1 text-sm font-semibold leading-6 text-slate-900">{routeLabels[item.applicationRoute]}</dd>
            </div>
            <div class="rounded-xl bg-slate-50 p-4">
              <dt class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-500">Jenis pendanaan</dt>
              <dd class="mt-1 text-sm font-semibold leading-6 text-slate-900">{fundingLabels[item.fundingType]}</dd>
            </div>
          </dl>

          <details class="mt-5 rounded-2xl border border-slate-200">
            <summary class="cursor-pointer list-none px-4 py-3 text-sm font-bold text-slate-800">Lihat syarat & catatan</summary>
            <div class="border-t border-slate-100 px-4 py-4 text-sm leading-6 text-slate-600">
              <p><strong class="text-slate-900">Kampus:</strong> {item.campusEligibilityNote}</p>
              <p class="mt-2"><strong class="text-slate-900">Kewarganegaraan:</strong> {item.nationalityNote}</p>
              <p class="mt-2"><strong class="text-slate-900">Bidang:</strong> {item.fields.join(', ')}</p>
              <p class="mt-2"><strong class="text-slate-900">Durasi:</strong> {item.duration}</p>
              <p class="mt-2"><strong class="text-slate-900">Periode yang diverifikasi:</strong> {item.latestVerifiedCycle ?? item.applicationPeriod}</p>
              <p class="mt-2"><strong class="text-slate-900">Beasiswa ganda:</strong> {item.pluralGrants}</p>
              {item.ageNote && <p class="mt-2"><strong class="text-slate-900">Usia:</strong> {item.ageNote}</p>}
              {item.visaNote && <p class="mt-2"><strong class="text-slate-900">Visa:</strong> {item.visaNote}</p>}
              {item.additionalRequirements?.length && (
                <ul class="mt-3 list-disc space-y-1 pl-5">
                  {item.additionalRequirements.map((req) => <li>{req}</li>)}
                </ul>
              )}
            </div>
          </details>

          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-400">Sumber</p>
              <p class="mt-1 text-xs leading-5 text-slate-500">{item.sourceLabel} · diperiksa {item.verified}</p>
              <p class="mt-1 text-[11px] leading-5 text-slate-400">Tenggat dan nominal dapat berubah. Cek pengumuman resmi terbaru sebelum mendaftar.</p>
              <p class="mt-1 text-[11px] leading-5 text-slate-400">Periksa pengumuman resmi terbaru sebelum menyiapkan aplikasi.</p>
            </div>
            {item.sourceUrl && (
              <a href={item.sourceUrl} target="_blank" rel="noreferrer" class="text-sm font-bold text-brand hover:underline">Sumber resmi ↗</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-6 lg:px-8">
    <details class="rounded-2xl border border-slate-200 bg-white p-5">
      <summary class="cursor-pointer font-bold text-slate-950">Sebelum mendaftar</summary>
      <p class="mt-3 max-w-4xl text-sm leading-6 text-slate-600">Pastikan tenggat, nominal, kuota, eligibility, dan prosedur aplikasi masih berlaku pada periode yang Anda tuju. Sumber resmi pemberi beasiswa menjadi rujukan akhir.</p>
    </details>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-6 lg:px-8">
    <div class="rounded-3xl bg-slate-950 p-7 text-white sm:p-8">
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-accent-soft">Cara menggunakan data ini</p>
      <h2 class="mt-2 text-2xl font-bold">Tiga pengecekan sebelum mendaftar.</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl bg-white/5 p-5">
          <p class="font-bold">1 · Persyaratan</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">Periksa jenjang, usia, kewarganegaraan, bidang studi, visa, tahun studi, dan ketentuan kampus.</p>
        </div>
        <div class="rounded-2xl bg-white/5 p-5">
          <p class="font-bold">2 · Jalur aplikasi</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">Bedakan pendaftaran langsung dengan beasiswa yang hanya menerima nominasi dari kampus.</p>
        </div>
        <div class="rounded-2xl bg-white/5 p-5">
          <p class="font-bold">3 · Pengumuman terbaru</p>
          <p class="mt-2 text-sm leading-6 text-slate-300">Gunakan daftar ini untuk menemukan opsi; tenggat dan kuota final selalu mengikuti pengumuman resmi terbaru.</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const campus = document.getElementById('filter-campus');
      const level = document.getElementById('filter-level');
      const stage = document.getElementById('filter-stage');
      const indonesia = document.getElementById('filter-indonesia');
      const route = document.getElementById('filter-route');
      const freshness = document.getElementById('filter-freshness');
      const campusScope = document.getElementById('filter-campus-scope');
      const reset = document.getElementById('filter-reset');
      const cards = [...document.querySelectorAll('.scholarship-card')];
      const count = document.getElementById('scholarship-count');
      const empty = document.getElementById('scholarship-empty');

      const matchesList = (raw, value) => !value || raw.split(',').includes(value);

      const apply = () => {
        let shown = 0;
        for (const card of cards) {
          const campusValue = campus?.value || '';
          const levelValue = level?.value || '';
          const stageValue = stage?.value || '';
          const indonesiaValue = indonesia?.value || '';
          const routeValue = route?.value || '';
          const freshnessValue = freshness?.value || '';
          const campusScopeValue = campusScope?.value || '';

          const campusRaw = card.dataset.campus || '';
          const levelRaw = card.dataset.level || '';
          const stageRaw = card.dataset.stage || '';
          const indonesiaRaw = card.dataset.indonesia || '';
          const routeRaw = card.dataset.route || '';
          const freshnessRaw = card.dataset.freshness || '';
          const campusScopeRaw = card.dataset.campusScope || '';

          const campusOk = !campusValue
            || matchesList(campusRaw, campusValue)
            || campusScopeRaw === 'all-japan'
            || campusScopeRaw === 'program-specific';
          const levelOk = matchesList(levelRaw, levelValue);
          const stageOk = !stageValue || matchesList(stageRaw, stageValue) || matchesList(stageRaw, 'both');
          const indonesiaOk = !indonesiaValue || indonesiaRaw === indonesiaValue;
          const routeOk = !routeValue || routeRaw === routeValue;
          const freshnessOk = !freshnessValue || freshnessRaw === freshnessValue;
          const campusScopeOk = !campusScopeValue || campusScopeRaw === campusScopeValue;
          const visible = campusOk && levelOk && stageOk && indonesiaOk && routeOk && freshnessOk && campusScopeOk;

          card.classList.toggle('hidden', !visible);
          if (visible) shown++;
        }
        if (count) count.textContent = `${shown} beasiswa ditampilkan`;
        empty?.classList.toggle('hidden', shown !== 0);
      };

      const params = new URLSearchParams(window.location.search);
      if (campus && params.get('campus')) campus.value = params.get('campus');
      if (level && params.get('level')) level.value = params.get('level');
      if (stage && params.get('stage')) stage.value = params.get('stage');
      if (indonesia && params.get('indonesia') === 'yes') indonesia.value = 'yes';
      if (route && params.get('route')) route.value = params.get('route');
      if (freshness && params.get('freshness')) freshness.value = params.get('freshness');
      if (campusScope && params.get('campusScope')) campusScope.value = params.get('campusScope');

      [campus, level, stage, indonesia, route, freshness, campusScope].forEach((el) => el?.addEventListener('change', apply));
      reset?.addEventListener('click', () => {
        if (campus) campus.value = '';
        if (level) level.value = '';
        if (stage) stage.value = '';
        if (indonesia) indonesia.value = '';
        if (route) route.value = '';
        if (freshness) freshness.value = '';
        if (campusScope) campusScope.value = '';
        apply();
      });

      document.querySelectorAll('[data-stage-jump]').forEach((link) => {
        link.addEventListener('click', () => {
          if (stage) stage.value = link.dataset.stageJump || '';
          setTimeout(apply, 0);
        });
      });
      document.querySelectorAll('[data-campus-jump]').forEach((link) => {
        link.addEventListener('click', () => {
          if (campus) campus.value = link.dataset.campusJump || '';
          setTimeout(apply, 0);
        });
      });

      document.querySelectorAll('[data-indonesia-jump]').forEach((link) => {
        link.addEventListener('click', () => {
          if (indonesia) indonesia.value = 'yes';
          setTimeout(apply, 0);
        });
      });

      apply();
    })();
  </script>
</BaseLayout>
