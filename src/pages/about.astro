---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { leadership, departments, vision, values, kaizen } from '../data/organization';
---
<BaseLayout title="Tentang">
  <PageIntro
    title="Tentang PPI Ishikawa"
    description="Ruang bersama pelajar Indonesia di Prefektur Ishikawa untuk saling mendukung, berkembang, terhubung, dan menjaga kesinambungan komunitas."
  />

  <section class="mx-auto max-w-7xl px-5 pb-12 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-3">
      <article class="rounded-3xl border border-slate-200 bg-white p-6 lg:col-span-2 sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Profil</p>
        <h2 class="mt-3 text-2xl font-bold text-slate-950">PPI Ishikawa</h2>
        <p class="mt-4 leading-7 text-slate-600">
          PPI Ishikawa adalah komunitas pelajar Indonesia di Prefektur Ishikawa, Jepang. Kami hadir untuk membantu anggota saling terhubung, berbagi informasi, beradaptasi dengan kehidupan di Ishikawa, dan membangun kolaborasi yang bermanfaat.
        </p>
      </article>
      <aside class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">Periode 2026/27</p>
        <p class="mt-3 text-xl font-bold">Struktur kerja periode 2026/27.</p>
        <p class="mt-3 text-sm leading-6 text-slate-300">Kepengurusan terdiri dari fungsi pimpinan, sekretariat, keuangan, dan tujuh departemen dengan bidang tanggung jawab masing-masing.</p>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="rounded-[2rem] border border-amber-200 bg-amber-50 p-7 sm:p-10">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-dark">Arah 2026/27</p>
      <h2 class="mt-3 max-w-4xl text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">{vision.headline}</h2>
      <p class="mt-4 text-lg font-semibold text-slate-800">{vision.subheadline}</p>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">{vision.supporting}</p>
      <div class="mt-6 border-t border-amber-200 pt-5">
        <p class="font-bold text-slate-950">{vision.studentFirst}</p>
        <p class="mt-1 text-sm leading-6 text-slate-700">{vision.studentFirstDescription}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Nilai yang kami pegang</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Empat prinsip untuk memilih, bekerja, dan melayani.</h2>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {values.map((value, index) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-7">
          <div class="flex items-start gap-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-amber-50 text-xs font-bold text-accent-dark">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-xl font-bold text-slate-950">{value.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{value.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
    <div class="rounded-[2rem] bg-slate-950 p-7 text-white sm:p-10">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">Cara kami bekerja</p>
      <h2 class="mt-3 text-3xl font-bold">{kaizen.title}</h2>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">{kaizen.description}</p>
      <div class="mt-7 grid gap-3 md:grid-cols-3">
        {kaizen.steps.map(([title, description]) => (
          <div class="rounded-2xl border border-slate-700 bg-white/5 p-5">
            <p class="font-bold text-white">{title}</p>
            <p class="mt-2 text-sm leading-6 text-slate-300">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Pimpinan & fungsi inti</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Struktur organisasi 2026/27.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
      {leadership.map((role) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{role.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{role.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Departemen</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Tujuh fungsi kerja.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {departments.map((department) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-bold text-slate-950">{department.name}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{department.description}</p>
        </article>
      ))}
    </div>
    <p class="mt-5 text-sm leading-6 text-slate-500">Sekretaris, Bendahara, dan setiap departemen dapat didukung staf/anggota sesuai kebutuhan organisasi.</p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-12 lg:px-8">
    <article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Sejarah & arsip</p>
      <h2 class="mt-3 text-xl font-bold text-slate-950">Menjaga jejak perjalanan PPI Ishikawa.</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Arsip kepengurusan, program, publikasi, dan dokumentasi membantu anggota mengenal perjalanan organisasi serta menjadi rujukan bagi periode berikutnya.</p>
    </article>
  </section>
</BaseLayout>
