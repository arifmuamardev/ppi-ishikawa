---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import HighlightPanel from '../components/HighlightPanel.astro';
import NavigationCard from '../components/NavigationCard.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import ScrollPillNav from '../components/ScrollPillNav.astro';
import { leadership, departments, vision, values, kaizen, workPrinciples, directionPillars, viceChairPortfolios } from '../data/organization';
import { withBase } from '../utils/paths';
import { generalRelatedContent } from '../data/related-content';
import { site } from '../data/site';
---
<BaseLayout title="Tentang">
  <LandingHeader
    title="Tentang PPI Ishikawa"
    description="Ruang bersama pelajar Indonesia di Prefektur Ishikawa untuk saling mendukung, berkembang, terhubung, dan menjaga kesinambungan komunitas."
  />

  <div class="pb-8">
    <ScrollPillNav
      ariaLabel="Navigasi halaman Tentang"
      items={[
        ['Profil', '#profil'],
        ['Arah', '#arah'],
        ['Nilai', '#nilai'],
        ['Cara kerja', '#cara-kerja'],
        ['Prinsip kerja', '#prinsip-kerja'],
        ['Struktur', '#struktur-organisasi'],
        ['Program', '/programs/'],
        ['Sejarah & arsip', '#sejarah-arsip']
      ]}
    />
  </div>

  <section id="profil" class="scroll-mt-24 mx-auto max-w-7xl px-5 pb-12 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-6 lg:col-span-2 sm:p-8">
        <p class="type-eyebrow text-brand">Profil</p>
        <h2 class="mt-3 text-2xl font-bold text-slate-950">PPI Ishikawa</h2>
        <p class="mt-4 leading-7 text-slate-600">
          PPI Ishikawa adalah komunitas pelajar Indonesia di Prefektur Ishikawa, Jepang. Kami menjadi ruang bersama untuk saling membantu, berbagi informasi, beradaptasi dengan kehidupan di Ishikawa, dan mengembangkan diri melalui kolaborasi lintas kampus. Kegiatan dan layanan disesuaikan dengan kebutuhan anggota serta kemampuan pengurus.
        </p>
      </article>
      <aside class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
        <p class="type-eyebrow text-accent-soft">Periode {site.period}</p>
        <p class="mt-3 text-xl font-bold">Struktur kerja periode {site.period}.</p>
        <p class="mt-3 text-sm leading-6 text-slate-300">Kepengurusan terdiri atas Ketua, dua Wakil Ketua, Sekretaris, Bendahara, dan tujuh divisi. Setiap divisi memiliki portofolio koordinasi dan ruang kerja yang jelas.</p>
      </aside>
    </div>
  </section>

  <section id="arah" class="scroll-mt-24 mx-auto max-w-7xl px-5 ui-section-space-compact lg:px-8">
    <HighlightPanel>
      <p class="type-eyebrow text-accent-dark">Arah {site.period}</p>
      <h2 class="type-section mt-3 max-w-4xl text-slate-950">{vision.headline}</h2>
      <p class="mt-4 text-lg font-semibold text-slate-800">{vision.subheadline}</p>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">{vision.supporting}</p>
      <div class="mt-7 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
        {directionPillars.map((pillar) => (
          <div class="rounded-2xl border border-accent/25 bg-white/75 p-5">
            <h3 class="font-bold text-slate-950">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">{pillar.description}</p>
          </div>
        ))}
      </div>
      <div class="mt-6 border-t border-accent/35 pt-5">
        <p class="font-bold text-slate-950">{vision.studentFirst}</p>
        <p class="mt-1 text-sm leading-6 text-slate-700">{vision.studentFirstDescription}</p>
      </div>
    </HighlightPanel>
  </section>

  <section id="nilai" class="scroll-mt-24 mx-auto max-w-7xl px-5 ui-section-space-compact lg:px-8">
    <div class="max-w-3xl">
      <p class="type-eyebrow text-brand">Nilai yang kami pegang</p>
      <h2 class="type-section mt-3 text-slate-950">Empat nilai yang membentuk cara kami melayani.</h2>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {values.map((value, index) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-7">
          <div class="flex items-start gap-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent/10 text-xs font-bold text-accent-dark">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-xl font-bold text-slate-950">{value.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{value.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="cara-kerja" class="scroll-mt-24 mx-auto max-w-7xl px-5 ui-section-space-compact lg:px-8">
    <div class="rounded-[2rem] bg-slate-950 p-7 text-white sm:p-10">
      <p class="type-eyebrow text-accent-soft">Cara kami bekerja</p>
      <h2 class="type-section mt-3">{kaizen.title}</h2>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">{kaizen.description}</p>
      <div class="mt-7 grid gap-3 md:grid-cols-3">
        {kaizen.steps.map(([title, description]) => (
          <div class="rounded-2xl border border-slate-700 bg-white/5 p-5">
            <p class="font-bold text-white">{title}</p>
            <p class="mt-2 text-sm leading-6 text-slate-300">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="prinsip-kerja" class="scroll-mt-24 mx-auto max-w-7xl px-5 ui-section-space-compact lg:px-8">
    <div class="max-w-3xl">
      <p class="type-eyebrow text-brand">Prinsip kerja bersama</p>
      <h2 class="type-section mt-3 text-slate-950">Berorganisasi tanpa mengabaikan peran utama sebagai pelajar.</h2>
      <p class="mt-3 leading-7 text-slate-600">Tujuh prinsip berikut menjadi acuan saat menyusun layanan, menentukan skala kegiatan, dan berkolaborasi dengan anggota dari berbagai kampus.</p>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {workPrinciples.map((principle, index) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="type-meta text-accent-dark">Prinsip {String(index + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 text-lg font-bold text-slate-950">{principle.title}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">{principle.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="struktur-organisasi" class="scroll-mt-24 mx-auto max-w-7xl px-5 ui-section-space-compact lg:px-8">
    <div class="max-w-3xl">
      <p class="type-eyebrow text-brand">Struktur organisasi</p>
      <h2 class="mt-3 type-section text-slate-950">Alur tanggung jawab periode {site.period}.</h2>
      <p class="mt-3 leading-7 text-slate-600">Ketua menjaga arah organisasi. Dua Wakil Ketua mengoordinasikan portofolio divisi masing-masing, sedangkan Sekretaris dan Bendahara menangani fungsi inti administrasi serta keuangan.</p>
    </div>

    <div class="mt-9 rounded-[2rem] border border-slate-200 bg-slate-50 p-5 sm:p-7 lg:p-9">
      <div class="mx-auto max-w-sm">
        <article class="rounded-2xl bg-slate-950 p-5 text-center text-white shadow-sm">
          <p class="type-meta text-slate-400">Pimpinan</p>
          <h3 class="mt-2 text-xl font-bold">{leadership[0].title}</h3>
          <p class="mt-2 text-xs leading-5 text-slate-300">{leadership[0].description}</p>
        </article>
      </div>

      <div class="mx-auto h-6 w-px bg-slate-300"></div>

      <div class="mx-auto grid max-w-2xl gap-4 sm:grid-cols-2">
        {leadership.slice(1, 3).map((role) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-5 text-center">
            <p class="type-meta text-accent-dark">Koordinasi</p>
            <h3 class="mt-2 font-bold text-slate-950">{role.title}</h3>
            <p class="mt-2 text-xs leading-5 text-slate-500">{role.description}</p>
          </article>
        ))}
      </div>

      <div class="mx-auto h-6 w-px bg-slate-300"></div>

      <div class="mx-auto grid max-w-2xl gap-4 sm:grid-cols-2">
        {leadership.slice(3).map((role) => (
          <article class="rounded-2xl border border-accent/35 bg-accent/10 p-5 text-center">
            <p class="type-meta text-secondary-dark">Fungsi inti</p>
            <h3 class="mt-2 font-bold text-slate-950">{role.title}</h3>
            <p class="mt-2 text-xs leading-5 text-slate-600">{role.description}</p>
          </article>
        ))}
      </div>

      <div class="mx-auto h-6 w-px bg-slate-300"></div>

      <div>
        <p class="mb-5 text-center type-meta text-slate-500">Tujuh divisi · dua portofolio koordinasi</p>
        <div class="grid gap-5 lg:grid-cols-2">
          {viceChairPortfolios.map((portfolio) => (
            <section aria-label={`Divisi di bawah koordinasi ${portfolio.title}`} class="rounded-2xl border border-slate-200 bg-white p-5">
              <h3 class="mb-4 text-base font-bold text-slate-950">{portfolio.title}</h3>
              <div class="grid gap-3">
                {portfolio.departmentSlugs.map((slug) => {
                  const department = departments.find((item) => item.slug === slug);
                  return department ? (
                    <NavigationCard
                      href={`/programs/#${department.slug}`}
                      title={department.name}
                      description={department.description}
                      action="Lihat bidang kerja →"
                      density="compact"
                    />
                  ) : null;
                })}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>

    <p class="mt-5 text-sm leading-6 text-slate-500">Setiap divisi dipimpin oleh Kepala Divisi dengan dukungan staf sesuai kebutuhan. Koordinasi lintas divisi tetap dimungkinkan dengan penanggung jawab utama yang jelas.</p>
  </section>

  <section id="sejarah-arsip" class="scroll-mt-24 mx-auto max-w-7xl px-5 pb-20 pt-12 lg:px-8">
    <article class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="type-eyebrow text-brand">Sejarah & arsip</p>
      <h2 class="mt-3 text-xl font-bold text-slate-950">Menjaga jejak perjalanan PPI Ishikawa.</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Arsip kepengurusan, program, publikasi, dan dokumentasi membantu anggota mengenal perjalanan organisasi serta menjadi rujukan bagi periode berikutnya.</p>
    </article>
  </section>
  <RelatedLinks items={generalRelatedContent.about} title="Lanjutkan mengenal PPI Ishikawa" />
</BaseLayout>
