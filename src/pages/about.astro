---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { leadership, departments, organizationPrinciples } from '../data/organization';
---
<BaseLayout title="Tentang">
  <PageIntro
    title="Tentang PPI Ishikawa"
    description="Ruang bersama pelajar Indonesia di Prefektur Ishikawa untuk saling mendukung, berkembang, terhubung, dan menjaga kesinambungan komunitas."
  />

  <section class="mx-auto max-w-7xl px-5 pb-16 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-3">
      <article class="rounded-3xl border border-slate-200 bg-white p-6 lg:col-span-2 sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Profil</p>
        <h2 class="mt-3 text-2xl font-bold text-slate-950">PPI Ishikawa</h2>
        <p class="mt-4 leading-7 text-slate-600">
          PPI Ishikawa adalah komunitas pelajar Indonesia di Prefektur Ishikawa, Jepang. Website ini disiapkan sebagai pusat informasi organisasi, panduan hidup, program, dokumentasi, dan jalur kolaborasi yang dapat diteruskan lintas periode kepengurusan.
        </p>
      </article>
      <aside class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-red-300">Periode 2026/27</p>
        <p class="mt-3 text-xl font-bold">Struktur sedang difinalisasi.</p>
        <p class="mt-3 text-sm leading-6 text-slate-300">Halaman ini menampilkan desain struktur dan fungsi organisasi. Nama pengurus akan ditambahkan setelah penetapan resmi.</p>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Pimpinan & fungsi inti</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Struktur organisasi 2026/27.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
      {leadership.map((role) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{role.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{role.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Departemen</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Tujuh fungsi kerja.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {departments.map((department) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6">
          <h3 class="font-bold text-slate-950">{department.name}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{department.description}</p>
        </article>
      ))}
    </div>
    <p class="mt-5 text-sm leading-6 text-slate-500">Sekretaris, Bendahara, dan setiap departemen dapat didukung staf/anggota sesuai kebutuhan organisasi.</p>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Prinsip kerja</p>
      <div class="mt-5 grid gap-3 md:grid-cols-2">
        {organizationPrinciples.map((principle) => (
          <div class="rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700">{principle}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-10 lg:px-8">
    <div class="grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Visi & misi</p>
        <h2 class="mt-3 text-xl font-bold text-slate-950">Akan dipublikasikan setelah penetapan resmi.</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Website tidak akan mengunci rumusan visi-misi sebelum dokumen kepengurusan 2026/27 selesai.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Sejarah & arsip</p>
        <h2 class="mt-3 text-xl font-bold text-slate-950">Memori organisasi sedang disusun.</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Arsip lama, kepengurusan terdahulu, program, publikasi, dan dokumentasi akan dikurasi sebagai institutional memory, bukan sekadar daftar file.</p>
      </article>
    </div>
  </section>
</BaseLayout>
