---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideMeta from '../components/GuideMeta.astro';
import TopicIcon from '../components/TopicIcon.astro';
import ContextualText from '../components/ContextualText.astro';
import InstitutionMark from '../components/InstitutionMark.astro';
import { survivalGuides } from '../data/survival';
import { withBase } from '../utils/paths';
import { publicMedia } from '../data/media';


const journeys = [
  {
    id: 'akan-datang',
    label: '01',
    title: 'Saya akan datang ke Ishikawa',
    description: 'Mulai dari persiapan sebelum berangkat agar administrasi dan kebutuhan awal tidak terlewat.',
    steps: [
      'Pastikan paspor, status tinggal, dan dokumen dari universitas tersimpan aman.',
      'Siapkan alamat tempat tinggal pertama dan informasi kontak universitas.',
      'Pahami kebutuhan awal: uang, telepon/internet, transportasi, obat pribadi, dan kebutuhan musim.',
      'Baca panduan resmi untuk pendatang baru sebelum berangkat.'
    ],
    href: '/life-in-ishikawa/sebelum-berangkat/'
  },
  {
    id: 'baru-tiba',
    label: '02',
    title: 'Saya baru tiba di Ishikawa',
    description: 'Prioritaskan administrasi dasar dan kebutuhan yang membuat Anda bisa mulai hidup dengan aman.',
    steps: [
      'Konfirmasi alamat tempat tinggal dan prosedur registrasi yang berlaku di municipality Anda.',
      'Pelajari National Health Insurance, pension, dan My Number sesuai kondisi Anda.',
      'Pastikan akses komunikasi, pembayaran, transportasi, dan kontak darurat.',
      'Gunakan panduan municipality tempat Anda tinggal karena prosedur lokal dapat berbeda.'
    ],
    href: '/life-in-ishikawa/hari-pertama/'
  },
  {
    id: 'sudah-tinggal',
    label: '03',
    title: 'Saya sudah tinggal di Ishikawa',
    description: 'Gunakan Survival Guide sebagai referensi untuk kehidupan sehari-hari, kesehatan, transportasi, dan bantuan.',
    steps: [
      'Cek aturan sampah dan layanan lokal berdasarkan kota tempat tinggal Anda.',
      'Simpan sumber resmi untuk klinik, rumah sakit, cuaca, bencana, dan jalan bersalju.',
      'Gunakan layanan konsultasi IFIE jika mengalami kesulitan terkait kehidupan, administrasi, pekerjaan, kesehatan, atau keluarga.',
      'Periksa kembali informasi resmi ketika biaya, jadwal, atau aturan dapat berubah.'
    ],
    href: '/life-in-ishikawa/kehidupan-sehari-hari/'
  },
  {
    id: 'akan-pergi',
    label: '04',
    title: 'Saya akan meninggalkan Ishikawa / Jepang',
    description: 'Mulai checklist lebih awal agar urusan tempat tinggal, administrasi, layanan, dan dokumen selesai dengan rapi.',
    steps: [
      'Cek prosedur pindah keluar di municipality tempat Anda terdaftar.',
      'Tutup atau pindahkan utilities, telepon/internet, dan kontrak tempat tinggal sesuai ketentuan masing-masing.',
      'Periksa kewajiban terkait health insurance, pension, pajak, bank, dan residence procedures.',
      'Simpan dokumen penting dan bukti penyelesaian untuk kebutuhan setelah meninggalkan Jepang.'
    ],
    href: '/life-in-ishikawa/leaving/'
  }
];


const officialSources = [
  {
    title: 'Foreign Residents Support Portal',
    owner: 'Immigration Services Agency of Japan',
    note: 'Portal nasional untuk informasi kehidupan dan prosedur warga asing, termasuk materi multibahasa dan Bahasa Indonesia.',
    url: 'https://www.moj.go.jp/isa/support/portal/'
  },
  {
    title: 'Guidance for New Entrants to Japan',
    owner: 'Immigration Services Agency of Japan',
    note: 'Panduan resmi bagi warga asing yang baru masuk Jepang.',
    url: 'https://www.moj.go.jp/isa/support/guidance/'
  },
  {
    title: 'Informasi Kehidupan untuk Warga Asing',
    owner: 'Ishikawa Foundation for International Exchange (IFIE)',
    note: 'Hub lokal Ishikawa untuk informasi kehidupan, bantuan, kesehatan, pendidikan, dan layanan terkait.',
    url: 'https://www.ifie.or.jp/foreigners_life/life_guide/'
  },
  {
    title: 'Konsultasi Gratis untuk Warga Asing',
    owner: 'IFIE',
    note: 'Layanan konsultasi bagi warga asing di Ishikawa, termasuk dukungan Bahasa Indonesia.',
    url: 'https://www.ifie.or.jp/foreigners_life/soudan/'
  },
  {
    title: 'Disaster Preparedness Guidebook for Foreign Residents',
    owner: 'Ishikawa Prefecture',
    note: 'Panduan resmi bencana Ishikawa yang tersedia juga dalam Bahasa Indonesia.',
    url: 'https://www.pref.ishikawa.lg.jp/kokusai/tabunka/bousaigaidoh30.html'
  },
  {
    title: 'Kanazawa Living Guide',
    owner: 'Kanazawa City',
    note: 'Panduan kehidupan resmi untuk warga asing yang tinggal di Kanazawa.',
    url: 'https://digilib.city.kanazawa.ishikawa.jp/doc/32/'
  }
];
---

<BaseLayout
  title="Hidup di Ishikawa"
  description="Panduan awal untuk pelajar Indonesia yang akan datang, baru tiba, sedang tinggal, atau akan meninggalkan Ishikawa."
>
  <section class="mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <div class="max-w-4xl">
      <div class="flex flex-wrap items-center gap-3">
        <InstitutionMark id="ishikawa" size="md" />
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand">Ishikawa Survival Guide · SG00</p>
      </div>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Mulai dari kondisi Anda sekarang.</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
        Tidak perlu membaca semuanya sekaligus. Pilih situasi yang paling sesuai, ikuti prioritas dasarnya,
        lalu gunakan halaman panduan yang lebih rinci ketika Anda membutuhkannya.
      </p>
    </div>

    <GuideMeta code="SG00" />
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-12 lg:px-8">
    <figure class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
      <img src={publicMedia.shinkansenKanazawa.imageUrl} alt={publicMedia.shinkansenKanazawa.alt} width="1400" height="933" class="aspect-[16/9] h-auto w-full object-cover" loading="eager" referrerpolicy="no-referrer" />
      <figcaption class="border-t border-slate-100 bg-slate-50 px-5 py-3 text-xs leading-5 text-slate-500">
        Hokuriku Shinkansen di Kanazawa Station · <a href={publicMedia.shinkansenKanazawa.sourcePage} target="_blank" rel="noreferrer" class="underline">{publicMedia.shinkansenKanazawa.credit}</a> · {publicMedia.shinkansenKanazawa.license}
      </figcaption>
    </figure>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-16 lg:px-8">
    <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-amber-800">Cara menggunakan panduan ini</p>
      <p class="mt-3 max-w-4xl leading-7 text-slate-700">
        Survival Guide PPI Ishikawa membantu menjelaskan informasi resmi dalam konteks kehidupan pelajar Indonesia.
        Untuk aturan administrasi, hukum, kesehatan, keselamatan, pajak, dan layanan kota, sumber resmi pemerintah tetap menjadi rujukan utama.
        Prosedur lokal juga dapat berbeda antara Kanazawa, Nonoichi, Hakusan, Komatsu, Kahoku, dan kota/town lain di Ishikawa.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-2">
      {journeys.map((journey, index) => (
        <article id={journey.id} class="scroll-mt-28 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div class="flex items-start gap-4">
            <div class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-red-50 text-brand">
              <TopicIcon name={(['documents','arrival','housing','documents'] as const)[index]} class="size-6" />
            </div>
            <div>
              <h2 class="text-2xl font-bold tracking-tight text-slate-950">{journey.title}</h2>
              <p class="mt-2 leading-7 text-slate-600"><ContextualText text={journey.description} maxLinks={2} /></p>
            </div>
          </div>

          <div class="mt-6 border-t border-slate-100 pt-5">
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-slate-500">Prioritas awal</p>
            <ol class="mt-4 space-y-3">
              {journey.steps.map((step, index) => (
                <li class="flex gap-3 text-sm leading-6 text-slate-700">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-700">
                    {index + 1}
                  </span>
                  <span><ContextualText text={step} maxLinks={1} /></span>
                </li>
              ))}
            </ol>
            {journey.href && (
              <a href={withBase(journey.href)} class="mt-6 inline-flex rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white transition hover:bg-slate-700">
                Buka panduan lengkap →
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Semua panduan</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">SG01–SG14 dalam satu tempat.</h2>
        <p class="mt-4 leading-7 text-slate-600">
          Jika Anda sudah tahu topik yang dicari, buka panduan langsung tanpa harus mengikuti urutan journey.
        </p>
      </div>
      <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {survivalGuides.slice(1).map((guide) => (
          <a
            href={withBase(guide.href)}
            class="group rounded-2xl bg-slate-50 p-4 transition hover:bg-slate-100"
          >
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand">{guide.code}</p>
            <p class="mt-1 font-bold text-slate-900 group-hover:text-brand">{guide.title} →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Prinsip penting</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Aturan resmi dan tips PPI bukan hal yang sama.</h2>
          <p class="mt-4 leading-7 text-slate-600">
            Panduan ini membedakan ketentuan resmi dari pengalaman praktis anggota.
            Untuk informasi yang dapat berubah—seperti jadwal, biaya, layanan kesehatan, transportasi,
            atau peringatan bencana—selalu periksa sumber resmi terbaru.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-slate-50 p-5">
            <p class="font-bold text-slate-950">Japan-wide</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">Immigration, residence status, sistem nasional, pension, dan aturan nasional lainnya.</p>
          </div>
          <div class="rounded-2xl bg-slate-50 p-5">
            <p class="font-bold text-slate-950">Ishikawa Prefecture</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">Bencana, layanan prefektur, dukungan warga asing, dan informasi regional.</p>
          </div>
          <div class="rounded-2xl bg-slate-50 p-5">
            <p class="font-bold text-slate-950">Pemerintah setempat</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">Registrasi alamat, sampah, childcare, layanan kota, dan prosedur yang bergantung pada tempat tinggal.</p>
          </div>
          <div class="rounded-2xl bg-slate-50 p-5">
            <p class="font-bold text-slate-950">Catatan praktis PPI</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">Urutan praktis, istilah yang membingungkan, pengalaman mahasiswa, dan kesalahan yang sering terjadi.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Butuh bantuan?</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Jangan bergantung pada guide ini untuk situasi mendesak.</h2>
      <p class="mt-4 leading-7 text-slate-600">
        Untuk kondisi darurat, gunakan layanan darurat Jepang dan informasi resmi yang berlaku saat itu.
        Untuk persoalan kehidupan, administrasi, pekerjaan, kesehatan, kesejahteraan, kelahiran, pengasuhan anak,
        atau pendidikan, IFIE menyediakan layanan konsultasi bagi warga asing di Ishikawa.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="https://www.ifie.or.jp/foreigners_life/soudan/"
          target="_blank"
          rel="noreferrer"
          class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-slate-700"
        >
          Buka layanan konsultasi IFIE ↗
        </a>
        <a
          href="https://www.pref.ishikawa.lg.jp/kokusai/tabunka/bousaigaidoh30.html"
          target="_blank"
          rel="noreferrer"
          class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800 transition hover:bg-slate-50"
        >
          Panduan bencana Ishikawa ↗
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 lg:px-8">
    <div class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-red-300">Sumber resmi utama</p>
        <h2 class="mt-3 text-2xl font-bold">Gunakan sumber asli untuk memeriksa informasi terbaru.</h2>
        <p class="mt-3 leading-7 text-slate-300">
          Gunakan sumber berikut untuk memeriksa aturan, prosedur, dan layanan terbaru.
        </p>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {officialSources.map((source) => (
          <a
            href={source.url}
            target="_blank"
            rel="noreferrer"
            class="group rounded-2xl border border-slate-700 bg-slate-900 p-5 transition hover:border-slate-500 hover:bg-slate-800"
          >
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">{source.owner}</p>
            <h3 class="mt-2 font-bold text-white group-hover:text-red-200">{source.title} ↗</h3>
            <p class="mt-2 text-sm leading-6 text-slate-400">{source.note}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
