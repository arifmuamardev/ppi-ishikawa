---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideToc from '../../../components/GuideToc.astro';
import InstitutionMark from '../../../components/InstitutionMark.astro';
import ContextualText from '../../../components/ContextualText.astro';
import CampusFaqGuideLinks from '../../../components/CampusFaqGuideLinks.astro';
import CampusScholarshipGuide from '../../../components/CampusScholarshipGuide.astro';
import CampusCareerGuide from '../../../components/CampusCareerGuide.astro';
import CampusOfficialSources from '../../../components/CampusOfficialSources.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CampusProfile from '../../../components/CampusProfile.astro';
import CampusGuideBridge from '../../../components/CampusGuideBridge.astro';
import CampusContactRoutes from '../../../components/CampusContactRoutes.astro';
import LicensedPhoto from '../../../components/LicensedPhoto.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';
import { campusRelatedContent } from '../../../data/related-content';
import { campusProfileBySlug } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';
import { campusMedia } from '../../../data/media';
import { campusMapPoints } from '../../../data/campus-map';
import { kinjoPack, kinjoSections, kinjoQuickLinks, kinjoContactMap, kinjoFaq } from '../../../data/campus-kinjo';

const campusPhoto = campusMedia['kinjo-university']!;
const campusMap = campusMapPoints['kinjo-university'];

const priorityFaq = kinjoFaq.filter((item) => ["tuition-reduction","peer-support","preparation-program-vs-degree","jalur-mahasiswa-internasional"].includes(item.id));
---

<BaseLayout
  title="Kinjo University Campus Pack"
  description="Panduan praktis mahasiswa Indonesia di Kinjo University: Kasama dan Matto Campus, international-student support, housing, transportasi, kesehatan, counseling, career, daily life di Hakusan, dan FAQ."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Kampus', href: '/community/kampus/' }, { label: 'Kinjo University' }]} />
    <p class="mt-8 text-sm font-bold uppercase tracking-[0.18em] text-accent-dark">PPI Ishikawa · Campus Pack</p>
    <div class="mt-4 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <InstitutionMark id="kinjo-university" size="lg" class="shrink-0" />
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Kinjo University</h1>
    </div>
    <p class="mt-2 text-lg text-slate-500">金城大学 · Hakusan</p>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
      Panduan praktis untuk mahasiswa Indonesia di Kinjo University. Campus Pack ini memberi perhatian khusus pada support mahasiswa internasional, private housing, mobilitas antara Kasama dan Matto Campus, serta studi profesional di bidang ekonomi, social welfare/education, rehabilitation, dan nursing.
    </p>

    <div class="mt-7 flex flex-wrap gap-3 text-sm">
      <span class="rounded-full bg-slate-900 px-4 py-2 font-semibold text-white">Private university</span>
      <span class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-700">Kasama + Matto · Hakusan</span>
      <span class="rounded-full border border-amber-200 bg-amber-50 px-4 py-2 font-semibold text-accent-dark">Terakhir diverifikasi: {kinjoPack.lastVerified}</span>
      <a href={withBase('/life-in-ishikawa/municipality-guides/#hakusan')} class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-brand transition hover:border-amber-200 hover:bg-amber-50">Panduan Hakusan →</a>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {kinjoQuickLinks.map(([label, url]) => (
        <a href={url} target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 text-sm font-bold text-slate-800 transition hover:border-amber-200 hover:shadow-sm">
          {label} ↗
        </a>
      ))}
    </div>
  </section>

  <CampusProfile profile={campusProfileBySlug['kinjo-university']} />

  <section class="mx-auto max-w-5xl px-5 pb-4 lg:px-8">
    <LicensedPhoto media={campusPhoto} imageClass="aspect-[16/9] w-full object-cover" />
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-8 lg:px-8">
    <div class="mb-4">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Lokasi utama kampus</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Lihat posisi kampus sebelum memilih housing dan commute.</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Peta dapat di-zoom dan digeser. Gunakan tombol akses resmi pada marker untuk petunjuk kampus terbaru.</p>
    </div>
    <InteractiveMap points={campusMap} heightClass="h-[340px] sm:h-[420px]" />
  </section>

  <GuideToc sections={kinjoSections} />

  <section id="kenali-kinjo" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-01" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">01 · Kenali Kinjo</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Kampus profesional dengan dua lokasi utama di Hakusan.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="text-xl font-bold text-slate-950">Undergraduate</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Kinjo University memiliki Faculty of Interdisciplinary Economics, Faculty of Human and Social Sciences, Faculty of Medical Health, dan Faculty of Nursing. Banyak program terhubung langsung dengan practicum, professional qualification, community work, atau career preparation.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="text-xl font-bold text-slate-950">Graduate & advanced study</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Graduate School berfokus pada Comprehensive Rehabilitation. Kinjo juga memiliki Advanced Course of Public Health Nursing. Karena lokasi aktivitas dapat berbeda, cek campus assignment setiap program dan practicum.</p>
        <a href="https://www.kinjo.ac.jp/ku/" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Academic programs ↗</a>
      </article>
    </div>

    <div class="mt-5 rounded-3xl border border-slate-200 bg-slate-50 p-6">
      <h3 class="font-bold text-slate-950">Dua kampus bukan sekadar alamat.</h3>
      <p class="mt-2 text-sm leading-6 text-slate-600">Kasama Campus adalah basis utama universitas dan Graduate School. Matto Campus juga digunakan oleh Faculty of Nursing serta Advanced Course of Public Health Nursing. Untuk housing dan commute, selalu mulai dari lokasi kegiatan Anda yang paling sering.</p>
    </div>
  </section>

  <CampusGuideBridge
    id="minggu-pertama"
    number="02"
    eyebrow="Minggu pertama"
    title="Minggu pertama di Kinjo: pastikan Kasama atau Matto dan kenali support route."
    summary="Checklist kedatangan yang berlaku umum—resident registration, health insurance, pension, komunikasi, pembayaran, dan kebutuhan hari pertama—tidak diulang di Campus Pack. Gunakan Survival Guide sebagai checklist utama."
    campusNote="Lokasi studi memengaruhi housing dan commute. International Exchange Center adalah titik awal untuk banyak kebutuhan international student, sedangkan kebutuhan akademik mengikuti faculty/advisor."
    links={[
      { label: 'Hari Pertama di Ishikawa', href: '/life-in-ishikawa/hari-pertama/', icon: 'arrival' },
      { label: 'Administrasi', href: '/life-in-ishikawa/administrasi/', icon: 'documents' }
    ]}
  />
  <section id="kontak-dukungan" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-03" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">03 · Ke mana harus bertanya</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Gunakan jalur sesuai masalahnya, lalu buka detail hanya jika diperlukan.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Bagian ini hanya berfungsi sebagai routing directory. Detail health, counseling, career, housing, dan support lain dijelaskan pada section masing-masing.</p>
    <CampusContactRoutes items={kinjoContactMap} sourceUrl="https://www.kinjo.ac.jp/english/student/center.html" sourceLabel="International Exchange Center" />
  </section>
  <section id="international-support" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-04" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">04 · International student support</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">International Exchange Center adalah pintu masuk utama untuk isu lintas administrasi dan daily life.</h2>
    <div class="mt-7 rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
      <h3 class="text-xl font-bold text-slate-950">Support yang disebutkan resmi</h3>
      <p class="mt-3 leading-7 text-slate-700">Kinjo menjelaskan bahwa International Exchange Center memberi consultation terkait residence status, housing, medical matters dan kehidupan sehari-hari, sekaligus informasi studi dan scholarship. Center ini melibatkan staff dari berbagai faculty/department dan menyediakan dukungan multibahasa.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="https://www.kinjo.ac.jp/english/student/center.html" target="_blank" rel="noreferrer" class="rounded-xl border border-amber-200 bg-white px-4 py-3 text-sm font-bold text-slate-800">International Exchange Center ↗</a>
        <a href="https://www.kinjo.ac.jp/english/prospective/examination.html" target="_blank" rel="noreferrer" class="rounded-xl border border-amber-200 bg-white px-4 py-3 text-sm font-bold text-slate-800">International admissions ↗</a>
      </div>
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {[
        ['Admission', 'Kinjo memiliki jalur dan guidance khusus international students. Eligibility dan Japanese-language requirements harus dicek per admission year.'],
        ['Scholarship', 'Panduan 2026 mencantumkan special tuition-reduction scholarship untuk international students; gunakan guideline terbaru sebelum menghitung biaya.'],
        ['Preparation program', 'Kinjo College menjalankan Preparation Program for Foreign Students. Ini berbeda dari degree route Kinjo University, jadi jangan mencampur prosedurnya.']
      ].map(([title,desc]) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="housing" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-05" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">05 · Housing</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Tidak ada foreign-student dormitory; pilih apartment berdasarkan Kasama atau Matto.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Campus Pack hanya menyimpan konteks housing yang spesifik kampus. Initial cost, guarantor, utilities, kontrak, move-out, dan checklist umum dirujuk ke Survival Guide.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Ordinary apartment</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Kinjo menyatakan international students tinggal di apartment biasa dan International Exchange Center menyediakan housing consultation.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Kasama vs Matto</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Untuk Kasama, Kaga-Kasama dan rail corridor Hakusan relevan. Untuk Nursing/Public Health Nursing di Matto, pilih lokasi berdasarkan akses Matto.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Co-signer support</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Kinjo menjelaskan kemungkinan dukungan co-signer dalam kondisi tertentu. Konsultasikan unit dan prosedur sebelum menandatangani kontrak.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kinjo.ac.jp/english/prospective/living.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Housing & living ↗</a>
      <a href="https://www.kinjo.ac.jp/english/student/center.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">International Exchange Center ↗</a>
      <a href={withBase('/life-in-ishikawa/tempat-tinggal/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Checklist Tempat Tinggal →</a>
    </div>
  </section>
  <section id="transportasi-dua-kampus" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-06" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">06 · Transportasi & dua kampus</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Kasama dan Matto punya pola commute yang berbeda.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Campus Pack hanya menyimpan pola akses yang khas kampus. Fare, timetable, bicycle rules, IC card, winter safety, dan transport umum tetap dirujuk ke Survival Guide.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Kasama Campus</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Akses utama melalui Kaga-Kasama Station lalu berjalan kaki menuju campus. Ini relevan untuk sebagian besar faculties dan graduate programs.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Matto Campus</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Untuk Nursing/Public Health Nursing, akses Matto Station dan local/shuttle connection lebih relevan.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Jangan campur rute</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Pastikan lokasi kelas/practicum sebelum memilih housing atau menyimpan satu rute commute sebagai default.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kinjo.ac.jp/ku/access/" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Access resmi Kinjo ↗</a>
      <a href={withBase('/life-in-ishikawa/transportasi/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Panduan Transportasi →</a>
    </div>
  </section>
  <section id="kesehatan-counseling-accessibility" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-07" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">07 · Kesehatan, counseling & accessibility</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Support system Kinjo cukup berlapis—gunakan yang paling sesuai kebutuhan.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-2">
      {[
        ['Health Room', 'Menangani health management, annual check-up, health consultation, first aid, referral guidance, dan koordinasi dengan support lain bila diperlukan.'],
        ['Counseling Room', 'Qualified clinical psychologists/certified psychologists menangani consultation tentang relationships, study, practicum, career, stress, dan student life.'],
        ['Disability Support Center', 'Menjadi consultation point untuk reasonable accommodation, koordinasi dengan faculty/staff, follow-up, dan study support.'],
        ['Human Rights / harassment route', 'Kinjo memiliki Human Rights Committee dan harassment consultation framework. Untuk kasus sensitif, gunakan official consultation route dan dokumentasikan kebutuhan Anda.']
      ].map(([title,desc]) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p>
        </article>
      ))}
    </div>
    <a href={withBase('/life-in-ishikawa/kesehatan/')} class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">SG07 · Kesehatan →</a>
  </section>

  <section id="studi-karier-fasilitas" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-08" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">08 · Studi, career & fasilitas</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Kinjo menggabungkan academic support dengan professional preparation.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Study support & peer support</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Kinjo menggunakan study-advisor system dan menyediakan learning commons. Peer Supporter juga menjalankan new-student activities, consultation, study sessions sebelum ujian, dan practicum-related support.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="https://www.kinjo.ac.jp/ku/campuslife/studentsupport.html" target="_blank" rel="noreferrer" class="text-sm font-bold text-brand hover:underline">Student support ↗</a>
          <a href="https://www.kinjo.ac.jp/ku/campuslife/peer-supporter.html" target="_blank" rel="noreferrer" class="text-sm font-bold text-brand hover:underline">Peer Supporter ↗</a>
        </div>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Career Support Center</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Career support mencakup guidance, industry/job preparation, application documents, interview practice, individual consultation, job information, dan berbagai seminars. Dukungan dimulai sebelum tahun akhir.</p>
        <a href="https://www.kinjo.ac.jp/ku/job/support.html" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Career support ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">University Library</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Library tersedia di Kasama dan Matto Campus dengan koleksi bidang universitas, OPAC, reading resources, dan study support. Opening hours dapat berubah menurut semester dan calendar.</p>
        <a href="https://www.kinjo.ac.jp/ku/campuslife/library.html" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">University Library ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Practicum-aware planning</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Untuk welfare, rehabilitation, nursing, education, dan bidang profesional lain, jadwal practicum dapat mengubah kebutuhan transport, pakaian, health requirements, dan waktu kerja part-time. Prioritaskan academic/practicum calendar.</p>
      </article>
    </div>
  </section>

    <CampusGuideBridge
    id="hakusan-daily-life"
    number="09"
    eyebrow="Hakusan & daily life"
    title="Lokasi housing menentukan municipality, commute, dan layanan harian."
    summary="Aturan sampah, city procedures, shopping, health services, dan kebutuhan keluarga sebaiknya dicari berdasarkan alamat tempat tinggal, bukan berdasarkan nama universitas."
    campusNote="Kinjo memiliki Kasama dan Matto Campus. Pastikan dulu kampus aktivitas utama Anda, lalu pilih housing dan municipality yang sesuai sebelum memakai panduan lokal."
    links={[
      { label: 'Kehidupan Sehari-hari', href: '/life-in-ishikawa/kehidupan-sehari-hari/', icon: 'guide' },
      { label: 'Panduan Hakusan', href: '/life-in-ishikawa/municipality-guides/#hakusan', icon: 'city' }
    ]}
  />
  <section id="faq" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-10" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">10 · FAQ mahasiswa Indonesia</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Pertanyaan tambahan yang khas Kinjo.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">FAQ hanya menyimpan pertanyaan yang tidak sudah dijelaskan pada housing, transport, support, academic, atau section kampus lainnya.</p>
    <div class="mt-6 space-y-3">
      {priorityFaq.map((item, index) => (
        <details id={`faq-${item.id}`} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-5">
          <span id={`faq-${String(index + 1).padStart(2, '0')}`} class="sr-only" aria-hidden="true"></span>
          <summary class="cursor-pointer font-bold text-slate-950">{item.q}</summary>
          <p class="mt-3 text-sm leading-6 text-slate-600"><ContextualText text={item.a} maxLinks={2} /></p>
          <CampusFaqGuideLinks campusSlug="kinjo-university" question={item.q} answer={item.a} />
        </details>
      ))}
    </div>
  </section>

  <CampusScholarshipGuide campusSlug="kinjo-university" />

  <CampusCareerGuide campusSlug="kinjo-university" />

  <RelatedLinks
    items={campusRelatedContent['kinjo-university']}
    eyebrow="Lanjut dari Campus Pack"
    title="Panduan yang paling relevan setelah membaca Campus Pack ini"
  />

  <CampusOfficialSources sources={kinjoPack.officialSources} lastVerified={kinjoPack.lastVerified} />
</BaseLayout>
