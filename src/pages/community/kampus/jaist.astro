---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideToc from '../../../components/GuideToc.astro';
import InstitutionMark from '../../../components/InstitutionMark.astro';
import ContextualText from '../../../components/ContextualText.astro';
import CampusFaqGuideLinks from '../../../components/CampusFaqGuideLinks.astro';
import CampusScholarshipGuide from '../../../components/CampusScholarshipGuide.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CampusProfile from '../../../components/CampusProfile.astro';
import CampusGuideBridge from '../../../components/CampusGuideBridge.astro';
import CampusContactRoutes from '../../../components/CampusContactRoutes.astro';
import LicensedPhoto from '../../../components/LicensedPhoto.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';
import { campusRelatedContent } from '../../../data/related-content';
import { campusProfileBySlug } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';
import { campusMedia } from '../../../data/media';
import { campusMapPoints } from '../../../data/campus-map';
import { jaistPack, jaistSections, jaistQuickLinks, jaistContactMap, jaistFaq } from '../../../data/campus-jaist';

const campusPhoto = campusMedia['jaist']!;
const campusMap = campusMapPoints['jaist'];

const priorityFaq = jaistFaq.filter((item) => ["perlu-mobil","tinggal-di-luar-nomi","handbook-vs-ppi"].includes(item.id));
---

<BaseLayout
  title="JAIST Campus Pack"
  description="Panduan praktis mahasiswa Indonesia di JAIST: minggu pertama, student housing, shuttle, International Student Section, health/counseling, Japanese, research, career, family, dan FAQ."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Kampus', href: '/community/kampus/' }, { label: 'JAIST' }]} />
    <p class="mt-8 text-sm font-bold uppercase tracking-[0.18em] text-accent-dark">PPI Ishikawa · Campus Pack</p>
    <div class="mt-4 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <InstitutionMark id="jaist" size="lg" class="shrink-0" />
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">JAIST</h1>
    </div>
    <p class="mt-2 text-lg text-slate-500">北陸先端科学技術大学院大学 · Nomi</p>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
      Panduan praktis untuk mahasiswa Indonesia di Japan Advanced Institute of Science and Technology. Karena JAIST adalah graduate university di Asahidai, Nomi, Campus Pack ini memberi perhatian khusus pada student housing, shuttle, mobilitas harian, support mahasiswa internasional, dan kehidupan berbasis research.
    </p>

    <div class="mt-7 flex flex-wrap gap-3 text-sm">
      <span class="rounded-full bg-slate-900 px-4 py-2 font-semibold text-white">National graduate university</span>
      <span class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-700">Asahidai · Nomi</span>
      <span class="rounded-full border border-amber-200 bg-amber-50 px-4 py-2 font-semibold text-accent-dark">Terakhir diverifikasi: {jaistPack.lastVerified}</span>
      <a href={withBase('/life-in-ishikawa/municipality-guides/#nomi')} class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-brand transition hover:border-amber-200 hover:bg-amber-50">Panduan Nomi →</a>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {jaistQuickLinks.map(([label, url]) => (
        <a href={url} target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 text-sm font-bold text-slate-800 transition hover:border-amber-200 hover:shadow-sm">
          {label} ↗
        </a>
      ))}
    </div>
  </section>

  <CampusProfile profile={campusProfileBySlug['jaist']} />

  <section class="mx-auto max-w-5xl px-5 pb-4 lg:px-8">
    <LicensedPhoto media={campusPhoto} imageClass="aspect-[16/9] w-full object-cover" />
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-8 lg:px-8">
    <div class="mb-4">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Lokasi kampus</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Lihat posisi kampus sebelum memilih housing dan commute.</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Peta dapat di-zoom dan digeser. Gunakan tombol akses resmi pada marker untuk petunjuk kampus terbaru.</p>
    </div>
    <InteractiveMap points={campusMap} heightClass="h-[340px] sm:h-[420px]" />
  </section>

  <GuideToc sections={jaistSections} />

  <section id="kenali-jaist" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-01" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">01 · Kenali JAIST</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Satu campus environment dengan student life yang sangat terhubung ke riset.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="text-xl font-bold text-slate-950">Asahidai Campus</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Campus map JAIST menggabungkan lecture/research buildings, library, cafeteria, convenience store, gymnasium, Health Care Center, Student Housing, JAIST HOUSE, dan shuttle stops dalam satu area kampus.</p>
        <a href="https://www.jaist.ac.jp/english/top/campusmap/" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Buka campus map ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="text-xl font-bold text-slate-950">Graduate & research focused</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">JAIST melayani program master, doctoral, dan berbagai kategori non-degree/research students. Pengalaman harian karena itu sangat terkait dengan research area, supervisor, laboratory, course work, dan milestone program.</p>
        <a href="https://www.jaist.ac.jp/english/admissions/" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Admissions & programs ↗</a>
      </article>
    </div>
  </section>

  <CampusGuideBridge
    id="minggu-pertama"
    number="02"
    eyebrow="Minggu pertama"
    title="Minggu pertama di JAIST: ikuti notice intake dan cek housing serta shuttle."
    summary="Checklist kedatangan yang berlaku umum—resident registration, health insurance, pension, komunikasi, pembayaran, dan kebutuhan hari pertama—tidak diulang di Campus Pack. Gunakan Survival Guide sebagai checklist utama."
    campusNote="Tanggal move-in, orientation, health check, student ID, dan registration berbeda menurut intake. Gunakan Notice to New Students dan cek Access/Shuttle untuk pola commute aktual."
    links={[
      { label: 'Hari Pertama di Ishikawa', href: '/life-in-ishikawa/hari-pertama/', icon: 'arrival' },
      { label: 'Administrasi', href: '/life-in-ishikawa/administrasi/', icon: 'documents' }
    ]}
  />
  <section id="kontak-dukungan" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-03" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">03 · Ke mana harus bertanya</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Gunakan office yang sesuai agar pertanyaan tidak berputar.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Bagian ini hanya berfungsi sebagai routing directory. Detail health, counseling, career, housing, dan support lain dijelaskan pada section masing-masing.</p>
    <CampusContactRoutes items={jaistContactMap} sourceUrl="https://www.jaist.ac.jp/english/studentlife/contact/index.html" sourceLabel="Contact Information resmi" />
  </section>
  <section id="housing" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-04" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">04 · Student housing & apartment</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Mulai dari campus housing; private apartment baru dibandingkan jika memang diperlukan.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Campus Pack hanya menyimpan konteks housing yang spesifik kampus. Initial cost, guarantor, utilities, kontrak, move-out, dan checklist umum dirujuk ke Survival Guide.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Student Housing & JAIST HOUSE</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">JAIST menyediakan housing di campus area, termasuk single serta beberapa opsi untuk pasangan/keluarga. Availability dan eligibility harus dicek per intake.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Private housing</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">JAIST mencantumkan pilihan di Nomi/Tatsunokuchi serta kota sekitar. Jika tinggal di luar campus, akses shuttle dan winter commute menjadi faktor utama.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Jalur resmi</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Student Welfare Section dan halaman Student Housing adalah sumber utama sebelum membuat keputusan tempat tinggal.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.jaist.ac.jp/english/studentlife/institution/housing.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Student Housing resmi ↗</a>
      <a href="https://www.jaist.ac.jp/english/studentlife/contact/index.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Student contacts ↗</a>
      <a href={withBase('/life-in-ishikawa/tempat-tinggal/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Checklist Tempat Tinggal →</a>
    </div>
  </section>
  <section id="transportasi" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-05" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">05 · Transportasi & mobilitas</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Shuttle adalah bagian utama dari pola commute JAIST.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Campus Pack hanya menyimpan pola akses yang khas kampus. Fare, timetable, bicycle rules, IC card, winter safety, dan transport umum tetap dirujuk ke Survival Guide.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Tsurugi Line</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Menghubungkan JAIST dengan Tsurugi Station. Cara operasi dan timetable dapat berubah, jadi selalu cek halaman Access.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Komatsu Line</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Menghubungkan JAIST dengan area Komatsu Station dan pada informasi yang diverifikasi menggunakan reservasi.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Nomi local mobility</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Community bus Nomi dapat membantu akses ke layanan kota. Gunakan timetable lokal terbaru untuk perjalanan di luar campus.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.jaist.ac.jp/english/top/access/" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Access & shuttle ↗</a>
      <a href={withBase('/life-in-ishikawa/transportasi/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Panduan Transportasi →</a>
    </div>
  </section>
  <section id="kesehatan-counseling" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-06" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">06 · Kesehatan & counseling</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Ada jalur kesehatan fisik dan mental di dalam kampus.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Health Care Center</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Menyediakan general health care, health examinations, first aid, dan health consultation. Jam layanan dapat berubah sehingga sebaiknya cek halaman resmi sebelum datang.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Student Counseling Service</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">JAIST menyediakan counseling oleh professional counselors. Ada juga Anything/Everything Advice sebagai ruang konsultasi informal dengan senior doctoral students untuk kesulitan research/seminar dan isu lain.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.jaist.ac.jp/english/studentlife/institution/healthcare.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Health Care Center ↗</a>
      <a href={withBase('/life-in-ishikawa/kesehatan/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">SG07 · Kesehatan →</a>
    </div>
  </section>

  <section id="bahasa-daily-life" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-07" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">07 · Bahasa Jepang & fasilitas kampus</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Pisahkan dukungan bahasa JAIST dari kebutuhan hidup umum di luar kampus.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">JAIST–Nomi Japanese Course</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">JAIST bekerja sama dengan Nomi International Exchange Association untuk menawarkan collaborative Japanese course bagi mahasiswa yang ingin meningkatkan bahasa Jepang.</p>
        <a href="https://www.jaist.ac.jp/english/careersupport/i-student/index.html" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">International student support ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Daily life on campus</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Campus map mencantumkan cafeteria, convenience store, library, training room, gymnasium, student housing, dan fasilitas lain. Untuk layanan kota, belanja, atau rumah sakit di luar campus, perencanaan transport menjadi bagian penting.</p>
        <a href="https://www.jaist.ac.jp/english/studentlife/life/handbook.html" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Student Handbook ↗</a>
      </article>
    </div>
  </section>

  <section id="akademik-riset-karier" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-08" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">08 · Academic, research & career</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Research life dan career planning berjalan paralel.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-3">
      {[
        ['Academic', 'Course registration, credits, transcripts, enrollment status, dan academic procedures ditangani melalui Educational Service Section dan sistem akademik JAIST.'],
        ['Research', 'Milestone, research area, supervisor/lab practice, off-campus research, TA/RA, dan grant mengikuti aturan program serta handbook. Gunakan supervisor dan office resmi untuk keputusan akademik.'],
        ['Career', 'Career Support menyediakan seminars, internship support, counseling, interview preparation, serta informasi khusus international students yang ingin bekerja di Jepang.']
      ].map(([title,desc]) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p>
        </article>
      ))}
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.jaist.ac.jp/english/careersupport/support/" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Career Support ↗</a>
      <a href="https://www.jaist.ac.jp/english/careersupport/i-student/index.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">For International Students ↗</a>
    </div>
  </section>

    <CampusGuideBridge
    id="keluarga"
    number="09"
    eyebrow="Keluarga"
    title="Yang spesifik di JAIST adalah opsi family housing; layanan keluarga lainnya mengikuti municipality."
    summary="Childcare, sekolah, kesehatan keluarga, dan layanan lokal tidak perlu diulang di Campus Pack. Gunakan panduan keluarga dan Nomi untuk kebutuhan yang bergantung pada alamat tempat tinggal."
    campusNote="JAIST menyediakan kategori housing untuk pasangan/keluarga, tetapi eligibility dan availability harus dikonfirmasi melalui Student Welfare Section."
    links={[
      { label: 'Keluarga & Anak', href: '/life-in-ishikawa/family-anak/', icon: 'family' },
      { label: 'Panduan Nomi', href: '/life-in-ishikawa/municipality-guides/#nomi', icon: 'city' }
    ]}
  />
  <section id="faq" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-10" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">10 · FAQ mahasiswa Indonesia</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Pertanyaan tambahan tentang pola hidup di JAIST.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">FAQ hanya menyimpan pertanyaan yang tidak sudah dijelaskan pada housing, transport, support, academic, atau section kampus lainnya.</p>
    <div class="mt-6 space-y-3">
      {priorityFaq.map((item, index) => (
        <details id={`faq-${item.id}`} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-5">
          <span id={`faq-${String(index + 1).padStart(2, '0')}`} class="sr-only" aria-hidden="true"></span>
          <summary class="cursor-pointer font-bold text-slate-950">{item.q}</summary>
          <p class="mt-3 text-sm leading-6 text-slate-600"><ContextualText text={item.a} maxLinks={2} /></p>
          <CampusFaqGuideLinks campusSlug="jaist" question={item.q} answer={item.a} />
        </details>
      ))}
    </div>
  </section>

  <RelatedLinks
    items={campusRelatedContent['jaist']}
    eyebrow="Lanjut dari Campus Pack"
    title="Panduan yang paling relevan setelah membaca Campus Pack ini"
  />

  <section class="mx-auto max-w-5xl px-5 pb-20 pt-10 lg:px-8">
    <div class="rounded-[2rem] border border-amber-200 bg-amber-50 p-7 sm:p-9">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-dark">Sumber resmi & verifikasi</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Gunakan data live untuk shuttle, intake, fee, dan availability.</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-700">Campus Pack ini terakhir diverifikasi pada {jaistPack.lastVerified}. Timetable, reservation rules, housing availability, fees, application periods, dan office arrangements dapat berubah.</p>
      <div class="mt-6 grid gap-2 sm:grid-cols-2">
        {jaistPack.officialSources.map(([label, url]) => (
          <a href={url} target="_blank" rel="noreferrer" class="rounded-xl border border-amber-200 bg-white px-4 py-3 text-sm font-bold text-slate-800 transition hover:border-amber-300">{label} ↗</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
