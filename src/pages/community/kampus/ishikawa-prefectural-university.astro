---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideToc from '../../../components/GuideToc.astro';
import InstitutionMark from '../../../components/InstitutionMark.astro';
import LicensedPhoto from '../../../components/LicensedPhoto.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';
import { withBase } from '../../../utils/paths';
import { campusMedia } from '../../../data/media';
import { campusMapPoints } from '../../../data/campus-map';
import { ipuPack, ipuSections, ipuQuickLinks, ipuContactMap, ipuFaq } from '../../../data/campus-ipu';

const ppiLinks = [
  ['Administrasi di Jepang', '/life-in-ishikawa/administrasi/'],
  ['Tempat Tinggal', '/life-in-ishikawa/tempat-tinggal/'],
  ['Transportasi', '/life-in-ishikawa/transportasi/'],
  ['Kesehatan', '/life-in-ishikawa/kesehatan/'],
  ['Keluarga & Anak', '/life-in-ishikawa/family-anak/'],
  ['Panduan Nonoichi', '/life-in-ishikawa/municipality-guides/']
];
const campusPhoto = campusMedia['ishikawa-prefectural-university']!;
const campusMap = campusMapPoints['ishikawa-prefectural-university'];
---

<BaseLayout
  title="Ishikawa Prefectural University Campus Pack"
  description="Panduan praktis mahasiswa Indonesia di Ishikawa Prefectural University: Nonoichi, housing, transportasi, student support, graduate research, career, daily life, dan FAQ."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <a href={withBase('/community/kampus/')} class="text-sm font-semibold text-brand hover:underline">← Kampus di Ishikawa</a>
    <p class="mt-8 text-sm font-bold uppercase tracking-[0.18em] text-accent-dark">PPI Ishikawa · Campus Pack</p>
    <div class="mt-4 flex items-center gap-4">
      <InstitutionMark id="ishikawa-prefectural-university" size="lg" class="shrink-0" />
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Ishikawa Prefectural University</h1>
    </div>
    <p class="mt-2 text-lg text-slate-500">石川県立大学 · IPU · Nonoichi</p>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
      Panduan praktis untuk mahasiswa Indonesia di IPU. Karena kampus berada di Nonoichi dan tidak memiliki student dormitory, Campus Pack ini memberi perhatian khusus pada private housing, commute, student-support route, serta graduate/research life di bidang bioresources, environment, food, dan life science.
    </p>

    <div class="mt-7 flex flex-wrap gap-3 text-sm">
      <span class="rounded-full bg-slate-900 px-4 py-2 font-semibold text-white">Public university</span>
      <span class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-700">Suematsu · Nonoichi</span>
      <span class="rounded-full border border-amber-200 bg-amber-50 px-4 py-2 font-semibold text-accent-dark">Terakhir diverifikasi: {ipuPack.lastVerified}</span>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {ipuQuickLinks.map(([label, url]) => (
        <a href={url} target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 text-sm font-bold text-slate-800 transition hover:border-amber-200 hover:shadow-sm">
          {label} ↗
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-4 lg:px-8">
    <LicensedPhoto media={campusPhoto} imageClass="aspect-[16/9] w-full object-cover" />
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-8 lg:px-8">
    <div class="mb-4">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Lokasi kampus</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Lihat posisi kampus sebelum memilih housing dan commute.</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Peta dapat di-zoom dan digeser. Gunakan tombol akses resmi pada marker untuk petunjuk kampus terbaru.</p>
    </div>
    <InteractiveMap points={campusMap} heightClass="h-[340px] sm:h-[420px]" />
  </section>

  <GuideToc sections={ipuSections} />

  <section id="bagian-01" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">01 · Kenali IPU</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Kampus kecil dengan fokus bioresources, environment, food, dan applied life science.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="text-xl font-bold text-slate-950">Undergraduate</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Faculty of Bioresources and Environmental Sciences mencakup Bioproduction Science, Environmental Science, dan Food Science. Lingkungan akademiknya dekat dengan agriculture, environmental systems, food, dan bioscience.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="text-xl font-bold text-slate-950">Graduate School</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Master-level fields mencakup Production Science, Environmental Science, Food Science, dan Applied Life Science. Doctoral fields mencakup Nature–Human Coexistence Science dan Biofunction Development Science.</p>
        <a href="https://www.ishikawa-pu.ac.jp/graduate/course/" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Graduate programs ↗</a>
      </article>
    </div>
  </section>

  <section id="bagian-02" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">02 · Minggu pertama</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Pastikan tiga hal: program/lab, tempat tinggal, dan jalur commute.</h2>
    <div class="mt-7 grid gap-3">
      {[
        ['1', 'Ikuti admission/orientation', 'Gunakan dokumen intake dan arahan Academic & Student Affairs Section. Foreign-student selection dan graduate admission memiliki ketentuan yang berubah menurut admission year.'],
        ['2', 'Pastikan private housing', 'IPU tidak memiliki dormitory universitas. Jika belum memiliki apartment, tanyakan informasi real-estate sekitar kampus ke Academic & Student Affairs Section dan gunakan checklist housing PPI sebelum kontrak.'],
        ['3', 'Uji commute sebelum jadwal padat', 'Coba rute dari tempat tinggal ke kampus menggunakan Nonkey shuttle, Hokutetsu Bus, bicycle, atau moda lain yang benar-benar akan Anda gunakan.'],
        ['4', 'Selesaikan administrasi kota', 'Residence registration, insurance, pension, My Number, dan layanan keluarga mengikuti municipality tempat tinggal—sering kali Nonoichi, Hakusan, atau Kanazawa.'],
        ['5', 'Kenali advisor dan support desks', 'Simpan Academic & Student Affairs, Health Room, Counseling Room, Career Center, serta kontak supervisor/laboratory.'],
        ['6', 'Aktifkan research workflow', 'Untuk graduate/research students, pahami laboratory practice, supervisor expectations, TA/RA opportunities, dan conference/research support sejak awal.']
      ].map(([n,title,desc]) => (
        <div class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-[44px_1fr]">
          <span class="grid size-10 place-items-center rounded-full bg-amber-50 text-sm font-bold text-accent-dark">{n}</span>
          <div>
            <h3 class="font-bold text-slate-950">{title}</h3>
            <p class="mt-1 text-sm leading-6 text-slate-600">{desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="bagian-03" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">03 · Ke mana harus bertanya</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">IPU lebih ringkas—kenali office dan advisor yang tepat.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-2">
      {ipuContactMap.map((item) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{item.topics}</p>
        </article>
      ))}
    </div>
    <a href="https://www.ishikawa-pu.ac.jp/campus/soudan/" target="_blank" rel="noreferrer" class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">Student support & counseling ↗</a>
  </section>

  <section id="bagian-04" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">04 · Housing</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Tidak ada university dormitory: rencanakan private housing sejak awal.</h2>
    <div class="mt-7 rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
      <h3 class="text-xl font-bold text-slate-950">Official position</h3>
      <p class="mt-3 leading-7 text-slate-700">FAQ resmi IPU untuk international applicants menyatakan universitas tidak mempunyai dormitory. Untuk informasi real estate di sekitar kampus, mahasiswa dapat menghubungi Academic & Student Affairs Section.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="https://www.ishikawa-pu.ac.jp/admission/abroad/" target="_blank" rel="noreferrer" class="rounded-xl border border-amber-200 bg-white px-4 py-3 text-sm font-bold text-slate-800">International applicant FAQ ↗</a>
        <a href={withBase('/life-in-ishikawa/tempat-tinggal/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">SG04 · Tempat Tinggal →</a>
      </div>
    </div>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {[
        ['Dekat kampus', 'Prioritaskan commute sederhana bila Anda banyak bekerja di lab atau sering kembali malam.'],
        ['Dekat transport hub', 'Nonoichi/Hakusan/Kanazawa dapat memberi pilihan lebih luas, tetapi hitung waktu dan biaya commute.'],
        ['Sebelum kontrak', 'Periksa initial cost, guarantor/guarantee company, utilities, bicycle/car parking, winter access, dan move-out terms.']
      ].map(([title,desc]) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="bagian-05" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">05 · Transportasi & Nonoichi</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Kampus terhubung dengan Nonoichi Station dan Kanazawa melalui beberapa moda.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">IR Nonoichi Station</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">IPU mencantumkan shuttle bus Nonkey dari IR Nonoichi Station menuju halte di dalam kampus. Gunakan timetable/fare terbaru dari Nonoichi City.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Kanazawa Station</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Akses resmi juga mencantumkan Hokutetsu Bus dari Kanazawa Station menuju IPU atau halte dekat kampus.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Bicycle / car</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Nonoichi relatif compact, tetapi winter, rain, dan jarak dari housing tetap perlu dipertimbangkan. Bicycle liability insurance diwajibkan di Ishikawa.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.ishikawa-pu.ac.jp/access/" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Access resmi ↗</a>
      <a href={withBase('/life-in-ishikawa/transportasi/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">SG06 · Transportasi →</a>
    </div>
  </section>

  <section id="bagian-06" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">06 · Kesehatan & counseling</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Gunakan Health Room, Counseling Room, dan advisor sebelum masalah membesar.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-3">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Health Room</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Menjadi jalur untuk health consultation dan juga titik awal bagi beberapa kebutuhan study support terkait disability/health.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Counseling Room</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">IPU menyediakan counseling oleh clinical psychologist pada hari tertentu; appointment dikoordinasikan melalui Health Room.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Academic Advisor</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Academic Advisor dan faculty/class advisors dapat membantu study planning, adaptation, academic difficulties, dan future direction.</p>
      </article>
    </div>
    <a href={withBase('/life-in-ishikawa/kesehatan/')} class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">SG07 · Kesehatan →</a>
  </section>

  <section id="bagian-07" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">07 · Graduate & research support</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">IPU punya beberapa support yang relevan langsung untuk graduate students.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-2">
      {[
        ['International / conference support', 'Student-support program IPU mencantumkan travel support untuk partisipasi seminar/student exchange di luar negeri dan presentasi pada konferensi internasional, sesuai ketentuan program.'],
        ['Student tutor', 'IPU mencantumkan skema student tutor yang membantu international students dalam study dan daily life.'],
        ['Research Assistant', 'RA memberi kesempatan graduate students membantu riset faculty sambil membangun research skills; recruitment dan compensation mengikuti pengumuman resmi.'],
        ['Teaching Assistant', 'TA memberi kesempatan graduate students membantu exercise/experiment/teaching activities di bawah supervisi, sesuai aturan program.']
      ].map(([title,desc]) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p>
        </article>
      ))}
    </div>
    <a href="https://www.ishikawa-pu.ac.jp/graduate/guidance-2/" target="_blank" rel="noreferrer" class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">Graduate student support ↗</a>
  </section>

  <section id="bagian-08" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">08 · Career & campus facilities</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Career support dan library adalah dua resource yang jangan dilewatkan.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Career Center</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Career Center / Employment Support Office menyediakan consultation, résumé dan entry-sheet review, interview guidance, seminars, serta job information.</p>
        <a href="https://www.ishikawa-pu.ac.jp/career/careercenter/" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Career Center ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Library & Information Center</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Library berfokus kuat pada agriculture, food, biotechnology, dan bidang terkait serta menyediakan search, interlibrary resources, computers, dan study spaces.</p>
        <a href="https://www.ishikawa-pu.ac.jp/campus/library/" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Library ↗</a>
      </article>
    </div>
  </section>

  <section id="bagian-09" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">09 · Keluarga & daily life</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Untuk daily life, Nonoichi menjadi bagian dari pengalaman kampus.</h2>
    <p class="mt-4 max-w-3xl leading-7 text-slate-600">IPU menyediakan guide sekitar kampus yang menunjuk city hall, library/civic center, shopping, community bus, dan fasilitas lain di Nonoichi. Untuk family administration, childcare, school, garbage, dan health subsidy, gunakan municipality sesuai alamat tempat tinggal.</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.ishikawa-pu.ac.jp/campus/guide/" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Around campus ↗</a>
      <a href={withBase('/life-in-ishikawa/family-anak/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">SG08 · Keluarga & Anak →</a>
      <a href={withBase('/life-in-ishikawa/municipality-guides/')} class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Municipality guides →</a>
    </div>
  </section>

  <section id="bagian-10" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">10 · FAQ mahasiswa Indonesia</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Jawaban cepat untuk housing, admission, research, dan daily life.</h2>
    <div class="mt-7 space-y-3">
      {ipuFaq.map((item) => (
        <details class="rounded-2xl border border-slate-200 bg-white p-5">
          <summary class="cursor-pointer font-bold text-slate-950">{item.q}</summary>
          <p class="mt-3 text-sm leading-6 text-slate-600">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">PPI Ishikawa Survival Guide</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Campus Pack fokus pada IPU; Survival Guide menangani sistem hidup di Jepang.</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {ppiLinks.map(([label, href]) => (
          <a href={withBase(href)} class="rounded-2xl bg-slate-50 p-4 text-sm font-bold text-slate-800 transition hover:bg-slate-100">{label} →</a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-20 pt-10 lg:px-8">
    <div class="rounded-[2rem] border border-amber-200 bg-amber-50 p-7 sm:p-9">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-dark">Sumber resmi & verifikasi</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Admission, tuition, scholarship, transport, dan support dapat berubah.</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-700">Campus Pack ini terakhir diverifikasi pada {ipuPack.lastVerified}. Untuk keputusan aktual, gunakan sumber resmi IPU berikut.</p>
      <div class="mt-6 grid gap-2 sm:grid-cols-2">
        {ipuPack.officialSources.map(([label, url]) => (
          <a href={url} target="_blank" rel="noreferrer" class="rounded-xl border border-amber-200 bg-white px-4 py-3 text-sm font-bold text-slate-800 transition hover:border-amber-300">{label} ↗</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
