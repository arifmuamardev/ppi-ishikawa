---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideToc from '../../../components/GuideToc.astro';
import InstitutionMark from '../../../components/InstitutionMark.astro';
import ContextualText from '../../../components/ContextualText.astro';
import CampusFaqGuideLinks from '../../../components/CampusFaqGuideLinks.astro';
import CampusScholarshipGuide from '../../../components/CampusScholarshipGuide.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CampusProfile from '../../../components/CampusProfile.astro';
import LicensedPhoto from '../../../components/LicensedPhoto.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';
import { campusRelatedContent } from '../../../data/related-content';
import { campusProfileBySlug } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';
import { campusMedia } from '../../../data/media';
import { campusMapPoints } from '../../../data/campus-map';
import { kanazawaUniversityPack, kuSections, kuQuickLinks, kuFaq } from '../../../data/campus-kanazawa-university';

const campusPhoto = campusMedia['kanazawa-university']!;
const campusMap = campusMapPoints['kanazawa-university'];
---

<BaseLayout
  title="Kanazawa University Campus Pack"
  description="Panduan praktis mahasiswa Indonesia di Kanazawa University: kampus, minggu pertama, housing, transportasi, dukungan internasional, bahasa Jepang, prayer room, career, keluarga, dan FAQ."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Komunitas', href: '/community/' }, { label: 'Campus Hub', href: '/community/kampus/' }, { label: 'Kanazawa University' }]} />
    <p class="mt-8 text-sm font-bold uppercase tracking-[0.18em] text-accent-dark">PPI Ishikawa · Campus Pack</p>
    <div class="mt-4 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <InstitutionMark id="kanazawa-university" size="lg" class="shrink-0" />
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Kanazawa University</h1>
    </div>
    <p class="mt-2 text-lg text-slate-500">金沢大学 · Kanazawa</p>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
      Panduan praktis untuk mahasiswa Indonesia di Kanazawa University. Informasi resmi kampus tetap menjadi sumber utama; PPI membantu menyusun urutan, konteks, dan hal yang paling sering dibutuhkan mahasiswa baru maupun mahasiswa yang sudah tinggal di Ishikawa.
    </p>

    <div class="mt-7 flex flex-wrap gap-3 text-sm">
      <span class="rounded-full bg-slate-900 px-4 py-2 font-semibold text-white">National university</span>
      <span class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-700">Kakuma + Takaramachi–Tsuruma</span>
      <span class="rounded-full border border-amber-200 bg-amber-50 px-4 py-2 font-semibold text-accent-dark">Terakhir diverifikasi: {kanazawaUniversityPack.lastVerified}</span>
      <a href={withBase('/life-in-ishikawa/municipality-guides/#kanazawa')} class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-brand transition hover:border-amber-200 hover:bg-amber-50">Panduan Kanazawa →</a>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {kuQuickLinks.map(([label, url]) => (
        <a href={url} target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 text-sm font-bold text-slate-800 transition hover:border-amber-200 hover:shadow-sm">
          {label} ↗
        </a>
      ))}
    </div>
  </section>

  <CampusProfile profile={campusProfileBySlug['kanazawa-university']} />

  <section class="mx-auto max-w-5xl px-5 pb-4 lg:px-8">
    <LicensedPhoto media={campusPhoto} imageClass="aspect-[16/9] w-full object-cover" />
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-8 lg:px-8">
    <div class="mb-4">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Lokasi utama kampus</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Lihat posisi kampus sebelum memilih housing dan commute.</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Peta dapat di-zoom dan digeser. Gunakan tombol akses resmi pada marker untuk petunjuk kampus terbaru.</p>
    </div>
    <InteractiveMap points={campusMap} heightClass="h-[340px] sm:h-[420px]" />
  </section>

  <GuideToc sections={kuSections} />

  <section id="kenali-kampus" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-01" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">01 · Kenali kampusmu</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Dua campus area utama, pengalaman harian yang berbeda.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Kakuma Campus</p>
        <h3 class="mt-2 text-xl font-bold text-slate-950">角間キャンパス</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Pusat bagi Transdisciplinary Sciences, Humanities and Social Sciences, serta Science, Engineering and Pharmacy. Dormitory mahasiswa internasional juga berada di area Kakuma.</p>
        <a href="https://www.kanazawa-u.ac.jp/en/university/campus-guidance/map" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Buka campus map ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Takaramachi–Tsuruma</p>
        <h3 class="mt-2 text-xl font-bold text-slate-950">宝町・鶴間キャンパス</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Berfokus pada medicine dan health sciences serta berdekatan dengan Kanazawa University Hospital. Lokasinya lebih dekat ke pusat kota dibanding Kakuma.</p>
        <a href="https://www.kanazawa-u.ac.jp/en/university/campus-guidance/tokucyou" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Lihat campus features ↗</a>
      </article>
    </div>
  </section>

  <section id="minggu-pertama" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-02" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">02 · Minggu pertama</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Urutan yang aman untuk mahasiswa baru.</h2>
    <div class="mt-7 grid gap-3">
      {[
        ['1', 'Ikuti admission & orientation', 'Periksa instruksi school/graduate school Anda. KU mempublikasikan orientation/admission procedures per intake dan program.'],
        ['2', 'Pastikan housing & akses kampus', 'Kenali apakah aktivitas utama Anda di Kakuma atau Takaramachi–Tsuruma dan uji rute commute sebelum jadwal akademik padat.'],
        ['3', 'Selesaikan administrasi kota', 'Registrasi alamat, insurance, pension, My Number, dan urusan municipality mengikuti alamat tempat tinggal Anda—bukan campus office.'],
        ['4', 'Kenali One-Stop support', 'Simpan halaman International Student Support dan One-Stop Consultation Counter sebelum Anda membutuhkannya.'],
        ['5', 'Aktifkan rutinitas akademik', 'Pastikan Anda memahami portal, course registration, lab/supervisor communication, dan jadwal yang berlaku untuk program Anda.'],
        ['6', 'Cek dukungan tambahan', 'Japanese classes, health/counseling, prayer rooms, scholarship, dan career support tersedia melalui jalur kampus masing-masing.']
      ].map(([n,title,desc]) => (
        <div class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-[44px_1fr]">
          <span class="grid size-10 place-items-center rounded-full bg-amber-50 text-sm font-bold text-accent-dark">{n}</span>
          <div>
            <h3 class="font-bold text-slate-950">{title}</h3>
            <p class="mt-1 text-sm leading-6 text-slate-600">{desc}</p>
          </div>
        </div>
      ))}
    </div>
    <a href={withBase('/life-in-ishikawa/hari-pertama/')} class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">Lihat SG02 · Hari Pertama di Ishikawa →</a>
  </section>

  <section id="kontak-dukungan" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-03" class="sr-only" aria-hidden="true"></span>
    <div class="rounded-[2rem] bg-slate-950 p-7 text-white sm:p-9">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">03 · Ke mana harus bertanya</p>
      <h2 class="mt-3 text-3xl font-bold">Mulai dari One-Stop Consultation jika Anda tidak tahu jalurnya.</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-300">
        Kanazawa University menyediakan One-Stop Consultation Counter untuk mahasiswa internasional. Topik yang dicantumkan meliputi admission, scholarship, tuition exemption, status of residence/visa, apartment/dormitory, insurance, national pension, family support, advising/counseling, dan kehidupan sehari-hari.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://intl-support.w3.kanazawa-u.ac.jp/inquiry/" target="_blank" rel="noreferrer" class="rounded-xl bg-white px-4 py-3 text-sm font-bold text-slate-950">One-Stop Consultation ↗</a>
        <a href="https://intl-support.w3.kanazawa-u.ac.jp/" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-600 px-4 py-3 text-sm font-bold text-white">International Student Support ↗</a>
      </div>
    </div>
  </section>

  <section id="tempat-tinggal" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-04" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">04 · Tempat tinggal</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Dormitory kampus atau private apartment.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-3">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Sakigake</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Share-house style student housing di Kakuma. Unitnya menggabungkan mahasiswa internasional dengan Resident Advisors mahasiswa Jepang.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Hokumei</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Share-house style student housing di Kakuma yang menggabungkan mahasiswa internasional dan mahasiswa Jepang.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Private apartment</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">KU Co-op dan private real-estate route dapat digunakan. Cek guarantor/guarantee company, initial costs, utilities, dan contract terms sebelum menandatangani.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kanazawa-u.ac.jp/en/students/livelihood/residence" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Housing resmi KU ↗</a>
      <a href="https://intl-support.w3.kanazawa-u.ac.jp/campuslife/apartment/index.php" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Private apartment guidance ↗</a>
      <a href={withBase('/life-in-ishikawa/tempat-tinggal/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">SG04 · Tempat Tinggal →</a>
    </div>
    <p class="mt-4 text-xs leading-5 text-slate-500">Biaya, eligibility, dan availability dormitory berubah per intake; selalu gunakan halaman housing resmi untuk nilai terbaru.</p>

    <div id="apartemen-kanazawa" class="mt-8 scroll-mt-24 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Panduan cepat · Private apartment</p>
        <h3 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Mencari apartemen satu orang untuk mahasiswa Kanazawa University.</h3>
        <p class="mt-4 leading-7 text-slate-600">
          Jika Anda belum berada di Kanazawa, mulai dari <strong>lokasi kampus utama Anda</strong>, bukan hanya dari harga sewa.
          Mahasiswa yang banyak beraktivitas di Kakuma memiliki kebutuhan commute yang berbeda dari mahasiswa di
          Takaramachi–Tsuruma. Setelah itu bandingkan biaya awal, biaya bulanan, guarantor/guarantee company,
          furniture, internet, serta akses saat hujan dan musim dingin.
        </p>
      </div>

      <div class="mt-7 grid gap-4 md:grid-cols-3">
        <article class="rounded-2xl bg-slate-50 p-5">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Kisaran sewa</p>
          <p class="mt-2 text-2xl font-bold text-slate-950">± ¥30k–¥60k</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Halaman resmi KU memberi contoh sekitar ¥30,000–¥50,000 per bulan untuk rent, sementara informasi KUEP
            mencantumkan sekitar ¥40,000–¥60,000 untuk one-room. Gunakan ini sebagai kisaran orientasi, bukan harga tetap.
          </p>
        </article>
        <article class="rounded-2xl bg-slate-50 p-5">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Biaya di luar rent</p>
          <p class="mt-2 text-2xl font-bold text-slate-950">Cek total awal</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Selain rent dapat ada common fee, insurance, guarantee-company fee, agency fee, cleaning fee,
            deposit/key money, utilities, dan biaya lain sesuai properti. Minta breakdown tertulis sebelum setuju.
          </p>
        </article>
        <article class="rounded-2xl bg-slate-50 p-5">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Utilities</p>
          <p class="mt-2 text-2xl font-bold text-slate-950">± ¥13k</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            KU menggunakan sekitar ¥13,000 per bulan sebagai contoh electricity, water, dan gas, dengan catatan
            jumlah aktual berubah menurut musim dan penggunaan.
          </p>
        </article>
      </div>

      <div class="mt-7 grid gap-5 lg:grid-cols-[1.05fr_.95fr]">
        <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-accent-dark">Area awal untuk pencarian</p>
          <h4 class="mt-2 text-xl font-bold text-slate-950">Untuk Kakuma, mulai dari koridor yang memang banyak digunakan mahasiswa.</h4>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            {[
              ['Morinosato', 'Banyak kebutuhan harian dan akses bus menuju arah Kakuma.'],
              ['Wakamatsu', 'Dekat koridor bus kampus dan area mahasiswa di sisi timur Kanazawa.'],
              ['Tagami', 'Pilihan housing cukup luas; bandingkan akses bus, bicycle, dan elevasi rute.']
            ].map(([area, desc]) => (
              <div class="rounded-2xl bg-white p-4">
                <p class="font-bold text-slate-950">{area}</p>
                <p class="mt-1 text-xs leading-5 text-slate-600">{desc}</p>
              </div>
            ))}
          </div>
          <p class="mt-4 text-xs leading-5 text-slate-600">
            Jika aktivitas utama Anda di Takaramachi–Tsuruma, jangan otomatis memilih area Kakuma. Prioritaskan rute harian ke campus/hospital area dan cek commute sebelum menandatangani kontrak.
          </p>
        </div>

        <div class="rounded-3xl bg-slate-950 p-6 text-white">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-accent-soft">Cara mulai mencari</p>
          <ol class="mt-4 space-y-3 text-sm leading-6 text-slate-300">
            <li class="flex gap-3"><span class="font-bold text-white">1.</span><span>Pastikan kampus/lab utama dan tanggal mulai tinggal.</span></li>
            <li class="flex gap-3"><span class="font-bold text-white">2.</span><span>Tentukan budget <strong class="text-white">total bulanan</strong>, bukan rent saja.</span></li>
            <li class="flex gap-3"><span class="font-bold text-white">3.</span><span>Tanyakan apakah unit menerima international student dan guarantee company apa yang digunakan.</span></li>
            <li class="flex gap-3"><span class="font-bold text-white">4.</span><span>Minta initial-cost estimate tertulis sebelum transfer atau tanda tangan.</span></li>
            <li class="flex gap-3"><span class="font-bold text-white">5.</span><span>Jika memungkinkan, lakukan viewing langsung/video dan cek rute kampus + supermarket + bus stop.</span></li>
          </ol>
        </div>
      </div>

      <div class="mt-7">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand">Agen & jalur pencarian yang dicantumkan KU</p>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
          Ini bukan ranking atau endorsement PPI. Nama di bawah dicantumkan pada halaman resmi Kanazawa University
          untuk mahasiswa internasional; availability, bahasa layanan, biaya, dan properti dapat berubah.
        </p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <a href="https://www.kanazawa-u.ac.jp/en/students/livelihood/residence" target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-amber-200">
            <p class="font-bold text-slate-950">Kanazawa University Co-op</p>
            <p class="mt-1 text-xs leading-5 text-slate-500">KU menyebut Co-op sebagai jalur referral private apartment.</p>
          </a>
          <a href="https://chintai.noka.co.jp/foreigner/" target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-amber-200">
            <p class="font-bold text-slate-950">Noka Real Estate · Morinosato</p>
            <p class="mt-1 text-xs leading-5 text-slate-500">Dicantumkan KU; tersedia halaman untuk foreign residents.</p>
          </a>
          <a href="https://www.apamanshop.com/shop/17028101/" target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-amber-200">
            <p class="font-bold text-slate-950">Apaman Shop · Kanazawa Morinosato</p>
            <p class="mt-1 text-xs leading-5 text-slate-500">Salah satu agen yang dicantumkan halaman support KU.</p>
          </a>
          <a href="https://mooovin.jp/ja/" target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-amber-200">
            <p class="font-bold text-slate-950">Mooovin</p>
            <p class="mt-1 text-xs leading-5 text-slate-500">Dicantumkan pada daftar private-apartment support KU.</p>
          </a>
          <a href="https://urbanhome.co.jp/shop/5/" target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-amber-200">
            <p class="font-bold text-slate-950">Urban Home · Morinosato</p>
            <p class="mt-1 text-xs leading-5 text-slate-500">Dicantumkan pada halaman housing mahasiswa internasional KU.</p>
          </a>
          <a href="https://intl-support.w3.kanazawa-u.ac.jp/campuslife/apartment/index.php" target="_blank" rel="noreferrer" class="rounded-2xl border border-amber-200 bg-amber-50 p-4 transition hover:border-amber-300">
            <p class="font-bold text-slate-950">Daftar resmi terbaru KU</p>
            <p class="mt-1 text-xs leading-5 text-slate-600">Gunakan halaman ini untuk mengecek daftar dan kontak yang paling baru.</p>
          </a>
        </div>
      </div>

      <div class="mt-7 rounded-2xl border border-red-200 bg-red-50 p-5">
        <p class="font-bold text-slate-950">Catatan penting tentang guarantor</p>
        <p class="mt-2 text-sm leading-6 text-slate-700">
          Kanazawa University pada prinsipnya telah menghentikan institutional-guarantor scheme untuk kontrak baru sejak November 2023.
          Untuk kontrak baru, mahasiswa umumnya perlu menggunakan private guarantee system yang ditentukan agen/properti.
          Jangan meminta supervisor menjadi guarantor; bila bingung, hubungi One-Stop Consultation.
        </p>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://intl-support.w3.kanazawa-u.ac.jp/campuslife/apartment/index.php" target="_blank" rel="noreferrer" class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Housing internasional KU ↗</a>
        <a href={withBase('/life-in-ishikawa/tempat-tinggal/')} class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Checklist kontrak & move-in →</a>
        <a href={withBase('/life-in-ishikawa/transportasi/')} class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Cek transportasi →</a>
      </div>
    </div>
  </section>

  <section id="transportasi" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-05" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">05 · Transportasi</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Kenali rute sebelum bergantung pada satu moda.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Dari Kanazawa Station</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">KU menyediakan halaman akses resmi yang menunjuk bus menuju Kakuma maupun Takaramachi–Tsuruma. Nomor rute dan timetable dapat berubah, jadi cek langsung sebelum perjalanan.</p>
        <a href="https://www.kanazawa-u.ac.jp/university/campus-guidance/access/" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Akses resmi ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">KU shuttle antar-kampus</h3>
