---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideToc from '../../../components/GuideToc.astro';
import InstitutionMark from '../../../components/InstitutionMark.astro';
import ContextualText from '../../../components/ContextualText.astro';
import CampusFaqGuideLinks from '../../../components/CampusFaqGuideLinks.astro';
import CampusScholarshipGuide from '../../../components/CampusScholarshipGuide.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CampusProfile from '../../../components/CampusProfile.astro';
import CampusGuideBridge from '../../../components/CampusGuideBridge.astro';
import LicensedPhoto from '../../../components/LicensedPhoto.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';
import { campusRelatedContent } from '../../../data/related-content';
import { campusProfileBySlug } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';
import { campusMedia } from '../../../data/media';
import { campusMapPoints } from '../../../data/campus-map';
import { kanazawaUniversityPack, kuSections, kuQuickLinks, kuFaq } from '../../../data/campus-kanazawa-university';

const campusPhoto = campusMedia['kanazawa-university']!;
const campusMap = campusMapPoints['kanazawa-university'];
---

<BaseLayout
  title="Kanazawa University Campus Pack"
  description="Panduan praktis mahasiswa Indonesia di Kanazawa University: kampus, minggu pertama, housing, transportasi, dukungan internasional, bahasa Jepang, prayer room, career, keluarga, dan FAQ."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Kampus', href: '/community/kampus/' }, { label: 'Kanazawa University' }]} />
    <p class="mt-8 text-sm font-bold uppercase tracking-[0.18em] text-accent-dark">PPI Ishikawa · Campus Pack</p>
    <div class="mt-4 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <InstitutionMark id="kanazawa-university" size="lg" class="shrink-0" />
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Kanazawa University</h1>
    </div>
    <p class="mt-2 text-lg text-slate-500">金沢大学 · Kanazawa</p>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
      Panduan praktis untuk mahasiswa Indonesia di Kanazawa University. Informasi resmi kampus tetap menjadi sumber utama; PPI membantu menyusun urutan, konteks, dan hal yang paling sering dibutuhkan mahasiswa baru maupun mahasiswa yang sudah tinggal di Ishikawa.
    </p>

    <div class="mt-7 flex flex-wrap gap-3 text-sm">
      <span class="rounded-full bg-slate-900 px-4 py-2 font-semibold text-white">National university</span>
      <span class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-700">Kakuma + Takaramachi–Tsuruma</span>
      <span class="rounded-full border border-amber-200 bg-amber-50 px-4 py-2 font-semibold text-accent-dark">Terakhir diverifikasi: {kanazawaUniversityPack.lastVerified}</span>
      <a href={withBase('/life-in-ishikawa/municipality-guides/#kanazawa')} class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-brand transition hover:border-amber-200 hover:bg-amber-50">Panduan Kanazawa →</a>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {kuQuickLinks.map(([label, url]) => (
        <a href={url} target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 text-sm font-bold text-slate-800 transition hover:border-amber-200 hover:shadow-sm">
          {label} ↗
        </a>
      ))}
    </div>
  </section>

  <CampusProfile profile={campusProfileBySlug['kanazawa-university']} />

  <section class="mx-auto max-w-5xl px-5 pb-4 lg:px-8">
    <LicensedPhoto media={campusPhoto} imageClass="aspect-[16/9] w-full object-cover" />
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-8 lg:px-8">
    <div class="mb-4">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Lokasi utama kampus</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Lihat posisi kampus sebelum memilih housing dan commute.</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Peta dapat di-zoom dan digeser. Gunakan tombol akses resmi pada marker untuk petunjuk kampus terbaru.</p>
    </div>
    <InteractiveMap points={campusMap} heightClass="h-[340px] sm:h-[420px]" />
  </section>

  <GuideToc sections={kuSections} />

  <section id="kenali-kampus" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-01" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">01 · Kenali kampusmu</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Dua campus area utama, pengalaman harian yang berbeda.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Kakuma Campus</p>
        <h3 class="mt-2 text-xl font-bold text-slate-950">角間キャンパス</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Pusat bagi Transdisciplinary Sciences, Humanities and Social Sciences, serta Science, Engineering and Pharmacy. Dormitory mahasiswa internasional juga berada di area Kakuma.</p>
        <a href="https://www.kanazawa-u.ac.jp/en/university/campus-guidance/map" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Buka campus map ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Takaramachi–Tsuruma</p>
        <h3 class="mt-2 text-xl font-bold text-slate-950">宝町・鶴間キャンパス</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Berfokus pada medicine dan health sciences serta berdekatan dengan Kanazawa University Hospital. Lokasinya lebih dekat ke pusat kota dibanding Kakuma.</p>
        <a href="https://www.kanazawa-u.ac.jp/en/university/campus-guidance/tokucyou" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Lihat campus features ↗</a>
      </article>
    </div>
  </section>

  <CampusGuideBridge
    id="minggu-pertama"
    number="02"
    eyebrow="Minggu pertama"
    title="Minggu pertama di KU: pastikan kampus utama, jalur support, dan rute harian."
    summary="Checklist kedatangan yang berlaku umum—resident registration, health insurance, pension, komunikasi, pembayaran, dan kebutuhan hari pertama—tidak diulang di Campus Pack. Gunakan Survival Guide sebagai checklist utama."
    campusNote="Pastikan apakah aktivitas utama Anda di Kakuma atau Takaramachi–Tsuruma, ikuti orientation school/graduate school, dan simpan One-Stop Consultation sebagai titik awal bila jalur support belum jelas."
    links={[
      { label: 'Hari Pertama di Ishikawa', href: '/life-in-ishikawa/hari-pertama/', icon: 'arrival' },
      { label: 'Administrasi', href: '/life-in-ishikawa/administrasi/', icon: 'documents' }
    ]}
  />
  <section id="kontak-dukungan" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-03" class="sr-only" aria-hidden="true"></span>
    <div class="rounded-[2rem] bg-slate-950 p-7 text-white sm:p-9">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">03 · Ke mana harus bertanya</p>
      <h2 class="mt-3 text-3xl font-bold">Mulai dari One-Stop Consultation jika Anda tidak tahu jalurnya.</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-300">
        Kanazawa University menyediakan One-Stop Consultation Counter untuk mahasiswa internasional. Topik yang dicantumkan meliputi admission, scholarship, tuition exemption, status of residence/visa, apartment/dormitory, insurance, national pension, family support, advising/counseling, dan kehidupan sehari-hari.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="https://intl-support.w3.kanazawa-u.ac.jp/inquiry/" target="_blank" rel="noreferrer" class="rounded-xl bg-white px-4 py-3 text-sm font-bold text-slate-950">One-Stop Consultation ↗</a>
        <a href="https://intl-support.w3.kanazawa-u.ac.jp/" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-600 px-4 py-3 text-sm font-bold text-white">International Student Support ↗</a>
      </div>
    </div>
  </section>

  <section id="tempat-tinggal" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-04" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">04 · Tempat tinggal</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Pilih antara housing kampus dan private apartment berdasarkan kampus utama.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Campus Pack hanya menyimpan konteks housing yang spesifik kampus. Initial cost, guarantor, utilities, kontrak, move-out, dan checklist umum dirujuk ke Survival Guide.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Sakigake & Hokumei</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">KU menyediakan share-house style student housing di Kakuma yang mempertemukan mahasiswa internasional dan mahasiswa Jepang. Eligibility, biaya, dan availability berubah per intake.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Private apartment</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Untuk Kakuma, area seperti Morinosato, Wakamatsu, dan Tagami dapat menjadi titik awal pencarian. Jika aktivitas utama di Takaramachi–Tsuruma, prioritaskan commute ke area tersebut, bukan Kakuma.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Jalur resmi</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Gunakan housing page KU dan private-apartment guidance resmi untuk availability, prosedur, dan agen yang dirujuk kampus.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kanazawa-u.ac.jp/en/students/livelihood/residence" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Housing resmi KU ↗</a>
      <a href="https://intl-support.w3.kanazawa-u.ac.jp/campuslife/apartment/index.php" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Private apartment guidance ↗</a>
      <a href={withBase('/life-in-ishikawa/tempat-tinggal/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Checklist Tempat Tinggal →</a>
    </div>
  </section>
  <section id="transportasi" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-05" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">05 · Transportasi</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Yang penting di KU adalah membedakan Kakuma dan Takaramachi–Tsuruma.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Campus Pack hanya menyimpan pola akses yang khas kampus. Fare, timetable, bicycle rules, IC card, winter safety, dan transport umum tetap dirujuk ke Survival Guide.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Kakuma</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Gunakan access page resmi KU untuk rute menuju Kakuma. Jika housing Anda di area timur Kanazawa, uji commute aktual sebelum mengandalkan satu moda.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Takaramachi–Tsuruma</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Medicine dan health-science activities dapat berpusat di area ini, sehingga housing dan commute tidak boleh diasumsikan sama dengan Kakuma.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Shuttle antar-kampus</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">KU menyediakan shuttle gratis antara Kakuma dan Takaramachi–Tsuruma pada hari operasional tertentu. Gunakan timetable resmi terbaru.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kanazawa-u.ac.jp/university/campus-guidance/access/" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Akses resmi KU ↗</a>
      <a href="https://www.kanazawa-u.ac.jp/students/livelihood/shuttle_bus/?wovn=en" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">KU shuttle ↗</a>
      <a href={withBase('/life-in-ishikawa/transportasi/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Panduan Transportasi →</a>
    </div>
  </section>
  <section id="kesehatan-dukungan" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-06" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">06 · Kesehatan & dukungan</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Gunakan jalur kampus sebelum masalah menjadi berat.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Health Service Center</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">KU menyediakan health management dan student counseling melalui layanan kampus.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Student Counseling</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Ada beberapa consultation desks termasuk counseling, disability support, LGBTQ+ consultation, career support, dan KUGS Support Network.</p>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kanazawa-u.ac.jp/en/students/consultation/" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Student counseling ↗</a>
      <a href={withBase('/life-in-ishikawa/kesehatan/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">SG07 · Kesehatan →</a>
    </div>
  </section>

  <section id="bahasa-ibadah" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-07" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">07 · Bahasa Jepang & ibadah</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Dua fasilitas yang sangat relevan untuk mahasiswa Indonesia.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Integrated Japanese Language Program</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">IJLP ditujukan untuk mahasiswa internasional KU yang memenuhi syarat dan mendukung kebutuhan bahasa Jepang untuk study, research, seminar, serta kehidupan sehari-hari.</p>
        <a href="https://www.kanazawa-u.ac.jp/en/global-network/study/ijlp/" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">IJLP ↗</a>
      </article>
      <article class="rounded-3xl border border-amber-200 bg-amber-50 p-6">
        <h3 class="font-bold text-slate-950">Prayer rooms di Kakuma</h3>
        <p class="mt-3 text-sm leading-6 text-slate-700">KU mencantumkan tiga prayer room yang dapat digunakan mahasiswa internasional: Human and Social Sciences Hall 3, Natural Science Main Hall, dan Natural Science Hall 5.</p>
        <a href="https://intl-support.w3.kanazawa-u.ac.jp/campuslife/campus/prayer.php" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Prayer room map ↗</a>
      </article>
    </div>
  </section>

  <section id="akademik-riset-karier" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-08" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">08 · Academic, research & career</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Ikuti aturan school/lab; gunakan layanan universitas untuk support lintas program.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-3">
      {[
        ['Academic', 'Course registration, orientation, degree requirements, dan academic procedures mengikuti school/graduate school Anda.'],
        ['Research', 'Lab/supervisor practice berbeda antar-program. PPI dapat membantu konteks praktis, tetapi keputusan akademik tetap melalui supervisor dan program.'],
        ['Career', 'Career Support Office dan Link KAGAYAKI menyediakan guidance, business Japanese, career education, internship, dan support khusus international students.']
      ].map(([title,desc]) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p>
        </article>
      ))}
    </div>
    <a href="https://career-support.adm.kanazawa-u.ac.jp/international/" target="_blank" rel="noreferrer" class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">Career support for international students ↗</a>
  </section>

    <CampusGuideBridge
    id="keluarga"
    number="09"
    eyebrow="Keluarga"
    title="Untuk keluarga, kampus membantu pada konteks studi; layanan sehari-hari mengikuti tempat tinggal."
    summary="Informasi childcare, sekolah, kesehatan keluarga, subsidi, dan prosedur rumah tangga bergantung pada municipality. Campus Pack cukup menunjukkan jalur dukungan KU dan meneruskan detail umum ke panduan utama."
    campusNote="Kanazawa University memiliki jalur konsultasi mahasiswa internasional yang dapat membantu mengarahkan persoalan keluarga, residence status, housing, atau kebutuhan hidup yang berkaitan dengan studi."
    links={[
      { label: 'Keluarga & Anak', href: '/life-in-ishikawa/family-anak/', icon: 'family' },
      { label: 'Panduan Kanazawa', href: '/life-in-ishikawa/municipality-guides/#kanazawa', icon: 'city' }
    ]}
  />
  <section id="faq" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-10" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">10 · FAQ mahasiswa Indonesia</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Jawaban cepat sebelum membuka detail.</h2>
    <div class="mt-7 space-y-3">
      {kuFaq.map((item, index) => (
        <details id={`faq-${item.id}`} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-5">
          <span id={`faq-${String(index + 1).padStart(2, '0')}`} class="sr-only" aria-hidden="true"></span>
          <summary class="cursor-pointer font-bold text-slate-950">{item.q}</summary>
          <p class="mt-3 text-sm leading-6 text-slate-600"><ContextualText text={item.a} maxLinks={2} /></p>
          <CampusFaqGuideLinks campusSlug="kanazawa-university" question={item.q} answer={item.a} />
        </details>
      ))}
    </div>
  </section>

  <RelatedLinks
    items={campusRelatedContent['kanazawa-university']}
    eyebrow="Lanjut dari Campus Pack"
    title="Panduan yang paling relevan setelah membaca Campus Pack ini"
  />

  <section class="mx-auto max-w-5xl px-5 pb-20 pt-10 lg:px-8">
    <div class="rounded-[2rem] border border-amber-200 bg-amber-50 p-7 sm:p-9">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-dark">Sumber resmi & verifikasi</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Periksa sumber resmi sebelum mengambil keputusan penting.</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-700">Campus Pack ini terakhir diverifikasi pada {kanazawaUniversityPack.lastVerified}. Jadwal, biaya, application period, eligibility, dan layanan dapat berubah. Untuk hal yang berdampak pada keputusan Anda, buka sumber resmi berikut.</p>
      <div class="mt-6 grid gap-2 sm:grid-cols-2">
        {kanazawaUniversityPack.officialSources.map(([label, url]) => (
          <a href={url} target="_blank" rel="noreferrer" class="rounded-xl border border-amber-200 bg-white px-4 py-3 text-sm font-bold text-slate-800 transition hover:border-amber-300">{label} ↗</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
