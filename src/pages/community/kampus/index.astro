---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TopicIcon from '../../../components/TopicIcon.astro';
import InstitutionMark from '../../../components/InstitutionMark.astro';
import MunicipalityMark from '../../../components/MunicipalityMark.astro';
import ContextualText from '../../../components/ContextualText.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';

import { campuses, campusCensus, campusHubProfileBySlug } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';
import { campusMedia } from '../../../data/media';
import { campusOverviewPoints } from '../../../data/campus-map';


const areaGroups = [
  {
    area: 'Kanazawa',
    markId: 'kanazawa',
    description: 'Kota utama dan pusat aktivitas komunitas; pola perjalanan harian berbeda antara pusat kota, Kakuma, dan area selatan Kanazawa.',
    items: ['Kanazawa University', 'Alice Gakuen · Kanazawa Campus']
  },
  {
    area: 'Nonoichi',
    markId: 'nonoichi',
    description: 'Area compact di selatan Kanazawa dengan akses rail/bus/bicycle yang penting untuk kehidupan mahasiswa.',
    items: ['Kanazawa Institute of Technology', 'Ishikawa Prefectural University']
  },
  {
    area: 'Hakusan',
    markId: 'hakusan',
    description: 'Koridor rail di selatan Nonoichi; pilihan tempat tinggal harus disesuaikan dengan Kasama atau Matto.',
    items: ['Kinjo University · Kasama Campus', 'Kinjo University · Matto Campus']
  },
  {
    area: 'Nomi',
    markId: 'nomi',
    description: 'Lingkungan graduate/research yang lebih terpisah dari pusat Kanazawa sehingga mobility planning sangat penting.',
    items: ['JAIST']
  },
  {
    area: 'Kaga',
    markId: 'kaga',
    description: 'Area Daishoji di bagian selatan prefektur dengan pola kehidupan sehari-hari yang berbeda dari Kanazawa metropolitan area.',
    items: ['Alice Gakuen · Kaga Campus']
  }
];

const needs = [
  {
    title: 'Saya mahasiswa baru',
    description: 'Pilih kampus, lalu gunakan bagian “Minggu pertama” sebagai starting checklist.',
    href: '#campus-pack'
  },
  {
    title: 'Saya sedang mencari tempat tinggal',
    description: 'Bandingkan asrama atau tempat tinggal privat dan pola perjalanan harian sebelum memilih area.',
    href: '#bandingkan'
  },
  {
    title: 'Saya bingung harus bertanya ke siapa',
    description: 'Setiap Campus Pack memiliki peta kontak untuk akademik, layanan internasional, kesehatan, dan dukungan karier.',
    href: '#campus-pack'
  },
  {
    title: 'Saya belum tahu area Ishikawa',
    description: 'Mulai dari wilayah kampus: Kanazawa, Nonoichi, Hakusan, Nomi, atau Kaga.',
    href: '#wilayah'
  }
];
---

<BaseLayout
  title="Campus Hub · Kampus di Ishikawa"
  description="Campus Hub PPI Ishikawa untuk enam institusi dengan anggota tercatat: perbandingan lokasi, tempat tinggal, transportasi, dukungan mahasiswa internasional, dan Campus Pack lengkap."
>
  <div class="mx-auto max-w-7xl px-5 pt-10 lg:px-8">
    <Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Komunitas', href: '/community/' }, { label: 'Campus Hub' }]} />
  </div>
  <PageIntro
    title="Campus Hub"
    description="Kenali kampusmu, pahami area tempat tinggal dan perjalanan harian, lalu masuk ke Campus Pack yang sesuai. Enam institusi di bawah memiliki anggota PPI Ishikawa tercatat pada sensus September 2026."
  />

  <section class="mx-auto max-w-7xl px-5 pb-10 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Campus Pack</p>
        <p class="mt-2 text-3xl font-bold text-slate-950">{campuses.length}/{campuses.length}</p>
        <p class="mt-1 text-sm text-slate-600">Semua institusi tercatat sudah memiliki panduan khusus.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Wilayah</p>
        <p class="mt-2 text-3xl font-bold text-slate-950">{areaGroups.length}</p>
        <p class="mt-1 text-sm text-slate-600">Kanazawa, Nonoichi, Hakusan, Nomi, dan Kaga.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Basis data</p>
        <p class="mt-2 text-2xl font-bold text-slate-950">{campusCensus.verified}</p>
        <p class="mt-1 text-sm text-slate-600">Sensus anggota + survey mahasiswa baru.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Privasi</p>
        <p class="mt-2 text-xl font-bold text-slate-950">Tanpa jumlah per kampus</p>
        <p class="mt-1 text-sm text-slate-600">Kami menunjukkan coverage komunitas, bukan data individu.</p>
      </div>
    </div>

    <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-slate-700">
      <strong class="text-slate-950">PPI Ishikawa tidak terbatas pada enam institusi ini.</strong>
      Daftar ini menunjukkan institusi yang memiliki anggota tercatat pada data September 2026. Pelajar Indonesia dari institusi lain di Prefektur Ishikawa tetap bagian dari cakupan komunitas.
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="mb-10 grid gap-5 lg:grid-cols-[1.2fr_.8fr]">
      <div>
        <InteractiveMap points={campusOverviewPoints} heightClass="h-[420px] lg:h-[520px]" />
      </div>

      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="flex flex-wrap items-center gap-3">
          <InstitutionMark id="ishikawa" size="md" />
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Ishikawa secara geografis</p>
        </div>
        <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Kampus anggota tersebar dari Kanazawa sampai Kaga.</h2>
        <p class="mt-4 leading-7 text-slate-600">Peta membantu melihat bentuk prefektur; untuk kehidupan mahasiswa, lokasi pemerintah kota dan koneksi kereta/bus lebih penting daripada jarak garis lurus. Gunakan pembagian wilayah di bawah bersama informasi perjalanan harian pada Campus Pack.</p>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-5">
          {areaGroups.map((group) => (
            <a href="#wilayah" class="rounded-2xl bg-slate-50 px-3 py-4 text-center">
              <p class="font-bold text-slate-950">{group.area}</p>
              <p class="mt-1 text-[11px] text-slate-500">{group.items.length} lokasi</p>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Mulai dari kebutuhanmu</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Tidak harus membaca semuanya dari awal.</h2>
      <p class="mt-3 leading-7 text-slate-600">Campus Hub membantu memilih titik masuk. Detail resmi dan langkah praktis tetap berada di Campus Pack masing-masing.</p>
    </div>

    <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {needs.map((item, index) => (
        <a href={item.href} class="group rounded-3xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-amber-200 hover:shadow-sm">
          <span class="grid size-11 place-items-center rounded-2xl bg-amber-50 text-accent-dark">
            <TopicIcon name={(['arrival','housing','support','transport'] as const)[index]} class="size-6" />
          </span>
          <h3 class="mt-4 font-bold text-slate-950 group-hover:text-brand">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
          <span class="mt-4 inline-flex text-sm font-bold text-brand">Lihat bagian terkait →</span>
        </a>
      ))}
    </div>
  </section>

  <section id="wilayah" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-10 lg:px-8">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Wilayah kampus</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Lokasi membentuk cara hidup mahasiswa.</h2>
      </div>
      <p class="max-w-2xl text-sm leading-6 text-slate-500">Jarak ke kampus, rail/bus, bicycle, winter, dan lokasi practicum atau laboratory dapat lebih menentukan daripada jarak garis lurus di peta.</p>
    </div>

    <div class="mt-7 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
      {areaGroups.map((group) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-5">
          <div class="flex items-center gap-3">
            <MunicipalityMark id={group.markId as any} size="sm" class="shrink-0" />
            <h3 class="text-xl font-bold text-slate-950">{group.area}</h3>
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-600">{group.description}</p>
          <a
            href={withBase(`/life-in-ishikawa/municipality-guides/#${group.markId}`)}
            class="mt-3 inline-flex text-xs font-bold text-brand hover:underline"
          >
            Panduan {group.area} →
          </a>
          <div class="mt-4 space-y-2">
            {group.items.map((item) => (
              <div class="rounded-xl bg-slate-50 px-3 py-2 text-xs font-semibold leading-5 text-slate-700">{item}</div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Foto kampus</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Lihat lingkungan kampus yang sebenarnya.</h2>
        <p class="mt-3 leading-7 text-slate-600">Lihat lingkungan kampus melalui foto dengan sumber dan lisensi yang tercantum. Untuk kampus yang belum memiliki foto di sini, buka Campus Pack untuk menuju situs resminya.</p>
      </div>
    </div>
    <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {campuses.filter((campus) => campusMedia[campus.slug]).map((campus) => {
        const media = campusMedia[campus.slug]!;
        return (
          <figure class="overflow-hidden rounded-3xl border border-slate-200 bg-white">
            <a href={withBase(`/community/kampus/${campus.slug}/`)} class="group block">
              <img src={media.imageUrl} alt={media.alt} width="1280" height="960" class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-[1.02]" loading="lazy" referrerpolicy="no-referrer" />
              <div class="p-5">
                <p class="font-bold text-slate-950 group-hover:text-brand">{campus.shortName}</p>
                <p class="mt-1 text-sm text-slate-500">{campus.city}</p>
              </div>
            </a>
            <figcaption class="border-t border-slate-100 px-5 py-3 text-[10px] leading-4 text-slate-500">
              <a href={media.sourcePage} target="_blank" rel="noreferrer" class="hover:underline">{media.credit}</a> · {media.license}
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>

  <section id="bandingkan" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-10 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Perbandingan cepat</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Enam institusi, enam pola kehidupan mahasiswa.</h2>
      <p class="mt-3 leading-7 text-slate-600">Tabel ini bukan ranking. Tujuannya memberi konteks sebelum Anda masuk ke panduan kampus yang lebih detail.</p>
    </div>

    <div class="mt-7 overflow-x-auto rounded-3xl border border-slate-200 bg-white">
      <table class="min-w-[1080px] w-full border-collapse text-left text-sm">
        <thead class="bg-slate-950 text-white">
          <tr>
            <th class="px-5 py-4 font-bold">Institusi</th>
            <th class="px-5 py-4 font-bold">Profil studi</th>
            <th class="px-5 py-4 font-bold">Tempat tinggal</th>
            <th class="px-5 py-4 font-bold">Mobility</th>
            <th class="px-5 py-4 font-bold">Dukungan utama</th>
          </tr>
        </thead>
        <tbody>
          {campuses.map((campus) => {
            const profile = campusHubProfileBySlug[campus.slug];
            return (
              <tr class="border-t border-slate-100 align-top">
                <td class="px-5 py-5">
                  <a href={withBase(`/community/kampus/${campus.slug}/`)} class="font-bold text-slate-950 hover:text-brand hover:underline">{campus.shortName}</a>
                  <p class="mt-1 text-xs text-slate-500">{campus.city} · {campus.type}</p>
                </td>
                <td class="px-5 py-5 leading-6 text-slate-600"><ContextualText text={profile.studyProfile} maxLinks={1} /></td>
                <td class="px-5 py-5 leading-6 text-slate-600"><ContextualText text={profile.housing} maxLinks={1} /></td>
                <td class="px-5 py-5 leading-6 text-slate-600"><ContextualText text={profile.mobility} maxLinks={1} /></td>
                <td class="px-5 py-5 leading-6 text-slate-600"><ContextualText text={profile.supportPoint} maxLinks={1} /></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <p class="mt-3 text-xs leading-5 text-slate-500">Tempat tinggal, penerimaan, jadwal, beasiswa, dan pengaturan dukungan dapat berubah. Campus Pack menautkan sumber resmi dan tanggal verifikasi untuk pengecekan aktual.</p>
  </section>

  <section id="campus-pack" class="mx-auto max-w-7xl scroll-mt-24 px-5 py-10 lg:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">6 Campus Pack</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Pilih kampusmu.</h2>
      </div>
      <p class="max-w-xl text-sm leading-6 text-slate-500">Setiap pack memiliki 10 bagian: orientasi kampus, langkah awal, jalur dukungan, tempat tinggal/transportasi, kehidupan akademik atau vokasi, kehidupan sehari-hari, FAQ, dan sumber resmi.</p>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      {campuses.map((campus) => {
        const profile = campusHubProfileBySlug[campus.slug];
        return (
          <article class="flex flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-7">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="flex items-start gap-3">
                <InstitutionMark id={campus.slug as any} size="md" class="shrink-0" />
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">{campus.type} · {campus.city}</p>
                  <h3 class="mt-1 text-2xl font-bold text-slate-950">{campus.shortName}</h3>
                  {campus.japanese && <p class="mt-1 text-sm text-slate-500">{campus.japanese}</p>}
                </div>
              </div>
              <span class="rounded-full bg-emerald-50 px-3 py-2 text-xs font-bold text-emerald-700">Campus Pack tersedia</span>
            </div>

            <p class="mt-5 leading-7 text-slate-600">{campus.summary}</p>

            <div class="mt-5 rounded-2xl bg-slate-50 p-4">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand">Fokus utama</p>
              <p class="mt-2 text-sm leading-6 text-slate-700">{profile.academicFocus}</p>
            </div>

            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <div class="rounded-2xl border border-slate-100 p-4">
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Tempat tinggal</p>
                <p class="mt-2 text-sm leading-6 text-slate-700">{profile.housing}</p>
              </div>
              <div class="rounded-2xl border border-slate-100 p-4">
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Jalur dukungan</p>
                <p class="mt-2 text-sm leading-6 text-slate-700">{profile.supportPoint}</p>
              </div>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              {profile.tags.map((tag) => (
                <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700">{tag}</span>
              ))}
            </div>

            <div class="mt-auto pt-6">
              <a
                href={withBase(`/community/kampus/${campus.slug}/`)}
                class="inline-flex rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white transition hover:opacity-90"
              >
                Buka {campus.shortName} Campus Pack →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="rounded-3xl bg-slate-950 p-7 text-white sm:p-9">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">Campus Pack + Survival Guide</p>
        <h2 class="mt-3 text-2xl font-bold">Gunakan keduanya bersama.</h2>
        <p class="mt-4 max-w-3xl leading-7 text-slate-300">Campus Pack menjawab hal yang spesifik pada institusi. Survival Guide menjawab sistem hidup di Jepang yang lintas kampus—administrasi, tempat tinggal, transportasi, kesehatan, keluarga, bahasa, dan kebutuhan sehari-hari.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={withBase('/life-in-ishikawa/administrasi/')} class="rounded-xl bg-white px-4 py-3 text-sm font-bold text-slate-950">Administrasi →</a>
          <a href={withBase('/life-in-ishikawa/tempat-tinggal/')} class="rounded-xl border border-slate-700 px-4 py-3 text-sm font-bold text-white">Tempat tinggal →</a>
          <a href={withBase('/life-in-ishikawa/transportasi/')} class="rounded-xl border border-slate-700 px-4 py-3 text-sm font-bold text-white">Transportasi →</a>
        </div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-7 sm:p-9">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Cara membaca informasi</p>
        <h2 class="mt-3 text-2xl font-bold text-slate-950">Gunakan sumber resmi untuk keputusan penting.</h2>
        <p class="mt-4 text-sm leading-6 text-slate-600">Campus Pack membantu memahami konteks praktis setiap institusi. Untuk penerimaan, biaya, beasiswa, jadwal, visa/status tinggal, dan aturan lain yang dapat berubah, selalu periksa sumber resmi terbaru.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-10 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Di luar enam institusi</p>
          <h2 class="mt-3 text-2xl font-bold text-slate-950">Ishikawa memiliki lebih banyak institusi pendidikan tinggi.</h2>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">University Consortium Ishikawa mencantumkan institusi pendidikan tinggi lain di prefektur ini. Pelajar Indonesia dari institusi yang belum tercantum tetap berada dalam cakupan komunitas PPI Ishikawa.</p>
        </div>
        <a href="https://www.ucon-i.jp/about/members/" target="_blank" rel="noreferrer" class="inline-flex rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">
          University Consortium Ishikawa ↗
        </a>
      </div>
      <p class="mt-6 border-t border-slate-100 pt-5 text-xs leading-5 text-slate-500">{campusCensus.note}</p>
    </div>
  </section>
</BaseLayout>
