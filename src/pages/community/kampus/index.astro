---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NestedLandingHeader from '../../../components/NestedLandingHeader.astro';
import TopicIcon from '../../../components/TopicIcon.astro';
import InstitutionMark from '../../../components/InstitutionMark.astro';
import MunicipalityMark from '../../../components/MunicipalityMark.astro';
import ContextualText from '../../../components/ContextualText.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';

import { campuses, campusCensus, campusHubProfileBySlug, campusProfileBySlug } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';
import { campusOverviewPoints } from '../../../data/campus-map';

const areaGroups = [
  {
    area: 'Kanazawa',
    markId: 'kanazawa',
    description: 'Pusat kota dengan pola commute berbeda antara area pusat, Kakuma, dan selatan Kanazawa.',
    items: ['Kanazawa University', 'Alice Gakuen · Kanazawa']
  },
  {
    area: 'Nonoichi',
    markId: 'nonoichi',
    description: 'Area compact di selatan Kanazawa dengan rail, bus, dan bicycle yang penting untuk mahasiswa.',
    items: ['Kanazawa Institute of Technology', 'Ishikawa Prefectural University']
  },
  {
    area: 'Hakusan',
    markId: 'hakusan',
    description: 'Koridor rail di selatan Nonoichi; pilihan housing perlu disesuaikan dengan Kasama atau Matto.',
    items: ['Kinjo University · Kasama', 'Kinjo University · Matto']
  },
  {
    area: 'Nomi',
    markId: 'nomi',
    description: 'Lingkungan graduate/research JAIST yang lebih terpisah dari pusat Kanazawa.',
    items: ['JAIST']
  },
  {
    area: 'Kaga',
    markId: 'kaga',
    description: 'Area Daishoji di selatan prefektur dengan pola kehidupan berbeda dari Kanazawa metropolitan area.',
    items: ['Alice Gakuen · Kaga']
  }
];
---

<BaseLayout
  title="Kampus di Ishikawa"
  description="Panduan kampus PPI Ishikawa untuk enam institusi dengan anggota tercatat: lokasi, housing, mobilitas, dukungan mahasiswa, dan panduan kampus."
>
  <NestedLandingHeader
    parentLabel="Komunitas"
    parentHref="/community/"
    title="Kampus di Ishikawa"
    description="Pilih kampus Anda, pahami wilayahnya, lalu gunakan perbandingan hanya bila diperlukan."
    lastVerified={campusCensus.verified}
  />

  <section class="mx-auto max-w-7xl px-5 pb-6 lg:px-8">
    <div class="flex flex-wrap gap-x-6 gap-y-3 border-y border-slate-200 py-4 text-sm text-slate-600">
      <div class="flex items-center gap-2">
        <TopicIcon name="campus" class="size-5 text-brand" />
        <span><strong class="text-slate-950">{campuses.length} institusi</strong> dengan panduan kampus</span>
      </div>
      <div class="flex items-center gap-2">
        <TopicIcon name="map" class="size-5 text-brand" />
        <span><strong class="text-slate-950">{areaGroups.length} wilayah</strong> utama</span>
      </div>
      <div class="flex items-center gap-2">
        <TopicIcon name="info" class="size-5 text-brand" />
        <span>Data diperiksa <strong class="text-slate-950">{campusCensus.verified}</strong></span>
      </div>
    </div>
  </section>

  <section id="campus-pack" class="mx-auto max-w-7xl scroll-mt-24 px-5 ui-section-space lg:px-8">
    <div class="max-w-3xl">
      <p class="type-eyebrow text-brand">Pilih kampus</p>
      <h2 class="type-section mt-2 text-slate-950">Mulai dari institusi Anda.</h2>
      <p class="mt-3 leading-7 text-slate-600">Setiap halaman kampus menyimpan informasi yang benar-benar spesifik institusi: langkah awal, housing, commute, support, akademik atau vokasi, beasiswa, dan sumber resmi.</p>
    </div>

    <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {campuses.map((campus) => {
        const profile = campusHubProfileBySlug[campus.slug];
        const detail = campusProfileBySlug[campus.slug];
        return (
          <a href={withBase(`/community/kampus/${campus.slug}/`)} class="group rounded-2xl border border-slate-200 bg-white p-5 transition-colors hover:border-accent/35 hover:bg-accent/5">
            <div class="flex items-start gap-3">
              <InstitutionMark id={campus.slug as any} size="md" class="shrink-0" />
              <div class="min-w-0">
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">{campus.city} · {campus.type}</p>
                <h3 class="mt-1 text-lg font-bold text-slate-950 group-hover:text-brand">{campus.shortName}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">{detail.orientation}</p>
              </div>
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              {profile.tags.slice(0, 3).map((tag) => (
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-600">{tag}</span>
              ))}
            </div>
            <p class="mt-4 text-sm font-bold text-brand">Buka panduan →</p>
          </a>
        );
      })}
    </div>

    <p class="mt-4 text-xs leading-5 text-slate-500">Daftar menunjukkan institusi dengan anggota tercatat, bukan batas keanggotaan PPI Ishikawa.</p>
  </section>

  <section id="wilayah" class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
      <div class="max-w-3xl">
        <p class="type-eyebrow text-brand">Pahami wilayah</p>
        <h2 class="mt-2 type-section text-slate-950">Lokasi kampus memengaruhi housing dan commute.</h2>
        <p class="mt-3 leading-7 text-slate-600">Gunakan peta untuk orientasi umum. Untuk layanan kota, administrasi, dan daily life, lanjutkan ke panduan municipality sesuai alamat tempat tinggal.</p>
      </div>

      <div class="mt-7 grid gap-6 lg:grid-cols-[1.15fr_.85fr]">
        <InteractiveMap points={campusOverviewPoints} heightClass="h-[380px] lg:h-[520px]" />

        <div class="space-y-3">
          {areaGroups.map((group) => (
            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
              <div class="flex items-center gap-3">
                <MunicipalityMark id={group.markId as any} size="sm" class="shrink-0" />
                <div>
                  <h3 class="font-bold text-slate-950">{group.area}</h3>
                  <p class="mt-1 text-xs text-slate-500">{group.items.join(' · ')}</p>
                </div>
              </div>
              <p class="mt-3 text-sm leading-6 text-slate-600">{group.description}</p>
              <a href={withBase(`/life-in-ishikawa/municipality-guides/#${group.markId}`)} class="mt-3 inline-flex text-xs font-bold text-brand hover:underline">
                Panduan {group.area} →
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="bandingkan" class="mx-auto max-w-7xl scroll-mt-24 px-5 ui-section-space lg:px-8">
    <div class="max-w-3xl">
      <p class="type-eyebrow text-brand">Bandingkan bila perlu</p>
      <h2 class="mt-2 type-section text-slate-950">Perbedaan utama enam institusi.</h2>
      <p class="mt-3 leading-7 text-slate-600">Perbandingan ini bukan ranking. Gunakan hanya untuk memahami perbedaan profil studi, housing, mobilitas, dan jalur support.</p>
    </div>

    <div class="mt-7 space-y-3 lg:hidden">
      {campuses.map((campus) => {
        const profile = campusHubProfileBySlug[campus.slug];
        return (
          <details class="group rounded-2xl border border-slate-200 bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4">
              <div class="flex min-w-0 items-center gap-3">
                <InstitutionMark id={campus.slug as any} size="sm" class="shrink-0" />
                <div class="min-w-0">
                  <p class="truncate font-bold text-slate-950">{campus.shortName}</p>
                  <p class="mt-1 text-xs text-slate-500">{campus.city} · {campus.type}</p>
                </div>
              </div>
              <span class="text-xl text-slate-400 transition group-open:rotate-45">+</span>
            </summary>
            <div class="grid gap-3 border-t border-slate-100 p-4 sm:grid-cols-2">
              <div class="rounded-xl bg-slate-50 p-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-brand">Profil studi</p>
                <p class="mt-2 text-sm leading-6 text-slate-700"><ContextualText text={profile.studyProfile} maxLinks={0} /></p>
              </div>
              <div class="rounded-xl bg-slate-50 p-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-brand">Housing</p>
                <p class="mt-2 text-sm leading-6 text-slate-700"><ContextualText text={profile.housing} maxLinks={0} /></p>
              </div>
              <div class="rounded-xl bg-slate-50 p-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-brand">Mobilitas</p>
                <p class="mt-2 text-sm leading-6 text-slate-700"><ContextualText text={profile.mobility} maxLinks={0} /></p>
              </div>
              <div class="rounded-xl bg-accent/10 p-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent-dark">Dukungan utama</p>
                <p class="mt-2 text-sm leading-6 text-slate-700"><ContextualText text={profile.supportPoint} maxLinks={0} /></p>
              </div>
            </div>
          </details>
        );
      })}
    </div>

    <div class="mt-7 hidden overflow-x-auto rounded-2xl border border-slate-200 bg-white lg:block">
      <table class="min-w-[1080px] w-full border-collapse text-left text-sm">
        <thead class="bg-slate-950 text-white">
          <tr>
            <th class="px-5 py-4 font-bold">Institusi</th>
            <th class="px-5 py-4 font-bold">Profil studi</th>
            <th class="px-5 py-4 font-bold">Housing</th>
            <th class="px-5 py-4 font-bold">Mobilitas</th>
            <th class="px-5 py-4 font-bold">Dukungan utama</th>
          </tr>
        </thead>
        <tbody>
          {campuses.map((campus) => {
            const profile = campusHubProfileBySlug[campus.slug];
            return (
              <tr class="border-t border-slate-100 align-top">
                <td class="px-5 py-5">
                  <a href={withBase(`/community/kampus/${campus.slug}/`)} class="font-bold text-slate-950 hover:text-brand hover:underline">{campus.shortName}</a>
                  <p class="mt-1 text-xs text-slate-500">{campus.city} · {campus.type}</p>
                </td>
                <td class="px-5 py-5 leading-6 text-slate-600">{profile.studyProfile}</td>
                <td class="px-5 py-5 leading-6 text-slate-600">{profile.housing}</td>
                <td class="px-5 py-5 leading-6 text-slate-600">{profile.mobility}</td>
                <td class="px-5 py-5 leading-6 text-slate-600">{profile.supportPoint}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="rounded-2xl bg-slate-950 p-6 text-white">
        <p class="type-eyebrow text-accent-soft">Kampus & kehidupan sehari-hari</p>
        <h2 class="mt-2 text-xl font-bold">Pisahkan informasi kampus dan kehidupan sehari-hari.</h2>
        <p class="mt-3 text-sm leading-6 text-slate-300">Gunakan halaman kampus untuk informasi spesifik institusi. Untuk administrasi, kontrak tempat tinggal, transportasi umum, kesehatan, keluarga, dan kebutuhan lintas kampus, buka Hidup di Ishikawa.</p>
        <a href={withBase('/life-in-ishikawa/')} class="mt-4 inline-flex text-sm font-bold text-white hover:underline">Buka Hidup di Ishikawa →</a>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="type-eyebrow text-brand">Di luar enam institusi</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Pelajar Indonesia dari institusi lain di Prefektur Ishikawa tetap berada dalam cakupan komunitas PPI Ishikawa.</p>
        <a href="https://www.ucon-i.jp/about/members/" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">University Consortium Ishikawa ↗</a>
      </div>
    </div>
    <p class="mt-5 text-xs leading-5 text-slate-500">{campusCensus.note}</p>
  </section>
</BaseLayout>
