---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import { campuses, campusCensus } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';

---
<BaseLayout
  title="Kampus di Ishikawa"
  description="Direktori kampus dan institusi pendidikan yang memiliki anggota PPI Ishikawa berdasarkan sensus September 2026."
>
  <PageIntro
    title="Kampus di Ishikawa"
    description="Peta institusi tempat anggota PPI Ishikawa belajar—dengan tautan resmi, dukungan mahasiswa internasional, dan informasi praktis yang akan terus dikembangkan."
  />

  <section class="mx-auto max-w-7xl px-5 pb-10 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Basis data</p>
        <p class="mt-2 text-2xl font-bold text-slate-950">{campusCensus.verified}</p>
        <p class="mt-1 text-sm text-slate-600">Sensus anggota + survey mahasiswa baru.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Institusi tercatat</p>
        <p class="mt-2 text-2xl font-bold text-slate-950">{campuses.length}</p>
        <p class="mt-1 text-sm text-slate-600">Memiliki anggota tercatat pada data periode sebelumnya.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Privasi anggota</p>
        <p class="mt-2 text-xl font-bold text-slate-950">Tanpa jumlah per kampus</p>
        <p class="mt-1 text-sm text-slate-600">Website hanya menunjukkan kehadiran komunitas, bukan data individu atau jumlah kecil.</p>
      </div>
    </div>

    <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-slate-700">
      <strong class="text-slate-950">Cakupan PPI tidak berhenti pada enam institusi ini.</strong>
      PPI Ishikawa ditujukan bagi pelajar Indonesia di seluruh Prefektur Ishikawa. Daftar di bawah menunjukkan institusi yang memiliki anggota tercatat pada data September 2026, bukan daftar eksklusif kampus yang boleh bergabung.
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Kampus dengan anggota tercatat</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Enam institusi dalam sensus 2026.</h2>
      </div>
      <p class="max-w-xl text-sm leading-6 text-slate-500">Informasi resmi berasal dari website institusi. Catatan PPI akan dilengkapi bertahap berdasarkan pengalaman anggota.</p>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      {campuses.map((campus) => (
        <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-7">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">{campus.type} · {campus.city}</p>
              <h3 class="mt-2 text-2xl font-bold text-slate-950">{campus.shortName}</h3>
              {campus.japanese && <p class="mt-1 text-sm text-slate-500">{campus.japanese}</p>}
            </div>
            <span class="rounded-full bg-amber-50 px-3 py-2 text-xs font-bold text-accent-dark">Anggota tercatat · {campus.censusDate}</span>
          </div>

          <p class="mt-5 leading-7 text-slate-600">{campus.summary}</p>

          <div class="mt-5 rounded-2xl bg-slate-50 p-4">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand">Catatan PPI</p>
            <p class="mt-2 text-sm leading-6 text-slate-700">{campus.ppiNote}</p>
          </div>

          <div class="mt-5 flex flex-wrap gap-2">
            {campus.officialLinks.map((link) => (
              <a href={link.url} target="_blank" rel="noreferrer" class="rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold text-slate-700 transition hover:border-slate-400">
                {link.label} ↗
              </a>
            ))}
          </div>

          <a
            href={withBase(`/community/kampus/${campus.slug}/`)}
            class="mt-6 inline-flex text-sm font-bold text-brand hover:underline"
          >
            Detail kampus & panduan PPI →
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="rounded-3xl bg-slate-950 p-7 text-white sm:p-9">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">Konteks Ishikawa</p>
      <h2 class="mt-3 text-2xl font-bold">Ishikawa memiliki lebih banyak institusi pendidikan tinggi.</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-300">
        University Consortium Ishikawa mencantumkan 20 institusi pendidikan tinggi anggota, termasuk universitas, junior college, dan KOSEN. Untuk website PPI, kami memisahkan daftar umum tersebut dari institusi yang memang memiliki anggota PPI tercatat.
      </p>
      <a href="https://www.ucon-i.jp/about/members/" target="_blank" rel="noreferrer" class="mt-6 inline-flex rounded-xl bg-white px-4 py-3 text-sm font-bold text-slate-950">
        Lihat daftar University Consortium Ishikawa ↗
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-10 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Yang akan ditambahkan per kampus</p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {[
          'Lokasi kampus & transportasi',
          'International student support',
          'Housing / dormitory',
          'Administrasi khusus kampus',
          'Fasilitas & kehidupan kampus',
          'Catatan praktis mahasiswa Indonesia',
          'Kontak liaison PPI jika ditetapkan',
          'FAQ kampus',
          'Link resmi yang paling sering dibutuhkan'
        ].map((item) => (
          <div class="rounded-2xl bg-slate-50 p-4 text-sm font-medium text-slate-700">{item}</div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
