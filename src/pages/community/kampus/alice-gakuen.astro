---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideToc from '../../../components/GuideToc.astro';
import InstitutionMark from '../../../components/InstitutionMark.astro';
import ContextualText from '../../../components/ContextualText.astro';
import CampusFaqGuideLinks from '../../../components/CampusFaqGuideLinks.astro';
import CampusScholarshipGuide from '../../../components/CampusScholarshipGuide.astro';
import CampusCareerGuide from '../../../components/CampusCareerGuide.astro';
import CampusOfficialSources from '../../../components/CampusOfficialSources.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CampusProfile from '../../../components/CampusProfile.astro';
import CampusGuideBridge from '../../../components/CampusGuideBridge.astro';
import CampusContactRoutes from '../../../components/CampusContactRoutes.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';
import { campusRelatedContent } from '../../../data/related-content';
import { campusProfileBySlug } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';
import { alicePack, aliceSections, aliceQuickLinks, aliceContactMap, aliceFaq } from '../../../data/campus-alice';
import { campusMapPoints } from '../../../data/campus-map';

const campusMap = campusMapPoints['alice-gakuen'];


const priorityFaq = aliceFaq.filter((item) => ["lanjut-program-alice","international-business","care-worker","dukungan-sehari-hari"].includes(item.id));
---

<BaseLayout
  title="Alice Gakuen Campus Pack"
  description="Panduan praktis pelajar Indonesia di Vocational School Alice Gakuen: Kanazawa dan Kaga Campus, Japanese Language, International Business, Care Worker, dormitory, part-time work, transportasi, student support, dan career."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Kampus', href: '/community/kampus/' }, { label: 'Alice Gakuen' }]} />
    <p class="mt-8 text-sm font-bold uppercase tracking-[0.18em] text-accent-dark">PPI Ishikawa · Campus Pack</p>
    <div class="mt-4 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
      <InstitutionMark id="alice-gakuen" size="lg" class="shrink-0" />
      <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Vocational School Alice Gakuen</h1>
    </div>
    <p class="mt-2 text-lg text-slate-500">専門学校アリス学園 · Kanazawa / Kaga</p>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
      Panduan praktis untuk pelajar Indonesia di Alice Gakuen. Kebutuhan siswa Japanese Language, International Business, dan Care Worker tidak selalu sama dengan mahasiswa universitas, sehingga Campus Pack ini memberi perhatian khusus pada dormitory, dukungan kehidupan sehari-hari, part-time work, bahasa Jepang, vocational pathway, dan transisi ke studi atau pekerjaan berikutnya.
    </p>

    <div class="mt-7 flex flex-wrap gap-3 text-sm">
      <span class="rounded-full bg-slate-900 px-4 py-2 font-semibold text-white">Vocational school</span>
      <span class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-700">Kanazawa + Kaga</span>
      <span class="rounded-full border border-amber-200 bg-amber-50 px-4 py-2 font-semibold text-accent-dark">Terakhir diverifikasi: {alicePack.lastVerified}</span>
      <a href={withBase('/life-in-ishikawa/municipality-guides/#kanazawa')} class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-brand transition hover:border-amber-200 hover:bg-amber-50">Panduan Kanazawa →</a>
      <a href={withBase('/life-in-ishikawa/municipality-guides/#kaga')} class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-brand transition hover:border-amber-200 hover:bg-amber-50">Panduan Kaga →</a>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {aliceQuickLinks.map(([label, url]) => (
        <a href={url} target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-white p-4 text-sm font-bold text-slate-800 transition hover:border-amber-200 hover:shadow-sm">
          {label} ↗
        </a>
      ))}
    </div>
  </section>

  <CampusProfile profile={campusProfileBySlug['alice-gakuen']} />

  <section class="mx-auto max-w-5xl px-5 pb-8 lg:px-8">
    <div class="mb-5">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Dua lokasi di Ishikawa</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Kanazawa dan Kaga perlu diperlakukan sebagai dua pola commute yang berbeda.</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Marker menggunakan titik area alamat resmi. Untuk pintu masuk dan rute aktual, buka akses resmi Alice dari marker.</p>
    </div>
    <div class="grid gap-5 lg:grid-cols-2">
      {campusMap.map((point) => (
        <div>
          <div class="mb-3">
            <h3 class="font-bold text-slate-950">{point.name}</h3>
            <p class="mt-1 text-xs leading-5 text-slate-500">{point.address}</p>
          </div>
          <InteractiveMap points={[point]} heightClass="h-[300px] sm:h-[340px]" />
        </div>
      ))}
    </div>
  </section>

  <GuideToc sections={aliceSections} />

  <section id="kenali-alice" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-01" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">01 · Kenali Alice Gakuen</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Bukan university campus biasa: sekolah, tempat tinggal, bahasa, dan career saling terhubung erat.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-3">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="text-xl font-bold text-slate-950">Japanese Language</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Tersedia di Kanazawa dan Kaga. Fokusnya tidak hanya Japanese proficiency, tetapi juga adaptation to life in Japan serta persiapan untuk progression ke pendidikan berikutnya.</p>
        <a href="https://gakuen.alice-japan.net/courses/japanese" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Japanese Language ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="text-xl font-bold text-slate-950">International Business</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Program dua tahun di Kanazawa dan Kaga dengan business skills, communication, hospitality, tourism, service, Japanese, dan career preparation untuk bekerja di Jepang.</p>
        <a href="https://gakuen.alice-japan.net/courses/business" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">International Business ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="text-xl font-bold text-slate-950">Care Worker</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Program Kanazawa yang menggabungkan theory, practical skills, long-term practicum, communication, dan persiapan national examination untuk certified care worker.</p>
        <a href="https://gakuen.alice-japan.net/courses/nursing-care" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Care Worker ↗</a>
      </article>
    </div>
  </section>

  <section id="program-kampus" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-02" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">02 · Program & kampus</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Pastikan program, kampus, dan tujuan setelah lulus sejak awal.</h2>
    <div class="mt-7 overflow-hidden rounded-3xl border border-slate-200 bg-white">
      <div class="grid border-b border-slate-200 bg-slate-50 px-5 py-4 text-sm font-bold text-slate-700 sm:grid-cols-[1.4fr_1fr_1fr]">
        <span>Program</span><span>Kanazawa</span><span>Kaga</span>
      </div>
      {[
        ['Japanese Language Department', '✓', '✓'],
        ['International Business Department', '✓', '✓'],
        ['Care Worker Department', '✓', '—']
      ].map(([program,kanazawa,kaga]) => (
        <div class="grid gap-2 border-b border-slate-100 px-5 py-4 text-sm last:border-0 sm:grid-cols-[1.4fr_1fr_1fr]">
          <strong class="text-slate-950">{program}</strong>
          <span class="text-slate-600">{kanazawa}</span>
          <span class="text-slate-600">{kaga}</span>
        </div>
      ))}
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Kanazawa Campus</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Berada di Enkoji-honmachi, Kanazawa. Cocok dipahami sebagai ekosistem utama Alice di Ishikawa karena ketiga program tersedia di sini.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Kaga Campus</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Berada di Daishoji, Kaga. Japanese Language dan International Business tersedia di sini; daily life dan mobilitas berbeda cukup jauh dari kehidupan mahasiswa di Kanazawa.</p>
      </article>
    </div>

    <div class="mt-5 rounded-3xl border border-amber-200 bg-amber-50 p-6">
      <h3 class="font-bold text-slate-950">Japanese school → vocational program adalah salah satu pathway, bukan kewajiban.</h3>
      <p class="mt-2 text-sm leading-6 text-slate-700">Alice secara eksplisit mencantumkan internal progression dari Japanese Language Department ke International Business atau Care Worker. Tetap bandingkan dengan pilihan sekolah/universitas lain, eligibility, Japanese level, biaya, dan tujuan career Anda.</p>
    </div>
  </section>

  <CampusGuideBridge
    id="minggu-pertama"
    number="03"
    eyebrow="Minggu pertama"
    title="Minggu pertama di Alice: pastikan course, campus, dormitory, dan timetable."
    summary="Checklist kedatangan yang berlaku umum—resident registration, health insurance, pension, komunikasi, pembayaran, dan kebutuhan hari pertama—tidak diulang di Campus Pack. Gunakan Survival Guide sebagai checklist utama."
    campusNote="Japanese Language students perlu memastikan aturan dormitory dan class schedule. Kanazawa dan Kaga memiliki pola daily life dan commute berbeda, jadi gunakan kampus aktual sebagai titik orientasi."
    links={[
      { label: 'Hari Pertama di Ishikawa', href: '/life-in-ishikawa/hari-pertama/', icon: 'arrival' },
      { label: 'Administrasi', href: '/life-in-ishikawa/administrasi/', icon: 'documents' }
    ]}
  />
  <section id="kontak-dukungan" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-04" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">04 · Ke mana harus bertanya</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Alice memisahkan academic, daily-life, dan employment support dengan cukup jelas.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Pilih office sesuai kebutuhan: academic, health, counseling, career, housing, atau dukungan mahasiswa internasional.</p>
    <CampusContactRoutes items={aliceContactMap} sourceUrl="https://gakuen.alice-japan.net/entrance-exam/teachers" sourceLabel="School support structure" />
  </section>
  <section id="dormitory-housing" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-05" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">05 · Dormitory & housing</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Untuk Japanese Language students, aturan dormitory adalah konteks utama.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Campus Pack hanya menyimpan konteks housing yang spesifik kampus. Initial cost, guarantor, utilities, kontrak, move-out, dan checklist umum dirujuk ke Survival Guide.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Japanese Language Department</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Official guidance menyatakan siswa Japanese Language di Kanazawa dan Kaga pada prinsipnya tinggal di student dormitory.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Room assignment & move-out</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Penempatan kamar serta perubahan/keluar dorm mengikuti prosedur sekolah. Jangan membuat kontrak private housing sebelum status dorm jelas.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Kanazawa ≠ Kaga</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Jika program Anda memungkinkan private housing, gunakan campus aktual sebagai titik awal. Kanazawa dan Kaga bukan satu pasar housing maupun satu pola commute.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://gakuen.alice-japan.net/entrance-exam/dormitory" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Dormitory resmi ↗</a>
      <a href="https://gakuen.alice-japan.net/access" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Access kampus ↗</a>
      <a href={withBase('/life-in-ishikawa/tempat-tinggal/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Checklist Tempat Tinggal →</a>
    </div>
  </section>
  <section id="transportasi-kanazawa-kaga" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-06" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">06 · Transportasi Kanazawa & Kaga</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Kanazawa dan Kaga adalah dua pola commute yang benar-benar berbeda.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Pahami akses khas kampus untuk commute harian. Tarif, jadwal, aturan sepeda, penggunaan IC card, dan kondisi musim dingin mengikuti operator serta panduan transportasi yang berlaku.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Kanazawa Campus</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Campus berada di Enkoji-honmachi. Bus dari arah Kanazawa Station dan bicycle menjadi bagian penting dari daily mobility.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Kaga Campus</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Campus berada di Daishoji dan dapat diakses berjalan kaki dari Daishoji Station menurut informasi resmi sekolah.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Gunakan campus aktual</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Jangan menggunakan asumsi commute Kanazawa untuk siswa Kaga atau sebaliknya. Housing dan daily mobility harus mengikuti program serta campus.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://gakuen.alice-japan.net/access" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Access Alice ↗</a>
      <a href={withBase('/life-in-ishikawa/transportasi/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Panduan Transportasi →</a>
    </div>
  </section>
  <section id="studi-bahasa-jepang" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-07" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">07 · Studi & bahasa Jepang</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Target bahasa dan attendance bukan sekadar nilai—keduanya memengaruhi pathway berikutnya.</h2>

    <div class="mt-7 grid gap-4 md:grid-cols-2">
      {[
        ['Japanese Language', 'Gunakan target JLPT/J-TEST dan progression plan yang realistis. Alice juga mengajarkan Japanese untuk daily life dan cultural adaptation, bukan hanya test preparation.'],
        ['International Business', 'Japanese level, business communication, service/hospitality knowledge, computer skills, dan career study berjalan bersama. Rencanakan job-search vocabulary sejak awal.'],
        ['Care Worker', 'Bahasa Jepang harus berkembang bersama technical vocabulary, communication with users, practicum requirements, dan national-exam preparation.'],
        ['Attendance & school calendar', 'Orientation, exams, school events, practicum, long vacation, dan graduation mempunyai pola berbeda per department. Gunakan calendar dan notice resmi sekolah, bukan asumsi dari teman program lain.']
      ].map(([title,desc]) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p>
        </article>
      ))}
    </div>

    <a href="https://gakuen.alice-japan.net/entrance-exam/calendar" target="_blank" rel="noreferrer" class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">Annual calendar ↗</a>
  </section>

    <CampusGuideBridge
    id="part-time-biaya-hidup"
    number="08"
    eyebrow="Part-time work & biaya hidup"
    title="Alice dapat membantu pada jalur part-time; aturan kerja dan budgeting tetap lintas kampus."
    summary="Campus Pack cukup menjelaskan support Alice. Batas kerja, izin aktivitas di luar status tinggal, serta perencanaan biaya hidup adalah aturan dan kebutuhan umum yang sebaiknya dirujuk ke panduan utama."
    campusNote="Life-support staff Alice menangani konsultasi part-time work dan sekolah memiliki koneksi dengan perusahaan yang menerima international students. Tetap utamakan attendance dan study progress."
    links={[
      { label: 'Kehidupan Sehari-hari', href: '/life-in-ishikawa/kehidupan-sehari-hari/', icon: 'guide' },
      { label: 'Bank & Keuangan', href: '/life-in-ishikawa/bank-money/', icon: 'money' }
    ]}
  />
  <section id="karier-setelah-lulus" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-09" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">09 · Career & langkah setelah lulus</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Mulai dari tujuan akhir, lalu susun Japanese level, qualification, dan residence-status pathway.</h2>

    <div class="mt-7 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Lanjut studi</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Japanese Language students dapat melanjutkan ke Alice atau institusi lain. Mulai research sekolah/universitas, entrance requirements, JLPT/EJU bila diperlukan, dan financial plan jauh sebelum graduation.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Bekerja di Jepang</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">International Business dan Care Worker memiliki pathway kerja yang berbeda. Job offer saja tidak otomatis berarti residence status sesuai; cocokkan pekerjaan, qualification, dan immigration category.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Career support</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Employment Support Center menyediakan career guidance, individual consultation, entry-sheet guidance, interview preparation, dan job-search support.</p>
      </article>
    </div>

    <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-5">
      <p class="text-sm leading-6 text-slate-700"><strong>Untuk Care Worker:</strong> scholarship dapat memiliki syarat khusus terkait study atau pekerjaan setelah lulus. Jangan hanya melihat nominal bantuan; baca obligation, repayment/waiver conditions, dan employer/region requirements pada dokumen terbaru.</p>
    </div>
  </section>

  <CampusScholarshipGuide campusSlug="alice-gakuen" />

  <CampusCareerGuide campusSlug="alice-gakuen" />

  <section id="faq" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-10" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">10 · FAQ pelajar Indonesia</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Pertanyaan tambahan tentang pathway dan dukungan Alice.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">FAQ hanya menyimpan pertanyaan yang tidak sudah dijelaskan pada housing, transport, support, academic, atau section kampus lainnya.</p>
    <div class="mt-6 space-y-3">
      {priorityFaq.map((item, index) => (
        <details id={`faq-${item.id}`} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-5">
          <span id={`faq-${String(index + 1).padStart(2, '0')}`} class="sr-only" aria-hidden="true"></span>
          <summary class="cursor-pointer font-bold text-slate-950">{item.q}</summary>
          <p class="mt-3 text-sm leading-6 text-slate-600"><ContextualText text={item.a} maxLinks={2} /></p>
          <CampusFaqGuideLinks campusSlug="alice-gakuen" question={item.q} answer={item.a} />
        </details>
      ))}
    </div>
  </section>

  <RelatedLinks
    items={campusRelatedContent['alice-gakuen']}
    eyebrow="Lanjut dari Campus Pack"
    title="Panduan yang paling relevan setelah membaca Campus Pack ini"
  />

  <CampusOfficialSources sources={alicePack.officialSources} lastVerified={alicePack.lastVerified} />
</BaseLayout>
