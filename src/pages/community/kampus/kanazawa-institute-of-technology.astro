---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideToc from '../../../components/GuideToc.astro';
import CampusGuideHeader from '../../../components/CampusGuideHeader.astro';
import ContextualText from '../../../components/ContextualText.astro';
import CampusFaqGuideLinks from '../../../components/CampusFaqGuideLinks.astro';
import CampusScholarshipGuide from '../../../components/CampusScholarshipGuide.astro';
import CampusCareerGuide from '../../../components/CampusCareerGuide.astro';
import StoriesSection from '../../../components/StoriesSection.astro';
import CampusOfficialSources from '../../../components/CampusOfficialSources.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import CampusProfile from '../../../components/CampusProfile.astro';
import CampusGuideBridge from '../../../components/CampusGuideBridge.astro';
import CampusContactRoutes from '../../../components/CampusContactRoutes.astro';
import LicensedPhoto from '../../../components/LicensedPhoto.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';
import { campusRelatedContent } from '../../../data/related-content';
import { campusProfileBySlug } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';
import { campusMedia } from '../../../data/media';
import { campusMapPoints } from '../../../data/campus-map';
import { kitPack, kitSections, kitQuickLinks, kitContactMap, kitFaq } from '../../../data/campus-kit';

const campusPhoto = campusMedia['kanazawa-institute-of-technology']!;
const campusMap = campusMapPoints['kanazawa-institute-of-technology'];

const priorityFaq = kitFaq.filter((item) => ["international-community-house","bantuan-medis-multibahasa","campus-guide-vs-ppi"].includes(item.id));
---

<BaseLayout
  title="Kanazawa Institute of Technology · Panduan Kampus"
  description="Panduan praktis mahasiswa Indonesia di Kanazawa Institute of Technology: Ohgigaoka, housing, transportasi, international support, kesehatan, Japanese programs, career, dan FAQ."
>
  <CampusGuideHeader
    campusId="kanazawa-institute-of-technology"
    breadcrumbLabel="KIT"
    title="Kanazawa Institute of Technology"
    subtitle="金沢工業大学 · KIT · Nonoichi"
    description="Panduan praktis untuk mahasiswa Indonesia di KIT. Fokus utamanya adalah Ohgigaoka Campus, hubungan dengan Yatsukaho Research Campus, housing mahasiswa internasional, akses dari Kanazawa, layanan kampus, dan jalur dukungan yang paling berguna untuk kehidupan sehari-hari."
    institutionType="Private university"
    areaLabel="Ohgigaoka · Nonoichi"
    lastVerified={kitPack.lastVerified}
    municipalityLinks={[
      { label: "Panduan Nonoichi", href: "/life-in-ishikawa/municipality-guides/#nonoichi" }
    ]}
    quickLinks={kitQuickLinks}
  />

  <CampusProfile profile={campusProfileBySlug['kanazawa-institute-of-technology']} />

  <section class="mx-auto max-w-5xl px-5 pb-4 lg:px-8">
    <LicensedPhoto media={campusPhoto} imageClass="aspect-[16/9] w-full object-cover" />
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-8 lg:px-8">
    <div class="mb-4">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Lokasi kampus</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Lihat posisi kampus sebelum memilih housing dan commute.</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Peta dapat di-zoom dan digeser. Gunakan tombol akses resmi pada marker untuk petunjuk kampus terbaru.</p>
    </div>
    <InteractiveMap points={campusMap} heightClass="h-[340px] sm:h-[420px]" />
  </section>

  <GuideToc sections={kitSections} />

  <section id="kenali-kit" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-01" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">01 · Kenali KIT</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Ohgigaoka adalah pusat student life; Yatsukaho memperluas aktivitas riset.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Ohgigaoka Campus</p>
        <h3 class="mt-2 text-xl font-bold text-slate-950">扇が丘キャンパス</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Campus utama di Nonoichi. Campus map mencantumkan Student Support Center, International Programs Center, Library Center, Career Planning and Placement Services, cafeterias, convenience store, Health Center, Study Hall, dan berbagai fasilitas akademik.</p>
        <a href="https://www.kanazawa-it.ac.jp/ekit/map/ohgigaoka.html" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Ohgigaoka map & access ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Yatsukaho Research Campus</p>
        <h3 class="mt-2 text-xl font-bold text-slate-950">やつかほリサーチキャンパス</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Research campus KIT di Hakusan. KIT menyediakan shuttle gratis antara Ohgigaoka dan Yatsukaho untuk mahasiswa dan staf pada hari serta jadwal yang ditentukan.</p>
        <a href="https://www.kanazawa-it.ac.jp/ekit/map/yatsukaho.html" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Yatsukaho & shuttle ↗</a>
      </article>
    </div>
  </section>

  <CampusGuideBridge
    id="minggu-pertama"
    number="02"
    eyebrow="Minggu pertama"
    title="Minggu pertama di KIT: mulai dari status program dan jalur international support."
    summary="Checklist kedatangan yang berlaku umum—resident registration, health insurance, pension, komunikasi, pembayaran, dan kebutuhan hari pertama—tidak diulang di panduan kampus. Gunakan Survival Guide sebagai checklist utama."
    campusNote="Kebutuhan exchange, research, dan degree students dapat berbeda. Center for International Programs dan living information resmi adalah titik awal untuk memastikan housing, orientation, dan dukungan yang berlaku."
    links={[
      { label: 'Hari Pertama di Ishikawa', href: '/life-in-ishikawa/hari-pertama/', icon: 'arrival' },
      { label: 'Administrasi', href: '/life-in-ishikawa/administrasi/', icon: 'documents' }
    ]}
  />
  <section id="kontak-dukungan" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-03" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">03 · Ke mana harus bertanya</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Kenali fungsi office sebelum membutuhkan bantuan.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Pilih office sesuai kebutuhan: academic, health, counseling, career, housing, atau dukungan mahasiswa internasional.</p>
    <CampusContactRoutes items={kitContactMap} sourceUrl="https://www.kanazawa-it.ac.jp/ekit/exchanges/center.html" sourceLabel="Center for International Programs" />
  </section>
  <section id="housing" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-04" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">04 · Housing</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Housing KIT bergantung pada jenis program dan durasi tinggal.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Panduan kampus hanya menyimpan konteks housing yang spesifik kampus. Initial cost, guarantor, utilities, kontrak, move-out, dan checklist umum dirujuk ke Survival Guide.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">International Community House</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Fasilitas ini terutama terkait program internasional tertentu dan tidak otomatis tersedia untuk semua mahasiswa internasional.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">KIT-designated apartment</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Untuk long-term students, KIT menyediakan jalur designated apartment; banyak opsi berada dalam walking/bicycle distance dari Ohgigaoka.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Lokasi dulu, kontrak kemudian</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Pastikan aktivitas utama di Ohgigaoka atau Yatsukaho sebelum memilih area. Detail kontrak dan biaya umum tidak perlu diulang di panduan kampus.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kanazawa-it.ac.jp/ekit/exchanges/living.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Living information ↗</a>
      <a href="https://www.kanazawa-it.ac.jp/ekit/map/ohgigaoka.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Campus access ↗</a>
      <a href={withBase('/life-in-ishikawa/tempat-tinggal/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Checklist Tempat Tinggal →</a>
    </div>
  </section>
  <section id="transportasi-kampus" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-05" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">05 · Transportasi & kampus</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Ohgigaoka dan Yatsukaho perlu dipahami sebagai dua titik aktivitas yang berbeda.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Pahami akses khas kampus untuk commute harian. Tarif, jadwal, aturan sepeda, penggunaan IC card, dan kondisi musim dingin mengikuti operator serta panduan transportasi yang berlaku.</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Ohgigaoka</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Kampus utama berada di Nonoichi. Housing yang dekat walking/bicycle corridor sering lebih praktis daripada sekadar mencari alamat termurah.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Yatsukaho</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Research campus berada di Hakusan. KIT menyediakan shuttle antara Ohgigaoka dan Yatsukaho pada jadwal operasional tertentu.</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-950">Dari Kanazawa</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Akses bus dari Kanazawa Station tersedia, tetapi route dan timetable berubah. Gunakan halaman access resmi saat merencanakan perjalanan.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kanazawa-it.ac.jp/ekit/map/ohgigaoka.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Ohgigaoka Campus ↗</a>
      <a href="https://www.kanazawa-it.ac.jp/ekit/map/yatsukaho.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Yatsukaho Campus ↗</a>
      <a href={withBase('/life-in-ishikawa/transportasi/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Panduan Transportasi →</a>
    </div>
  </section>
  <section id="kesehatan-counseling" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-06" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">06 · Kesehatan & counseling</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">KIT punya layanan kampus dan bantuan medis multilingual tertentu.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-3">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Health Center</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Health Center berada di Ohgigaoka dan menyediakan basic medical/health support untuk mahasiswa sesuai sistem kampus.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">Counseling Center</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Counseling Center menerima konsultasi terkait interpersonal, daily life, dan psychological concerns serta dapat menghubungkan mahasiswa dengan dukungan lain.</p>
      </article>
      <article class="rounded-3xl border border-accent/35 bg-accent/10 p-6">
        <h3 class="font-bold text-slate-950">Multilingual medical assistance</h3>
        <p class="mt-3 text-sm leading-6 text-slate-700">KIT mempublikasikan Inbound Medical Assistance Service bagi kategori pengguna terdaftar. Bahasa Indonesia termasuk dalam daftar bahasa layanan. Eligibility harus dikonfirmasi menurut status/program.</p>
      </article>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kanazawa-it.ac.jp/ekit/life/facilities/index.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Campus facilities ↗</a>
      <a href="https://www.kanazawa-it.ac.jp/ekit/exchanges/pdf/handbook.pdf" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Medical assistance handbook ↗</a>
      <a href={withBase('/life-in-ishikawa/kesehatan/')} class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">SG07 · Kesehatan →</a>
    </div>
  </section>

  <section id="bahasa-international-life" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-07" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">07 · Bahasa Jepang & international support</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Program bahasa Jepang tersedia, tetapi formatnya bergantung pada jalur international program.</h2>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">KIT Japanese Language Program</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">KIT menjalankan Japanese Language Program dalam kerangka international exchange, termasuk summer program untuk mahasiswa partner institutions. Jangan menganggap semua kelas otomatis terbuka untuk setiap kategori mahasiswa internasional.</p>
        <a href="https://www.kanazawa-it.ac.jp/international/ijst.html" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Japanese education program ↗</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <h3 class="font-bold text-slate-950">International Programs Center</h3>
        <p class="mt-3 text-sm leading-6 text-slate-600">Center for International Programs mengelola berbagai kegiatan exchange/international programs serta menjadi jalur penting bagi incoming students yang membutuhkan guidance program-specific.</p>
        <a href="https://www.kanazawa-it.ac.jp/ekit/exchanges/center.html" target="_blank" rel="noreferrer" class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Center for International Programs ↗</a>
      </article>
    </div>
  </section>

  <section id="akademik-proyek-karier" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-08" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">08 · Academic, project & career</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">KIT kuat pada project-based learning dan career support.</h2>
    <div class="mt-7 grid gap-4 md:grid-cols-3">
      {[
        ['Academic & research', 'Graduate students mengikuti program, laboratory, supervisor, dan academic procedures masing-masing. Gunakan informasi program resmi untuk requirement dan milestone.'],
        ['Projects & facilities', 'KIT menonjolkan fasilitas seperti Yumekobo, Challenge Lab, Library Center, Innovation & Design Studio, dan berbagai research facilities sebagai bagian dari learning environment.'],
        ['Career', 'Career Planning and Placement Services menyediakan career advice, mock interviews, résumé review, employer information, events, internship support, dan layanan terkait employment.']
      ].map(([title,desc]) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5">
          <h3 class="font-bold text-slate-950">{title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{desc}</p>
        </article>
      ))}
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="https://www.kanazawa-it.ac.jp/ekit/education/curriculum/graduate/index.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Graduate programs ↗</a>
      <a href="https://www.kanazawa-it.ac.jp/career/index.html" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Career center ↗</a>
    </div>
  </section>

    <CampusGuideBridge
    id="keluarga-daily-life"
    number="09"
    eyebrow="Keluarga & daily life"
    title="Untuk kehidupan keluarga, alamat tempat tinggal lebih penting daripada nama kampus."
    summary="Panduan kampus tidak perlu mengulang aturan childcare, sekolah, sampah, layanan kesehatan keluarga, atau administrasi lokal. Detail tersebut mengikuti municipality tempat Anda tinggal."
    campusNote="KIT tetap menjadi titik awal untuk pertanyaan yang berkaitan dengan status mahasiswa, dukungan kampus, dan layanan international student; kebutuhan lokal diarahkan ke municipality."
    links={[
      { label: 'Keluarga & Anak', href: '/life-in-ishikawa/family-anak/', icon: 'family' },
      { label: 'Panduan Nonoichi', href: '/life-in-ishikawa/municipality-guides/#nonoichi', icon: 'city' }
    ]}
  />
  <section id="faq" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <span id="bagian-10" class="sr-only" aria-hidden="true"></span>
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">10 · FAQ mahasiswa Indonesia</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">Pertanyaan tambahan yang perlu konteks khusus KIT.</h2>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">FAQ hanya menyimpan pertanyaan yang tidak sudah dijelaskan pada housing, transport, support, academic, atau section kampus lainnya.</p>
    <div class="mt-6 space-y-3">
      {priorityFaq.map((item, index) => (
        <details id={`faq-${item.id}`} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-5">
          <span id={`faq-${String(index + 1).padStart(2, '0')}`} class="sr-only" aria-hidden="true"></span>
          <summary class="cursor-pointer font-bold text-slate-950">{item.q}</summary>
          <p class="mt-3 text-sm leading-6 text-slate-600"><ContextualText text={item.a} maxLinks={2} /></p>
          <CampusFaqGuideLinks campusSlug="kanazawa-institute-of-technology" question={item.q} answer={item.a} />
        </details>
      ))}
    </div>
  </section>

  <CampusScholarshipGuide campusSlug="kanazawa-institute-of-technology" />

  <CampusCareerGuide campusSlug="kanazawa-institute-of-technology" />

  <StoriesSection
    campusSlug="kanazawa-institute-of-technology"
    eyebrow="Cerita dari kampus"
    title="Cerita mahasiswa dan alumni dari kampus ini"
  />

  <CampusOfficialSources sources={kitPack.officialSources} lastVerified={kitPack.lastVerified} />

  <RelatedLinks
    items={campusRelatedContent['kanazawa-institute-of-technology']}
    eyebrow="Topik terkait"
    title="Lanjutkan ke informasi kampus dan kehidupan sehari-hari"
  />
</BaseLayout>
