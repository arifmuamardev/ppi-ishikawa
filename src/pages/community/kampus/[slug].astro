---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContextualText from '../../../components/ContextualText.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { campuses } from '../../../data/campuses';
import { withBase } from '../../../utils/paths';

export function getStaticPaths() {
  return campuses.filter((campus) => !['kanazawa-university', 'jaist', 'kanazawa-institute-of-technology', 'ishikawa-prefectural-university', 'kinjo-university', 'alice-gakuen'].includes(campus.slug)).map((campus) => ({
    params: { slug: campus.slug },
    props: { campus }
  }));
}

const { campus } = Astro.props;
---

<BaseLayout
  title={campus.shortName}
  description={`Informasi ${campus.name} untuk komunitas PPI Ishikawa: profil, dukungan mahasiswa, link resmi, dan fokus panduan PPI.`}
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Komunitas', href: '/community/' }, { label: 'Campus Hub', href: '/community/kampus/' }, { label: campus.shortName }]} />
    <p class="mt-8 text-sm font-bold uppercase tracking-[0.18em] text-accent-dark">{campus.type} · {campus.city}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">{campus.name}</h1>
    {campus.japanese && <p class="mt-3 text-lg text-slate-500">{campus.japanese}</p>}
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600"><ContextualText text={campus.summary} maxLinks={2} /></p>

    <div class="mt-7 flex flex-wrap gap-3">
      <span class="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white">{campus.city}</span>
      <span class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700">{campus.type}</span>
      <span class="rounded-full border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold text-accent-dark">Anggota PPI tercatat · {campus.censusDate}</span>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Informasi resmi</p>
        <h2 class="mt-3 text-2xl font-bold text-slate-950">Hal yang perlu diketahui.</h2>
        <ul class="mt-5 space-y-3">
          {campus.officialFacts.map((fact) => (
            <li class="flex gap-3 text-sm leading-6 text-slate-700">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
              <span>{fact}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">Kebutuhan mahasiswa</p>
        <h2 class="mt-3 text-2xl font-bold">Hal yang paling relevan untuk kehidupan kampus.</h2>
        <ul class="mt-5 space-y-3">
          {campus.ppiFocus.map((item) => (
            <li class="flex gap-3 text-sm leading-6 text-slate-300">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-soft"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Link resmi kampus</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Mulai dari sumber kampus yang benar.</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {campus.officialLinks.map((link) => (
          <a href={link.url} target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 p-4 text-sm font-bold text-slate-800 transition hover:border-slate-400 hover:bg-slate-50">
            {link.label} ↗
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-20 pt-10 lg:px-8">
    <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-dark">Konteks lokal</p>
      <h2 class="mt-3 text-xl font-bold text-slate-950">Bedakan aturan resmi dan pengalaman praktis.</h2>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-700">
        Gunakan sumber kampus untuk aturan dan prosedur resmi. Pengalaman anggota tentang housing, transportasi, administrasi, dan fasilitas dapat membantu sebagai konteks praktis setelah informasinya diverifikasi.
      </p>
    </div>
  </section>
</BaseLayout>
