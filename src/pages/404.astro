---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan di website PPI Ishikawa.">
  <section class="mx-auto max-w-3xl px-5 py-24 text-center lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">404</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950">Halaman tidak ditemukan.</h1>
    <p class="mt-5 leading-7 text-slate-600">Link mungkin berubah atau halaman belum tersedia. Kembali ke beranda atau buka Ishikawa Survival Guide.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={withBase('/')} class="rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white">Beranda</a>
      <a href={withBase('/life-in-ishikawa/')} class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800">Survival Guide</a>
    </div>
  </section>
</BaseLayout>
