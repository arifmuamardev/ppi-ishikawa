---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerificationShell from '../../components/VerificationShell.astro';
---

<BaseLayout title="Verifikasi Kartu Anggota" description="Verifikasi kartu anggota digital PPI Ishikawa.">
  <VerificationShell
    title="Kartu Anggota PPI Ishikawa"
    description="Periksa keaslian dan status kartu anggota digital PPI Ishikawa."
  >
    <div id="verify-loading" role="status" aria-live="polite" class="mt-8 rounded-2xl bg-slate-50 p-6 text-sm text-slate-600">Memeriksa token kartu…</div>
    <div id="verify-invalid" role="alert" class="mt-8 hidden rounded-2xl border border-red-200 bg-red-50 p-6">
        <p class="font-bold text-red-900">Kartu tidak dapat diverifikasi.</p>
        <p class="mt-2 text-sm leading-6 text-red-800">Token tidak ditemukan, sudah diganti, atau kartu tidak lagi valid.</p>
      </div>
    <div id="verify-result" aria-live="polite" class="mt-8 hidden">
        <div class="flex items-center justify-between gap-3">
          <p id="verify-name" class="text-2xl font-bold text-slate-950">—</p>
          <span id="verify-badge" class="rounded-full px-3 py-1.5 text-xs font-bold">—</span>
        </div>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-slate-50 p-4">
            <dt class="type-meta uppercase tracking-[0.1em] text-slate-500">Nomor kartu</dt>
            <dd id="verify-number" class="mt-2 font-mono font-bold text-slate-900">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4">
            <dt class="type-meta uppercase tracking-[0.1em] text-slate-500">Kampus</dt>
            <dd id="verify-campus" class="mt-2 font-bold text-slate-900">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4">
            <dt class="type-meta uppercase tracking-[0.1em] text-slate-500">Status</dt>
            <dd id="verify-status" class="mt-2 font-bold text-slate-900">—</dd>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4">
            <dt class="type-meta uppercase tracking-[0.1em] text-slate-500">Terbit</dt>
            <dd id="verify-issued" class="mt-2 font-bold text-slate-900">—</dd>
          </div>
        </dl>
        <p class="mt-6 text-xs leading-5 text-slate-500">Halaman ini hanya memverifikasi status kartu. Informasi kontak dan data pribadi lain tidak ditampilkan.</p>
    </div>
  </VerificationShell>

  <script>
    import { campuses } from '../../data/campuses';
    import { verifyMembershipCard } from '../../lib/member-advanced';

    const token = new URLSearchParams(window.location.search).get('token') || '';
    const loading = document.getElementById('verify-loading');
    const invalid = document.getElementById('verify-invalid');
    const result = document.getElementById('verify-result');

    if (!token) {
      loading?.classList.add('hidden');
      invalid?.classList.remove('hidden');
    } else {
      const { data, error } = await verifyMembershipCard(token);
      const card = data?.[0];
      loading?.classList.add('hidden');

      if (error || !card) {
        invalid?.classList.remove('hidden');
      } else {
        result?.classList.remove('hidden');
        const campus = campuses.find((item) => item.slug === card.campus_slug);
        const set = (id, text) => {
          const el = document.getElementById(id);
          if (el) el.textContent = text;
        };
        set('verify-name', card.full_name);
        set('verify-number', card.card_number);
        set('verify-campus', campus?.name || card.campus_slug || '—');
        set('verify-status', card.membership_status === 'alumni' ? 'Alumni' : 'Anggota aktif');
        set('verify-issued', new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(new Date(card.issued_at)));

        const badge = document.getElementById('verify-badge');
        if (badge) {
          badge.textContent = card.valid ? 'VALID' : 'TIDAK VALID';
          badge.className = card.valid
            ? 'rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700'
            : 'rounded-full bg-red-50 px-3 py-1.5 text-xs font-bold text-red-700';
        }
      }
    }
  </script>
</BaseLayout>
