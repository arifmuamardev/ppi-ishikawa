---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerificationShell from '../../components/VerificationShell.astro';
---

<BaseLayout title="Verifikasi Sertifikat" description="Verifikasi sertifikat PPI Ishikawa.">
  <VerificationShell
    eyebrow="Verifikasi Sertifikat"
    title="Verifikasi Sertifikat PPI Ishikawa"
    description="Periksa keaslian dan status sertifikat yang diterbitkan PPI Ishikawa."
  >

    <div id="cert-loading" role="status" aria-live="polite" class="mt-8 rounded-2xl bg-slate-50 p-6 text-sm text-slate-600">Memeriksa sertifikat…</div>
    <div id="cert-invalid" role="alert" class="mt-8 hidden rounded-2xl border border-red-200 bg-red-50 p-6">
        <p class="font-bold text-red-900">Sertifikat tidak ditemukan atau token tidak valid.</p>
      </div>

    <div id="cert-result" aria-live="polite" class="mt-8 hidden">
        <div class="flex items-center justify-between gap-3">
          <span id="cert-badge" class="rounded-full px-3 py-1.5 text-xs font-bold">—</span>
          <span id="cert-number" class="font-mono text-sm font-bold text-slate-500">—</span>
        </div>
        <h2 id="cert-title" class="type-section mt-6 text-slate-950">—</h2>
        <p id="cert-name" class="mt-3 text-lg font-semibold text-slate-800">—</p>
        <p id="cert-description" class="mt-4 text-sm leading-7 text-slate-600"></p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="type-meta uppercase tracking-[0.1em] text-slate-500">Kegiatan</p>
            <p id="cert-event" class="mt-2 font-semibold text-slate-900">—</p>
          </div>
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="type-meta uppercase tracking-[0.1em] text-slate-500">Tanggal terbit</p>
            <p id="cert-issued" class="mt-2 font-semibold text-slate-900">—</p>
          </div>
        </div>
    </div>
  </VerificationShell>

  <script>
    import { verifyCertificate } from '../../lib/member-advanced';

    const token = new URLSearchParams(window.location.search).get('token') || '';
    const loading = document.getElementById('cert-loading');
    const invalid = document.getElementById('cert-invalid');
    const result = document.getElementById('cert-result');

    const set = (id, text) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    if (!token) {
      loading?.classList.add('hidden');
      invalid?.classList.remove('hidden');
    } else {
      const { data, error } = await verifyCertificate(token);
      const cert = data?.[0];
      loading?.classList.add('hidden');

      if (error || !cert) {
        invalid?.classList.remove('hidden');
      } else {
        result?.classList.remove('hidden');
        set('cert-number', cert.certificate_number);
        set('cert-title', cert.title);
        set('cert-name', cert.full_name);
        set('cert-description', cert.description || '');
        set('cert-event', cert.event_title || '—');
        set('cert-issued', new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(new Date(cert.issued_at)));

        const badge = document.getElementById('cert-badge');
        if (badge) {
          badge.textContent = cert.valid ? 'VALID' : 'DICABUT';
          badge.className = cert.valid
            ? 'rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700'
            : 'rounded-full bg-red-50 px-3 py-1.5 text-xs font-bold text-red-700';
        }
      }
    }
  </script>
</BaseLayout>
