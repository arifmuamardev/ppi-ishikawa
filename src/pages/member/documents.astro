---
import MemberLayout from '../../layouts/MemberLayout.astro';
import AppPageHeader from '../../components/AppPageHeader.astro';
---

<MemberLayout title="Dokumen Anggota" requireApproved={true}>
  <div class="space-y-6">
    <AppPageHeader
      eyebrow="Dokumen"
      title="Dokumen untuk anggota"
      description="Dokumen di halaman ini disimpan pada private storage. Tautan unduhan bersifat sementara dan akses mengikuti kategori audiens dokumen."
    />

    <div id="document-message" class="hidden rounded-2xl border p-4 text-sm leading-6"></div>
    <div id="document-empty" role="status" aria-live="polite" class="hidden rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-600">Belum ada dokumen yang tersedia untuk akun Anda.</div>
    <section id="document-list" class="grid gap-4 lg:grid-cols-2"></section>
  </div>

  <script>
    import { getDocumentDownloadUrl, getMemberDocuments } from '../../lib/member-advanced';

    const list = document.getElementById('document-list');
    const empty = document.getElementById('document-empty');
    const message = document.getElementById('document-message');

    const show = (text, error = false) => {
      if (!message) return;
      message.textContent = text;
      message.className = `rounded-2xl border p-4 text-sm leading-6 ${error ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-900'}`;
    };

    const { data, error } = await getMemberDocuments();
    const documents = error ? [] : (data || []);
    empty?.classList.toggle('hidden', documents.length !== 0);

    for (const document of documents) {
      const card = document.createElement('article');
      card.className = 'rounded-2xl border border-slate-200 bg-white p-6';

      const badge = document.createElement('span');
      badge.className = 'rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-600';
      badge.textContent = document.audience === 'verified' ? 'Semua anggota terverifikasi' : document.audience === 'officers' ? 'Pengurus' : 'Alumni';

      const h = document.createElement('h2');
      h.className = 'mt-4 text-xl font-bold text-slate-950';
      h.textContent = document.title;

      const p = document.createElement('p');
      p.className = 'mt-2 text-sm leading-6 text-slate-600';
      p.textContent = document.description || 'Dokumen internal PPI Ishikawa.';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'mt-5 rounded-xl bg-brand px-4 py-2.5 text-sm font-bold text-white';
      button.textContent = 'Unduh dokumen';
      button.addEventListener('click', async () => {
        button.disabled = true;
        button.textContent = 'Menyiapkan…';
        const { data: signed, error: signedError } = await getDocumentDownloadUrl(document.storage_path);
        if (signedError || !signed?.signedUrl) {
          show('Dokumen belum dapat diunduh.', true);
          button.disabled = false;
          button.textContent = 'Unduh dokumen';
          return;
        }
        window.location.href = signed.signedUrl;
        button.disabled = false;
        button.textContent = 'Unduh dokumen';
      });

      card.append(badge, h, p, button);
      list?.append(card);
    }
  </script>
</MemberLayout>
