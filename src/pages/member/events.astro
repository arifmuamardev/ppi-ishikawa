---
import MemberLayout from '../../layouts/MemberLayout.astro';
import AppPageHeader from '../../components/AppPageHeader.astro';
---

<MemberLayout title="Agenda Anggota" requireApproved={true}>
  <div class="space-y-6">
    <AppPageHeader
      eyebrow="Agenda"
      title="Kegiatan PPI Ishikawa"
      description="Lihat kegiatan mendatang, tandai kehadiran, dan tambahkan agenda ke kalender pribadi."
    />

    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <div class="grid gap-3 md:grid-cols-2">
        <label>
          <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Kategori</span>
          <select id="event-category" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-900">
            <option value="">Semua kategori</option>
            <option>Akademik</option>
            <option>Karier</option>
            <option>Komunitas</option>
            <option>Olahraga</option>
          </select>
        </label>
        <label>
          <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Kehadiran saya</span>
          <select id="event-rsvp-filter" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-900">
            <option value="">Semua</option>
            <option value="yes">Saya akan hadir</option>
            <option value="no">Belum RSVP</option>
          </select>
        </label>
      </div>
      <div class="mt-4 flex items-center justify-between gap-3">
        <button id="event-reset" type="button" class="ui-action-secondary">Reset</button>
        <p id="event-count" class="text-sm font-semibold text-slate-500" aria-live="polite" aria-atomic="true">Memuat…</p>
      </div>
    </section>

    <div id="event-error" class="hidden rounded-2xl border border-red-200 bg-red-50 p-5 text-sm text-red-800"></div>
    <div id="event-empty" role="status" aria-live="polite" class="hidden rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
      <p class="font-bold text-slate-950">Tidak ada kegiatan untuk filter ini.</p>
    </div>
    <section id="event-list" class="space-y-4"></section>
  </div>

  <script>
    import { getMemberEvents, getRsvps, googleCalendarUrl, setRsvp } from '../../lib/member-community';

    const list = document.getElementById('event-list');
    const empty = document.getElementById('event-empty');
    const errorBox = document.getElementById('event-error');
    const count = document.getElementById('event-count');
    const category = document.getElementById('event-category');
    const rsvpFilter = document.getElementById('event-rsvp-filter');
    const reset = document.getElementById('event-reset');

    let events = [];
    let rsvps = {};

    const formatDate = (value) => new Intl.DateTimeFormat('id-ID', {
      dateStyle: 'full',
      timeStyle: 'short',
      timeZone: 'Asia/Tokyo',
    }).format(new Date(value));

    const node = (tag, className, text) => {
      const el = document.createElement(tag);
      if (className) el.className = className;
      if (text !== undefined && text !== null) el.textContent = text;
      return el;
    };

    const render = () => {
      if (!list) return;
      list.replaceChildren();

      const categoryValue = category instanceof HTMLSelectElement ? category.value : '';
      const rsvpValue = rsvpFilter instanceof HTMLSelectElement ? rsvpFilter.value : '';

      const filtered = events.filter((event) => {
        const categoryOk = !categoryValue || event.category === categoryValue;
        const attending = rsvps[event.id] === true;
        const rsvpOk = !rsvpValue || (rsvpValue === 'yes' ? attending : !attending);
        return categoryOk && rsvpOk;
      });

      if (count) count.textContent = `${filtered.length} kegiatan`;
      empty?.classList.toggle('hidden', filtered.length !== 0);

      for (const event of filtered) {
        const card = node('article', 'rounded-2xl border border-slate-200 bg-white p-6 sm:p-7');
        const header = node('div', 'flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between');
        const info = node('div', 'max-w-3xl');
        const badges = node('div', 'flex flex-wrap gap-2');
        badges.append(node('span', 'rounded-full bg-accent/10 px-3 py-1 text-[11px] font-bold text-accent-dark', event.category));
        badges.append(node('span', 'rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-600', event.mode === 'onsite' ? 'Onsite' : event.mode === 'online' ? 'Online' : 'Hybrid'));
        if (rsvps[event.id] === true) badges.append(node('span', 'rounded-full bg-emerald-50 px-3 py-1 text-[11px] font-bold text-emerald-700', 'RSVP: Hadir'));
        info.append(badges);
        info.append(node('h2', 'mt-4 text-xl font-bold text-slate-950', event.title));
        info.append(node('p', 'mt-2 text-sm leading-6 text-slate-600', event.description));

        const meta = node('div', 'mt-4 grid gap-2 text-sm text-slate-600 sm:grid-cols-2');
        meta.append(node('p', '', formatDate(event.starts_at)));
        meta.append(node('p', '', event.location));
        if (event.capacity) meta.append(node('p', '', `Kapasitas: ${event.capacity} orang`));
        if (event.registration_deadline) meta.append(node('p', '', `Batas RSVP: ${formatDate(event.registration_deadline)}`));
        info.append(meta);

        const controls = node('div', 'flex shrink-0 flex-col gap-2 sm:flex-row lg:flex-col');
        const attending = rsvps[event.id] === true;
        const rsvpButton = node('button', attending
          ? 'rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700'
          : 'rounded-xl bg-brand px-4 py-2.5 text-sm font-bold text-white',
          attending ? 'Batalkan RSVP' : 'Saya akan hadir');
        rsvpButton.type = 'button';
        rsvpButton.addEventListener('click', async () => {
          await setRsvp(event.id, !attending);
          rsvps[event.id] = !attending;
          render();
        });

        const calendar = node('a', 'rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-bold text-slate-700 hover:text-brand', 'Tambah ke kalender ↗');
        calendar.href = googleCalendarUrl(event);
        calendar.target = '_blank';
        calendar.rel = 'noreferrer';

        controls.append(rsvpButton, calendar);
        header.append(info, controls);
        card.append(header);
        list.append(card);
      }
    };

    const load = async () => {
      const [eventResult, rsvpResult] = await Promise.all([getMemberEvents(), getRsvps()]);
      if (eventResult.error) {
        if (errorBox) {
          errorBox.textContent = 'Agenda belum dapat dimuat.';
          errorBox.classList.remove('hidden');
        }
        return;
      }
      events = eventResult.data || [];
      rsvps = rsvpResult || {};
      render();
    };

    category?.addEventListener('change', render);
    rsvpFilter?.addEventListener('change', render);
    reset?.addEventListener('click', () => {
      if (category instanceof HTMLSelectElement) category.value = '';
      if (rsvpFilter instanceof HTMLSelectElement) rsvpFilter.value = '';
      render();
    });

    load();
  </script>
</MemberLayout>
