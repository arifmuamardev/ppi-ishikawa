---
import MemberLayout from '../../layouts/MemberLayout.astro';
---

<MemberLayout title="Pengumuman Anggota" requireApproved={true}>
  <div class="space-y-6">
    <section>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Pengumuman</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Informasi untuk anggota</h1>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">Pengumuman kegiatan, membership, kampus, dan informasi internal yang relevan.</p>
    </section>

    <section id="announcement-list" class="space-y-4"></section>
  </div>

  <script>
    import { getAnnouncements } from '../../lib/member-community';

    const list = document.getElementById('announcement-list');
    const { data } = await getAnnouncements();

    const formatDate = (value) => new Intl.DateTimeFormat('id-ID', {
      dateStyle: 'long',
      timeZone: 'Asia/Tokyo',
    }).format(new Date(value));

    for (const item of data || []) {
      const article = document.createElement('article');
      article.className = item.important
        ? 'rounded-3xl border border-accent/35 bg-accent/10 p-6 sm:p-7'
        : 'rounded-3xl border border-slate-200 bg-white p-6 sm:p-7';

      const meta = document.createElement('div');
      meta.className = 'flex flex-wrap gap-2';
      for (const label of [item.category, item.audience, formatDate(item.published_at)]) {
        const badge = document.createElement('span');
        badge.className = 'rounded-full bg-white/80 px-3 py-1 text-[11px] font-bold text-slate-600';
        badge.textContent = label;
        meta.append(badge);
      }

      const heading = document.createElement('h2');
      heading.className = 'mt-4 text-xl font-bold text-slate-950';
      heading.textContent = item.title;

      const body = document.createElement('p');
      body.className = 'mt-3 max-w-3xl text-sm leading-7 text-slate-600';
      body.textContent = item.body;

      article.append(meta, heading, body);
      list?.append(article);
    }
  </script>
</MemberLayout>
