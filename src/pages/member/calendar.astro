---
import MemberLayout from '../../layouts/MemberLayout.astro';
import AppPageHeader from '../../components/AppPageHeader.astro';
---

<MemberLayout title="Kalender Anggota" requireApproved={true}>
  <div class="space-y-6">
    <AppPageHeader
      eyebrow="Kalender"
      title="Agenda dalam satu tampilan"
      description="Lihat kegiatan berdasarkan bulan dan tambahkan acara yang relevan ke Google Calendar."
    />

    <section class="rounded-2xl border border-slate-200 bg-white p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <button id="calendar-prev" type="button" class="ui-action-secondary">← Bulan sebelumnya</button>
        <h2 id="calendar-title" class="text-xl font-bold text-slate-950">Kalender</h2>
        <button id="calendar-next" type="button" class="ui-action-secondary">Bulan berikutnya →</button>
      </div>
      <div id="calendar-events" class="mt-6 space-y-3"></div>
      <div id="calendar-empty" role="status" aria-live="polite" class="mt-6 hidden rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-600">Tidak ada kegiatan pada bulan ini.</div>
    </section>
  </div>

  <script>
    import { getMemberEvents, googleCalendarUrl } from '../../lib/member-community';

    const title = document.getElementById('calendar-title');
    const list = document.getElementById('calendar-events');
    const empty = document.getElementById('calendar-empty');
    const prev = document.getElementById('calendar-prev');
    const next = document.getElementById('calendar-next');
    let cursor = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
    let events = [];

    const render = () => {
      const year = cursor.getFullYear();
      const month = cursor.getMonth();
      if (title) title.textContent = new Intl.DateTimeFormat('id-ID', { month: 'long', year: 'numeric' }).format(cursor);
      if (!list) return;
      list.replaceChildren();

      const matches = events.filter((event) => {
        const date = new Date(event.starts_at);
        return date.getFullYear() === year && date.getMonth() === month;
      });

      empty?.classList.toggle('hidden', matches.length !== 0);

      for (const event of matches) {
        const row = document.createElement('article');
        row.className = 'grid gap-4 rounded-2xl border border-slate-200 p-5 sm:grid-cols-[90px_1fr_auto] sm:items-center';

        const when = document.createElement('div');
        const date = new Date(event.starts_at);
        when.innerHTML = `<p class="text-3xl font-bold text-slate-950">${new Intl.DateTimeFormat('id-ID', { day: '2-digit', timeZone: 'Asia/Tokyo' }).format(date)}</p><p class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">${new Intl.DateTimeFormat('id-ID', { weekday: 'short', timeZone: 'Asia/Tokyo' }).format(date)}</p>`;

        const info = document.createElement('div');
        const h = document.createElement('h3');
        h.className = 'font-bold text-slate-950';
        h.textContent = event.title;
        const p = document.createElement('p');
        p.className = 'mt-1 text-sm text-slate-600';
        p.textContent = `${new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Tokyo' }).format(date)} · ${event.location} · ${event.category}`;
        info.append(h, p);

        const link = document.createElement('a');
        link.className = 'text-sm font-bold text-brand hover:underline';
        link.textContent = 'Google Calendar ↗';
        link.href = googleCalendarUrl(event);
        link.target = '_blank';
        link.rel = 'noreferrer';

        row.append(when, info, link);
        list.append(row);
      }
    };

    const { data } = await getMemberEvents();
    events = data || [];
    render();

    prev?.addEventListener('click', () => {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1);
      render();
    });
    next?.addEventListener('click', () => {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
      render();
    });
  </script>
</MemberLayout>
