---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { withBase } from '../../utils/paths';
---

<MemberLayout title="Dashboard Anggota">
  <div class="space-y-6">
    <section class="rounded-[2rem] bg-slate-950 p-7 text-white sm:p-9">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">Dashboard Anggota</p>
      <h1 class="mt-3 text-3xl font-bold">Halo, <span id="dashboard-name">Anggota PPI Ishikawa</span></h1>
      <p id="dashboard-summary" class="mt-3 max-w-3xl leading-7 text-slate-300">Memuat profil keanggotaan Anda…</p>
    </section>

    <section id="verification-card" class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Status membership</p>
          <h2 id="verification-title" class="mt-2 text-xl font-bold text-slate-950">Memeriksa status…</h2>
          <p id="verification-copy" class="mt-2 max-w-2xl text-sm leading-6 text-slate-600"></p>
        </div>
        <span id="verification-badge" class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">—</span>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Profil</p>
        <p class="mt-3 text-3xl font-bold text-slate-950"><span id="profile-completion">0</span>%</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Lengkapi profil agar data membership lebih akurat.</p>
        <a href={withBase('/member/profile/')} class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Kelola profil →</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Direktori</p>
        <p id="directory-state" class="mt-3 text-xl font-bold text-slate-950">—</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Anda mengontrol apakah profil dapat ditemukan anggota lain.</p>
        <a href={withBase('/member/directory/')} class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Buka direktori →</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Kampus</p>
        <p id="dashboard-campus" class="mt-3 text-xl font-bold text-slate-950">—</p>
        <p id="dashboard-program" class="mt-2 text-sm leading-6 text-slate-600">—</p>
      </article>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">Akses cepat</p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        <a href={withBase('/member/profile/')} class="rounded-2xl bg-slate-50 p-5 font-bold text-slate-900 hover:bg-amber-50 hover:text-brand">Profil & privasi →</a>
        <a href={withBase('/member/directory/')} class="rounded-2xl bg-slate-50 p-5 font-bold text-slate-900 hover:bg-amber-50 hover:text-brand">Direktori anggota →</a>
        <a href={withBase('/community/kampus/')} class="rounded-2xl bg-slate-50 p-5 font-bold text-slate-900 hover:bg-amber-50 hover:text-brand">Campus Hub →</a>
      </div>
    </section>
  </div>

  <script>
    import { campuses } from '../../data/campuses';
    import { getCurrentMember, profileCompletion } from '../../lib/member';

    {
      const member = await getCurrentMember();
      const profile = member.profile;
      if (profile) {
        const campus = campuses.find((item) => item.slug === profile.campus_slug);
        const name = document.getElementById('dashboard-name');
        const summary = document.getElementById('dashboard-summary');
        const title = document.getElementById('verification-title');
        const copy = document.getElementById('verification-copy');
        const badge = document.getElementById('verification-badge');

        if (name) name.textContent = profile.full_name || 'Anggota PPI Ishikawa';
        if (summary) summary.textContent = [campus?.shortName, profile.program, profile.study_level].filter(Boolean).join(' · ') || 'Lengkapi profil membership Anda.';

        const state = {
          pending: ['Menunggu verifikasi pengurus', 'Pendaftaran Anda sudah tersimpan. Anda masih dapat melengkapi profil sambil menunggu pengurus memverifikasi membership.', 'Menunggu'],
          approved: ['Membership terverifikasi', 'Akun Anda sudah terverifikasi dan dapat menggunakan fitur anggota sesuai status membership.', 'Terverifikasi'],
          rejected: ['Verifikasi memerlukan tindak lanjut', 'Periksa kembali profil Anda atau hubungi pengurus PPI Ishikawa bila data perlu diperbaiki.', 'Tindak lanjut'],
        }[profile.verification_status];

        if (title) title.textContent = state[0];
        if (copy) copy.textContent = state[1];
        if (badge) badge.textContent = state[2];

        const completion = document.getElementById('profile-completion');
        if (completion) completion.textContent = String(profileCompletion(profile));

        const directory = document.getElementById('directory-state');
        if (directory) directory.textContent = profile.directory_visible ? 'Ditampilkan' : 'Tidak ditampilkan';

        const campusEl = document.getElementById('dashboard-campus');
        if (campusEl) campusEl.textContent = campus?.shortName || 'Belum dipilih';
        const programEl = document.getElementById('dashboard-program');
        if (programEl) programEl.textContent = profile.program || 'Program belum diisi';
      }
    }
  </script>
</MemberLayout>
