---
import MemberLayout from '../../layouts/MemberLayout.astro';
---

<MemberLayout title="Volunteer" requireApproved={true}>
  <div class="space-y-6">
    <section>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Volunteer</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Kontribusi sesuai minat Anda</h1>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">Lihat kebutuhan volunteer yang sedang dibuka. Menyatakan minat tidak otomatis menjadikan Anda panitia; pengurus akan menindaklanjuti bila sesuai.</p>
    </section>

    <div id="volunteer-message" class="hidden rounded-2xl border p-4 text-sm leading-6"></div>
    <div id="volunteer-empty" class="hidden rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-600">Belum ada kesempatan volunteer yang dibuka.</div>
    <section id="volunteer-list" class="space-y-5"></section>
  </div>

  <script>
    import {
      applyForVolunteer,
      getMyVolunteerApplications,
      getVolunteerOpportunities,
      withdrawVolunteerApplication,
    } from '../../lib/member-organization';

    const list = document.getElementById('volunteer-list');
    const empty = document.getElementById('volunteer-empty');
    const messageBox = document.getElementById('volunteer-message');
    let opportunities = [];
    let applications = [];

    const show = (text, error = false) => {
      if (!messageBox) return;
      messageBox.textContent = text;
      messageBox.className = `rounded-2xl border p-4 text-sm leading-6 ${error ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-900'}`;
    };

    const statusLabels = {
      interested: 'Tertarik',
      selected: 'Dipilih',
      not_selected: 'Belum dipilih',
      withdrawn: 'Dibatalkan',
    };

    const render = () => {
      if (!list) return;
      list.replaceChildren();
      const items = opportunities.filter((item) => item.status === 'open');
      empty?.classList.toggle('hidden', items.length !== 0);

      for (const item of items) {
        const application = applications.find((app) => app.opportunity_id === item.id);
        const card = document.createElement('article');
        card.className = 'rounded-3xl border border-slate-200 bg-white p-6 sm:p-7';

        const badges = document.createElement('div');
        badges.className = 'flex flex-wrap gap-2';
        for (const label of [
          item.organization_units?.name || 'Unit',
          item.slots ? `${item.slots} slot` : 'Slot fleksibel',
          application ? statusLabels[application.status] : 'Terbuka',
        ]) {
          const badge = document.createElement('span');
          badge.className = 'rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-600';
          badge.textContent = label;
          badges.append(badge);
        }

        const heading = document.createElement('h2');
        heading.className = 'mt-4 text-xl font-bold text-slate-950';
        heading.textContent = item.title;

        const description = document.createElement('p');
        description.className = 'mt-2 text-sm leading-7 text-slate-600';
        description.textContent = item.description;

        const tags = document.createElement('div');
        tags.className = 'mt-4 flex flex-wrap gap-2';
        for (const tag of [...(item.interests || []), ...(item.skills || [])]) {
          const span = document.createElement('span');
          span.className = 'rounded-full bg-amber-50 px-3 py-1 text-[11px] font-bold text-accent-dark';
          span.textContent = tag;
          tags.append(span);
        }

        const controls = document.createElement('div');
        controls.className = 'mt-5 border-t border-slate-100 pt-5';

        if (!application || application.status === 'withdrawn' || application.status === 'not_selected') {
          const textarea = document.createElement('textarea');
          textarea.rows = 3;
          textarea.maxLength = 800;
          textarea.placeholder = 'Pesan singkat untuk pengurus (opsional)';
          textarea.className = 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900';

          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'mt-3 rounded-xl bg-brand px-5 py-2.5 text-sm font-bold text-white';
          button.textContent = 'Saya tertarik';
          button.addEventListener('click', async () => {
            const { error } = await applyForVolunteer(item.id, textarea.value.trim());
            if (error) return show('Minat volunteer belum dapat disimpan.', true);
            show('Minat volunteer berhasil disimpan.');
            await load();
          });
          controls.append(textarea, button);
        } else if (application.status === 'interested') {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-700';
          button.textContent = 'Batalkan minat';
          button.addEventListener('click', async () => {
            const { error } = await withdrawVolunteerApplication(item.id);
            if (error) return show('Minat belum dapat dibatalkan.', true);
            show('Minat volunteer dibatalkan.');
            await load();
          });
          controls.append(button);
        } else {
          const p = document.createElement('p');
          p.className = 'text-sm font-semibold text-slate-700';
          p.textContent = application.status === 'selected'
            ? 'Anda dipilih untuk kesempatan ini. Pengurus akan menghubungi Anda.'
            : statusLabels[application.status];
          controls.append(p);
        }

        card.append(badges, heading, description, tags, controls);
        list.append(card);
      }
    };

    const load = async () => {
      const [oppResult, appResult] = await Promise.all([
        getVolunteerOpportunities(),
        getMyVolunteerApplications(),
      ]);
      opportunities = oppResult.data || [];
      applications = appResult.data || [];
      render();
    };

    load();
  </script>
</MemberLayout>
