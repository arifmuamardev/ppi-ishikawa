---
import MemberLayout from '../../layouts/MemberLayout.astro';
import AppPageHeader from '../../components/AppPageHeader.astro';
---

<MemberLayout title="Mentoring" requireApproved={true}>
  <div class="space-y-6">
    <AppPageHeader
      eyebrow="Mentoring"
      title="Belajar dari sesama anggota & alumni"
      description="Mentoring bersifat opt-in. Anda dapat menawarkan pengalaman, mencari mentor, atau keduanya tanpa membuka email pribadi di direktori."
    />

    <div id="mentoring-message" class="hidden rounded-2xl border p-4 text-sm leading-6"></div>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <h2 class="text-xl font-bold text-slate-950">Preferensi mentoring saya</h2>
      <form id="mentoring-preference-form" class="mt-6 space-y-6">
        <div>
          <label class="flex items-start gap-3 rounded-2xl bg-accent/10 p-4">
            <input name="mentor_available" type="checkbox" class="ui-check mt-0.5" />
            <span><strong class="text-slate-950">Saya bersedia menjadi mentor</strong><span class="mt-1 block text-sm leading-6 text-slate-600">Profil Anda dapat muncul di daftar mentor untuk topik yang dipilih.</span></span>
          </label>
          <p class="mt-4 text-sm font-bold text-slate-800">Topik yang dapat saya bantu</p>
          <div id="mentor-topic-options" class="mt-3 grid gap-3 sm:grid-cols-2"></div>
        </div>

        <div class="border-t border-slate-100 pt-6">
          <label class="flex items-start gap-3 rounded-2xl bg-slate-50 p-4">
            <input name="seeking_mentor" type="checkbox" class="ui-check mt-0.5" />
            <span><strong class="text-slate-950">Saya sedang mencari mentor</strong><span class="mt-1 block text-sm leading-6 text-slate-600">Ini hanya preference pribadi dan tidak otomatis mengirim permintaan.</span></span>
          </label>
          <p class="mt-4 text-sm font-bold text-slate-800">Topik yang ingin saya pelajari</p>
          <div id="mentee-topic-options" class="mt-3 grid gap-3 sm:grid-cols-2"></div>
        </div>

        <div class="flex justify-end">
          <button class="ui-action-primary">Simpan preferensi</button>
        </div>
      </form>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="type-meta uppercase tracking-[0.12em] text-slate-500">Mentor Finder</p>
          <h2 class="mt-2 text-xl font-bold text-slate-950">Anggota yang bersedia berbagi</h2>
        </div>
        <p id="mentor-count" class="text-sm font-semibold text-slate-500" aria-live="polite" aria-atomic="true">Memuat…</p>
      </div>
      <div id="mentor-empty" role="status" aria-live="polite" class="mt-6 hidden rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-600">Belum ada mentor yang membuka availability.</div>
      <div id="mentor-grid" class="mt-6 grid gap-4 lg:grid-cols-2"></div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="type-meta uppercase tracking-[0.12em] text-slate-500">Riwayat</p>
      <h2 class="mt-2 text-xl font-bold text-slate-950">Permintaan mentoring</h2>
      <div id="mentoring-request-empty" class="mt-6 rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-600">Belum ada permintaan mentoring.</div>
      <div id="mentoring-request-list" class="mt-6 space-y-3"></div>
    </section>
  </div>

  <script>
    import { getCurrentMember } from '../../lib/member';
    import {
      createMentoringRequest,
      getGrowthPreferences,
      getMentorDirectory,
      getMyMentoringRequests,
      mentoringTopics,
      saveGrowthPreferences,
      updateMentoringRequestStatus,
    } from '../../lib/member-growth';

    const preferenceForm = document.getElementById('mentoring-preference-form');
    const messageBox = document.getElementById('mentoring-message');
    const mentorGrid = document.getElementById('mentor-grid');
    const mentorEmpty = document.getElementById('mentor-empty');
    const mentorCount = document.getElementById('mentor-count');
    const requestList = document.getElementById('mentoring-request-list');
    const requestEmpty = document.getElementById('mentoring-request-empty');

    const show = (text, error = false) => {
      if (!messageBox) return;
      messageBox.textContent = text;
      messageBox.className = `rounded-2xl border p-4 text-sm leading-6 ${error ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-900'}`;
    };

    const buildTopicOptions = (containerId, name) => {
      const container = document.getElementById(containerId);
      for (const topic of mentoringTopics) {
        const label = document.createElement('label');
        label.className = 'flex items-start gap-3 rounded-2xl bg-slate-50 p-4';
        const input = document.createElement('input');
        input.type = 'checkbox'; input.name = name; input.value = topic; input.className = 'mt-1 size-4';
        const text = document.createElement('span');
        text.className = 'text-sm font-semibold text-slate-700'; text.textContent = topic;
        label.append(input, text); container?.append(label);
      }
    };

    buildTopicOptions('mentor-topic-options', 'mentor_topics');
    buildTopicOptions('mentee-topic-options', 'mentee_topics');

    const prefResult = await getGrowthPreferences();
    const preferences = prefResult.data || {
      career_interests: [],
      mentor_available: false,
      mentor_topics: [],
      seeking_mentor: false,
      mentee_topics: [],
      story_willing: false,
      story_topics: [],
    };

    if (preferenceForm instanceof HTMLFormElement) {
      const mentorAvailable = preferenceForm.elements.namedItem('mentor_available');
      const seeking = preferenceForm.elements.namedItem('seeking_mentor');
      if (mentorAvailable instanceof HTMLInputElement) mentorAvailable.checked = preferences.mentor_available;
      if (seeking instanceof HTMLInputElement) seeking.checked = preferences.seeking_mentor;
    }

    for (const input of document.querySelectorAll('input[name="mentor_topics"]')) {
      if (input instanceof HTMLInputElement) input.checked = (preferences.mentor_topics || []).includes(input.value);
    }
    for (const input of document.querySelectorAll('input[name="mentee_topics"]')) {
      if (input instanceof HTMLInputElement) input.checked = (preferences.mentee_topics || []).includes(input.value);
    }

    const current = await getCurrentMember();

    const loadMentors = async () => {
      const { data, error } = await getMentorDirectory();
      if (error) return;
      const mentors = (data || []).filter((item) => item.user_id !== current.user?.id);
      if (mentorCount) mentorCount.textContent = `${mentors.length} mentor`;
      mentorEmpty?.classList.toggle('hidden', mentors.length !== 0);
      if (!mentorGrid) return;
      mentorGrid.replaceChildren();

      for (const mentor of mentors) {
        const card = document.createElement('article');
        card.className = 'rounded-2xl border border-slate-200 p-5';

        const h = document.createElement('h3');
        h.className = 'text-lg font-bold text-slate-950'; h.textContent = mentor.full_name;
        const meta = document.createElement('p');
        meta.className = 'mt-2 text-sm leading-6 text-slate-600';
        meta.textContent = [mentor.program, mentor.field_of_study, mentor.role_title, mentor.organization].filter(Boolean).join(' · ');
        const tags = document.createElement('div');
        tags.className = 'mt-4 flex flex-wrap gap-2';
        for (const topic of mentor.mentor_topics || []) {
          const tag = document.createElement('span');
          tag.className = 'rounded-full bg-accent/10 px-3 py-1 text-[11px] font-bold text-accent-dark';
          tag.textContent = topic; tags.append(tag);
        }

        const requestBox = document.createElement('div');
        requestBox.className = 'mt-5 border-t border-slate-100 pt-4';
        const topicSelect = document.createElement('select');
        topicSelect.className = 'w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm';
        for (const topic of mentor.mentor_topics || []) {
          const option = document.createElement('option'); option.value = topic; option.textContent = topic; topicSelect.append(option);
        }
        const textarea = document.createElement('textarea');
        textarea.rows = 3; textarea.maxLength = 1000; textarea.placeholder = 'Jelaskan singkat apa yang ingin Anda diskusikan.';
        textarea.className = 'mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm';
        const button = document.createElement('button');
        button.type = 'button'; button.className = 'mt-2 rounded-xl bg-brand px-4 py-2.5 text-sm font-bold text-white'; button.textContent = 'Kirim permintaan';
        button.addEventListener('click', async () => {
          const { error } = await createMentoringRequest(mentor.user_id, topicSelect.value, textarea.value.trim());
          if (error) return show('Permintaan mentoring belum dapat dikirim.', true);
          show('Permintaan mentoring berhasil dikirim.');
          textarea.value = '';
          await loadRequests();
        });
        requestBox.append(topicSelect, textarea, button);

        card.append(h, meta, tags, requestBox);
        mentorGrid.append(card);
      }
    };

    const loadRequests = async () => {
      const { data, error } = await getMyMentoringRequests();
      if (error) return;
      const items = data || [];
      requestEmpty?.classList.toggle('hidden', items.length !== 0);
      if (!requestList) return;
      requestList.replaceChildren();

      for (const item of items) {
        const incoming = item.mentor_id === current.user?.id;
        const card = document.createElement('article');
        card.className = 'rounded-2xl border border-slate-200 p-5';

        const h = document.createElement('h3');
        h.className = 'font-bold text-slate-950';
        h.textContent = incoming ? `Dari ${item.requester_name}` : `Ke ${item.mentor_name}`;

        const meta = document.createElement('p');
        meta.className = 'mt-1 text-xs font-bold uppercase tracking-[0.1em] text-slate-500';
        meta.textContent = `${item.topic} · ${item.status}`;

        const body = document.createElement('p');
        body.className = 'mt-3 text-sm leading-6 text-slate-600';
        body.textContent = item.message || 'Tanpa pesan tambahan.';

        card.append(h, meta, body);

        if (incoming && item.status === 'pending') {
          const controls = document.createElement('div');
          controls.className = 'mt-4 flex gap-2';
          for (const [status, label] of [['accepted','Terima'],['declined','Tolak']]) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = status === 'accepted'
              ? 'rounded-xl bg-brand px-4 py-2 text-sm font-bold text-white'
              : 'rounded-xl border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700';
            button.textContent = label;
            button.addEventListener('click', async () => {
              const { error } = await updateMentoringRequestStatus(item.id, status);
              if (error) return show('Status mentoring belum dapat diperbarui.', true);
              show('Status mentoring diperbarui.');
              await loadRequests();
            });
            controls.append(button);
          }
          card.append(controls);
        } else if (!incoming && ['pending','accepted'].includes(item.status)) {
          const close = document.createElement('button');
          close.type = 'button'; close.className = 'mt-4 rounded-xl border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700'; close.textContent = 'Tutup permintaan';
          close.addEventListener('click', async () => {
            const { error } = await updateMentoringRequestStatus(item.id, 'closed');
            if (error) return show('Permintaan belum dapat ditutup.', true);
            show('Permintaan mentoring ditutup.');
            await loadRequests();
          });
          card.append(close);
        }

        requestList.append(card);
      }
    };

    preferenceForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(preferenceForm instanceof HTMLFormElement)) return;
      const values = new FormData(preferenceForm);
      const mentorTopicsSelected = [...document.querySelectorAll('input[name="mentor_topics"]:checked')].map((input) => input.value);
      const menteeTopicsSelected = [...document.querySelectorAll('input[name="mentee_topics"]:checked')].map((input) => input.value);
      const { error } = await saveGrowthPreferences({
        ...preferences,
        mentor_available: values.get('mentor_available') === 'on',
        mentor_topics: mentorTopicsSelected,
        seeking_mentor: values.get('seeking_mentor') === 'on',
        mentee_topics: menteeTopicsSelected,
      });
      if (error) return show('Preferensi mentoring belum dapat disimpan.', true);
      Object.assign(preferences, {
        mentor_available: values.get('mentor_available') === 'on',
        mentor_topics: mentorTopicsSelected,
        seeking_mentor: values.get('seeking_mentor') === 'on',
        mentee_topics: menteeTopicsSelected,
      });
      show('Preferensi mentoring berhasil disimpan.');
      await loadMentors();
    });

    await Promise.all([loadMentors(), loadRequests()]);
  </script>
</MemberLayout>
