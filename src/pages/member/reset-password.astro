---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import AuthFeedback from '../../components/AuthFeedback.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="Buat Password Baru" description="Atur password baru Area Anggota PPI Ishikawa.">
  <AuthShell
    title="Buat password baru"
    description="Masukkan password baru untuk akun membership Anda."
  >

      <AuthFeedback id="reset-message" />
      <form id="reset-form" aria-busy="false" data-auth-state="idle" class="mt-7 space-y-5">
        <label class="block">
          <span class="text-sm font-bold text-slate-800">Password baru</span>
          <input name="password" type="password" minlength="8" autocomplete="new-password" required class="ui-field mt-2" />
        </label>
        <label class="block">
          <span class="text-sm font-bold text-slate-800">Ulangi password</span>
          <input name="password_confirm" type="password" minlength="8" autocomplete="new-password" required class="ui-field mt-2" />
        </label>
        <button type="submit" class="ui-action-primary w-full">Simpan password baru</button>
      </form>
      <a href={withBase('/member/login/')} class="mt-6 inline-flex text-sm font-bold text-brand hover:underline">← Kembali ke login</a>
  </AuthShell>


<script>
  import { isSupabaseConfigured, supabase } from '../../lib/supabase';
  import { memberPath } from '../../lib/member';
  import { createAuthFeedback } from '../../lib/auth-feedback';

  const form = document.querySelector<HTMLFormElement>('#reset-form');
  const feedback = createAuthFeedback(form, 'reset-message');
  const confirmationField = form?.querySelector<HTMLInputElement>('[name="password_confirm"]');

  if (!isSupabaseConfigured || !supabase) {
    feedback.show('Mode demo tidak menggunakan password nyata. Password reset akan aktif setelah backend membership terhubung.');
    form?.querySelectorAll('input, button').forEach((el) => el.setAttribute('disabled', ''));
  } else {
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const values = new FormData(form);
      const password = String(values.get('password') || '');
      const confirmation = String(values.get('password_confirm') || '');
      if (password !== confirmation) {
        feedback.show('Password dan konfirmasi password tidak sama.', 'error', confirmationField ?? undefined);
        return;
      }

      await feedback.run('Menyimpan…', async () => {
        const { error } = await supabase.auth.updateUser({ password });
        if (error) {
          feedback.show('Password belum dapat diperbarui. Pastikan tautan pemulihan masih berlaku.', 'error');
          return;
        }
        window.location.replace(memberPath('/member/login/?reset=1'));
      }, 'Password belum dapat diperbarui karena kendala koneksi. Coba lagi.');
    });
  }
</script>
</BaseLayout>
