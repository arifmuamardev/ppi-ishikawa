---
import MemberLayout from '../../../layouts/MemberLayout.astro';
import { campuses } from '../../../data/campuses';
---

<MemberLayout title="Verifikasi Anggota" requireAdmin={true}>
  <div class="space-y-6">
    <section>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Admin Membership</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Verifikasi anggota</h1>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">Periksa data pendaftaran, tentukan status membership, lalu setujui atau tandai untuk tindak lanjut.</p>
    </section>

    <div id="verification-admin-message" class="hidden rounded-2xl border p-4 text-sm leading-6"></div>

    <section class="rounded-3xl border border-slate-200 bg-white p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Antrian</p>
          <p id="verification-admin-count" class="mt-1 text-xl font-bold text-slate-950">Memuat…</p>
        </div>
        <button id="verification-refresh" type="button" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700">Muat ulang</button>
      </div>
    </section>

    <div id="verification-admin-empty" class="hidden rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
      <p class="font-bold text-slate-950">Tidak ada pendaftaran yang menunggu verifikasi.</p>
    </div>
    <section id="verification-admin-list" class="space-y-4"></section>
  </div>

  <script>
    import { campuses } from '../../../data/campuses';
    import { isSupabaseConfigured, supabase } from '../../../lib/supabase';

    const list = document.getElementById('verification-admin-list');
    const count = document.getElementById('verification-admin-count');
    const empty = document.getElementById('verification-admin-empty');
    const message = document.getElementById('verification-admin-message');
    const refresh = document.getElementById('verification-refresh');
    const campusMap = new Map(campuses.map((item) => [item.slug, item.shortName]));

    const show = (text, error = false) => {
      if (!message) return;
      message.textContent = text;
      message.className = `rounded-2xl border p-4 text-sm leading-6 ${error ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-900'}`;
    };

    const node = (tag, className, text) => {
      const el = document.createElement(tag);
      if (className) el.className = className;
      if (text !== undefined && text !== null) el.textContent = text;
      return el;
    };

    const review = async (userId, decision, nextStatus) => {
      if (!supabase) return;
      const { error } = await supabase.rpc('review_membership', {
        target_user_id: userId,
        decision,
        next_status: nextStatus,
      });
      if (error) {
        show('Keputusan belum dapat disimpan.', true);
        return;
      }
      show(decision === 'approved' ? 'Membership berhasil disetujui.' : 'Pendaftaran ditandai untuk tindak lanjut.');
      await load();
    };

    const render = (members) => {
      if (!list) return;
      list.replaceChildren();
      if (count) count.textContent = `${members.length} menunggu`;
      empty?.classList.toggle('hidden', members.length !== 0);

      for (const member of members) {
        const card = node('article', 'rounded-3xl border border-slate-200 bg-white p-6');
        const header = node('div', 'flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between');
        const info = node('div', '');
        info.append(node('h2', 'text-xl font-bold text-slate-950', member.full_name || 'Nama belum diisi'));
        info.append(node('p', 'mt-2 text-sm text-slate-600', [campusMap.get(member.campus_slug) || member.campus_slug, member.program, member.study_level].filter(Boolean).join(' · ')));
        if (member.field_of_study) info.append(node('p', 'mt-2 text-sm text-slate-500', member.field_of_study));

        const controls = node('div', 'flex flex-col gap-2 sm:flex-row');
        const select = document.createElement('select');
        select.className = 'rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800';
        for (const [value, label] of [['incoming','Incoming'],['active','Anggota aktif'],['alumni','Alumni'],['inactive','Tidak aktif']]) {
          const option = document.createElement('option');
          option.value = value; option.textContent = label; option.selected = member.membership_status === value; select.append(option);
        }

        const approve = node('button', 'rounded-xl bg-brand px-4 py-2.5 text-sm font-bold text-white', 'Setujui');
        approve.type = 'button';
        approve.addEventListener('click', () => review(member.user_id, 'approved', select.value));

        const reject = node('button', 'rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-bold text-red-700', 'Tindak lanjut');
        reject.type = 'button';
        reject.addEventListener('click', () => review(member.user_id, 'rejected', select.value));

        controls.append(select, approve, reject);
        header.append(info, controls);
        card.append(header);
        list.append(card);
      }
    };

    const load = async () => {
      if (!isSupabaseConfigured || !supabase) return;
      if (count) count.textContent = 'Memuat…';
      const { data, error } = await supabase
        .from('profiles')
        .select('user_id,full_name,campus_slug,program,study_level,field_of_study,membership_status,created_at')
        .eq('verification_status', 'pending')
        .order('created_at', { ascending: true });

      if (error) {
        show('Antrian verifikasi belum dapat dimuat. Pastikan akun ini memiliki role admin.', true);
        if (count) count.textContent = '—';
        return;
      }
      render(data || []);
    };

    refresh?.addEventListener('click', load);
    load();
  </script>
</MemberLayout>
