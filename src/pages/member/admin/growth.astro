---
import MemberLayout from '../../../layouts/MemberLayout.astro';
import AppPageHeader from '../../../components/AppPageHeader.astro';
---

<MemberLayout title="Alumni & Stories" requireAdmin={true}>
  <div class="space-y-6">
    <AppPageHeader
      eyebrow="Admin · Pengembangan"
      title="Alumni, mentoring, dan cerita"
      description="Pantau keterhubungan alumni, availability mentor, dan pipeline kontribusi cerita tanpa membuka data kontak yang tidak diperlukan."
    />

    <div id="growth-admin-message" class="hidden rounded-2xl border p-4 text-sm leading-6"></div>

    <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <p id="summary-alumni" class="text-3xl font-bold text-slate-950">0</p>
        <p class="mt-1 text-sm text-slate-600">profil alumni</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <p id="summary-mentors" class="text-3xl font-bold text-slate-950">0</p>
        <p class="mt-1 text-sm text-slate-600">mentor tersedia</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <p id="summary-seekers" class="text-3xl font-bold text-slate-950">0</p>
        <p class="mt-1 text-sm text-slate-600">mencari mentor</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <p id="summary-story-willing" class="text-3xl font-bold text-slate-950">0</p>
        <p class="mt-1 text-sm text-slate-600">bersedia berbagi cerita</p>
      </article>
      <article class="rounded-2xl border border-slate-200 bg-white p-5">
        <p id="summary-submissions" class="text-3xl font-bold text-slate-950">0</p>
        <p class="mt-1 text-sm text-slate-600">pengajuan cerita</p>
      </article>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="type-meta uppercase tracking-[0.12em] text-slate-500">Editorial pipeline</p>
          <h2 class="mt-2 text-xl font-bold text-slate-950">Kontribusi Cerita PPI Ishikawa</h2>
        </div>
        <label class="text-sm">
          <span class="sr-only">Filter status</span>
          <select id="story-admin-filter" class="rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800">
            <option value="">Semua status</option>
            <option value="proposed">Diajukan</option>
            <option value="contacted">Sudah dihubungi</option>
            <option value="draft">Dalam penyusunan</option>
            <option value="published">Dipublikasikan</option>
            <option value="declined">Tidak dilanjutkan</option>
          </select>
        </label>
      </div>

      <div id="story-admin-empty" role="status" aria-live="polite" class="mt-6 hidden rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-600">Belum ada pengajuan cerita.</div>
      <div id="story-admin-list" class="mt-6 space-y-4"></div>
    </section>
  </div>

  <script>
    import {
      getGrowthAdminSummary,
      getStoryPipeline,
      storyTopicOptions,
      updateStorySubmissionStatus,
    } from '../../../lib/member-growth';

    const message = document.getElementById('growth-admin-message');
    const filter = document.getElementById('story-admin-filter');
    const list = document.getElementById('story-admin-list');
    const empty = document.getElementById('story-admin-empty');
    let submissions = [];

    const labels = {
      proposed: 'Diajukan',
      contacted: 'Sudah dihubungi',
      draft: 'Dalam penyusunan',
      published: 'Dipublikasikan',
      declined: 'Tidak dilanjutkan',
    };

    const show = (text, error = false) => {
      if (!message) return;
      message.textContent = text;
      message.className = `rounded-2xl border p-4 text-sm leading-6 ${error ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-900'}`;
    };

    const setText = (id, value) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(value);
    };

    const loadSummary = async () => {
      const summary = await getGrowthAdminSummary();
      setText('summary-alumni', summary.alumniProfiles);
      setText('summary-mentors', summary.mentors);
      setText('summary-seekers', summary.seekingMentors);
      setText('summary-story-willing', summary.storyWilling);
      setText('summary-submissions', summary.storySubmissions);
    };

    const render = () => {
      if (!list) return;
      list.replaceChildren();
      const selected = filter instanceof HTMLSelectElement ? filter.value : '';
      const items = submissions.filter((item) => !selected || item.status === selected);
      empty?.classList.toggle('hidden', items.length !== 0);

      for (const item of items) {
        const card = document.createElement('article');
        card.className = 'rounded-2xl border border-slate-200 p-5';

        const top = document.createElement('div');
        top.className = 'flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between';

        const info = document.createElement('div');
        const h = document.createElement('h3');
        h.className = 'font-bold text-slate-950';
        h.textContent = item.full_name;

        const meta = document.createElement('p');
        meta.className = 'mt-1 text-xs font-bold uppercase tracking-[0.1em] text-slate-500';
        meta.textContent = [item.membership_status, item.campus_slug].filter(Boolean).join(' · ');

        const topics = document.createElement('p');
        topics.className = 'mt-3 text-sm font-semibold text-slate-700';
        topics.textContent = (item.topics || []).map((topic) => storyTopicOptions.find((x) => x.value === topic)?.label || topic).join(' · ');

        const note = document.createElement('p');
        note.className = 'mt-2 text-sm leading-6 text-slate-600';
        note.textContent = item.note || 'Tanpa catatan.';

        info.append(h, meta, topics, note);

        const select = document.createElement('select');
        select.className = 'rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800';
        for (const [value, label] of Object.entries(labels)) {
          const option = document.createElement('option');
          option.value = value;
          option.textContent = label;
          option.selected = item.status === value;
          select.append(option);
        }
        select.addEventListener('change', async () => {
          const { error } = await updateStorySubmissionStatus(item.id, select.value);
          if (error) return show('Status cerita belum dapat diperbarui.', true);
          show('Status cerita berhasil diperbarui.');
          await load();
        });

        top.append(info, select);
        card.append(top);
        list.append(card);
      }
    };

    const load = async () => {
      await loadSummary();
      const { data, error } = await getStoryPipeline();
      if (error) return show('Pipeline cerita belum dapat dimuat.', true);
      submissions = data || [];
      render();
    };

    filter?.addEventListener('change', render);
    load();
  </script>
</MemberLayout>
