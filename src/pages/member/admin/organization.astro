---
import MemberLayout from '../../../layouts/MemberLayout.astro';
import AppPageHeader from '../../../components/AppPageHeader.astro';
import FormFeedback from '../../../components/FormFeedback.astro';
---

<MemberLayout title="Kelola Organisasi" requireAdmin={true}>
  <div class="space-y-6">
    <AppPageHeader
      eyebrow="Admin · Organisasi"
      title="Periode, struktur, dan pengurus"
      description="Kelola periode kepengurusan, unit, posisi, dan penugasan pengurus tanpa mengubah source code."
    />

    <FormFeedback id="org-admin-message" />

    <section class="grid gap-5 xl:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-bold text-slate-950">Periode kepengurusan</h2>
        <FormFeedback id="org-term-message" />
        <form id="term-form" aria-busy="false" data-auth-state="idle" class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class="sm:col-span-2">
            <span class="text-sm font-bold text-slate-800">Label periode</span>
            <input name="label" required placeholder="Contoh: 2027/28" class="ui-field mt-2" />
          </label>
          <label>
            <span class="text-sm font-bold text-slate-800">Mulai</span>
            <input name="starts_on" type="date" required class="ui-field mt-2" />
          </label>
          <label>
            <span class="text-sm font-bold text-slate-800">Selesai</span>
            <input name="ends_on" type="date" required class="ui-field mt-2" />
          </label>
          <label class="sm:col-span-2 flex items-start gap-3 rounded-2xl bg-slate-50 p-4">
            <input name="is_current" type="checkbox" class="ui-check mt-0.5" />
            <span class="text-sm font-semibold text-slate-700">Jadikan periode aktif</span>
          </label>
          <div class="sm:col-span-2 flex justify-end">
            <button type="submit" class="ui-action-primary">Tambah periode</button>
          </div>
        </form>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <p class="type-meta uppercase tracking-[0.12em] text-slate-500">Konteks pengelolaan</p>
        <h2 class="mt-2 text-xl font-bold text-slate-950">Pilih periode</h2>
        <select id="term-selector" aria-label="Pilih periode yang dikelola" class="ui-field mt-5"></select>
        <p id="term-meta" class="mt-3 text-sm leading-6 text-slate-600">—</p>
      </article>
    </section>

    <section class="grid gap-5 xl:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-bold text-slate-950">Tambah unit</h2>
        <FormFeedback id="org-unit-message" />
        <form id="unit-form" aria-busy="false" data-auth-state="idle" class="mt-5 space-y-4">
          <label class="block">
            <span class="text-sm font-bold text-slate-800">Nama unit</span>
            <input name="name" required class="ui-field mt-2" />
          </label>
          <label class="block">
            <span class="text-sm font-bold text-slate-800">Slug</span>
            <input name="slug" required placeholder="contoh-unit" class="ui-field mt-2" />
          </label>
          <label class="block">
            <span class="text-sm font-bold text-slate-800">Jenis</span>
            <select name="unit_type" class="ui-field mt-2">
              <option value="department">Divisi</option>
              <option value="leadership">Pengurus inti</option>
              <option value="committee">Panitia</option>
              <option value="other">Lainnya</option>
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-bold text-slate-800">Deskripsi</span>
            <textarea name="description" rows="3" class="ui-field mt-2"></textarea>
          </label>
          <button type="submit" class="ui-action-primary">Tambah unit</button>
        </form>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-bold text-slate-950">Tambah posisi</h2>
        <FormFeedback id="org-position-message" />
        <form id="position-form" aria-busy="false" data-auth-state="idle" class="mt-5 space-y-4">
          <label class="block">
            <span class="text-sm font-bold text-slate-800">Unit</span>
            <select name="unit_id" required class="ui-field mt-2"></select>
          </label>
          <label class="block">
            <span class="text-sm font-bold text-slate-800">Nama posisi</span>
            <input name="title" required class="ui-field mt-2" />
          </label>
          <label class="block">
            <span class="text-sm font-bold text-slate-800">Slug</span>
            <input name="slug" required placeholder="nama-posisi" class="ui-field mt-2" />
          </label>
          <button type="submit" class="ui-action-primary">Tambah posisi</button>
        </form>
      </article>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="type-meta uppercase tracking-[0.12em] text-slate-500">Penugasan</p>
          <h2 class="mt-2 text-xl font-bold text-slate-950">Tetapkan pengurus</h2>
        </div>
        <p id="assignment-count" aria-live="polite" aria-atomic="true" class="text-sm font-semibold text-slate-500">—</p>
      </div>

      <FormFeedback id="org-assignment-message" />
      <form id="assignment-form" aria-busy="false" data-auth-state="idle" class="mt-6 grid gap-4 md:grid-cols-[1fr_1fr_auto] md:items-end">
        <label>
          <span class="text-sm font-bold text-slate-800">Posisi</span>
          <select name="position_id" required class="ui-field mt-2"></select>
        </label>
        <label>
          <span class="text-sm font-bold text-slate-800">Anggota</span>
          <select name="user_id" required class="ui-field mt-2"></select>
        </label>
        <div class="space-y-2">
          <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
            <input name="can_manage" type="checkbox" class="size-4" />
            Dapat mengelola unit
          </label>
          <button type="submit" class="ui-action-primary w-full">Tetapkan</button>
        </div>
      </form>

      <div id="assignment-list" aria-busy="false" class="mt-6 space-y-3"></div>
      <p id="assignment-empty" role="status" aria-live="polite" class="mt-6 hidden rounded-2xl bg-slate-50 p-5 text-sm text-slate-600">Belum ada penugasan pada periode ini.</p>
    </section>
  </div>

  <script>
    import {
      getAssignableMembers,
      getOrganizationAssignments,
      getOrganizationPositions,
      getOrganizationTerms,
      getOrganizationUnits,
      removeOrganizationAssignment,
      saveOrganizationAssignment,
      saveOrganizationPosition,
      saveOrganizationTerm,
      saveOrganizationUnit,
      type OrganizationTerm,
      type OrganizationUnit,
      type OrganizationPosition,
    } from '../../../lib/member-organization';
    import { createFormFeedback } from '../../../lib/form-feedback';

    type Assignment = { id: string; user_id: string; position_id: string; can_manage: boolean };
    type Member = { user_id: string; full_name: string };

    const termForm = document.querySelector<HTMLFormElement>('#term-form');
    const unitForm = document.querySelector<HTMLFormElement>('#unit-form');
    const positionForm = document.querySelector<HTMLFormElement>('#position-form');
    const assignmentForm = document.querySelector<HTMLFormElement>('#assignment-form');
    const forms = [termForm, unitForm, positionForm, assignmentForm];
    const termFeedback = createFormFeedback(termForm, 'org-term-message');
    const unitFeedback = createFormFeedback(unitForm, 'org-unit-message');
    const positionFeedback = createFormFeedback(positionForm, 'org-position-message');
    const assignmentFeedback = createFormFeedback(assignmentForm, 'org-assignment-message');
    const globalFeedback = createFormFeedback(null, 'org-admin-message');
    const termSelector = document.querySelector<HTMLSelectElement>('#term-selector');
    const termMeta = document.getElementById('term-meta');
    const assignmentList = document.getElementById('assignment-list');
    const assignmentCount = document.getElementById('assignment-count');
    const assignmentEmpty = document.getElementById('assignment-empty');

    let terms: OrganizationTerm[] = [];
    let units: OrganizationUnit[] = [];
    let positions: OrganizationPosition[] = [];
    let members: Member[] = [];
    let assignments: Assignment[] = [];
    let mutationBusy = false;
    let contextReady = false;
    let contextSequence = 0;
    let deletingId: string | null = null;
    const selectedTermId = () => termSelector?.value || '';

    function updateControls() {
      if (termSelector) termSelector.disabled = mutationBusy || terms.length === 0;
      const buttons = forms.map(form => form?.querySelector<HTMLButtonElement>('button[type="submit"]'));
      buttons[0] && (buttons[0].disabled = mutationBusy);
      buttons[1] && (buttons[1].disabled = mutationBusy || !contextReady || !selectedTermId());
      buttons[2] && (buttons[2].disabled = mutationBusy || !contextReady || units.length === 0);
      buttons[3] && (buttons[3].disabled = mutationBusy || !contextReady || positions.length === 0 || members.length === 0);
      assignmentList?.querySelectorAll<HTMLButtonElement>('button[data-remove-assignment]').forEach(button => {
        button.disabled = mutationBusy;
      });
    }

    async function mutate(
      feedback: ReturnType<typeof createFormFeedback>,
      label: string,
      action: () => Promise<void>,
      errorMessage: string
    ) {
      if (mutationBusy) return;
      mutationBusy = true; // lock all four related forms, even on a synthetic duplicate submit
      updateControls();
      try {
        // run() handles aria-busy, the active submit label, thrown errors and finally reset.
        await feedback.run(label, action, errorMessage);
      } finally {
        mutationBusy = false;
        updateControls();
      }
    }

    function fillSelect<T extends { id: string }>(
      select: HTMLSelectElement | null, items: T[], label: (item: T) => string
    ) {
      if (!select) return;
      const previous = select.value;
      select.replaceChildren();
      if (!items.length) {
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Belum tersedia';
        select.append(placeholder);
        return;
      }
      for (const item of items) {
        const option = document.createElement('option');
        option.value = item.id;
        option.textContent = label(item);
        select.append(option);
      }
      if (items.some(item => item.id === previous)) select.value = previous;
    }

    function renderAssignments() {
      if (!assignmentList) return;
      assignmentList.replaceChildren();
      if (assignmentCount) assignmentCount.textContent = `${assignments.length} penugasan`;
      assignmentEmpty?.classList.toggle('hidden', assignments.length !== 0);

      for (const assignment of assignments) {
        const position = positions.find(item => item.id === assignment.position_id);
        const unit = units.find(item => item.id === position?.unit_id);
        const member = members.find(item => item.user_id === assignment.user_id);
        const row = document.createElement('article');
        row.className = 'flex flex-col gap-3 rounded-2xl border border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between';
        const info = document.createElement('div');
        const heading = document.createElement('h3');
        heading.className = 'font-bold text-slate-950';
        heading.textContent = member?.full_name || 'Anggota';
        const meta = document.createElement('p');
        meta.className = 'mt-1 text-sm text-slate-600';
        meta.textContent = `${position?.title || 'Posisi'} · ${unit?.name || 'Unit'}${assignment.can_manage ? ' · Dapat mengelola unit' : ''}`;
        info.append(heading, meta);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.dataset.removeAssignment = assignment.id;
        remove.className = 'rounded-xl border border-red-200 bg-red-50 px-4 py-2 text-sm font-bold text-red-700';
        remove.textContent = 'Hapus';
        remove.addEventListener('click', async () => {
          if (mutationBusy || deletingId) return;
          if (!window.confirm('Hapus penugasan pengurus ini?')) return;
          mutationBusy = true;
          deletingId = assignment.id;
          row.setAttribute('aria-busy', 'true');
          remove.textContent = 'Menghapus…';
          updateControls();
          globalFeedback.show('Sedang menghapus penugasan…');
          try {
            const { error } = await removeOrganizationAssignment(assignment.id);
            if (error) {
              globalFeedback.show('Penugasan belum dapat dihapus. Coba lagi.', 'error');
              return;
            }
            if (await loadContext()) globalFeedback.show('Penugasan berhasil dihapus.', 'success');
            else globalFeedback.show('Penugasan dihapus, tetapi daftar belum dapat diperbarui. Muat ulang halaman.');
          } catch {
            globalFeedback.show('Penugasan belum dapat dihapus karena kendala koneksi.', 'error');
          } finally {
            deletingId = null;
            mutationBusy = false;
            row.setAttribute('aria-busy', 'false');
            remove.textContent = 'Hapus';
            updateControls();
          }
        });
        row.append(info, remove);
        assignmentList.append(row);
      }
      updateControls();
    }

    async function loadContext(): Promise<boolean> {
      const seq = ++contextSequence;
      const termId = selectedTermId();
      contextReady = false;
      updateControls();
      if (!termId) {
        units = []; positions = []; members = []; assignments = [];
        if (termMeta) termMeta.textContent = 'Belum ada periode. Tambahkan periode terlebih dahulu.';
        assignmentEmpty?.classList.add('hidden');
        if (assignmentCount) assignmentCount.textContent = '—';
        assignmentList?.replaceChildren();
        return false;
      }
      const term = terms.find(item => item.id === termId);
      if (term && termMeta) termMeta.textContent = `${term.starts_on} – ${term.ends_on}${term.is_current ? ' · Periode aktif' : ''}`;
      assignmentList?.setAttribute('aria-busy', 'true');
      try {
        const [u, p, a, m] = await Promise.all([
          getOrganizationUnits(termId), getOrganizationPositions(termId),
          getOrganizationAssignments(termId), getAssignableMembers(),
        ]);
        if (seq !== contextSequence || termId !== selectedTermId()) return false;
        if (u.error || p.error || a.error || m.error) {
          globalFeedback.show('Data organisasi belum dapat dimuat. Periksa koneksi dan pilih periode kembali.', 'error');
          return false;
        }
        units = u.data || [];
        positions = p.data || [];
        assignments = a.data || [];
        members = m.data || [];
        fillSelect(positionForm?.querySelector('select[name="unit_id"]') || null, units, item => item.name);
        fillSelect(assignmentForm?.querySelector('select[name="position_id"]') || null, positions, item => {
          const unit = units.find(u => u.id === item.unit_id);
          return `${unit?.name || 'Unit'} · ${item.title}`;
        });
        fillSelect(assignmentForm?.querySelector('select[name="user_id"]') || null, members.map(x=>({...x,id:x.user_id})), item => item.full_name);
        contextReady = true;
        renderAssignments();
        return true;
      } catch {
        if (seq === contextSequence) globalFeedback.show('Data organisasi gagal dimuat. Periksa koneksi dan coba lagi.', 'error');
        return false;
      } finally {
        assignmentList?.setAttribute('aria-busy', 'false');
        updateControls();
      }
    }

    async function loadTerms(): Promise<boolean> {
      try {
        const { data, error } = await getOrganizationTerms();
        if (error) {
          globalFeedback.show('Periode belum dapat dimuat. Muat ulang halaman untuk mencoba lagi.', 'error');
          return false;
        }
        terms = data || [];
        if (!termSelector) return false;
        const previous = selectedTermId();
        fillSelect(termSelector, terms, item => `${item.label}${item.is_current ? ' · aktif' : ''}`);
        if (!terms.some(item => item.id === previous)) {
          const current = terms.find(item => item.is_current);
          if (current) termSelector.value = current.id;
        }
        return !terms.length || await loadContext();
      } catch {
        globalFeedback.show('Periode gagal dimuat. Periksa koneksi dan coba lagi.', 'error');
        return false;
      }
    }

    termForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!termForm || mutationBusy) return;
      const values = new FormData(termForm);
      const starts = String(values.get('starts_on') || '');
      const ends = String(values.get('ends_on') || '');
      if (ends <= starts) {
        termFeedback.show('Tanggal selesai harus setelah tanggal mulai.', 'error', termForm.elements.namedItem('ends_on') as HTMLInputElement);
        return;
      }
      await mutate(termFeedback, 'Menyimpan…', async () => {
        const { error } = await saveOrganizationTerm({
          label: String(values.get('label') || '').trim(),
          starts_on: starts,
          ends_on: ends,
          is_current: values.get('is_current') === 'on',
        });
        if (error) return termFeedback.show('Periode belum dapat ditambahkan. Periksa data lalu coba lagi.', 'error');
        termForm.reset();
        if (await loadTerms()) termFeedback.show('Periode berhasil ditambahkan.', 'success');
        else termFeedback.show('Periode tersimpan, tetapi daftar belum dapat diperbarui. Muat ulang halaman.');
      }, 'Periode belum dapat diproses karena kendala koneksi. Coba lagi.');
    });

    unitForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!unitForm || mutationBusy || !contextReady || !selectedTermId()) return;
      const values = new FormData(unitForm);
      await mutate(unitFeedback, 'Menyimpan…', async () => {
        const { error } = await saveOrganizationUnit({
          term_id: selectedTermId(),
          name: String(values.get('name') || '').trim(),
          slug: String(values.get('slug') || '').trim(),
          description: String(values.get('description') || '').trim(),
          unit_type: String(values.get('unit_type') || 'department'),
        });
        if (error) return unitFeedback.show('Unit belum dapat ditambahkan. Periksa data lalu coba lagi.', 'error');
        unitForm.reset();
        if (await loadContext()) unitFeedback.show('Unit berhasil ditambahkan.', 'success');
        else unitFeedback.show('Unit tersimpan, tetapi daftar belum dapat diperbarui. Muat ulang halaman.');
      }, 'Unit belum dapat diproses karena kendala koneksi. Coba lagi.');
    });

    positionForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!positionForm || mutationBusy || !contextReady || !units.length) return;
      const values = new FormData(positionForm);
      await mutate(positionFeedback, 'Menyimpan…', async () => {
        const { error } = await saveOrganizationPosition({
          term_id: selectedTermId(),
          unit_id: String(values.get('unit_id') || ''),
          title: String(values.get('title') || '').trim(),
          slug: String(values.get('slug') || '').trim(),
        });
        if (error) return positionFeedback.show('Posisi belum dapat ditambahkan. Periksa data lalu coba lagi.', 'error');
        positionForm.reset();
        if (await loadContext()) positionFeedback.show('Posisi berhasil ditambahkan.', 'success');
        else positionFeedback.show('Posisi tersimpan, tetapi daftar belum dapat diperbarui. Muat ulang halaman.');
      }, 'Posisi belum dapat diproses karena kendala koneksi. Coba lagi.');
    });

    assignmentForm?.addEventListener('submit', async event => {
      event.preventDefault();
      if (!assignmentForm || mutationBusy || !contextReady || !positions.length || !members.length) return;
      const values = new FormData(assignmentForm);
      await mutate(assignmentFeedback, 'Menetapkan…', async () => {
        const { error } = await saveOrganizationAssignment({
          term_id: selectedTermId(),
          position_id: String(values.get('position_id') || ''),
          user_id: String(values.get('user_id') || ''),
          can_manage: values.get('can_manage') === 'on',
        });
        if (error) return assignmentFeedback.show('Penugasan belum dapat disimpan. Coba lagi.', 'error');
        if (await loadContext()) assignmentFeedback.show('Pengurus berhasil ditetapkan.', 'success');
        else assignmentFeedback.show('Penugasan tersimpan, tetapi daftar belum dapat diperbarui. Muat ulang halaman.');
      }, 'Penugasan belum dapat diproses karena kendala koneksi. Coba lagi.');
    });

    termSelector?.addEventListener('change', () => { if (!mutationBusy) loadContext(); });
    updateControls();
    loadTerms();
  </script>
</MemberLayout>
