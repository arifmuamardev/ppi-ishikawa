---
import MemberLayout from '../../../layouts/MemberLayout.astro';
---

<MemberLayout title="Attendance Kegiatan" requireAdmin={true}>
  <div class="space-y-6">
    <section>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Admin · Attendance</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Check-in peserta kegiatan</h1>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">Pilih kegiatan, lihat anggota yang RSVP hadir, lalu tandai kehadiran aktual.</p>
    </section>

    <div id="attendance-message" class="hidden rounded-2xl border p-4 text-sm leading-6"></div>

    <section class="rounded-3xl border border-slate-200 bg-white p-5">
      <label>
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500">Kegiatan</span>
        <select id="attendance-event" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-sm text-slate-900">
          <option value="">Pilih kegiatan</option>
        </select>
      </label>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Peserta RSVP</p>
          <h2 id="attendance-title" class="mt-2 text-xl font-bold text-slate-950">Pilih kegiatan terlebih dahulu</h2>
        </div>
        <p id="attendance-count" class="text-sm font-semibold text-slate-500">—</p>
      </div>

      <div id="attendance-empty" class="mt-6 rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-600">Belum ada kegiatan yang dipilih.</div>
      <div id="attendance-list" class="mt-6 space-y-3"></div>
    </section>
  </div>

  <script>
    import { getEventAttendance, getMemberEvents, setEventCheckin } from '../../../lib/member-community';

    const eventSelect = document.getElementById('attendance-event');
    const list = document.getElementById('attendance-list');
    const empty = document.getElementById('attendance-empty');
    const count = document.getElementById('attendance-count');
    const title = document.getElementById('attendance-title');
    const message = document.getElementById('attendance-message');
    let events = [];

    const show = (text, error = false) => {
      if (!message) return;
      message.textContent = text;
      message.className = `rounded-2xl border p-4 text-sm leading-6 ${error ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-900'}`;
    };

    const renderAttendance = async () => {
      if (!(eventSelect instanceof HTMLSelectElement)) return;
      const eventId = eventSelect.value;
      if (!eventId) {
        if (title) title.textContent = 'Pilih kegiatan terlebih dahulu';
        if (count) count.textContent = '—';
        if (list) list.replaceChildren();
        empty?.classList.remove('hidden');
        return;
      }

      const event = events.find((item) => item.id === eventId);
      if (title) title.textContent = event?.title || 'Attendance';
      const { data, error } = await getEventAttendance(eventId);
      if (error) return show('Daftar peserta belum dapat dimuat.', true);

      const members = (data || []).filter((item) => item.attending);
      if (count) count.textContent = `${members.filter((item) => item.checked_in_at).length}/${members.length} hadir`;
      empty?.classList.toggle('hidden', members.length !== 0);
      if (empty && members.length === 0) empty.textContent = 'Belum ada peserta yang RSVP hadir.';
      if (!list) return;
      list.replaceChildren();

      for (const member of members) {
        const row = document.createElement('article');
        row.className = 'flex flex-col gap-3 rounded-2xl border border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between';

        const info = document.createElement('div');
        const name = document.createElement('h3');
        name.className = 'font-bold text-slate-950';
        name.textContent = member.full_name;
        const status = document.createElement('p');
        status.className = 'mt-1 text-sm text-slate-500';
        status.textContent = member.checked_in_at
          ? `Check-in: ${new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Tokyo' }).format(new Date(member.checked_in_at))}`
          : 'Belum check-in';
        info.append(name, status);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = member.checked_in_at
          ? 'rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700'
          : 'rounded-xl bg-brand px-4 py-2.5 text-sm font-bold text-white';
        button.textContent = member.checked_in_at ? 'Batalkan check-in' : 'Check-in';
        button.addEventListener('click', async () => {
          const { error } = await setEventCheckin(eventId, member.user_id, !member.checked_in_at);
          if (error) return show('Status kehadiran belum dapat diperbarui.', true);
          show(member.checked_in_at ? 'Check-in dibatalkan.' : 'Peserta berhasil di-check-in.');
          await renderAttendance();
        });

        row.append(info, button);
        list.append(row);
      }
    };

    const { data, error } = await getMemberEvents();
    if (error) {
      show('Agenda belum dapat dimuat.', true);
    } else {
      events = data || [];
      if (eventSelect instanceof HTMLSelectElement) {
        for (const event of events) {
          const option = document.createElement('option');
          option.value = event.id;
          option.textContent = `${event.title} · ${new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeZone: 'Asia/Tokyo' }).format(new Date(event.starts_at))}`;
          eventSelect.append(option);
        }
      }
    }

    eventSelect?.addEventListener('change', renderAttendance);
  </script>
</MemberLayout>
