---
import MemberLayout from '../../../layouts/MemberLayout.astro';
import AppPageHeader from '../../../components/AppPageHeader.astro';
import FormFeedback from '../../../components/FormFeedback.astro';
---

<MemberLayout title="QR Check-in" requireAdmin={true}>
  <div class="space-y-6">
    <AppPageHeader
      eyebrow="Admin · QR Check-in"
      title="Buat QR check-in kegiatan"
      description="QR hanya valid pada window yang ditentukan. Anggota tetap harus login dan sudah RSVP hadir sebelum check-in."
    />

    <FormFeedback id="qr-admin-message" />

    <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <h2 class="text-xl font-bold text-slate-950">Session baru</h2>
      <form id="qr-session-form" aria-busy="false" data-auth-state="idle" class="mt-6 grid gap-5 md:grid-cols-3">
        <label class="md:col-span-3">
          <span class="text-sm font-bold text-slate-800">Kegiatan</span>
          <select name="event_id" required class="ui-field mt-2"></select>
        </label>
        <label>
          <span class="text-sm font-bold text-slate-800">Buka</span>
          <input name="opens_at" type="datetime-local" required class="ui-field mt-2" />
        </label>
        <label>
          <span class="text-sm font-bold text-slate-800">Tutup</span>
          <input name="closes_at" type="datetime-local" class="ui-field mt-2" />
        </label>
        <div class="flex items-end">
          <button type="submit" class="ui-action-primary w-full">Buat QR</button>
        </div>
      </form>
    </section>

    <section aria-labelledby="qr-list-heading" class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <h2 id="qr-list-heading" class="text-xl font-bold text-slate-950">Sesi QR tersedia</h2>
        <p id="qr-session-count" aria-live="polite" aria-atomic="true" class="text-sm font-semibold text-slate-500">Memuat…</p>
      </div>
      <div id="qr-session-list" aria-busy="false" class="space-y-5"></div>
      <p id="qr-session-empty" role="status" aria-live="polite" class="hidden rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-600">Belum ada sesi QR. Pilih kegiatan dan tentukan waktunya untuk membuat sesi.</p>
    </section>
  </div>

  <script>
    import QRCode from 'qrcode';
    import { getMemberEvents, type MemberEvent } from '../../../lib/member-community';
    import { memberAbsoluteUrl } from '../../../lib/member';
    import {
      createCheckinSession,
      getCheckinSessions,
      setCheckinSessionActive,
    } from '../../../lib/member-advanced';
    import { createFormFeedback } from '../../../lib/form-feedback';

    type Session = {
      id: string;
      event_id: string;
      checkin_token: string;
      opens_at: string;
      closes_at: string | null;
      active: boolean;
      member_events?: { title: string } | null;
    };

    const form = document.querySelector<HTMLFormElement>('#qr-session-form');
    const list = document.getElementById('qr-session-list');
    const count = document.getElementById('qr-session-count');
    const empty = document.getElementById('qr-session-empty');
    const feedback = createFormFeedback(form, 'qr-admin-message');
    const eventSelect = form?.querySelector<HTMLSelectElement>('select[name="event_id"]') ?? null;
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;
    let events: MemberEvent[] = [];
    let sessions: Session[] = [];
    let initialized = false;
    let mutating = false;
    let listLoaded = false;
    let loadVersion = 0;

    const isFormPending = () => form?.getAttribute('aria-busy') === 'true';
    const updateActions = () => {
      if (submit) submit.disabled = !initialized || events.length === 0 || mutating || isFormPending();
      if (eventSelect) eventSelect.disabled = !initialized || events.length === 0 || mutating;
      list?.querySelectorAll<HTMLButtonElement>('button[data-qr-toggle]').forEach(button => {
        button.disabled = mutating;
      });
    };

    const toLocalInput = (date: Date) => {
      const shifted = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
      return shifted.toISOString().slice(0, 16);
    };
    const initializeDefaults = () => {
      if (!form) return;
      const opens = form.elements.namedItem('opens_at');
      const closes = form.elements.namedItem('closes_at');
      const now = new Date();
      const later = new Date(now.getTime() + 3 * 60 * 60 * 1000);
      if (opens instanceof HTMLInputElement) opens.value = toLocalInput(now);
      if (closes instanceof HTMLInputElement) closes.value = toLocalInput(later);
    };

    async function renderSessions() {
      if (!list) return;
      list.replaceChildren();
      if (count) count.textContent = `${sessions.length} sesi`;
      empty?.classList.toggle('hidden', sessions.length !== 0);

      for (const session of sessions) {
        const card = document.createElement('article');
        card.className = 'rounded-2xl border border-slate-200 bg-white p-6';
        const layout = document.createElement('div');
        layout.className = 'grid gap-6 lg:grid-cols-[1fr_190px] lg:items-center';
        const info = document.createElement('div');
        const status = document.createElement('span');
        status.className = session.active
          ? 'rounded-full bg-emerald-50 px-3 py-1 text-[11px] font-bold text-emerald-700'
          : 'rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-600';
        status.textContent = session.active ? 'Aktif' : 'Nonaktif';

        const h = document.createElement('h3');
        h.className = 'mt-4 text-xl font-bold text-slate-950';
        h.textContent = session.member_events?.title || 'Kegiatan';
        const meta = document.createElement('p');
        meta.className = 'mt-2 text-sm leading-6 text-slate-600';
        const closeText = session.closes_at
          ? new Intl.DateTimeFormat('id-ID', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Asia/Tokyo' }).format(new Date(session.closes_at))
          : 'tanpa batas waktu';
        meta.textContent = `Dibuka ${new Intl.DateTimeFormat('id-ID', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Asia/Tokyo' }).format(new Date(session.opens_at))} · Tutup ${closeText}`;

        const url = memberAbsoluteUrl(`/member/checkin/?token=${encodeURIComponent(session.checkin_token)}`);
        const urlText = document.createElement('p');
        urlText.className = 'mt-3 break-all font-mono text-xs text-slate-500';
        urlText.textContent = url;

        const controls = document.createElement('div');
        controls.className = 'mt-4 flex flex-wrap gap-2';
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.dataset.qrToggle = session.id;
        toggle.className = session.active
          ? 'rounded-xl border border-red-200 bg-red-50 px-4 py-2 text-sm font-bold text-red-700'
          : 'ui-action-secondary';
        toggle.textContent = session.active ? 'Nonaktifkan' : 'Aktifkan kembali';
        toggle.disabled = mutating;
        toggle.addEventListener('click', async () => {
          if (mutating || isFormPending()) return;
          if (session.active && !window.confirm('Nonaktifkan sesi QR ini? Anggota tidak akan dapat check-in menggunakan tautannya selama sesi nonaktif.')) return;
          mutating = true;
          card.setAttribute('aria-busy', 'true');
          toggle.textContent = session.active ? 'Menonaktifkan…' : 'Mengaktifkan…';
          updateActions();
          feedback.show('Sedang memperbarui status sesi…');
          try {
            const { error } = await setCheckinSessionActive(session.id, !session.active);
            if (error) {
              feedback.show('Status sesi belum dapat diperbarui. Coba lagi.', 'error');
              return;
            }
            if (await load()) feedback.show('Status sesi QR berhasil diperbarui.', 'success');
            else feedback.show('Status sesi berhasil diubah, tetapi daftar belum dapat dimuat ulang. Muat ulang halaman.');
          } catch {
            feedback.show('Status sesi belum dapat diperbarui karena kendala koneksi.', 'error');
          } finally {
            mutating = false;
            card.setAttribute('aria-busy', 'false');
            toggle.textContent = session.active ? 'Nonaktifkan' : 'Aktifkan kembali';
            updateActions();
          }
        });

        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'ui-action-secondary';
        copy.textContent = 'Salin link';
        copy.addEventListener('click', async () => {
          copy.disabled = true;
          try {
            await navigator.clipboard.writeText(url);
            feedback.show('Link check-in berhasil disalin.', 'success');
          } catch {
            feedback.show('Link tidak dapat disalin otomatis. Salin tautan yang ditampilkan pada kartu secara manual.', 'error');
            urlText.setAttribute('tabindex', '-1');
            urlText.focus();
          } finally {
            copy.disabled = false;
          }
        });

        controls.append(toggle, copy);
        info.append(status, h, meta, urlText, controls);
        const qrBox = document.createElement('div');
        qrBox.className = 'rounded-2xl bg-slate-50 p-3';
        const canvas = document.createElement('canvas');
        canvas.setAttribute('role', 'img');
        canvas.setAttribute('aria-label', `QR check-in untuk ${session.member_events?.title || 'kegiatan'}`);
        qrBox.append(canvas);
        layout.append(info, qrBox);
        card.append(layout);
        list.append(card);
        try {
          await QRCode.toCanvas(canvas, url, { width: 165, margin: 1, errorCorrectionLevel: 'M' });
        } catch {
          canvas.remove();
          const fallback = document.createElement('p');
          fallback.className = 'text-sm text-slate-700';
          fallback.textContent = 'QR belum dapat ditampilkan. Gunakan tautan check-in di samping.';
          qrBox.append(fallback);
        }
      }
      updateActions();
    }

    async function load(): Promise<boolean> {
      const requestVersion = ++loadVersion;
      list?.setAttribute('aria-busy', 'true');
      if (count && !listLoaded) count.textContent = 'Memuat…';
      try {
        const { data, error } = await getCheckinSessions();
        if (requestVersion !== loadVersion) return false;
        if (error) {
          feedback.show('Sesi QR belum dapat dimuat. Periksa koneksi lalu muat ulang halaman.', 'error');
          return false;
        }
        sessions = (data || []) as Session[];
        await renderSessions();
        listLoaded = true;
        return true;
      } catch {
        feedback.show('Sesi QR belum dapat dimuat karena kendala koneksi.', 'error');
        return false;
      } finally {
        if (requestVersion === loadVersion) list?.setAttribute('aria-busy', 'false');
      }
    }

    async function loadEvents() {
      try {
        const { data, error } = await getMemberEvents();
        if (error) {
          feedback.show('Daftar kegiatan belum dapat dimuat. Muat ulang halaman untuk mencoba lagi.', 'error');
          return;
        }
        events = data || [];
        if (eventSelect) {
          eventSelect.replaceChildren();
          for (const event of events) {
            const option = document.createElement('option');
            option.value = event.id;
            option.textContent = `${event.title} · ${new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeZone: 'Asia/Tokyo' }).format(new Date(event.starts_at))}`;
            eventSelect.append(option);
          }
        }
        initialized = true;
        updateActions();
        if (!events.length) feedback.show('Belum ada kegiatan untuk dibuatkan sesi QR. Tambahkan kegiatan terlebih dahulu.');
      } catch {
        feedback.show('Daftar kegiatan gagal dimuat. Periksa koneksi lalu muat ulang halaman.', 'error');
      }
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form || !initialized || !events.length || mutating || isFormPending()) return;
      const values = new FormData(form);
      const opens = String(values.get('opens_at') || '');
      const closes = String(values.get('closes_at') || '');
      const endField = form.querySelector<HTMLInputElement>('input[name="closes_at"]');
      if (closes && new Date(closes) <= new Date(opens)) {
        feedback.show('Waktu tutup harus setelah waktu buka.', 'error', endField ?? undefined);
        return;
      }
      mutating = true;
      updateActions();
      try {
        await feedback.run('Membuat…', async () => {
          const { error } = await createCheckinSession({
            event_id: String(values.get('event_id') || ''),
            opens_at: new Date(opens).toISOString(),
            closes_at: closes ? new Date(closes).toISOString() : null,
          });
          if (error) {
            feedback.show('Sesi QR belum dapat dibuat. Periksa data lalu coba lagi.', 'error');
            return;
          }
          initializeDefaults();
          if (await load()) feedback.show('Sesi QR berhasil dibuat.', 'success');
          else feedback.show('Sesi QR dibuat, tetapi daftar belum dapat dimuat ulang. Muat ulang halaman.');
        }, 'Sesi QR belum dapat dibuat karena kendala koneksi. Coba lagi.');
      } finally {
        mutating = false;
        updateActions();
      }
    });

    initializeDefaults();
    updateActions();
    loadEvents();
    load();
  </script>
</MemberLayout>
