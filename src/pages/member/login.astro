---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="Masuk Anggota" description="Masuk ke Area Anggota PPI Ishikawa.">
  <AuthShell
    title="Masuk ke akun Anda"
    description="Gunakan email yang terdaftar pada membership PPI Ishikawa."
  >

      <div id="login-message" class="mt-6 hidden rounded-2xl border p-4 text-sm leading-6"></div>

      <div id="demo-login" class="mt-7 hidden rounded-2xl border border-accent/35 bg-accent/10 p-5">
        <p class="font-bold text-slate-950">Coba Area Anggota dalam mode demo</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Tidak ada data yang dikirim ke server. Pilih peran untuk mencoba alur anggota atau admin.</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <button id="demo-member-login" type="button" class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Masuk sebagai anggota</button>
          <button id="demo-admin-login" type="button" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Masuk sebagai admin</button>
        </div>
      </div>

      <form id="member-login-form" class="mt-7 space-y-5">
        <label class="block">
          <span class="text-sm font-bold text-slate-800">Email</span>
          <input name="email" type="email" autocomplete="email" required class="ui-field mt-2" />
        </label>
        <label class="block">
          <span class="text-sm font-bold text-slate-800">Password</span>
          <input name="password" type="password" autocomplete="current-password" required class="ui-field mt-2" />
        </label>
        <button type="submit" class="w-full rounded-xl bg-brand px-5 py-3 font-bold text-white">Masuk</button>
      </form>

      <div class="mt-6 flex flex-wrap justify-between gap-3 text-sm">
        <a href={withBase('/member/forgot-password/')} class="font-bold text-brand hover:underline">Lupa password?</a>
        <a href={withBase('/member/register/')} class="font-bold text-brand hover:underline">Daftar sebagai anggota →</a>
      </div>
  </AuthShell>

  <script>
    import { isSupabaseConfigured, supabase } from '../../lib/supabase';
    import { demoSignIn, isMembershipDemoMode, memberPath } from '../../lib/member';

    const form = document.getElementById('member-login-form');
    const message = document.getElementById('login-message');

    const showMessage = (text, type = 'info') => {
      if (!message) return;
      message.textContent = text;
      message.className = `mt-6 rounded-2xl border p-4 text-sm leading-6 ${type === 'error' ? 'border-red-200 bg-red-50 text-red-800' : 'border-accent/35 bg-accent/10 text-slate-700'}`;
    };

    if (isMembershipDemoMode) {
      showMessage('Membership sedang berjalan dalam mode demo. Form login nyata akan aktif setelah backend terhubung.');
      document.getElementById('demo-login')?.classList.remove('hidden');
      form?.querySelectorAll('input, button').forEach((el) => el.setAttribute('disabled', ''));

      document.getElementById('demo-member-login')?.addEventListener('click', () => {
        demoSignIn('member');
        window.location.replace(memberPath('/member/'));
      });
      document.getElementById('demo-admin-login')?.addEventListener('click', () => {
        demoSignIn('admin');
        window.location.replace(memberPath('/member/'));
      });
    } else if (isSupabaseConfigured && supabase) {
      const params = new URLSearchParams(window.location.search);
      if (params.get('confirmed') === '1') showMessage('Email berhasil dikonfirmasi. Silakan masuk.');
      if (params.get('reset') === '1') showMessage('Password berhasil diperbarui. Silakan masuk.');

      const { data } = await supabase.auth.getUser();
      if (data.user) window.location.replace(memberPath('/member/'));

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const submit = form.querySelector('button[type="submit"]');
        submit?.setAttribute('disabled', '');
        if (submit) submit.textContent = 'Memproses…';

        const values = new FormData(form);
        const email = String(values.get('email') || '').trim();
        const password = String(values.get('password') || '');

        const { error } = await supabase.auth.signInWithPassword({ email, password });

        if (error) {
          showMessage('Email atau password belum dapat digunakan. Periksa kembali data Anda.', 'error');
          submit?.removeAttribute('disabled');
          if (submit) submit.textContent = 'Masuk';
          return;
        }

        window.location.replace(memberPath('/member/'));
      });
    }
  </script>
</BaseLayout>
