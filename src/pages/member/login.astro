---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import AuthFeedback from '../../components/AuthFeedback.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="Masuk Anggota" description="Masuk ke Area Anggota PPI Ishikawa.">
  <AuthShell
    title="Masuk atau daftar anggota"
    description="Masukkan email saja. Jika sudah punya akun, Anda akan masuk. Jika belum, akun baru dibuat setelah verifikasi email, lalu Anda melengkapi profil."
  >

      <AuthFeedback id="login-message" />

      <div id="demo-login" class="mt-7 hidden rounded-2xl border border-accent/35 bg-accent/10 p-5">
        <p class="font-bold text-slate-950">Coba Area Anggota dalam mode demo</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Tidak ada data yang dikirim ke server. Pilih peran untuk mencoba alur anggota atau admin.</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <button id="demo-member-login" type="button" class="rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white">Masuk sebagai anggota</button>
          <button id="demo-admin-login" type="button" class="rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800">Masuk sebagai admin</button>
        </div>
      </div>

      <form id="member-login-form" aria-busy="false" data-auth-state="idle" class="mt-7 space-y-5">
        <label class="block">
          <span class="text-sm font-bold text-slate-800">Alamat email Anda</span>
          <input name="email" type="email" autocomplete="email" required class="ui-field mt-2" />
        </label>
        <button type="submit" class="ui-action-primary w-full">Lanjutkan dengan email</button>
        <p class="text-xs leading-5 text-slate-600">Akun baru otomatis dibuat bila email belum terdaftar. Setelah klik tautan, lengkapi profil dan setujui penggunaan data untuk administrasi membership. Keanggotaan tetap diverifikasi pengurus.</p>
      </form>

      <details id="password-login-option" class="mt-6 rounded-2xl border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer text-sm font-bold text-brand">Sudah punya password? Gunakan cara lama</summary>
        <form id="member-password-form" aria-busy="false" data-auth-state="idle" class="mt-4 space-y-4">
          <label class="block">
            <span class="text-sm font-bold text-slate-800">Email</span>
            <input name="email" type="email" autocomplete="email" required class="ui-field mt-2" />
          </label>
          <label class="block">
            <span class="text-sm font-bold text-slate-800">Password</span>
            <input name="password" type="password" autocomplete="current-password" required class="ui-field mt-2" />
          </label>
          <button type="submit" class="ui-action-secondary w-full">Masuk dengan password</button>
          <a href={withBase('/member/forgot-password/')} class="inline-flex text-sm font-bold text-brand hover:underline">Lupa password?</a>
        </form>
      </details>


  </AuthShell>


<script>
  import { isSupabaseConfigured, supabase } from '../../lib/supabase';
  import { demoSignIn, isMembershipDemoMode, memberAbsoluteUrl, memberPath } from '../../lib/member';
  import { createAuthFeedback } from '../../lib/auth-feedback';

  const form = document.querySelector<HTMLFormElement>('#member-login-form');
  const feedback = createAuthFeedback(form, 'login-message');
  const passwordForm = document.querySelector<HTMLFormElement>('#member-password-form');
  const passwordFeedback = createAuthFeedback(passwordForm, 'login-message');

  if (isMembershipDemoMode) {
    feedback.show('Membership sedang berjalan dalam mode demo. Form login nyata akan aktif setelah backend terhubung.');
    document.getElementById('demo-login')?.classList.remove('hidden');
    form?.querySelectorAll('input, button').forEach((el) => el.setAttribute('disabled', ''));
    document.getElementById('password-login-option')?.classList.add('hidden');
    passwordForm?.querySelectorAll('input, button').forEach((el) => el.setAttribute('disabled', ''));

    document.getElementById('demo-member-login')?.addEventListener('click', () => {
      demoSignIn('member');
      window.location.replace(memberPath('/member/'));
    });
    document.getElementById('demo-admin-login')?.addEventListener('click', () => {
      demoSignIn('admin');
      window.location.replace(memberPath('/member/'));
    });
  } else if (isSupabaseConfigured && supabase) {
    const params = new URLSearchParams(window.location.search);
    if (params.get('confirmed') === '1') feedback.show('Email berhasil dikonfirmasi. Silakan masuk.', 'success');
    if (params.get('reset') === '1') feedback.show('Password berhasil diperbarui. Silakan masuk.', 'success');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      await feedback.run('Mengirim…', async () => {
        const values = new FormData(form);
        const email = String(values.get('email') || '').trim().toLowerCase();
        const { error } = await supabase.auth.signInWithOtp({
          email,
          options: {
            shouldCreateUser: true,
            emailRedirectTo: memberAbsoluteUrl('/member/login/'),
          },
        });
        if (error) {
          // Avoid turning the login page into a public email-enumeration oracle.
          // Supabase may use throttling for unknown or frequently requested addresses.
          if (error.status === 429) {
            feedback.show('Terlalu banyak permintaan. Tunggu beberapa saat sebelum mencoba kembali.', 'error');
          } else if (/email.*not authorized/i.test(error.message)) {
            feedback.show('Layanan email belum siap untuk alamat ini. Hubungi pengurus PPI Ishikawa atau gunakan cara masuk sebelumnya.', 'error');
          } else {
            feedback.show('Tautan belum dapat dikirim. Periksa koneksi atau coba lagi nanti.', 'error');
          }
          return;
        }
        feedback.show('Jika alamat email dapat digunakan, tautan verifikasi telah dikirim. Periksa kotak masuk dan spam. Tautan hanya berlaku sekali.', 'success');
      }, 'Layanan email belum dapat dihubungi. Coba lagi.');
    });

    passwordForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      await passwordFeedback.run('Memproses…', async () => {
        const values = new FormData(passwordForm);
        const email = String(values.get('email') || '').trim();
        const password = String(values.get('password') || '');
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) {
          passwordFeedback.show('Email atau password belum dapat digunakan. Periksa kembali data Anda.', 'error');
          return;
        }
        window.location.replace(memberPath('/member/'));
      }, 'Login belum dapat diproses karena kendala koneksi. Coba lagi.');
    });

    document.getElementById('password-login-option')?.addEventListener('toggle', () => {
      const primaryEmail = form?.querySelector<HTMLInputElement>('[name="email"]')?.value || '';
      const legacyEmail = passwordForm?.querySelector<HTMLInputElement>('[name="email"]');
      if (legacyEmail && !legacyEmail.value) legacyEmail.value = primaryEmail;
    });

    try {
      const { data } = await supabase.auth.getUser();
      if (data.user) window.location.replace(memberPath('/member/'));
    } catch {
      // Users can still sign in via the form when the session pre-check fails.
    }
  }
</script>
</BaseLayout>
