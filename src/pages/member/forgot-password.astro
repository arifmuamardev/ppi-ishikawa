---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="Lupa Password" description="Pulihkan password Area Anggota PPI Ishikawa.">
  <AuthShell
    title="Pulihkan password"
    description="Masukkan email akun membership Anda. Tautan untuk membuat password baru akan dikirim melalui email."
  >

      <div id="forgot-message" class="mt-6 hidden rounded-2xl border p-4 text-sm leading-6"></div>
      <form id="forgot-form" class="mt-7 space-y-5">
        <label class="block">
          <span class="text-sm font-bold text-slate-800">Email</span>
          <input name="email" type="email" autocomplete="email" required class="ui-field mt-2" />
        </label>
        <button type="submit" class="w-full rounded-xl bg-brand px-5 py-3 font-bold text-white">Kirim tautan pemulihan</button>
      </form>
      <a href={withBase('/member/login/')} class="mt-6 inline-flex text-sm font-bold text-brand hover:underline">← Kembali ke login</a>
  </AuthShell>

  <script>
    import { isSupabaseConfigured, supabase } from '../../lib/supabase';
    import { memberAbsoluteUrl } from '../../lib/member';

    const form = document.getElementById('forgot-form');
    const message = document.getElementById('forgot-message');
    const show = (text, error = false) => {
      if (!message) return;
      message.textContent = text;
      message.className = `mt-6 rounded-2xl border p-4 text-sm leading-6 ${error ? 'border-red-200 bg-red-50 text-red-800' : 'border-emerald-200 bg-emerald-50 text-emerald-900'}`;
    };

    if (!isSupabaseConfigured || !supabase) {
      show('Mode demo tidak menggunakan password nyata. Gunakan tombol masuk demo pada halaman login. Password recovery akan aktif setelah backend membership terhubung.');
      form?.querySelectorAll('input, button').forEach((el) => el.setAttribute('disabled', ''));
    } else {
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const values = new FormData(form);
        const email = String(values.get('email') || '').trim();
        const redirectTo = memberAbsoluteUrl('/member/reset-password/');
        const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo });
        if (error) {
          show('Tautan pemulihan belum dapat dikirim. Coba lagi beberapa saat kemudian.', true);
          return;
        }
        show('Jika email tersebut terdaftar, tautan pemulihan telah dikirim.');
        form.reset();
      });
    }
  </script>
</BaseLayout>
