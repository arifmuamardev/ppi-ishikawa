---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import AuthFeedback from '../../components/AuthFeedback.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="Lupa Password" description="Pulihkan password Area Anggota PPI Ishikawa.">
  <AuthShell
    title="Pulihkan password"
    description="Masukkan email akun membership Anda. Tautan untuk membuat password baru akan dikirim melalui email."
  >

      <AuthFeedback id="forgot-message" />
      <form id="forgot-form" aria-busy="false" data-auth-state="idle" class="mt-7 space-y-5">
        <label class="block">
          <span class="text-sm font-bold text-slate-800">Email</span>
          <input name="email" type="email" autocomplete="email" required class="ui-field mt-2" />
        </label>
        <button type="submit" class="ui-action-primary w-full">Kirim tautan pemulihan</button>
      </form>
      <a href={withBase('/member/login/')} class="mt-6 inline-flex text-sm font-bold text-brand hover:underline">← Kembali ke login</a>
  </AuthShell>


<script>
  import { isSupabaseConfigured, supabase } from '../../lib/supabase';
  import { memberAbsoluteUrl } from '../../lib/member';
  import { createAuthFeedback } from '../../lib/auth-feedback';

  const form = document.querySelector<HTMLFormElement>('#forgot-form');
  const feedback = createAuthFeedback(form, 'forgot-message');

  if (!isSupabaseConfigured || !supabase) {
    feedback.show('Mode demo tidak menggunakan password nyata. Gunakan tombol masuk demo pada halaman login. Password recovery akan aktif setelah backend membership terhubung.');
    form?.querySelectorAll('input, button').forEach((el) => el.setAttribute('disabled', ''));
  } else {
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      await feedback.run('Mengirim…', async () => {
        const values = new FormData(form);
        const email = String(values.get('email') || '').trim();
        const redirectTo = memberAbsoluteUrl('/member/reset-password/');
        const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo });
        if (error) {
          feedback.show('Tautan pemulihan belum dapat dikirim. Coba lagi beberapa saat kemudian.', 'error');
          return;
        }
        feedback.show('Jika email tersebut terdaftar, tautan pemulihan telah dikirim.', 'success');
        form.reset();
      }, 'Layanan pemulihan belum dapat dihubungi. Coba lagi.');
    });
  }
</script>
</BaseLayout>
