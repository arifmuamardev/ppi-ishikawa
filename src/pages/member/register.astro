---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="Daftar Anggota" description="Masuk dan daftar anggota melalui satu formulir Magic Link.">
  <AuthShell
    eyebrow="Membership PPI Ishikawa"
    title="Daftar atau masuk dengan email"
    description="Sekarang cukup menggunakan satu formulir email untuk anggota baru maupun lama. Tidak perlu membuat password."
  >
    <p class="mt-6 text-sm leading-6 text-slate-700">Anda akan dialihkan ke halaman masuk atau daftar terpadu. Jika belum berpindah, gunakan tautan berikut.</p>
    <a class="ui-action-primary mt-5 inline-flex w-full justify-center" href={withBase('/member/login/')}>Lanjutkan dengan email</a>
  </AuthShell>
  <script>
    import { memberPath } from '../../lib/member';
    window.location.replace(memberPath('/member/login/'));
  </script>
</BaseLayout>
