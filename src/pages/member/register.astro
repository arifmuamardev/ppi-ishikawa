---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthShell from '../../components/AuthShell.astro';
import AuthFeedback from '../../components/AuthFeedback.astro';
import { campuses } from '../../data/campuses';
import { ishikawaCities, studyLevels } from '../../data/membership';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="Daftar Anggota" description="Pendaftaran membership PPI Ishikawa.">
  <AuthShell
    eyebrow="Membership PPI Ishikawa"
    title="Daftar sebagai anggota"
    description="Setelah email dikonfirmasi, pendaftaran akan berstatus menunggu verifikasi pengurus. Data yang Anda isi digunakan untuk administrasi keanggotaan dan tidak otomatis ditampilkan di direktori."
    size="md"
  >

      <AuthFeedback id="register-message" />

      <form id="member-register-form" aria-busy="false" data-auth-state="idle" class="mt-8 grid gap-5 md:grid-cols-2">
        <label class="md:col-span-2">
          <span class="text-sm font-bold text-slate-800">Nama lengkap</span>
          <input name="full_name" type="text" autocomplete="name" required class="ui-field mt-2" />
        </label>

        <label>
          <span class="text-sm font-bold text-slate-800">Email</span>
          <input name="email" type="email" autocomplete="email" required class="ui-field mt-2" />
        </label>
        <label>
          <span class="text-sm font-bold text-slate-800">Kampus</span>
          <select name="campus_slug" required class="ui-field mt-2">
            <option value="">Pilih kampus</option>
            {campuses.map((campus) => <option value={campus.slug}>{campus.shortName}</option>)}
          </select>
        </label>

        <label>
          <span class="text-sm font-bold text-slate-800">Program / jurusan</span>
          <input name="program" type="text" required placeholder="Contoh: Information Science" class="ui-field mt-2" />
        </label>
        <label>
          <span class="text-sm font-bold text-slate-800">Jenjang / status studi</span>
          <select name="study_level" required class="ui-field mt-2">
            <option value="">Pilih jenjang</option>
            {studyLevels.map((item) => <option value={item.value}>{item.label}</option>)}
          </select>
        </label>

        <label>
          <span class="text-sm font-bold text-slate-800">Bidang studi</span>
          <input name="field_of_study" type="text" placeholder="Contoh: Artificial Intelligence" class="ui-field mt-2" />
        </label>
        <label>
          <span class="text-sm font-bold text-slate-800">Kota tempat tinggal</span>
          <select name="city" class="ui-field mt-2">
            <option value="">Tidak diisi</option>
            {ishikawaCities.map((city) => <option value={city}>{city}</option>)}
          </select>
        </label>

        <label>
          <span class="text-sm font-bold text-slate-800">Password</span>
          <input name="password" type="password" minlength="8" autocomplete="new-password" required class="ui-field mt-2" />
        </label>
        <label>
          <span class="text-sm font-bold text-slate-800">Ulangi password</span>
          <input name="password_confirm" type="password" minlength="8" autocomplete="new-password" required class="ui-field mt-2" />
        </label>

        <label class="md:col-span-2 flex items-start gap-3 rounded-2xl bg-slate-50 p-4">
          <input name="consent" type="checkbox" required class="ui-check mt-0.5" />
          <span class="text-sm leading-6 text-slate-600">Saya memahami bahwa data ini digunakan untuk verifikasi dan pengelolaan membership PPI Ishikawa. Saya dapat mengatur sendiri apakah profil saya tampil di direktori anggota.</span>
        </label>

        <div class="md:col-span-2 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <a href={withBase('/member/login/')} class="text-sm font-bold text-brand hover:underline">← Sudah punya akun</a>
          <button type="submit" class="ui-action-primary">Daftar</button>
        </div>
      </form>
  </AuthShell>


<script>
  import { isSupabaseConfigured, supabase } from '../../lib/supabase';
  import { demoRegister, isMembershipDemoMode, memberAbsoluteUrl, memberPath } from '../../lib/member';
  import { createAuthFeedback } from '../../lib/auth-feedback';

  const form = document.querySelector<HTMLFormElement>('#member-register-form');
  const feedback = createAuthFeedback(form, 'register-message');
  const confirmationField = form?.querySelector<HTMLInputElement>('[name="password_confirm"]');

  if (isMembershipDemoMode) {
    feedback.show('Mode demo aktif. Data pendaftaran hanya akan disimpan di browser ini dan tidak dikirim ke PPI Ishikawa.');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const values = new FormData(form);
      const password = String(values.get('password') || '');
      const confirmation = String(values.get('password_confirm') || '');
      if (password !== confirmation) {
        feedback.show('Password dan konfirmasi password tidak sama.', 'error', confirmationField ?? undefined);
        return;
      }
      demoRegister({
        full_name: String(values.get('full_name') || '').trim(),
        email: String(values.get('email') || '').trim(),
        campus_slug: String(values.get('campus_slug') || ''),
        program: String(values.get('program') || '').trim(),
        study_level: String(values.get('study_level') || ''),
        field_of_study: String(values.get('field_of_study') || '').trim(),
        city: String(values.get('city') || ''),
      });
      window.location.replace(memberPath('/member/'));
    });
  } else if (isSupabaseConfigured && supabase) {
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const values = new FormData(form);
      const password = String(values.get('password') || '');
      const confirmation = String(values.get('password_confirm') || '');
      if (password !== confirmation) {
        feedback.show('Password dan konfirmasi password tidak sama.', 'error', confirmationField ?? undefined);
        return;
      }

      await feedback.run('Mendaftarkan…', async () => {
        const redirectTo = memberAbsoluteUrl('/member/login/?confirmed=1');
        const { data, error } = await supabase.auth.signUp({
          email: String(values.get('email') || '').trim(),
          password,
          options: {
            emailRedirectTo: redirectTo,
            data: {
              full_name: String(values.get('full_name') || '').trim(),
              campus_slug: String(values.get('campus_slug') || ''),
              program: String(values.get('program') || '').trim(),
              study_level: String(values.get('study_level') || ''),
              field_of_study: String(values.get('field_of_study') || '').trim(),
              city: String(values.get('city') || ''),
            },
          },
        });

        if (error) {
          feedback.show('Pendaftaran belum dapat diproses. Periksa email, password, dan data yang Anda isi.', 'error');
          return;
        }

        form.reset();
        if (data.session) {
          window.location.replace(memberPath('/member/'));
        } else {
          feedback.show('Pendaftaran diterima. Periksa email Anda untuk konfirmasi, lalu masuk. Setelah itu status membership akan menunggu verifikasi pengurus.', 'success');
        }
      }, 'Pendaftaran belum dapat diproses karena kendala koneksi. Coba lagi.');
    });
  }
</script>
</BaseLayout>
