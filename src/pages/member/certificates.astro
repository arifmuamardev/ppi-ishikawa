---
import MemberLayout from '../../layouts/MemberLayout.astro';
import AppPageHeader from '../../components/AppPageHeader.astro';
---

<MemberLayout title="Sertifikat" requireApproved={true}>
  <div class="space-y-6">
    <AppPageHeader
      eyebrow="Sertifikat"
      title="Sertifikat & verifikasi"
      description="Sertifikat yang diterbitkan PPI Ishikawa memiliki nomor dan QR verifikasi publik. QR tidak membuka data kontak atau profil pribadi Anda."
    />

    <div id="certificate-empty" role="status" aria-live="polite" class="hidden rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-600">Belum ada sertifikat yang diterbitkan untuk akun Anda.</div>
    <section id="certificate-list" class="space-y-5"></section>
  </div>

  <script>
    import QRCode from 'qrcode';
    import { memberAbsoluteUrl } from '../../lib/member';
    import { getCurrentMember } from '../../lib/member';
    import { getMyCertificates } from '../../lib/member-advanced';

    const list = document.getElementById('certificate-list');
    const empty = document.getElementById('certificate-empty');
    const member = await getCurrentMember();

    const { data, error } = await getMyCertificates();
    const certificates = error ? [] : (data || []);
    empty?.classList.toggle('hidden', certificates.length !== 0);

    for (const certificate of certificates) {
      const card = document.createElement('article');
      card.className = 'certificate-print rounded-[2rem] border border-slate-200 bg-white p-7 sm:p-9';
      card.dataset.certificateId = certificate.id;

      const header = document.createElement('div');
      header.className = 'flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between';

      const info = document.createElement('div');
      const eyebrow = document.createElement('p');
      eyebrow.className = 'type-eyebrow text-brand';
      eyebrow.textContent = 'PPI Ishikawa · Certificate';
      const h = document.createElement('h2');
      h.className = 'mt-2 text-2xl font-bold text-slate-950';
      h.textContent = certificate.title;
      const name = document.createElement('p');
      name.className = 'mt-5 text-lg font-semibold text-slate-800';
      name.textContent = member.profile?.full_name || 'Anggota PPI Ishikawa';
      const desc = document.createElement('p');
      desc.className = 'mt-3 max-w-2xl text-sm leading-7 text-slate-600';
      desc.textContent = certificate.description || (certificate.member_events?.title ? `Partisipasi pada ${certificate.member_events.title}` : 'Sertifikat PPI Ishikawa.');
      info.append(eyebrow, h, name, desc);

      const qrBox = document.createElement('div');
      qrBox.className = 'shrink-0 rounded-2xl bg-slate-50 p-3';
      const canvas = document.createElement('canvas');
      qrBox.append(canvas);

      const verifyUrl = memberAbsoluteUrl(`/verify/certificate/?token=${encodeURIComponent(certificate.verification_token)}`);
      await QRCode.toCanvas(canvas, verifyUrl, { width: 135, margin: 1, errorCorrectionLevel: 'M' });

      header.append(info, qrBox);

      const footer = document.createElement('div');
      footer.className = 'mt-7 flex flex-col gap-4 border-t border-slate-100 pt-5 sm:flex-row sm:items-end sm:justify-between';
      const metadata = document.createElement('div');
      metadata.className = 'text-xs leading-5 text-slate-500';
      metadata.innerHTML = `<p><strong class="text-slate-700">No.</strong> ${certificate.certificate_number}</p><p><strong class="text-slate-700">Terbit:</strong> ${new Intl.DateTimeFormat('id-ID', { dateStyle: 'long' }).format(new Date(certificate.issued_at))}</p>`;
      const controls = document.createElement('div');
      controls.className = 'no-print flex gap-2';
      const verifyLink = document.createElement('a');
      verifyLink.href = verifyUrl; verifyLink.target = '_blank'; verifyLink.rel = 'noreferrer';
      verifyLink.className = 'rounded-xl border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700';
      verifyLink.textContent = 'Verifikasi ↗';
      const print = document.createElement('button');
      print.type = 'button'; print.className = 'rounded-xl bg-brand px-4 py-2 text-sm font-bold text-white'; print.textContent = 'Cetak';
      print.addEventListener('click', () => {
        document.querySelectorAll('.certificate-print').forEach((el) => el.removeAttribute('data-printing'));
        card.dataset.printing = 'true';
        window.print();
        setTimeout(() => card.removeAttribute('data-printing'), 250);
      });
      controls.append(verifyLink, print);
      footer.append(metadata, controls);
      card.append(header, footer);
      list?.append(card);
    }
  </script>

  <style is:global>
    @media print {
      body * { visibility: hidden !important; }
      .certificate-print[data-printing="true"],
      .certificate-print[data-printing="true"] * { visibility: visible !important; }
      .certificate-print[data-printing="true"] { position: fixed; inset: 15mm; }
      .no-print { display: none !important; }
    }
  </style>
</MemberLayout>
