---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TopicIcon from '../../../components/TopicIcon.astro';
import { withBase } from '../../../utils/paths';
import { familyActivityFilters, familyActivityPlaces } from '../../../data/family-activities';
import { familyLastVerified } from '../../../data/family';

const tagLabels: Record<string, string> = {
  indoor: 'Indoor',
  outdoor: 'Outdoor',
  free: 'Gratis',
  baby: 'Bayi',
  preschool: 'Preschool',
  school: 'Anak sekolah',
  winter: 'Winter / hujan'
};
---

<BaseLayout
  title="Aktivitas keluarga di Ishikawa"
  description="Direktori aktivitas keluarga PPI Ishikawa: indoor, outdoor, gratis, bayi, preschool, anak sekolah, dan pilihan saat hujan atau winter."
>
  <section class="mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <Breadcrumbs items={[
      { label: 'Beranda', href: '/' },
      { label: 'Hidup di Ishikawa', href: '/life-in-ishikawa/' },
      { label: 'Family', href: '/life-in-ishikawa/family-anak/' },
      { label: 'Aktivitas keluarga' }
    ]} />
    <div class="mt-8 max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Family · F06</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Cari aktivitas sesuai kondisi keluarga.</h1>
      <p class="mt-5 text-lg leading-8 text-slate-600">
        Tidak semua keluarga membutuhkan tempat yang sama. Pilih berdasarkan cuaca, usia anak, energi yang ingin dikeluarkan, dan biaya.
        Direktori awal ini memprioritaskan fasilitas publik atau tempat dengan sumber resmi yang mudah diverifikasi.
      </p>
      <p class="mt-4 text-xs font-semibold uppercase tracking-[0.12em] text-slate-400">Terakhir diverifikasi · {familyLastVerified}</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-8 lg:px-8">
    <div class="rounded-3xl border border-accent/35 bg-accent/10 p-6 sm:p-8">
      <div class="grid gap-5 md:grid-cols-3">
        <div>
          <p class="text-sm font-bold text-slate-950">Saat hujan / salju</p>
          <p class="mt-2 text-sm leading-6 text-slate-700">Mulai dari Indoor atau Winter / hujan. Ini penting di Ishikawa karena cuaca dapat berubah cepat.</p>
        </div>
        <div>
          <p class="text-sm font-bold text-slate-950">Bayi & toddler</p>
          <p class="mt-2 text-sm leading-6 text-slate-700">Prioritaskan nursing space, diaper-changing facility, area usia kecil, dan durasi outing yang pendek.</p>
        </div>
        <div>
          <p class="text-sm font-bold text-slate-950">Anak sekolah</p>
          <p class="mt-2 text-sm leading-6 text-slate-700">Cari ruang gerak lebih besar, aktivitas edukatif, atau kombinasi outdoor + library/museum.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-8 lg:px-8">
    <div class="flex flex-wrap gap-2" aria-label="Filter aktivitas keluarga">
      {familyActivityFilters.map((filter) => (
        <button
          type="button"
          class:list={[
            'activity-filter rounded-full border px-4 py-2 text-sm font-bold transition',
            filter.id === 'all'
              ? 'border-slate-950 bg-slate-950 text-white'
              : 'border-slate-300 bg-white text-slate-700 hover:border-accent/50 hover:bg-accent/10'
          ]}
          data-filter={filter.id}
          aria-pressed={filter.id === 'all' ? 'true' : 'false'}
        >
          {filter.label}
        </button>
      ))}
    </div>

    <p id="activity-count" class="mt-5 text-sm font-semibold text-slate-500">{familyActivityPlaces.length} tempat ditampilkan</p>

    <div id="activity-grid" class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {familyActivityPlaces.map((place) => (
        <article
          class="activity-place flex h-full flex-col rounded-3xl border border-slate-200 bg-white p-6 shadow-sm"
          data-tags={place.tags.join(' ')}
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.13em] text-brand">{place.area}</p>
              <h2 class="mt-2 text-xl font-bold leading-7 text-slate-950">{place.name}</h2>
            </div>
            <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-700">{place.costLabel}</span>
          </div>

          <p class="mt-4 text-sm leading-6 text-slate-600">{place.summary}</p>

          <div class="mt-4 flex flex-wrap gap-1.5">
            {place.tags.map((tag) => (
              <span class="rounded-full bg-accent/10 px-2.5 py-1 text-[11px] font-bold text-secondary-dark">{tagLabels[tag]}</span>
            ))}
          </div>

          <dl class="mt-5 space-y-3 text-sm">
            <div>
              <dt class="font-bold text-slate-900">Cocok untuk</dt>
              <dd class="mt-1 leading-6 text-slate-600">{place.bestFor}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-900">Lokasi</dt>
              <dd class="mt-1 leading-6 text-slate-600">{place.address}</dd>
            </div>
          </dl>

          {place.note && <p class="mt-5 rounded-2xl bg-slate-50 p-4 text-xs leading-5 text-slate-600">{place.note}</p>}

          <div class="mt-auto pt-5">
            <a href={place.sourceUrl} target="_blank" rel="noreferrer" class="text-sm font-bold text-brand hover:underline">
              Cek {place.sourceLabel} ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-2">
      <div class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-red-300">Evergreen by design</p>
        <h2 class="mt-3 text-2xl font-bold">Kami tidak menyalin kalender event harian.</h2>
        <p class="mt-4 text-sm leading-7 text-slate-300">
          Jam buka, event, maintenance, seasonal closure, dan harga dapat berubah. Karena itu direktori ini membantu memilih tempat,
          sedangkan informasi operasional terakhir tetap diperiksa pada situs resmi masing-masing.
        </p>
      </div>
      <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">Cakupan awal</p>
        <h2 class="mt-3 text-2xl font-bold text-slate-950">Cakupan sekarang: Kanazawa, Nonoichi, Hakusan, dan Nomi.</h2>
        <p class="mt-4 text-sm leading-7 text-slate-600">
          Direktori ini sekarang mencakup area yang dekat dengan sebagian besar kampus anggota PPI Ishikawa. Tempat lain akan ditambahkan hanya setelah sumber resmi dan kegunaan praktisnya untuk keluarga diverifikasi.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 pt-4 lg:px-8">
    <div class="flex flex-wrap gap-3">
      <a href={withBase('/life-in-ishikawa/family-anak/')} class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800 hover:bg-slate-50">← Keluarga</a>
      <a href="https://www.kanazawa-kosodate.net/" target="_blank" rel="noreferrer" class="rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">Event keluarga terbaru ↗</a>
    </div>
  </section>

  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.activity-filter'));
    const places = Array.from(document.querySelectorAll<HTMLElement>('.activity-place'));
    const count = document.getElementById('activity-count');

    const applyFilter = (filter: string) => {
      let visible = 0;
      for (const place of places) {
        const tags = (place.dataset.tags || '').split(' ');
        const show = filter === 'all' || tags.includes(filter);
        place.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }

      for (const button of buttons) {
        const active = button.dataset.filter === filter;
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        button.classList.toggle('border-slate-950', active);
        button.classList.toggle('bg-slate-950', active);
        button.classList.toggle('text-white', active);
        button.classList.toggle('border-slate-300', !active);
        button.classList.toggle('bg-white', !active);
        button.classList.toggle('text-slate-700', !active);
      }

      if (count) count.textContent = `${visible} tempat ditampilkan`;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter || 'all';
        applyFilter(filter);
        const url = new URL(window.location.href);
        if (filter === 'all') url.searchParams.delete('filter');
        else url.searchParams.set('filter', filter);
        window.history.replaceState({}, '', url);
      });
    }

    const requestedFilter = new URLSearchParams(window.location.search).get('filter') || 'all';
    const validFilters = buttons.map((button) => button.dataset.filter || 'all');
    applyFilter(validFilters.includes(requestedFilter) ? requestedFilter : 'all');
  </script>
</BaseLayout>
