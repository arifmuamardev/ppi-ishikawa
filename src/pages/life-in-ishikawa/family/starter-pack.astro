---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TopicIcon from '../../../components/TopicIcon.astro';
import { withBase } from '../../../utils/paths';
import { familyLastVerified } from '../../../data/family';

const groups = [
  {
    code: 'A',
    title: 'Sebelum keluarga datang',
    icon: 'documents',
    items: [
      'Residence status / visa setiap anggota keluarga sudah jelas.',
      'Paspor, COE/visa, marriage/birth certificate, dan dokumen hubungan keluarga tersimpan.',
      'Housing mengizinkan jumlah penghuni yang akan tinggal bersama.',
      'Vaccination record, medical record penting, prescription, dan school record anak dibawa.',
      'Municipality tempat tinggal sudah diketahui.',
      'Jika butuh nursery/kodomo-en, application period sudah dicek sebelum kedatangan.'
    ],
    href: '/life-in-ishikawa/family/datang-bersama-keluarga/',
    label: 'Panduan datang bersama keluarga'
  },
  {
    code: 'B',
    title: '14 hari pertama',
    icon: 'arrival',
    highlight: 'Mid-to-long-term residents: laporkan alamat ke municipality dalam 14 hari setelah menetapkan tempat tinggal.',
    items: [
      'Moving-in/address notification selesai.',
      'Residence card/passport dan family relationship documents siap bila diminta.',
      'Health insurance setiap anggota keluarga sudah dicek.',
      'My Number / resident registration documents sudah dipahami.',
      'Kontak City Hall, kampus, sekolah/daycare, PPI, dan IFIE sudah disimpan.'
    ],
    href: '/life-in-ishikawa/family/timeline/',
    label: 'Lihat Family Timeline'
  },
  {
    code: 'C',
    title: 'Anak & layanan keluarga',
    icon: 'family',
    items: [
      'Child allowance dan child medical support sudah dicek berdasarkan municipality.',
      'Vaccination record anak sudah dicocokkan dengan jadwal lokal.',
      'Jika usia sekolah: enrollment/transfer dan Japanese-language support sudah dikonfirmasi.',
      'Jika membutuhkan childcare: application, certification category, dan start date sudah dicek.',
      'Pediatric clinic dan after-hours medical route sudah diketahui.'
    ],
    href: '/life-in-ishikawa/family/municipality/',
    label: 'Pilih municipality'
  },
  {
    code: 'D',
    title: 'Kehamilan / bayi',
    icon: 'health',
    items: [
      'Pregnancy notification dilakukan setelah kehamilan terkonfirmasi.',
      'Mother and Child Health Handbook diterima dari municipality.',
      'Prenatal checkup dan rencana fasilitas persalinan sudah diatur.',
      'Jika bayi lahir: birth notification, passport/nationality, residence status, insurance, allowance, dan medical support diproses.',
      'Jika bayi foreign national akan tinggal lebih dari 60 hari: acquisition of status of residence diperiksa dalam 30 hari sejak lahir.'
    ],
    href: '/life-in-ishikawa/family/kehamilan-kelahiran/',
    label: 'Panduan kehamilan & kelahiran'
  },
  {
    code: 'E',
    title: 'Rutinitas keluarga',
    icon: 'guide',
    items: [
      'Folder dokumen keluarga dibuat: residence, insurance, health, school, childcare, allowance.',
      'Renewal date, school calendar, health check, dan application period dimasukkan ke kalender.',
      'Emergency bag keluarga dan winter preparation tersedia.',
      'Rute harian: supermarket, clinic, school/daycare, bus/parking sudah dipahami.',
      'Pilih ruang bermain, library, atau community space yang dekat untuk rutinitas anak.'
    ],
    href: '/life-in-ishikawa/family/aktivitas/',
    label: 'Cari aktivitas keluarga'
  },
  {
    code: 'F',
    title: 'Saat pindah atau pulang',
    icon: 'city',
    items: [
      'Moving-out notification dan moving-in di municipality baru disiapkan.',
      'School/nursery diberi tahu dan transfer documents diambil.',
      'Child allowance, medical subsidy, insurance, dan health records dipindahkan/ditutup sesuai kebutuhan.',
      'Jika meninggalkan Jepang: residence, insurance, pension, bank, utilities, school, dan childcare dicek satu per satu.'
    ],
    href: '/life-in-ishikawa/leaving/',
    label: 'Panduan meninggalkan Ishikawa/Jepang'
  }
];

const emergency = [
  ['Ambulance / Fire', '119'],
  ['Police', '110'],
  ['IFIE consultation', 'https://www.ifie.or.jp/foreigners_life/soudan/'],
  ['Family by Municipality', '/life-in-ishikawa/family/municipality/']
];

const sources = [
  {
    owner: 'Immigration Services Agency',
    title: 'Procedures at Municipal Offices',
    note: 'Address notification untuk mid-to-long-term residents dan prosedur moving.',
    url: 'https://www.moj.go.jp/isa/content/001450969.pdf'
  },
  {
    owner: 'Immigration Services Agency',
    title: 'Acquisition of Status of Residence after Birth',
    note: 'Untuk bayi foreign national yang akan tinggal lebih dari 60 hari.',
    url: 'https://www.moj.go.jp/isa/applications/procedures/16-10.html'
  },
  {
    owner: 'Kanazawa City',
    title: 'A Guide to Living in Kanazawa 2026',
    note: 'Contoh living guide resmi foreign residents; layanan keluarga tetap mengikuti municipality masing-masing.',
    url: 'https://www4.city.kanazawa.lg.jp/material/files/group/6/seikatsu_guide_2026_en.pdf'
  }
];
---

<BaseLayout
  title="Family Starter Pack"
  description="Checklist ringkas untuk keluarga mahasiswa Indonesia di Ishikawa: sebelum datang, 14 hari pertama, anak, kesehatan, municipality, emergency, dan pindah."
>
  <section class="starter-hero mx-auto max-w-6xl px-5 pb-8 pt-16 lg:px-8 lg:pt-24">
    <Breadcrumbs items={[
      { label: 'Beranda', href: '/' },
      { label: 'Hidup di Ishikawa', href: '/life-in-ishikawa/' },
      { label: 'Family', href: '/life-in-ishikawa/family-anak/' },
      { label: 'Starter Pack' }
    ]} />

    <div class="mt-8 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-4xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Family · F10</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Family Starter Pack</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Checklist ringkas untuk keluarga yang akan datang atau baru mulai tinggal di Ishikawa.
          Centang yang sudah selesai, lalu buka panduan detail hanya ketika diperlukan.
        </p>
        <p class="mt-4 text-xs font-semibold uppercase tracking-[0.12em] text-slate-400">Terakhir diverifikasi · {familyLastVerified}</p>
      </div>

      <button id="print-starter-pack" type="button" class="no-print inline-flex shrink-0 items-center justify-center rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800">
        Cetak / Simpan PDF
      </button>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-8 lg:px-8">
    <div class="rounded-3xl border border-accent/35 bg-accent/10 p-6 sm:p-8">
      <div class="grid gap-5 md:grid-cols-3">
        <div>
          <p class="font-bold text-slate-950">Gunakan sebagai checklist</p>
          <p class="mt-2 text-sm leading-6 text-slate-700">Kotak centang ini untuk membantu mengingat, bukan bukti bahwa suatu prosedur resmi selesai.</p>
        </div>
        <div>
          <p class="font-bold text-slate-950">Ikuti municipality Anda</p>
          <p class="mt-2 text-sm leading-6 text-slate-700">Childcare, school, medical subsidy, dan banyak benefit mengikuti kota tempat alamat terdaftar.</p>
        </div>
        <div>
          <p class="font-bold text-slate-950">Cek sumber asli</p>
          <p class="mt-2 text-sm leading-6 text-slate-700">Deadline, eligibility, fee, dan formulir dapat berubah meskipun alurnya tetap sama.</p>
        </div>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-6xl px-5 py-8 lg:px-8">
    <div class="grid gap-6">
      {groups.map((group) => (
        <section class="starter-section rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-accent/10 text-brand">
              <TopicIcon name={group.icon as any} class="size-6" />
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-full bg-slate-950 px-3 py-1 text-xs font-bold text-white">{group.code}</span>
                <h2 class="text-2xl font-bold tracking-tight text-slate-950">{group.title}</h2>
              </div>

              {group.highlight && (
                <p class="mt-4 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm font-bold leading-6 text-red-900">{group.highlight}</p>
              )}

              <div class="mt-5 space-y-3">
                {group.items.map((item, index) => (
                  <label class="starter-item flex cursor-pointer gap-3 rounded-xl p-2 transition hover:bg-slate-50">
                    <input type="checkbox" class="mt-0.5 size-5 shrink-0 accent-slate-950" data-check={group.code + '-' + index} />
                    <span class="text-sm leading-6 text-slate-700">{item}</span>
                  </label>
                ))}
              </div>

              <a href={withBase(group.href)} class="no-print mt-5 inline-flex text-sm font-bold text-brand hover:underline">{group.label} →</a>
            </div>
          </div>
        </section>
      ))}
    </div>
  </main>

  <section class="mx-auto max-w-6xl px-5 py-8 lg:px-8">
    <div class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-red-300">Simpan di HP</p>
      <h2 class="mt-3 text-2xl font-bold">Kontak & shortcut penting</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {emergency.map(([label, value]) => (
          value.startsWith('http') || value.startsWith('/') ? (
            <a href={value.startsWith('/') ? withBase(value) : value} target={value.startsWith('http') ? '_blank' : undefined} rel={value.startsWith('http') ? 'noreferrer' : undefined} class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-400">{label}</p>
              <p class="mt-2 font-bold text-white">Buka ↗</p>
            </a>
          ) : (
            <div class="rounded-2xl border border-slate-700 bg-slate-900 p-4">
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-400">{label}</p>
              <p class="mt-2 text-2xl font-bold text-white">{value}</p>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-8 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">Progress checklist</p>
      <div class="mt-3 flex items-end gap-3">
        <p id="starter-progress" class="text-3xl font-bold text-slate-950">0%</p>
        <p id="starter-progress-detail" class="pb-1 text-sm text-slate-500">0 item selesai</p>
      </div>
      <div class="mt-4 h-3 overflow-hidden rounded-full bg-slate-100">
        <div id="starter-progress-bar" class="h-full w-0 rounded-full bg-slate-950 transition-[width]"></div>
      </div>
      <p class="mt-4 text-xs leading-5 text-slate-500">Progress disimpan hanya di browser/perangkat ini. Tidak dikirim ke server PPI.</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-8 lg:px-8">
    <div class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.14em] text-red-300">Sumber resmi utama</p>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {sources.map((source) => (
          <a href={source.url} target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-700 bg-slate-900 p-5 transition hover:border-slate-500 hover:bg-slate-800">
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-400">{source.owner}</p>
            <h3 class="mt-2 font-bold text-white">{source.title} ↗</h3>
            <p class="mt-2 text-sm leading-6 text-slate-400">{source.note}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="no-print mx-auto max-w-6xl px-5 pb-24 pt-4 lg:px-8">
    <div class="flex flex-wrap gap-3">
      <a href={withBase('/life-in-ishikawa/family-anak/')} class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-800 hover:bg-slate-50">← Keluarga</a>
      <a href={withBase('/life-in-ishikawa/family/timeline/')} class="rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">Lihat timeline lengkap →</a>
    </div>
  </section>

  <script>
    const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('[data-check]'));
    const progress = document.getElementById('starter-progress');
    const detail = document.getElementById('starter-progress-detail');
    const bar = document.getElementById('starter-progress-bar');
    const printButton = document.getElementById('print-starter-pack');
    const storageKey = 'ppi-ishikawa-family-starter-pack-v1';

    let saved: Record<string, boolean> = {};
    try {
      saved = JSON.parse(localStorage.getItem(storageKey) || '{}');
    } catch {
      saved = {};
    }

    for (const checkbox of checkboxes) {
      const key = checkbox.dataset.check || '';
      checkbox.checked = Boolean(saved[key]);
    }

    const updateProgress = () => {
      const done = checkboxes.filter((checkbox) => checkbox.checked).length;
      const total = checkboxes.length;
      const percent = total ? Math.round((done / total) * 100) : 0;

      if (progress) progress.textContent = percent + '%';
      if (detail) detail.textContent = done + ' dari ' + total + ' item selesai';
      if (bar) (bar as HTMLElement).style.width = percent + '%';

      const next: Record<string, boolean> = {};
      for (const checkbox of checkboxes) {
        const key = checkbox.dataset.check || '';
        if (key) next[key] = checkbox.checked;
      }
      localStorage.setItem(storageKey, JSON.stringify(next));
    };

    for (const checkbox of checkboxes) {
      checkbox.addEventListener('change', updateProgress);
    }

    printButton?.addEventListener('click', () => window.print());
    updateProgress();
  </script>

  <style>
    @media print {
      :global(header),
      :global(footer),
      .no-print {
        display: none !important;
      }

      :global(body) {
        background: white !important;
      }

      .starter-hero {
        padding-top: 1rem !important;
      }

      .starter-section {
        break-inside: avoid;
        box-shadow: none !important;
      }

      main,
      section {
        max-width: none !important;
      }

      a {
        color: inherit !important;
        text-decoration: none !important;
      }
    }
  </style>
</BaseLayout>
