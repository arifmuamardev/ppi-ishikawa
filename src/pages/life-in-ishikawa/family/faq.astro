const sections = [
  {
    title: 'Apakah pasangan mahasiswa bisa ikut tinggal di Jepang?',
    intro: 'Bisa dalam kondisi yang sesuai, tetapi status tinggal pasangan/anak harus diproses tersendiri. Dependent / 家族滞在 dapat relevan untuk pasangan dan anak yang menjadi tanggungan pemegang status Student.',
