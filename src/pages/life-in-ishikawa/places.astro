---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinderHeader from '../../components/FinderHeader.astro';
import ResultCard from '../../components/ResultCard.astro';
import InteractiveMap from '../../components/InteractiveMap.astro';
import type { CampusMapPoint } from '../../data/campus-map';
import {
  ishikawaPlaces,
  mappablePlaces,
  placeCategoryLabels,
  placeCities,
  type PlaceCategory
} from '../../data/places';
import { withBase } from '../../utils/paths';

const categories = Object.entries(placeCategoryLabels) as [PlaceCategory, string][];

const mapPoints: CampusMapPoint[] = mappablePlaces.map((place) => ({
  id: place.id,
  name: place.name,
  shortName: place.shortName,
  city: place.city,
  lat: place.lat,
  lng: place.lng,
  address: place.address,
  officialUrl: place.officialUrl,
  approximate: place.approximate
}));

const googleMapsUrl = (address: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---

<BaseLayout
  title="Direktori Tempat di Ishikawa"
  description="Direktori lokasi praktis untuk pelajar Indonesia di Ishikawa: kampus, pemerintah lokal, dukungan warga asing, kesehatan, dan kebutuhan keluarga."
>
  <FinderHeader
    breadcrumbs={[
      { label: 'Beranda', href: '/' },
      { label: 'Hidup di Ishikawa', href: '/life-in-ishikawa/' },
      { label: 'Direktori Tempat' }
    ]}
    eyebrow="Direktori"
    title="Direktori Tempat di Ishikawa"
    description="Tempat praktis untuk pelajar Indonesia di Ishikawa, dikumpulkan berdasarkan kebutuhan dan dirujukkan ke sumber resmi masing-masing lokasi."
  >
    <div slot="meta" class="flex flex-wrap gap-2 text-xs font-semibold text-slate-600">
      <span class="rounded-full bg-slate-100 px-3 py-2">{ishikawaPlaces.length} tempat</span>
      <span class="rounded-full bg-slate-100 px-3 py-2">{mappablePlaces.length} titik terpetakan</span>
      <span class="rounded-full bg-slate-100 px-3 py-2">{placeCities.length} kota/area</span>
    </div>
  </FinderHeader>

  <div class="flex flex-col">
  <section class="order-3 mx-auto w-full max-w-7xl px-5 pb-24 lg:order-2 lg:px-8 lg:pb-14">
    <div id="places-map-panel">
      <InteractiveMap
        points={mapPoints}
        heightClass="h-[420px] sm:h-[500px]"
        showLegend={false}
        ariaLabel="Peta direktori tempat di Ishikawa"
      />
      <p class="mt-3 text-xs leading-5 text-slate-500">
        Peta mengikuti filter yang aktif dan hanya menampilkan lokasi dengan koordinat yang sudah tersedia. Tempat lain tetap dapat dibuka melalui Google Maps berdasarkan alamat resmi.
      </p>
    </div>
    <div id="places-map-empty" role="status" aria-live="polite" class="hidden rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-7 text-center">
      <p class="font-bold text-slate-900">Belum ada koordinat terverifikasi untuk hasil filter ini.</p>
      <p class="mt-2 text-sm text-slate-500">Daftar tempat di bawah tetap dapat digunakan dan setiap kartu memiliki link navigasi berdasarkan alamat resmi.</p>
    </div>
  </section>

  <section class="order-1 mx-auto w-full max-w-7xl px-5 pb-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-5">
        <div>
          <p class="type-eyebrow text-brand">Filter</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">Pilih kategori atau kota. Filter bekerja langsung di browser tanpa layanan peta eksternal.</p>
        </div>

        <div>
          <label for="place-search" class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Cari tempat atau kebutuhan</label>
          <input
            id="place-search"
            type="search"
            placeholder="Contoh: anak, konsultasi, city hall, Kanazawa..."
            class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-slate-400"
          />
        </div>

        <div>
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Kategori</p>
          <div class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:pb-0" data-category-filters role="group" aria-label="Filter kategori tempat">
            <button type="button" data-category="" aria-pressed="true" class="place-filter min-h-11 shrink-0 rounded-full bg-slate-900 px-4 text-sm font-semibold text-white">Semua</button>
            {categories.map(([key, label]) => (
              <button type="button" data-category={key} aria-pressed="false" class="place-filter min-h-11 shrink-0 rounded-full border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">{label}</button>
            ))}
          </div>
        </div>

        <div>
          <label for="place-city" class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Kota / area</label>
          <select id="place-city" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 sm:max-w-xs">
            <option value="">Semua kota</option>
            {placeCities.map((city) => <option value={city}>{city}</option>)}
          </select>
        </div>
      </div>
    </div>
  </section>

  <section class="order-2 mx-auto w-full max-w-7xl px-5 pb-10 lg:order-3 lg:px-8 lg:pb-24">
    <div class="mb-4 flex items-center justify-between gap-4">
      <p class="text-sm text-slate-500" aria-live="polite" aria-atomic="true"><span id="place-count" class="font-bold text-slate-900">{ishikawaPlaces.length}</span> tempat ditampilkan</p>
      <a href={withBase('/life-in-ishikawa/municipality-guides/')} class="text-sm font-bold text-brand hover:underline">Panduan municipality →</a>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" id="places-grid">
      {ishikawaPlaces.map((place) => (
        <ResultCard
          class="place-card flex h-full flex-col p-5"
          data-place-id={place.id}
          data-mappable={typeof place.lat === 'number' && typeof place.lng === 'number' ? 'true' : 'false'}
          data-category={place.category}
          data-city={place.city}
          data-search={[place.name, place.shortName, place.city, place.address, place.description, ...place.tags].join(' ').toLowerCase()}
        >
          <div class="flex items-start justify-between gap-3">
            <span class="rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-brand">{placeCategoryLabels[place.category]}</span>
            <span class="text-xs font-semibold text-slate-400">{place.city}</span>
          </div>

          <h2 class="mt-4 text-xl font-bold tracking-tight text-slate-950">{place.name}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{place.description}</p>

          <div class="mt-4 rounded-2xl bg-slate-50 p-4">
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Alamat</p>
            <p class="mt-1 text-sm leading-6 text-slate-700">{place.address}</p>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            {place.tags.slice(0, 4).map((tag) => (
              <span class="rounded-full border border-slate-200 px-2.5 py-1 text-[11px] font-semibold text-slate-500">{tag}</span>
            ))}
          </div>

          <div class="mt-auto flex flex-wrap gap-2 pt-5">
            <a
              href={place.officialUrl}
              target="_blank"
              rel="noreferrer"
              class="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-slate-700"
            >
              Sumber resmi ↗
            </a>
            <a
              href={googleMapsUrl(place.address)}
              target="_blank"
              rel="noreferrer"
              class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-800 transition hover:bg-slate-50"
            >
              Google Maps ↗
            </a>
          </div>

          <p class="mt-3 text-[11px] text-slate-400">Diverifikasi: {place.lastVerified}</p>
        </ResultCard>
      ))}
    </div>

    <div id="places-empty" role="status" aria-live="polite" class="hidden rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
      <p class="font-bold text-slate-900">Belum ada tempat untuk kombinasi filter ini.</p>
      <p class="mt-2 text-sm text-slate-500">Pilih kategori atau kota lain.</p>
    </div>
  </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const cards = Array.from(document.querySelectorAll('.place-card'));
    const categoryButtons = Array.from(document.querySelectorAll('[data-category-filters] [data-category]'));
    const citySelect = document.querySelector('#place-city');
    const searchInput = document.querySelector('#place-search');
    const count = document.querySelector('#place-count');
    const empty = document.querySelector('#places-empty');
    const mapElement = document.querySelector('#places-map-panel .ppi-leaflet-map');
    const mapPanel = document.querySelector('#places-map-panel');
    const mapEmpty = document.querySelector('#places-map-empty');

    const params = new URLSearchParams(window.location.search);
    let activeCategory = params.get('category') || '';
    const validCategories = categoryButtons.map((button) => button.dataset.category || '');
    if (!validCategories.includes(activeCategory)) activeCategory = '';

    const validCities = Array.from(citySelect?.options || []).map((option) => option.value);
    const initialCity = params.get('city') || '';
    const initialQuery = params.get('q') || '';

    if (citySelect) citySelect.value = validCities.includes(initialCity) ? initialCity : '';
    if (searchInput) searchInput.value = initialQuery;

    const setActiveButton = () => {
      categoryButtons.forEach((candidate) => {
        const active = (candidate.dataset.category || '') === activeCategory;
        candidate.setAttribute('aria-pressed', active ? 'true' : 'false');
        candidate.classList.toggle('bg-slate-900', active);
        candidate.classList.toggle('text-white', active);
        candidate.classList.toggle('border-slate-200', !active);
        candidate.classList.toggle('bg-white', !active);
        candidate.classList.toggle('text-slate-700', !active);
      });
    };

    const syncUrl = () => {
      const url = new URL(window.location.href);
      const city = citySelect?.value || '';
      const query = (searchInput?.value || '').trim();

      if (activeCategory) url.searchParams.set('category', activeCategory);
      else url.searchParams.delete('category');

      if (city) url.searchParams.set('city', city);
      else url.searchParams.delete('city');

      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');

      window.history.replaceState({}, '', url);
    };

    const update = () => {
      const city = citySelect?.value || '';
      const query = (searchInput?.value || '').trim().toLowerCase();
      const visibleMapIds = [];
      let visible = 0;

      cards.forEach((card) => {
        const matchesCategory = !activeCategory || card.dataset.category === activeCategory;
        const matchesCity = !city || card.dataset.city === city;
        const matchesQuery = !query || (card.dataset.search || '').includes(query);
        const show = matchesCategory && matchesCity && matchesQuery;

        card.classList.toggle('hidden', !show);
        if (show) {
          visible += 1;
          if (card.dataset.mappable === 'true' && card.dataset.placeId) {
            visibleMapIds.push(card.dataset.placeId);
          }
        }
      });

      if (count) count.textContent = String(visible);
      empty?.classList.toggle('hidden', visible !== 0);

      const hasMapResults = visibleMapIds.length > 0;
      mapPanel?.classList.toggle('hidden', !hasMapResults);
      mapEmpty?.classList.toggle('hidden', hasMapResults);

      if (mapElement) {
        mapElement.dataset.visibleIds = JSON.stringify(visibleMapIds);
        mapElement.dispatchEvent(new CustomEvent('ppi-map-filter', { detail: { ids: visibleMapIds } }));
      }

      syncUrl();
    };

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.category || '';
        setActiveButton();
        update();
      });
    });

    citySelect?.addEventListener('change', update);
    searchInput?.addEventListener('input', update);

    setActiveButton();
    update();
  })();
</script>
