---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NestedLandingHeader from '../../components/NestedLandingHeader.astro';
import OfficialSources from '../../components/OfficialSources.astro';
import TopicIcon from '../../components/TopicIcon.astro';
import { withBase } from '../../utils/paths';
import { familyHubItems, familyLastVerified } from '../../data/family';
import { publicMedia } from '../../data/media';

const starterPack = familyHubItems.find((item) => item.code === 'F10');
const primaryGuides = familyHubItems.filter((item) =>
  ['F01', 'F02', 'F03', 'F04', 'F05'].includes(item.code)
);
const familyTools = familyHubItems.filter((item) =>
  ['F06', 'F07', 'F08', 'F09'].includes(item.code)
);

const officialSources = [
  {
    owner: 'Kanazawa City',
    title: 'Children & Family — Foreign Residents',
    description: 'Pregnancy, childbirth, childcare, allowance, medical subsidy, dan education untuk foreign residents.',
    url: 'https://www4.city.kanazawa.lg.jp/kurashi_tetsuzuki/gaikokujimmuke/9990.html'
  },
  {
    owner: 'IFIE',
    title: 'Education for Children',
    description: 'Japanese/learning support dan informasi pendidikan untuk anak dengan latar belakang asing di Ishikawa.',
    url: 'https://www.ifie.or.jp/foreigners_life/kyoiku/'
  },
  {
    owner: 'Immigration Services Agency',
    title: 'Residence Procedures',
    description: 'Residence status untuk pasangan/anak serta prosedur immigration nasional.',
    url: 'https://www.moj.go.jp/isa/'
  },
  {
    owner: 'Kanazawa Child-Rearing Portal',
    title: 'Nobinobi Be-no',
    description: 'Portal aktif untuk childcare, support center, parenting information, dan event keluarga.',
    url: 'https://www.kanazawa-kosodate.net/'
  }
];

const supportRoutes = [
  {
    eyebrow: 'Bahasa',
    title: 'Tidak harus menyelesaikan semuanya dalam bahasa Jepang.',
    description: 'Kanazawa menyediakan multilingual telephone interpretation termasuk Bahasa Indonesia untuk banyak layanan City Hall, termasuk childcare, health, insurance, dan education.',
    label: 'Language support ↗',
    href: 'https://www4.city.kanazawa.lg.jp/kurashi_tetsuzuki/gaikokujimmuke/9989.html',
    external: true
  },
  {
    eyebrow: 'Konsultasi',
    title: 'Jika tidak tahu harus mulai dari mana.',
    description: 'IFIE menyediakan consultation support untuk foreign residents di Ishikawa dan dapat membantu menemukan jalur yang sesuai untuk masalah anak, school, health, atau administration.',
    label: 'IFIE consultation ↗',
    href: 'https://www.ifie.or.jp/foreigners_life/soudan/',
    external: true
  },
  {
    eyebrow: 'Komunitas',
    title: 'Informasi resmi + pengalaman keluarga Indonesia.',
    description: 'PPI Ishikawa dapat membantu memberi konteks pengalaman komunitas tanpa menggantikan sumber pemerintah.',
    label: 'Hubungi PPI Ishikawa →',
    href: '/contact/',
    external: false
  }
];
---

<BaseLayout
  title="Keluarga & Anak di Ishikawa"
  description="Panduan PPI Ishikawa untuk mahasiswa yang tinggal bersama pasangan atau anak: residence, pregnancy, childcare, school, benefit, health, dan aktivitas keluarga."
>
  <NestedLandingHeader
    parentLabel="Hidup di Ishikawa"
    parentHref="/life-in-ishikawa/"
    eyebrow="Keluarga di Ishikawa"
    title="Keluarga & Anak"
    description="Panduan praktis untuk mahasiswa yang datang bersama pasangan atau anak—mulai dari residence status, pregnancy dan childbirth, childcare, sekolah, kesehatan, benefit, sampai kehidupan keluarga sehari-hari."
    lastVerified={familyLastVerified}
  >
    <figure slot="visual" class="overflow-hidden rounded-3xl border border-slate-200 bg-white">
      <img
        src={publicMedia.kanazawaCentralPark.imageUrl}
        alt={publicMedia.kanazawaCentralPark.alt}
        width="1500"
        height="1155"
        class="aspect-[4/3] h-auto w-full object-cover"
        loading="eager"
        referrerpolicy="no-referrer"
      />
      <figcaption class="border-t border-slate-100 bg-slate-50 px-4 py-3 text-xs leading-5 text-slate-500">
        {publicMedia.kanazawaCentralPark.title} ·
        <a href={publicMedia.kanazawaCentralPark.sourcePage} target="_blank" rel="noreferrer" class="underline">
          {publicMedia.kanazawaCentralPark.credit}
        </a>
        · {publicMedia.kanazawaCentralPark.license}
      </figcaption>
    </figure>
  </NestedLandingHeader>

  {starterPack && (
    <section class="mx-auto max-w-7xl px-5 pb-10 lg:px-8">
      <div class="rounded-3xl bg-slate-950 p-7 text-white sm:p-9">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
          <div class="max-w-3xl">
            <p class="type-eyebrow text-accent-soft">Mulai di sini</p>
            <h2 class="type-section mt-3">Baru membawa keluarga ke Ishikawa?</h2>
            <p class="mt-3 leading-7 text-slate-300">{starterPack.description}</p>
          </div>
          <a href={withBase(starterPack.href)} class="type-ui inline-flex rounded-xl bg-white px-5 py-3 text-slate-950 transition-colors hover:bg-slate-100">
            Buka Starter Pack →
          </a>
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-7xl px-5 pb-6 lg:px-8">
    <div class="max-w-4xl border-l-2 border-accent pl-5 sm:pl-6">
      <p class="type-eyebrow text-secondary-dark">Perlu diketahui</p>
      <h2 class="type-card-title mt-2 text-slate-950">Banyak layanan keluarga mengikuti municipality tempat alamat Anda terdaftar.</h2>
      <p class="mt-3 leading-7 text-slate-600">
        Immigration berlaku nasional, tetapi pregnancy services, childcare, public school process, medical subsidy, dan berbagai family support mengikuti pemerintah setempat.
        Informasi Kanazawa berguna sebagai contoh konkret, tetapi keluarga di municipality lain tetap perlu memeriksa sumber kotanya sendiri.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
    <div class="max-w-3xl">
      <p class="type-eyebrow text-brand">Panduan utama</p>
      <h2 class="type-section mt-3 text-slate-950">Mulai dari kebutuhan keluarga Anda.</h2>
    </div>

    <div class="mt-7 grid gap-3 md:grid-cols-2 xl:grid-cols-5">
      {primaryGuides.map((item) => (
        <a
          href={withBase(item.href)}
          class="group rounded-2xl border border-slate-200 bg-white p-5 transition-colors hover:border-accent/35 hover:bg-accent/5"
        >
          <span class="grid size-10 place-items-center rounded-xl bg-accent/10 text-brand">
            <TopicIcon name={item.icon} class="size-5" />
          </span>
          <p class="type-meta mt-4 text-slate-400">{item.code}</p>
          <h3 class="type-card-title mt-1 text-slate-950 group-hover:text-brand">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
      <div class="max-w-3xl">
        <p class="type-eyebrow text-brand">Cari & rencanakan</p>
        <h2 class="type-section mt-3 text-slate-950">Gunakan alat sesuai situasi Anda.</h2>
      </div>

      <div class="mt-7 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {familyTools.map((item) => (
          <a
            href={withBase(item.href)}
            class="group flex items-start gap-4 border-b border-slate-200 py-4 transition-colors hover:border-accent/40"
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-white text-brand">
              <TopicIcon name={item.icon} class="size-5" />
            </span>
            <span class="min-w-0">
              <span class="font-bold text-slate-950 group-hover:text-brand">{item.title} →</span>
              <span class="mt-1 block text-sm leading-6 text-slate-600">{item.description}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[.7fr_1.3fr]">
      <div>
        <p class="type-eyebrow text-brand">Butuh bantuan?</p>
        <h2 class="type-section mt-3 text-slate-950">Pilih jalur bantuan yang sesuai.</h2>
        <p class="mt-3 max-w-xl leading-7 text-slate-600">
          Gunakan layanan resmi untuk keputusan administratif; gunakan PPI untuk konteks dan pengalaman komunitas.
        </p>
      </div>

      <div class="divide-y divide-slate-200 border-y border-slate-200">
        {supportRoutes.map((item) => (
          <article class="py-5">
            <p class="type-eyebrow text-slate-500">{item.eyebrow}</p>
            <h3 class="type-card-title mt-2 text-slate-950">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
            {item.external ? (
              <a href={item.href} target="_blank" rel="noreferrer" class="mt-3 inline-flex text-sm font-bold text-brand hover:underline">
                {item.label}
              </a>
            ) : (
              <a href={withBase(item.href)} class="mt-3 inline-flex text-sm font-bold text-brand hover:underline">
                {item.label}
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <OfficialSources
    sources={officialSources}
    title="Gunakan halaman PPI untuk orientasi; gunakan sumber asli untuk keputusan."
  />
</BaseLayout>
