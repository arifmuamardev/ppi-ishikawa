---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideMeta from '../../components/GuideMeta.astro';
import GuideToc from '../../components/GuideToc.astro';
import GuidePager from '../../components/GuidePager.astro';
import { withBase } from '../../utils/paths';

const sections = [
  {
    label: '01',
    title: 'Pregnancy: mulai dari municipality',
    intro: 'Jika hamil saat tinggal di Jepang, municipality menjadi pintu utama untuk pregnancy notification, Maternal and Child Health Handbook, health-check support, dan berbagai layanan maternal/child health.',
    points: [
      'Setelah kehamilan terkonfirmasi, lakukan pregnancy notification melalui municipality sesuai prosedur lokal.',
      'Municipality menerbitkan Maternal and Child Health Handbook (Boshi Kenkō Techō) setelah notification.',
      'Handbook digunakan untuk mencatat kesehatan ibu dan anak, pemeriksaan, serta informasi perkembangan.',
      'Jangan mengandalkan prosedur kota lain karena lokasi layanan, formulir, dan benefit mengikuti municipality tempat tinggal.'
    ]
  },
  {
    label: '02',
    title: 'Prenatal care dan persiapan melahirkan',
    intro: 'Gunakan obstetrics/gynecology facility yang sesuai dan ikuti antenatal checkup yang direkomendasikan oleh tenaga kesehatan.',
    points: [
      'Simpan jadwal checkup dan seluruh dokumen yang diberikan municipality atau rumah sakit.',
      'Jika membutuhkan dukungan bahasa, cari fasilitas yang menerima foreign patients atau tanyakan dukungan interpreter.',
      'Untuk pekerja, MHLW menyediakan informasi maternal health management di tempat kerja.',
      'Biaya dan benefit persalinan dapat bergantung pada medical insurance dan municipality; cek sumber resmi sebelum membuat asumsi.'
    ]
  },
  {
    label: '03',
    title: 'Setelah anak lahir',
    intro: 'Kelahiran memicu beberapa prosedur yang berbeda: birth notification, resident registration, medical insurance, benefit keluarga, dan—untuk anak berkewarganegaraan asing—residence status.',
    points: [
      'Birth notification di Jepang pada prinsipnya diajukan dalam 14 hari setelah kelahiran.',
      'Jika anak berkewarganegaraan asing akan tinggal di Jepang lebih dari 60 hari, Immigration Services Agency mensyaratkan application to acquire status of residence dalam 30 hari sejak kelahiran.',
      'Hubungi embassy/consulate negara kewarganegaraan anak untuk prosedur nationality/passport yang berlaku.',
      'Setelah itu, cek health insurance, child-related support, dan layanan kesehatan bayi melalui municipality.'
    ]
  },
  {
    label: '04',
    title: 'Medical care dan child support',
    intro: 'Municipality dapat menyediakan medical-expense support, child allowance, health checkups, vaccination support, dan layanan keluarga lain. Eligibility dan detailnya dapat berubah.',
    points: [
      'Cek apakah anak perlu didaftarkan pada medical insurance keluarga.',
      'Tanyakan municipality mengenai child medical-expense subsidy dan child allowance yang berlaku.',
      'Simpan medical certificate/card yang diterbitkan bila Anda memenuhi syarat.',
      'Jangan menyalin nominal benefit dari posting lama karena aturan nasional maupun lokal dapat berubah.'
    ]
  },
  {
    label: '05',
    title: 'Nursery, daycare, kindergarten',
    intro: 'Pilihan childcare di Jepang mencakup hoikusho, certified kodomo-en, kindergarten, dan layanan lain. Prosedur masuk serta kebutuhan sertifikasi bergantung pada usia, kondisi keluarga, fasilitas, dan municipality.',
    points: [
      'Mulai mencari lebih awal jika membutuhkan childcare pada tanggal tertentu.',
      'Cek application period resmi karena penerimaan April biasanya memiliki jadwal pendaftaran tersendiri.',
      'Jangan menganggap tempat otomatis tersedia meskipun fasilitas dekat rumah.',
      'Untuk Kanazawa, gunakan portal resmi child-rearing karena informasi childcare dan application diperbarui setiap tahun.'
    ]
  },
  {
    label: '06',
    title: 'Masuk sekolah di Jepang',
    intro: 'Anak foreign resident dapat memperoleh akses ke public elementary dan junior high school melalui municipality. MEXT menyediakan panduan khusus untuk keluarga asing dan pemerintah lokal bertanggung jawab memberi informasi enrollment.',
    points: [
      'Hubungi municipality/board of education untuk prosedur enrollment dan penentuan sekolah.',
      'Bawa dokumen pendidikan sebelumnya bila tersedia agar sekolah memahami riwayat belajar anak.',
      'Jika anak membutuhkan Japanese-language support, sampaikan kebutuhan tersebut kepada school atau board of education.',
      'MEXT memperbarui pedoman nasional pada Agustus 2026 untuk memperkuat school enrollment dan support bagi foreign children.'
    ]
  },
  {
    label: '07',
    title: 'Japanese-language dan learning support',
    intro: 'IFIE mengumpulkan informasi khusus untuk children with foreign backgrounds di Ishikawa, termasuk Japanese-language support, learning support, financial support, dan informasi sekolah.',
    points: [
      'Sekolah dasar, junior high, dan high school di Ishikawa dapat menyediakan Japanese-language support sesuai kebutuhan dan kondisi sekolah.',
      'Konsultasikan ke school atau board of education bila anak kesulitan mengikuti pelajaran karena bahasa.',
      'IFIE juga mencantumkan organisasi komunitas yang memberi learning/Japanese support.',
      'Untuk high school admission, aturan dan special measures harus dicek untuk tahun penerimaan yang benar.'
    ]
  },
  {
    label: '08',
    title: 'Saat pindah municipality atau meninggalkan Jepang',
    intro: 'Layanan keluarga melekat pada alamat dan status keluarga. Pindah kota dapat berarti perubahan school district, childcare, subsidy, insurance, dan prosedur administrasi lainnya.',
    points: [
      'Beri tahu school/nursery dan municipality sebelum pindah.',
      'Tanyakan dokumen transfer sekolah dan health/child-support records yang perlu dibawa.',
      'Jika pindah ke municipality lain, lakukan pendaftaran ulang layanan yang memang bersifat lokal.',
      'Jika meninggalkan Jepang, cek residence, school, insurance, allowance, dan medical-record matters secara terpisah.'
    ]
  }
];

const familyChecklist = [
  'Residence status dan resident registration setiap anggota keluarga.',
  'Medical insurance untuk pasangan dan anak.',
  'Maternal and Child Health Handbook jika hamil/memiliki bayi.',
  'Vaccination dan health-check records anak.',
  'School/nursery documents dan riwayat pendidikan.',
  'Emergency contact serta informasi kesehatan penting.',
  'Dokumen hubungan keluarga dan terjemahan bila suatu prosedur memerlukannya.',
  'Tanggal penting: application, renewal, school entry, dan move-out.'
];

const liveLinks = [
  {
    name: 'Kanazawa Child-Rearing Portal',
    note: 'Portal aktif untuk childcare, nursery/kodomo-en, support, events, dan prosedur keluarga di Kanazawa.',
    url: 'https://www.kanazawa-kosodate.net/'
  },
  {
    name: 'IFIE — Education for Children',
    note: 'Japanese/learning support, education assistance, dan informasi khusus children with foreign backgrounds di Ishikawa.',
    url: 'https://www.ifie.or.jp/foreigners_life/kyoiku/'
  },
  {
    name: 'MEXT — Guide for Foreign Students to Start School',
    note: 'Panduan resmi proses masuk sekolah Jepang untuk keluarga asing.',
    url: 'https://www.mext.go.jp/en/policy/education/elsec/title02/detail02/1373857.htm'
  },
  {
    name: 'Immigration — Acquisition of Status of Residence',
    note: 'Untuk anak foreign national yang lahir di Jepang dan akan tinggal lebih dari 60 hari.',
    url: 'https://www.moj.go.jp/isa/applications/procedures/16-10.html'
  }
];

const sources = [
  {
    owner: 'Ministry of Health, Labour and Welfare',
    title: 'Maternal and Child Health — Pregnancy Notification and Handbook',
    description: 'Municipality menerima pregnancy notification dan menerbitkan Maternal and Child Health Handbook; MHLW juga menyediakan pregnancy guidance dalam Bahasa Indonesia.',
    url: 'https://www.mhlw.go.jp/bunya/kodomo/boshi-hoken10/'
  },
  {
    owner: 'Ministry of Justice',
    title: 'Birth Notification',
    description: 'Birth notification pada prinsipnya diajukan dalam 14 hari setelah kelahiran di Jepang.',
    url: 'https://www.moj.go.jp/ONLINE/FAMILYREGISTER/5-1'
  },
  {
    owner: 'Immigration Services Agency',
    title: 'Acquisition of Status of Residence',
    description: 'Anak foreign national yang lahir di Jepang dan akan tinggal lebih dari 60 hari perlu mengajukan status of residence dalam 30 hari.',
    url: 'https://www.moj.go.jp/isa/applications/procedures/16-10.html'
  },
  {
    owner: 'Ministry of Education, Culture, Sports, Science and Technology',
    title: 'School Enrollment Guide for Foreign Children',
    description: 'Panduan resmi enrollment ke sekolah Jepang untuk keluarga asing.',
    url: 'https://www.mext.go.jp/a_menu/shotou/clarinet/003/1320860.htm'
  },
  {
    owner: 'MEXT',
    title: '2026 Guideline on School Enrollment for Foreign Children',
    description: 'Pedoman nasional yang direvisi 28 Agustus 2026 mengenai school enrollment dan support untuk foreign children.',
    url: 'https://www.mext.go.jp/a_menu/shotou/clarinet/004/1415154_00018.html'
  },
  {
    owner: 'IFIE',
    title: 'Education for Children',
    description: 'Informasi Ishikawa mengenai Japanese support, learning support, financial assistance, school systems, dan pathways.',
    url: 'https://www.ifie.or.jp/foreigners_life/kyoiku/'
  }
];
---

<BaseLayout
  title="Keluarga & Anak di Ishikawa"
  description="Panduan keluarga untuk pelajar Indonesia di Ishikawa: pregnancy, childbirth, childcare, medical support, sekolah, dan dukungan pendidikan anak."
>
  <section class="mx-auto max-w-5xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
    <a href={withBase('/life-in-ishikawa/')} class="text-sm font-semibold text-brand hover:underline">← Ishikawa Survival Guide</a>
    <p class="mt-8 text-sm font-bold uppercase tracking-[0.2em] text-brand">SG08 · Keluarga & Anak</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Tinggal di Ishikawa bersama keluarga.</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
      Pregnancy, childbirth, childcare, sekolah, medical support, dan benefit keluarga banyak ditangani di tingkat municipality.
      Halaman ini membantu memahami alurnya; eligibility, nominal bantuan, deadline, dan availability tetap harus dicek pada sumber resmi terbaru.
    </p>

    <GuideMeta code="SG08" />
  </section>

  <GuideToc sections={sections} />

  <section class="mx-auto max-w-5xl px-5 pb-10 lg:px-8">
    <div class="rounded-3xl border border-red-200 bg-red-50 p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Ringkasnya</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Untuk keluarga, municipality adalah titik awal yang sangat penting.</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-700">
        Pregnancy notification, maternal-child health services, childcare, school enrollment, child-related medical support,
        dan berbagai benefit berjalan melalui municipality. Karena itu, keluarga yang tinggal di Kanazawa tidak selalu memiliki prosedur
        yang identik dengan keluarga di Nonoichi, Hakusan, Komatsu, atau municipality lain.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
    <div class="space-y-6">
      {sections.map((section) => (
        <article id={`bagian-${section.label}`} class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div class="flex flex-col gap-5 sm:flex-row">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-slate-100 text-sm font-bold text-slate-700">{section.label}</div>
            <div class="min-w-0 flex-1">
              <h2 class="text-2xl font-bold tracking-tight text-slate-950">{section.title}</h2>
              <p class="mt-4 leading-7 text-slate-600">{section.intro}</p>
              <ul class="mt-5 space-y-3">
                {section.points.map((point) => (
                  <li class="flex gap-3 text-sm leading-6 text-slate-700">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-2">
      <div class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-red-300">Jika bayi lahir di Jepang</p>
        <h2 class="mt-3 text-2xl font-bold">Ada lebih dari satu prosedur.</h2>
        <p class="mt-4 leading-7 text-slate-300">
          Birth notification dan residence status adalah proses yang berbeda. Birth notification pada prinsipnya dilakukan
          dalam 14 hari. Jika bayi foreign national akan tinggal di Jepang lebih dari 60 hari, application to acquire
          status of residence perlu diajukan dalam 30 hari sejak kelahiran.
        </p>
        <p class="mt-4 text-sm leading-6 text-slate-400">
          Nationality dan passport mengikuti hukum/prosedur negara kewarganegaraan anak; hubungi embassy/consulate yang relevan.
        </p>
      </div>

      <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-amber-800">Tunjangan & subsidi</p>
        <h2 class="mt-3 text-2xl font-bold text-slate-950">Cek nominal dan syarat terbaru sebelum mengajukan.</h2>
        <p class="mt-4 leading-7 text-slate-700">
          Child allowance, medical-expense subsidy, childcare fee, dan bantuan lain dapat berubah berdasarkan aturan, usia, kondisi keluarga, pendapatan, insurance, atau pemerintah setempat. Gunakan panduan ini untuk mengenali jenis layanannya, lalu cek nominal dan eligibility terbaru pada halaman pemerintah.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Checklist keluarga</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Simpan dokumen keluarga sebagai satu sistem.</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {familyChecklist.map((item) => (
          <div class="rounded-2xl bg-slate-50 p-4 text-sm leading-6 text-slate-700">{item}</div>
        ))}
      </div>
      <p class="mt-5 text-xs leading-5 text-slate-500">Ini adalah tips organisasi praktis, bukan daftar persyaratan universal.</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Informasi langsung</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Gunakan sumber yang terus diperbarui.</h2>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {liveLinks.map((item) => (
          <a href={item.url} target="_blank" rel="noreferrer" class="rounded-2xl bg-slate-50 p-4 transition hover:bg-slate-100">
            <p class="font-bold text-slate-900">{item.name} ↗</p>
            <p class="mt-1 text-xs leading-5 text-slate-500">{item.note}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
    <div class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-red-300">Sumber resmi</p>
      <h2 class="mt-3 text-2xl font-bold">Nasional untuk sistem; municipality untuk layanan keluarga setempat.</h2>
      <div class="mt-7 grid gap-4">
        {sources.map((source) => (
          <a
            href={source.url}
            target="_blank"
            rel="noreferrer"
            class="group rounded-2xl border border-slate-700 bg-slate-900 p-5 transition hover:border-slate-500 hover:bg-slate-800"
          >
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">{source.owner}</p>
            <h3 class="mt-2 font-bold text-white group-hover:text-red-200">{source.title} ↗</h3>
            <p class="mt-2 text-sm leading-6 text-slate-400">{source.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <GuidePager code="SG08" />
</BaseLayout>
