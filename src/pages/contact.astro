---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import TopicIcon from '../components/TopicIcon.astro';
import { withBase } from '../utils/paths';
import { site } from '../data/site';

const helpRoutes = [
  {
    icon: 'arrival',
    title: 'Baru / akan datang',
    description: 'Persiapan sebelum berangkat, hari pertama, administrasi awal, tempat tinggal, dan kebutuhan dasar.',
    href: '/life-in-ishikawa/',
    action: 'Mulai dari Survival Guide'
  },
  {
    icon: 'campus',
    title: 'Pertanyaan tentang kampus',
    description: 'Cari panduan khusus KU, JAIST, KIT, IPU, Kinjo, atau Alice Gakuen.',
    href: '/community/kampus/',
    action: 'Lihat kampus'
  },
  {
    icon: 'support',
    title: 'Butuh bantuan kehidupan',
    description: 'Bahasa Jepang, konsultasi IFIE, immigration, kampus, labor support, dan jalur profesional.',
    href: '/life-in-ishikawa/japanese-support/',
    action: 'Cari jalur bantuan'
  },
  {
    icon: 'emergency',
    title: 'Darurat atau masalah kesehatan',
    description: 'Nomor darurat, #7119, fasilitas kesehatan, bencana, evakuasi, dan sumber informasi live.',
    href: '/life-in-ishikawa/disaster-emergency/',
    action: 'Buka informasi darurat'
  }
];
---
<BaseLayout title="Kontak">
  <LandingHeader
    title="Hubungi PPI Ishikawa"
    description="Temukan jalur informasi yang paling sesuai dengan kebutuhanmu."
  />

  <section class="mx-auto max-w-7xl px-5 pb-14 lg:px-8">
    <div class="grid gap-4 md:grid-cols-2">
      {helpRoutes.map((item) => (
        <a href={withBase(item.href)} class="group rounded-2xl border border-slate-200 bg-white p-6 transition-colors hover:border-accent/35 hover:bg-accent/5 sm:p-7">
          <span class="grid size-11 place-items-center rounded-2xl bg-accent/10 text-accent-dark">
            <TopicIcon name={item.icon as any} class="size-6" />
          </span>
          <h2 class="mt-5 text-xl font-bold text-slate-950 group-hover:text-brand">{item.title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
          <p class="mt-5 text-sm font-bold text-brand">{item.action} →</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-14 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-[1.15fr_.85fr]">
      <div class="rounded-[2rem] bg-slate-950 p-7 text-white sm:p-9">
        <p class="type-eyebrow text-red-300">Jika mendesak</p>
        <h2 class="mt-3 text-2xl font-bold">Jangan menunggu balasan organisasi untuk keadaan darurat.</h2>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-slate-700 bg-slate-900 p-5">
            <p class="text-3xl font-black">110</p>
            <p class="mt-1 text-sm font-semibold text-slate-300">Police</p>
          </div>
          <div class="rounded-2xl border border-slate-700 bg-slate-900 p-5">
            <p class="text-3xl font-black">119</p>
            <p class="mt-1 text-sm font-semibold text-slate-300">Ambulance / Fire</p>
          </div>
          <div class="rounded-2xl border border-slate-700 bg-slate-900 p-5">
            <p class="text-3xl font-black">#7119</p>
            <p class="mt-1 text-sm font-semibold text-slate-300">Medical advice</p>
          </div>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={withBase('/life-in-ishikawa/disaster-emergency/')} class="rounded-xl bg-white px-4 py-3 text-sm font-bold text-slate-950">Bencana & darurat →</a>
          <a href={withBase('/life-in-ishikawa/kesehatan/')} class="rounded-xl border border-slate-600 px-4 py-3 text-sm font-bold text-white">Panduan kesehatan →</a>
        </div>
      </div>

      <div class="rounded-[2rem] border border-accent/35 bg-accent/10 p-7 sm:p-9">
        <p class="type-eyebrow text-secondary-dark">Kontak organisasi</p>
        <h2 class="mt-3 text-2xl font-bold text-slate-950">Untuk kolaborasi, media, dan urusan organisasi.</h2>
        <p class="mt-4 leading-7 text-slate-700">Kanal resmi periode {site.period} belum tersedia. Untuk komunikasi resmi dan pengiriman data pribadi, gunakan hanya kanal PPI Ishikawa yang telah diumumkan secara resmi.</p>
        <div class="mt-6 rounded-2xl border border-accent/35 bg-white p-5">
          <p class="text-sm font-bold text-slate-950">Sementara ini</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">Gunakan Survival Guide dan Campus Hub untuk kebutuhan informasi yang sudah tersedia.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
