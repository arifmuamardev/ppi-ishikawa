---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { withBase } from '../utils/paths';

const contactTypes = [
  ['Anggota & pendatang baru', 'Pertanyaan tentang komunitas, kedatangan, kehidupan di Ishikawa, atau layanan anggota.'],
  ['Kolaborasi', 'Kerja sama dengan universitas, institusi, komunitas, organisasi, atau mitra kegiatan.'],
  ['Media & publikasi', 'Permintaan informasi organisasi, dokumentasi kegiatan, atau komunikasi publik.'],
  ['Internal organisasi', 'Administrasi kepengurusan, dokumen, program, dan koordinasi lintas bidang.']
];
---
<BaseLayout title="Kontak">
  <PageIntro
    title="Hubungi PPI Ishikawa"
    description="Pintu masuk untuk anggota, calon mahasiswa, mitra, media, dan komunitas."
  />

  <section class="mx-auto max-w-7xl px-5 pb-12 lg:px-8">
    <div class="grid gap-4 md:grid-cols-2">
      {contactTypes.map(([title, description]) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="font-bold text-slate-950">{title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-12 lg:px-8">
    <div class="rounded-3xl border border-amber-200 bg-amber-50 p-7 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-amber-800">Kanal resmi 2026/27</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Belum dipublikasikan.</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-700">Email, form kontak, dan kanal resmi organisasi akan ditambahkan setelah kepengurusan menetapkannya. Website tidak menggunakan email atau nomor pribadi sebagai kontak organisasi sementara.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <div class="rounded-3xl bg-slate-950 p-7 text-white sm:p-9">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-red-300">Butuh informasi sekarang?</p>
      <h2 class="mt-3 text-2xl font-bold">Gunakan panduan yang sudah tersedia.</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-300">Untuk pertanyaan umum tentang hidup di Ishikawa, administrasi, kesehatan, bantuan, atau bencana, Survival Guide sudah dapat digunakan tanpa menunggu kanal kontak organisasi.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={withBase('/life-in-ishikawa/')} class="rounded-xl bg-white px-4 py-3 text-sm font-bold text-slate-950">Buka Survival Guide</a>
        <a href={withBase('/life-in-ishikawa/japanese-support/')} class="rounded-xl border border-slate-600 px-4 py-3 text-sm font-bold text-white">Cari jalur bantuan</a>
      </div>
    </div>
  </section>
</BaseLayout>
