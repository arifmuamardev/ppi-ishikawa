---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicIcon from '../components/TopicIcon.astro';
import InstitutionMark from '../components/InstitutionMark.astro';
import StoryCard from '../components/StoryCard.astro';
import LicensedPhoto from '../components/LicensedPhoto.astro';
import { vision } from '../data/organization';
import { campuses } from '../data/campuses';
import { withBase } from '../utils/paths';
import { publicMedia } from '../data/media';
import { stories } from '../data/stories';
import { site } from '../data/site';

// Preserve the canonical vision sentence while presenting the approved
// three-line institutional headline in a compact, editorial composition.
const heroKeywords = vision.headline
  .replace(/^PPI Ishikawa yang\s+/i, '')
  .replace(/\.$/, '')
  .split(/,\s*(?:dan\s+)?|\s+dan\s+/);

const primaryPaths = [
  {
    icon: 'campus',
    title: 'Kampus',
    description: 'Kenali kampus, lokasi, tempat tinggal, mobilitas, dan dukungan mahasiswa.',
    href: '/community/kampus/'
  },
  {
    icon: 'housing',
    title: 'Hidup di Ishikawa',
    description: 'Panduan datang, tinggal, administrasi, kesehatan, transportasi, keluarga, winter, dan kebutuhan sehari-hari.',
    href: '/life-in-ishikawa/'
  },
  {
    icon: 'scholarship',
    title: 'Beasiswa',
    description: 'Cari beasiswa berdasarkan kampus, jenjang, status studi, kewarganegaraan, jalur pendaftaran, dan cakupan kampus.',
    href: '/beasiswa/'
  },
  {
    icon: 'career',
    title: 'Karier',
    description: 'Cari sumber lowongan kerja, internship, postdoc, researcher, faculty, fellowship, dan dukungan career center kampus.',
    href: '/career/'
  },
  {
    icon: 'collaboration',
    title: 'Komunitas',
    description: 'Terhubung dengan pelajar Indonesia, keluarga, kegiatan, dan jejaring PPI Ishikawa.',
    href: '/community/'
  },
  {
    icon: 'info',
    title: 'Tentang PPI',
    description: 'Kenali arah, nilai, struktur organisasi, dan bidang kerja PPI Ishikawa.',
    href: '/about/'
  }
];
---
<BaseLayout
  title="Beranda"
  description={`Rumah digital PPI Ishikawa ${site.period} untuk kampus, kehidupan di Ishikawa, beasiswa, karier, komunitas, dan informasi organisasi.`}
>
  <section class="home-hero" data-home-hero aria-label="Selamat datang di PPI Ishikawa">
    <div class="home-hero__inner mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_.85fr] lg:gap-14">
        <div>
          <p class="type-eyebrow inline-flex rounded-full border border-white/30 bg-white/10 px-3 py-1 text-white">PPI Ishikawa · {site.period}</p>
          <h1 class="home-hero__title type-hero mt-6 text-white" aria-label={vision.headline}>
            {heroKeywords.length === 3 ? (
              <>
                <span class="home-hero__line">{heroKeywords[0]},</span>
                <span class="home-hero__line home-hero__highlight">{heroKeywords[1]},</span>
                <span class="home-hero__line">{heroKeywords[2]}.</span>
              </>
            ) : vision.headline}
          </h1>
          <p class="mt-6 text-xl font-semibold text-white sm:text-2xl">{vision.subheadline}</p>
          <p class="mt-4 max-w-2xl text-base leading-7 text-white/85 sm:text-lg">{vision.supporting}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={withBase('/life-in-ishikawa/')} class="home-hero__action-primary inline-flex min-h-11 items-center rounded-xl px-5 text-sm font-semibold ui-motion-color">Hidup di Ishikawa <span class="ml-2" aria-hidden="true">›</span></a>
            <a href={withBase('/community/kampus/')} class="home-hero__action-secondary inline-flex min-h-11 items-center rounded-xl px-5 text-sm font-semibold ui-motion-color">Cari kampus <span class="ml-2" aria-hidden="true">›</span></a>
          </div>
        </div>
        <div class="home-hero__visual">
          <svg class="home-hero__motif" viewBox="0 0 480 340" fill="none" aria-hidden="true" focusable="false">
            <path d="M-40 250C70 160 98 330 183 202S306 90 466 10M-60 292C72 202 113 365 211 224S321 122 503 44M-30 327C101 251 133 380 241 260S355 150 522 91" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <LicensedPhoto media={publicMedia.kanazawaStation} class="home-hero__media" eager />
        </div>
      </div>
    </div>
  </section>

  <section class="home-family" aria-label="Panduan keluarga di Ishikawa">
    <div class="home-family__inner mx-auto max-w-7xl px-5 lg:px-8">
      <div class="home-family__card p-7 sm:p-8">
        <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
          <div class="max-w-3xl">
            <div class="flex items-center gap-3">
              <span class="ui-icon-tile home-family__icon"><TopicIcon name="family" class="size-6" /></span>
              <p class="home-family__eyebrow type-eyebrow">Keluarga</p>
            </div>
            <h2 class="type-section mt-4">Datang atau tinggal di Ishikawa bersama pasangan dan anak?</h2>
            <p class="home-family__description mt-3 leading-7">Mulai dari residence status, pregnancy, childcare, sekolah, benefit, kesehatan, sampai tempat bermain dan dukungan keluarga.</p>
          </div>
          <a href={withBase('/life-in-ishikawa/family-anak/')} class="home-family__action inline-flex min-h-11 items-center rounded-xl px-5 text-sm font-bold ui-motion-color">Buka Keluarga →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
      <div class="max-w-3xl">
        <p class="type-eyebrow text-brand">Mulai dari kebutuhan Anda</p>
        <h2 class="type-section mt-3 text-slate-950">Apa yang sedang Anda cari?</h2>
        <p class="mt-3 leading-7 text-slate-600">Pilih area yang paling sesuai dengan kebutuhan Anda.</p>
      </div>

      <div class="mt-8 grid ui-grid-gap-balanced sm:grid-cols-2 lg:grid-cols-3">
        {primaryPaths.map((item) => (
          <a href={withBase(item.href)} class="group ui-card-space-balanced ui-radius-card ui-border-subtle border-slate-200 bg-white ui-motion-navigation hover:border-accent/35 hover:bg-accent/5">
            <span class="ui-icon-tile text-accent-dark">
              <TopicIcon name={item.icon as any} class="size-6" />
            </span>
            <h3 class="mt-4 font-bold text-slate-950 group-hover:text-brand">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
    <div class="rounded-3xl border border-accent/35 bg-accent/10 p-7 sm:p-9">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="type-eyebrow text-accent-dark">Baru akan datang?</p>
          <h2 class="type-section mt-2 text-slate-950">Mulai dari persiapan sebelum berangkat.</h2>
          <p class="mt-3 max-w-3xl leading-7 text-slate-700">Cek dokumen, tempat tinggal pertama, kebutuhan awal, komunikasi, transportasi, dan langkah penting sebelum tiba di Ishikawa.</p>
        </div>
        <a href={withBase('/life-in-ishikawa/sebelum-berangkat/')} class="inline-flex min-h-11 items-center rounded-xl bg-slate-950 px-5 text-sm font-bold text-white ui-motion-color hover:bg-slate-800">Buka panduan →</a>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="type-eyebrow text-brand">Kampus</p>
              <h2 class="type-section mt-2 text-slate-950">Enam panduan kampus tersedia.</h2>
              <p class="mt-3 text-sm leading-6 text-slate-600">Kenali lokasi, housing, commute, dukungan mahasiswa, dan konteks tiap institusi.</p>
            </div>
            <TopicIcon name="campus" class="size-7 shrink-0 text-brand" />
          </div>
          <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3">
            {campuses.map((campus) => (
              <a href={withBase(`/community/kampus/${campus.slug}/`)} class="flex min-h-14 items-center gap-2 rounded-xl border border-slate-200 bg-white p-3 ui-motion-color hover:border-accent/35 hover:bg-accent/5">
                <InstitutionMark id={campus.slug as any} size="sm" class="shrink-0" />
                <span class="truncate text-xs font-bold text-slate-800">{campus.shortName}</span>
              </a>
            ))}
          </div>
          <a href={withBase('/community/kampus/')} class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">Lihat kampus →</a>
        </div>

        <div class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="type-eyebrow text-accent-soft">Beasiswa</p>
              <h2 class="type-section mt-2">Cari yang relevan untuk kondisi Anda.</h2>
              <p class="mt-3 text-sm leading-6 text-slate-300">Saring berdasarkan kampus, jenjang, status studi, kewarganegaraan, jalur pendaftaran, dan cakupan kampus.</p>
            </div>
            <TopicIcon name="scholarship" class="size-7 shrink-0 text-accent-soft" />
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            {['MEXT','JASSO','Ishikawa','Foundation'].map((label) => (
              <span class="rounded-full border border-slate-700 bg-white/5 px-3 py-2 text-xs font-bold text-slate-200">{label}</span>
            ))}
          </div>
          <a href={withBase('/beasiswa/')} class="mt-5 inline-flex min-h-11 items-center rounded-xl bg-white px-4 text-sm font-bold text-slate-950 ui-motion-color hover:bg-slate-100">Cari beasiswa →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-accent/10 text-brand">
            <TopicIcon name="stories" class="size-5" />
          </span>
          <p class="type-eyebrow text-brand">Cerita PPI Ishikawa</p>
        </div>
        <h2 class="type-section mt-4 text-slate-950">Pengalaman mahasiswa dan alumni.</h2>
        <p class="mt-3 leading-7 text-slate-600">Kisah tentang studi, riset, karier, keluarga, dan kehidupan di Ishikawa.</p>
      </div>
      <a href={withBase('/stories/')} class="text-sm font-bold text-brand hover:underline">Lihat semua cerita →</a>
    </div>

    {stories.length > 0 ? (
      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {stories.slice(0, 3).map((story) => <StoryCard story={story} />)}
      </div>
    ) : (
      <div class="mt-7 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-7">
        <p class="font-bold text-slate-950">Cerita pertama segera hadir.</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Mahasiswa aktif dan alumni dapat berbagi pengalaman dari berbagai kampus di Ishikawa.</p>
      </div>
    )}
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <div class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-7 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm font-bold text-slate-950">Tentang organisasi, program, dan cara terhubung</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Kenali PPI Ishikawa, program kerja, dan kanal untuk terhubung.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={withBase('/about/')} class="text-sm font-bold text-brand hover:underline">Tentang PPI →</a>
        <a href={withBase('/programs/')} class="text-sm font-bold text-brand hover:underline">Program →</a>
        <a href={withBase('/contact/')} class="text-sm font-bold text-brand hover:underline">Hubungi kami →</a>
      </div>
    </div>
  </section>
</BaseLayout>
