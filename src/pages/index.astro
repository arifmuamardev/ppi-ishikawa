---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicIcon from '../components/TopicIcon.astro';
import InstitutionMark from '../components/InstitutionMark.astro';
import StoryCard from '../components/StoryCard.astro';
import { vision } from '../data/organization';
import { campuses } from '../data/campuses';
import { withBase } from '../utils/paths';
import { publicMedia } from '../data/media';
import { stories } from '../data/stories';
import { site } from '../data/site';

const primaryPaths = [
  {
    icon: 'campus',
    title: 'Kampus',
    description: 'Kenali kampus, lokasi, tempat tinggal, mobilitas, dan dukungan mahasiswa.',
    href: '/community/kampus/'
  },
  {
    icon: 'housing',
    title: 'Hidup di Ishikawa',
    description: 'Panduan datang, tinggal, administrasi, kesehatan, transportasi, keluarga, winter, dan kebutuhan sehari-hari.',
    href: '/life-in-ishikawa/'
  },
  {
    icon: 'scholarship',
    title: 'Beasiswa',
    description: 'Cari beasiswa berdasarkan kampus, jenjang, status studi, kewarganegaraan, jalur pendaftaran, dan cakupan kampus.',
    href: '/beasiswa/'
  },
  {
    icon: 'career',
    title: 'Karier',
    description: 'Cari sumber lowongan kerja, internship, postdoc, researcher, faculty, fellowship, dan dukungan career center kampus.',
    href: '/career/'
  },
  {
    icon: 'collaboration',
    title: 'Komunitas',
    description: 'Terhubung dengan pelajar Indonesia, keluarga, kegiatan, dan jejaring PPI Ishikawa.',
    href: '/community/'
  },
  {
    icon: 'info',
    title: 'Tentang PPI',
    description: 'Kenali arah, nilai, struktur organisasi, dan bidang kerja PPI Ishikawa.',
    href: '/about/'
  }
];
---
<BaseLayout
  title="Beranda"
  description={`Rumah digital PPI Ishikawa ${site.period} untuk kampus, kehidupan di Ishikawa, beasiswa, karier, komunitas, dan informasi organisasi.`}
>
  <section class="mx-auto max-w-7xl px-5 pb-14 pt-16 lg:px-8 lg:pb-20 lg:pt-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1.2fr_.8fr]">
      <div>
        <p class="inline-flex rounded-full border border-accent/35 bg-accent/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-accent-dark">PPI Ishikawa · {site.period}</p>
        <h1 class="mt-6 max-w-5xl text-5xl font-bold leading-[1.03] tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">{vision.headline}</h1>
        <p class="mt-6 text-xl font-semibold text-slate-800 sm:text-2xl">{vision.subheadline}</p>
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">{vision.supporting}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={withBase('/life-in-ishikawa/')} class="rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-dark">Hidup di Ishikawa</a>
          <a href={withBase('/community/kampus/')} class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-800 transition hover:border-slate-400">Cari kampus</a>
        </div>
      </div>
      <figure class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
        <img
          src={publicMedia.kanazawaStation.imageUrl}
          alt={publicMedia.kanazawaStation.alt}
          width="1600"
          height="1067"
          class="aspect-[4/3] h-auto w-full object-cover"
          loading="eager"
          referrerpolicy="no-referrer"
        />
        <figcaption class="absolute bottom-3 right-3 rounded-lg bg-slate-950/75 px-2.5 py-1.5 text-[10px] text-white backdrop-blur">
          <a href={publicMedia.kanazawaStation.sourcePage} target="_blank" rel="noreferrer" class="hover:underline">{publicMedia.kanazawaStation.credit} · {publicMedia.kanazawaStation.license}</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-14 lg:px-8 lg:pb-16">
    <div class="rounded-[2rem] bg-slate-950 p-7 text-white sm:p-9">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
        <div class="max-w-3xl">
          <div class="flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-2xl bg-white/10 text-accent-soft"><TopicIcon name="family" class="size-6" /></span>
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">Family Hub</p>
          </div>
          <h2 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">Datang atau tinggal di Ishikawa bersama pasangan dan anak?</h2>
          <p class="mt-3 leading-7 text-slate-300">Mulai dari residence status, pregnancy, childcare, sekolah, benefit, kesehatan, sampai tempat bermain dan dukungan keluarga.</p>
        </div>
        <a href={withBase('/life-in-ishikawa/family-anak/')} class="inline-flex rounded-xl bg-white px-5 py-3 text-sm font-bold text-slate-950">Buka Family Hub →</a>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8 lg:py-16">
      <div class="max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Mulai dari kebutuhan Anda</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Apa yang sedang Anda cari?</h2>
        <p class="mt-3 leading-7 text-slate-600">Pilih area yang paling sesuai dengan kebutuhan Anda.</p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        {primaryPaths.map((item) => (
          <a href={withBase(item.href)} class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-accent/35 hover:shadow-sm">
            <span class="grid size-11 place-items-center rounded-2xl bg-accent/10 text-accent-dark">
              <TopicIcon name={item.icon as any} class="size-6" />
            </span>
            <h3 class="mt-4 font-bold text-slate-950 group-hover:text-brand">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-14 lg:px-8 lg:py-16">
    <div class="rounded-[2rem] border border-accent/35 bg-accent/10 p-7 sm:p-9">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-dark">Baru akan datang?</p>
          <h2 class="mt-2 text-2xl font-bold text-slate-950">Mulai dari persiapan sebelum berangkat.</h2>
          <p class="mt-3 max-w-3xl leading-7 text-slate-700">Cek dokumen, tempat tinggal pertama, kebutuhan awal, komunikasi, transportasi, dan langkah penting sebelum tiba di Ishikawa.</p>
        </div>
        <a href={withBase('/life-in-ishikawa/sebelum-berangkat/')} class="inline-flex rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white">Buka panduan →</a>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8 lg:py-16">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-[2rem] border border-slate-200 bg-slate-50 p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Kampus</p>
              <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">Enam Campus Pack tersedia.</h2>
              <p class="mt-3 text-sm leading-6 text-slate-600">Kenali lokasi, housing, commute, dukungan mahasiswa, dan konteks tiap institusi.</p>
            </div>
            <TopicIcon name="campus" class="size-7 shrink-0 text-brand" />
          </div>
          <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3">
            {campuses.map((campus) => (
              <a href={withBase(`/community/kampus/${campus.slug}/`)} class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white p-3 transition hover:border-accent/35">
                <InstitutionMark id={campus.slug as any} size="sm" class="shrink-0" />
                <span class="truncate text-xs font-bold text-slate-800">{campus.shortName}</span>
              </a>
            ))}
          </div>
          <a href={withBase('/community/kampus/')} class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">Lihat kampus →</a>
        </div>

        <div class="rounded-[2rem] bg-slate-950 p-6 text-white sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent-soft">Beasiswa</p>
              <h2 class="mt-2 text-2xl font-bold tracking-tight">Cari yang relevan untuk kondisi Anda.</h2>
              <p class="mt-3 text-sm leading-6 text-slate-300">Saring berdasarkan kampus, jenjang, status studi, kewarganegaraan, jalur pendaftaran, dan cakupan kampus.</p>
            </div>
            <TopicIcon name="scholarship" class="size-7 shrink-0 text-accent-soft" />
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            {['MEXT','JASSO','Ishikawa','Foundation'].map((label) => (
              <span class="rounded-full border border-slate-700 bg-white/5 px-3 py-2 text-xs font-bold text-slate-200">{label}</span>
            ))}
          </div>
          <a href={withBase('/beasiswa/')} class="mt-5 inline-flex rounded-xl bg-white px-4 py-3 text-sm font-bold text-slate-950">Cari beasiswa →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-14 lg:px-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-accent/10 text-brand">
            <TopicIcon name="stories" class="size-5" />
          </span>
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Cerita PPI Ishikawa</p>
        </div>
        <h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-950">Pengalaman mahasiswa dan alumni.</h2>
        <p class="mt-3 leading-7 text-slate-600">Kisah tentang studi, riset, karier, keluarga, dan kehidupan di Ishikawa.</p>
      </div>
      <a href={withBase('/stories/')} class="text-sm font-bold text-brand hover:underline">Lihat semua cerita →</a>
    </div>

    {stories.length > 0 ? (
      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {stories.slice(0, 3).map((story) => <StoryCard story={story} />)}
      </div>
    ) : (
      <div class="mt-7 rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-7">
        <p class="font-bold text-slate-950">Cerita pertama segera hadir.</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Mahasiswa aktif dan alumni dapat berbagi pengalaman dari berbagai kampus di Ishikawa.</p>
      </div>
    )}
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <div class="flex flex-col gap-4 rounded-3xl border border-slate-200 bg-white p-7 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm font-bold text-slate-950">Tentang organisasi, program, dan cara terhubung</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Kenali PPI Ishikawa, program kerja, dan kanal untuk terhubung.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={withBase('/about/')} class="text-sm font-bold text-brand hover:underline">Tentang PPI →</a>
        <a href={withBase('/programs/')} class="text-sm font-bold text-brand hover:underline">Program →</a>
        <a href={withBase('/contact/')} class="text-sm font-bold text-brand hover:underline">Hubungi kami →</a>
      </div>
    </div>
  </section>
</BaseLayout>
