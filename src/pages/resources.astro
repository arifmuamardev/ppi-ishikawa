---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import TopicIcon from '../components/TopicIcon.astro';
import { withBase } from '../utils/paths';

const directories = [
  {
    icon: 'campus',
    title: 'Kampus',
    description: 'Panduan enam kampus yang saat ini terhubung dengan PPI Ishikawa.',
    href: '/community/kampus/'
  },
  {
    icon: 'housing',
    title: 'Hidup di Ishikawa',
    description: 'Panduan untuk kedatangan, kehidupan sehari-hari, dan persiapan kepulangan.',
    href: '/life-in-ishikawa/'
  },
  {
    icon: 'scholarship',
    title: 'Beasiswa',
    description: 'Daftar dan pencarian beasiswa.',
    href: '/beasiswa/'
  },
  {
    icon: 'career',
    title: 'Karier',
    description: 'Sumber lowongan, postdoc, research career, internship, dan dukungan career center kampus.',
    href: '/career/'
  },
  {
    icon: 'collaboration',
    title: 'Komunitas',
    description: 'Kegiatan, jejaring kampus, keluarga, dan cara terhubung.',
    href: '/community/'
  },
  {
    icon: 'info',
    title: 'Tentang PPI',
    description: 'Profil, arah, struktur, nilai, dan program organisasi.',
    href: '/about/'
  }
];
---
<BaseLayout title="Direktori">
  <PageIntro
    title="Direktori"
    description="Halaman ringkas untuk menuju area utama website PPI Ishikawa."
  />

  <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5 sm:p-6">
      <p class="text-sm leading-6 text-slate-600">Untuk penggunaan sehari-hari, Anda tidak perlu melewati halaman ini. Gunakan menu utama atau pilih area yang sesuai di bawah.</p>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
      {directories.map((item) => (
        <a href={withBase(item.href)} class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-amber-200 hover:shadow-sm">
          <span class="grid size-10 place-items-center rounded-xl bg-amber-50 text-accent-dark">
            <TopicIcon name={item.icon as any} class="size-5" />
          </span>
          <h2 class="mt-4 font-bold text-slate-950 group-hover:text-brand">{item.title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
