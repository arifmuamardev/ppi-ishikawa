---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { withBase } from '../utils/paths';

const resources = [
  {
    title: 'Survival Guide',
    description: 'SG00–SG14: panduan hidup untuk mahasiswa dan keluarga di Ishikawa.',
    status: 'Tersedia',
    href: '/life-in-ishikawa/'
  },
  {
    title: 'Panduan Pemerintah Lokal',
    description: 'Kanazawa, Nonoichi, Hakusan, Komatsu, Kahoku, dan seluruh 19 municipality di Ishikawa.',
    status: 'Tersedia',
    href: '/life-in-ishikawa/municipality-guides/'
  },
  {
    title: 'Bahasa Jepang & Dukungan',
    description: 'Kelas bahasa Jepang, IFIE, konsultasi hukum, immigration, kampus, dan labor support.',
    status: 'Tersedia',
    href: '/life-in-ishikawa/japanese-support/'
  },
  {
    title: 'Bencana & Darurat',
    description: 'Nomor darurat, evakuasi, sumber live Ishikawa, JMA, dan kesiapsiagaan bencana.',
    status: 'Tersedia',
    href: '/life-in-ishikawa/disaster-emergency/'
  },
  { title: 'FAQ', description: 'Pertanyaan yang paling sering muncul dari anggota dan pendatang baru.', status: 'Dalam persiapan' },
  { title: 'Beasiswa', description: 'Tautan dan informasi beasiswa yang relevan.', status: 'Dalam persiapan' },
  { title: 'Form & Layanan', description: 'Akses ke form dan layanan resmi PPI Ishikawa.', status: 'Dalam persiapan' },
  { title: 'Publikasi & Arsip', description: 'Publikasi, laporan, dokumentasi, dan memori organisasi.', status: 'Dalam persiapan' }
];
---
<BaseLayout title="Sumber Daya">
  <PageIntro
    title="Sumber daya"
    description="Panduan, dokumen, tautan, dan layanan yang tetap berguna meskipun kepengurusan berganti."
  />
  <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {resources.map((resource) => {
        const content = (
          <>
            <div class="flex items-start justify-between gap-4">
              <h2 class="font-semibold text-slate-950">{resource.title}</h2>
              <span class={`rounded-full px-2.5 py-1 text-xs font-bold ${resource.href ? 'bg-green-50 text-green-700' : 'bg-slate-100 text-slate-600'}`}>
                {resource.status}
              </span>
            </div>
            <p class="mt-3 text-sm leading-6 text-slate-600">{resource.description}</p>
          </>
        );

        return resource.href ? (
          <a href={withBase(resource.href)} class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-red-200 hover:shadow-sm">
            {content}
          </a>
        ) : (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">{content}</div>
        );
      })}
    </div>
  </section>
</BaseLayout>
