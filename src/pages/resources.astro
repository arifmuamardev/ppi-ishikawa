---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import NavigationCard from '../components/NavigationCard.astro';

const directories = [
  {
    icon: 'campus',
    title: 'Kampus',
    description: 'Panduan enam kampus yang saat ini terhubung dengan PPI Ishikawa.',
    href: '/community/kampus/'
  },
  {
    icon: 'housing',
    title: 'Hidup di Ishikawa',
    description: 'Panduan untuk kedatangan, kehidupan sehari-hari, dan persiapan kepulangan.',
    href: '/life-in-ishikawa/'
  },
  {
    icon: 'scholarship',
    title: 'Beasiswa',
    description: 'Daftar dan pencarian beasiswa.',
    href: '/beasiswa/'
  },
  {
    icon: 'career',
    title: 'Karier',
    description: 'Sumber lowongan, postdoc, research career, internship, dan dukungan career center kampus.',
    href: '/career/'
  },
  {
    icon: 'collaboration',
    title: 'Komunitas',
    description: 'Kegiatan, jejaring kampus, keluarga, dan cara terhubung.',
    href: '/community/'
  },
  {
    icon: 'info',
    title: 'Tentang PPI',
    description: 'Profil, arah, struktur, nilai, dan program organisasi.',
    href: '/about/'
  }
];
---
<BaseLayout title="Direktori">
  <LandingHeader
    title="Direktori"
    description="Halaman ringkas untuk menuju area utama website PPI Ishikawa."
  />

  <section class="mx-auto max-w-7xl px-5 pb-20 lg:px-8">
    <h2 class="type-section text-slate-950">Pilih area sesuai kebutuhan Anda.</h2>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
      {directories.map((item) => (
        <NavigationCard href={item.href} title={item.title} description={item.description} icon={item.icon} density="compact" />
      ))}
    </div>
  </section>
</BaseLayout>
