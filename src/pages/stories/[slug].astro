---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StoryCard from '../../components/StoryCard.astro';
import { campuses } from '../../data/campuses';
import { stories, storyTopicLabels, type Story } from '../../data/stories';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return stories.map((story) => ({
    params: { slug: story.slug },
    props: { story }
  }));
}

interface Props {
  story: Story;
}

const { story } = Astro.props;
const campus = campuses.find((item) => item.slug === story.campusSlug);
const relatedStories = stories
  .filter((item) => item.slug !== story.slug)
  .filter((item) =>
    item.campusSlug === story.campusSlug ||
    item.topics.some((topic) => story.topics.includes(topic))
  )
  .slice(0, 3);
---

<BaseLayout title={story.title} description={story.excerpt}>
  <article>
    <header class="mx-auto max-w-5xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
      <Breadcrumbs items={[
        { label: 'Beranda', href: '/' },
        { label: 'Cerita PPI Ishikawa', href: '/stories/' },
        { label: story.title }
      ]} />

      <div class="mt-8 flex flex-wrap gap-2">
        {campus && <a href={withBase(`/community/kampus/${campus.slug}/`)} class="rounded-full bg-accent/10 px-3 py-1.5 text-xs font-bold text-accent-dark">{campus.shortName}</a>}
        <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">{story.status}</span>
        {story.topics.map((topic) => (
          <span class="rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-500">{storyTopicLabels[topic]}</span>
        ))}
      </div>

      <h1 class="mt-6 max-w-4xl text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">{story.title}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{story.excerpt}</p>

      <div class="mt-7 flex flex-wrap gap-x-8 gap-y-3 border-t border-slate-200 pt-6 text-sm">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-400">Narasumber</p>
          <p class="mt-1 font-bold text-slate-950">{story.personName}</p>
        </div>
        {story.program && (
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-400">Program</p>
            <p class="mt-1 font-semibold text-slate-700">{story.program}</p>
          </div>
        )}
        {story.period && (
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-400">Periode di Ishikawa</p>
            <p class="mt-1 font-semibold text-slate-700">{story.period}</p>
          </div>
        )}
        {story.currentActivity && (
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-slate-400">Sekarang</p>
            <p class="mt-1 font-semibold text-slate-700">{story.currentActivity}</p>
          </div>
        )}
      </div>
    </header>

    {story.imageUrl && (
      <figure class="mx-auto max-w-6xl px-5 lg:px-8">
        <img src={story.imageUrl} alt={story.imageAlt || story.title} class="aspect-[16/9] w-full rounded-[2rem] object-cover" />
      </figure>
    )}

    <div class="mx-auto max-w-3xl px-5 py-12 lg:px-8">
      {story.quote && (
        <blockquote class="mb-10 border-l-4 border-accent/50 pl-6 text-2xl font-semibold leading-9 text-slate-800">
          “{story.quote}”
        </blockquote>
      )}

      <div class="space-y-10">
        {story.sections.map((section) => (
          <section>
            <h2 class="text-2xl font-bold tracking-tight text-slate-950">{section.heading}</h2>
            <div class="mt-4 space-y-4">
              {section.paragraphs.map((paragraph) => (
                <p class="leading-8 text-slate-700">{paragraph}</p>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </article>

  {relatedStories.length > 0 && (
    <section class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Cerita terkait</p>
        <h2 class="mt-3 text-2xl font-bold text-slate-950">Baca pengalaman lainnya.</h2>
        <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {relatedStories.map((item) => <StoryCard story={item} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
