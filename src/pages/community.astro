---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import TopicIcon from '../components/TopicIcon.astro';
import { withBase } from '../utils/paths';
import { publicMedia } from '../data/media';
import { generalRelatedContent } from '../data/related-content';

const entryPoints = [
  {
    title: 'Pendatang baru',
    description: 'Mulai dari persiapan kedatangan, administrasi awal, tempat tinggal, transportasi, dan kebutuhan sehari-hari.',
    href: '/life-in-ishikawa/'
  },
  {
    title: 'Mahasiswa yang sudah tinggal di Ishikawa',
    description: 'Akses informasi kesehatan, bantuan, bencana, musim dingin, keuangan, dan layanan lokal.',
    href: '/life-in-ishikawa/kehidupan-sehari-hari/'
  },
  {
    title: 'Keluarga',
    description: 'Panduan untuk pasangan dan anak: pregnancy, childcare, sekolah, kesehatan, dan layanan keluarga.',
    href: '/life-in-ishikawa/family-anak/'
  },
  {
    title: 'Butuh bantuan',
    description: 'Temukan jalur konsultasi IFIE, dukungan kampus, immigration, labor, dan layanan profesional.',
    href: '/life-in-ishikawa/japanese-support/'
  }
];
---
<BaseLayout title="Komunitas">
  <PageIntro
    title="Komunitas PPI Ishikawa"
    description="PPI Ishikawa menghubungkan mahasiswa, keluarga, pendatang baru, alumni, serta jejaring Indonesia di Prefektur Ishikawa."
  />

  <section class="mx-auto max-w-7xl px-5 pb-12 lg:px-8">
    <figure class="mb-8 overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
      <img src={publicMedia.higashiyama.imageUrl} alt={publicMedia.higashiyama.alt} width="1600" height="1067" class="aspect-[16/9] h-auto w-full object-cover" loading="eager" referrerpolicy="no-referrer" />
      <figcaption class="border-t border-slate-100 bg-slate-50 px-5 py-3 text-xs leading-5 text-slate-500">
        Higashiyama-higashi, Kanazawa · <a href={publicMedia.higashiyama.sourcePage} target="_blank" rel="noreferrer" class="underline">{publicMedia.higashiyama.credit}</a> · {publicMedia.higashiyama.license}
      </figcaption>
    </figure>

    <div class="mb-6 rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-accent-dark">Kampus di Ishikawa</p>
        <h2 class="mt-2 text-xl font-bold text-slate-950">Kenali jaringan kampus anggota PPI Ishikawa.</h2>
        <p class="mt-2 text-sm leading-6 text-slate-700">Campus Hub untuk enam institusi dengan Campus Pack lengkap, perbandingan housing, mobility, support route, dan sumber resmi.</p>
      </div>
      <a href={withBase('/community/kampus/')} class="mt-5 inline-flex shrink-0 rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white sm:mt-0">Buka Campus Hub →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {entryPoints.map((item, index) => (
        <a href={withBase(item.href)} class="rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-red-200 hover:shadow-sm">
          <span class="grid size-11 place-items-center rounded-2xl bg-amber-50 text-accent-dark">
            <TopicIcon name={(['arrival','guide','family','support'] as const)[index]} class="size-6" />
          </span>
          <h2 class="mt-4 font-bold text-slate-950">{item.title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <div class="grid gap-5 md:grid-cols-3">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <span class="grid size-10 place-items-center rounded-xl bg-slate-100 text-brand"><TopicIcon name="campus" class="size-5" /></span>
        <p class="mt-4 text-sm font-bold uppercase tracking-[0.14em] text-brand">Kampus & institusi</p>
        <h2 class="mt-3 text-xl font-bold text-slate-950">6 Campus Pack tersedia</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Enam institusi dengan anggota tercatat pada sensus September 2026 sudah memiliki panduan khusus. Cakupan PPI tetap terbuka untuk pelajar Indonesia di seluruh Prefektur Ishikawa.</p>
        <a href={withBase('/community/kampus/')} class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Jelajahi Campus Hub →</a>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <span class="grid size-10 place-items-center rounded-xl bg-slate-100 text-brand"><TopicIcon name="documents" class="size-5" /></span>
        <p class="mt-4 text-sm font-bold uppercase tracking-[0.14em] text-brand">Data anggota</p>
        <h2 class="mt-3 text-xl font-bold text-slate-950">Privasi anggota tetap dijaga</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Nomor telepon, alamat, dan data pribadi anggota tidak dipublikasikan. Informasi tentang komunitas hanya ditampilkan dalam bentuk yang tidak mengidentifikasi individu.</p>
      </article>
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <span class="grid size-10 place-items-center rounded-xl bg-slate-100 text-brand"><TopicIcon name="collaboration" class="size-5" /></span>
        <p class="mt-4 text-sm font-bold uppercase tracking-[0.14em] text-brand">Bergabung</p>
        <h2 class="mt-3 text-xl font-bold text-slate-950">Bergabung melalui kanal resmi</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Informasi pendaftaran anggota akan diumumkan melalui kanal resmi PPI Ishikawa ketika tersedia.</p>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-10 lg:px-8">
    <div class="rounded-3xl bg-slate-950 p-7 text-white sm:p-9">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-red-300">Prinsip privasi</p>
      <h2 class="mt-3 text-2xl font-bold">Komunitas tidak harus berarti data pribadi menjadi publik.</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-300">Informasi pribadi anggota hanya digunakan untuk kebutuhan organisasi yang relevan dan tidak dipublikasikan tanpa dasar yang jelas.</p>
    </div>
  </section>
  <RelatedLinks items={generalRelatedContent.community} title="Jelajahi komunitas lebih lanjut" />
</BaseLayout>
