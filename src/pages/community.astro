---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import HighlightPanel from '../components/HighlightPanel.astro';
import NavigationCard from '../components/NavigationCard.astro';
import TopicIcon from '../components/TopicIcon.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import LicensedPhoto from '../components/LicensedPhoto.astro';
import { withBase } from '../utils/paths';
import { publicMedia } from '../data/media';

const communityPaths = [
  {
    icon: 'collaboration',
    title: 'Kegiatan & kebersamaan',
    description: 'Temukan ruang untuk bertemu, belajar, berolahraga, berkarya, dan saling mendukung sebagai sesama pelajar Indonesia.',
    href: '/programs/'
  },
  {
    icon: 'campus',
    title: 'Jaringan kampus',
    description: 'Kenali enam institusi yang saat ini terhubung melalui anggota PPI Ishikawa.',
    href: '/community/kampus/'
  },
  {
    icon: 'family',
    title: 'Pelajar & keluarga',
    description: 'PPI Ishikawa juga menjadi ruang sosial bagi pasangan dan keluarga yang tinggal bersama pelajar Indonesia.',
    href: '/life-in-ishikawa/family-anak/'
  },
  {
    icon: 'stories',
    title: 'Cerita PPI Ishikawa',
    description: 'Kisah mahasiswa dan alumni tentang studi, riset, karier, keluarga, dan kehidupan di Ishikawa.',
    href: '/stories/'
  },
  {
    icon: 'support',
    title: 'Terhubung dengan PPI',
    description: 'Hubungi PPI Ishikawa untuk bertanya, mengenalkan diri, menyampaikan kebutuhan, atau menawarkan kolaborasi.',
    href: '/contact/'
  }
];
---
<BaseLayout
  title="Komunitas"
  description="Ruang untuk terhubung dengan pelajar Indonesia, keluarga, kegiatan, kampus, dan jejaring PPI Ishikawa."
>
  <LandingHeader
    title="Komunitas PPI Ishikawa"
    description="Ruang untuk saling terhubung sebagai pelajar Indonesia di Ishikawa—lintas kampus, tahap studi, minat, dan kehidupan keluarga."
  />

  <section class="mx-auto max-w-7xl px-5 pb-16 lg:px-8">
    <div class="max-w-3xl">
      <p class="type-eyebrow text-brand">Terhubung sebagai komunitas</p>
      <h2 class="mt-3 type-section text-slate-950">Terhubung dengan orang, kegiatan, dan jejaring di Ishikawa.</h2>
      <p class="mt-4 leading-7 text-slate-600">Temukan kegiatan PPI Ishikawa, jaringan kampus, ruang bagi pelajar dan keluarga, serta jalur untuk bertanya atau menawarkan kolaborasi.</p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {communityPaths.map((item) => (
        <NavigationCard href={item.href} title={item.title} description={item.description} icon={item.icon} />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-12 lg:px-8">
    <LicensedPhoto media={publicMedia.higashiyama} />
  </section>

  <InstagramFeed />

  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[1fr_.9fr]">
        <div>
          <p class="type-eyebrow text-brand">Cakupan komunitas</p>
          <h2 class="mt-3 type-section text-slate-950">Lintas kampus, tetap satu komunitas.</h2>
          <p class="mt-4 max-w-2xl leading-7 text-slate-600">Enam institusi saat ini tercatat memiliki anggota terhubung, tetapi PPI Ishikawa tetap terbuka bagi pelajar Indonesia di seluruh Prefektur Ishikawa.</p>
          <a href={withBase('/community/kampus/')} class="mt-5 inline-flex text-sm font-bold text-brand hover:underline">Lihat jaringan kampus →</a>
        </div>
        <div class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-accent-soft">Butuh informasi praktis?</p>
          <p class="mt-3 text-xl font-bold">Pilih panduan sesuai kebutuhan.</p>
          <div class="mt-5 space-y-3 text-sm">
            <a href={withBase('/life-in-ishikawa/')} class="block rounded-xl border border-slate-700 bg-white/5 px-4 py-3 font-bold hover:bg-white/10">Hidup di Ishikawa →</a>
            <a href={withBase('/beasiswa/')} class="block rounded-xl border border-slate-700 bg-white/5 px-4 py-3 font-bold hover:bg-white/10">Beasiswa →</a>
            <a href={withBase('/community/kampus/')} class="block rounded-xl border border-slate-700 bg-white/5 px-4 py-3 font-bold hover:bg-white/10">Kampus →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 ui-section-space lg:px-8">
    <HighlightPanel>
      <p class="type-eyebrow text-accent-dark">Ingin terhubung?</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Mulai dari percakapan.</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-700">Mahasiswa baru, mahasiswa aktif, keluarga, alumni, maupun mitra dapat menghubungi PPI Ishikawa melalui jalur kontak yang tersedia.</p>
      <a href={withBase('/contact/')} class="mt-5 inline-flex rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white">Hubungi PPI Ishikawa →</a>
    </HighlightPanel>
  </section>
</BaseLayout>
