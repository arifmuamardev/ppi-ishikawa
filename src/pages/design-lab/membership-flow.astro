---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { campuses } from '../../data/campuses';
import { studyLevels } from '../../data/membership';
---
<BaseLayout title="Design Lab — Membership tanpa password" description="Prototipe interaktif alur login Magic Link dan onboarding bertahap PPI Ishikawa.">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mb-7 flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="type-eyebrow text-brand">Design Lab / Membership · Konsep W02</p>
        <h1 class="mt-2 text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl">Satu akun, dua jalur.</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Simulasikan akun peserta kegiatan atau pendaftaran keanggotaan resmi PPI. Login dan onboarding produksi tidak berubah.</p>
      </div>
      <span class="rounded-full border border-accent/35 bg-accent/10 px-3 py-2 text-xs font-bold text-brand">PROTOTIPE · TANPA DATABASE</span>
    </div>

    <div class="grid overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm lg:min-h-[650px] lg:grid-cols-[0.79fr_1fr]">
      <aside class="relative isolate overflow-hidden bg-[#103D40] px-6 py-8 text-white sm:px-9 sm:py-12 lg:px-10">
        <svg class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-30" viewBox="0 0 440 670" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
          <path d="M-45 442C62 336 56 519 163 425C286 318 311 438 489 245" stroke="#DBF0DF" stroke-width="1.5"/>
          <path d="M-45 470C62 364 56 547 163 453C286 346 311 466 489 273" stroke="#DBF0DF" stroke-width="1.5"/>
          <path d="M-45 498C62 392 56 575 163 481C286 374 311 494 489 301" stroke="#DBF0DF" stroke-width="1.5"/>
          <path d="M-45 526C62 420 56 603 163 509C286 402 311 522 489 329" stroke="#DBF0DF" stroke-width="1.5"/>
          <path d="M-45 554C62 448 56 631 163 537C286 430 311 550 489 357" stroke="#DBF0DF" stroke-width="1.5"/>
          <circle cx="333" cy="92" r="123" stroke="#B7D9CC" stroke-width="1.5" stroke-dasharray="5 8"/>
          <circle cx="333" cy="92" r="96" stroke="#B7D9CC" stroke-width="1.5"/>
          <circle cx="333" cy="92" r="72" stroke="#B7D9CC" stroke-width="1.5"/>
        </svg>
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/30 bg-white/15 text-lg font-extrabold">P</div>
          <div>
            <p class="text-sm font-bold tracking-wide">PPI Ishikawa</p>
            <p class="text-xs text-white/65">Student first, organization sustainable</p>
          </div>
        </div>

        <div class="mt-16 lg:mt-24">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#B9E3D7]">Member Experience</p>
          <h2 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">Satu email.<br/>Satu langkah<br/>setiap waktu.</h2>
          <p class="mt-5 max-w-sm text-sm leading-7 text-white/80">Tidak semua pengguna website adalah anggota organisasi. Pilih tujuan Anda, lalu isi hanya data yang diperlukan, satu pertanyaan setiap layar.</p>
        </div>

        <div class="mt-10 space-y-4 border-t border-white/20 pt-7 text-sm lg:mt-20">
          <div class="flex gap-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/15 font-bold">1</span><p class="pt-1">Masukkan email dan buka Magic Link</p></div>
          <div class="flex gap-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/15 font-bold">2</span><p class="pt-1">Pilih peserta kegiatan atau calon anggota PPI</p></div>
          <div class="flex gap-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/15 font-bold">3</span><p class="pt-1">Hanya keanggotaan resmi perlu verifikasi</p></div>
        </div>
      </aside>

      <div class="min-w-0 px-5 py-7 sm:px-9 sm:py-11 lg:px-11">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 pb-5">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Simulasi perjalanan</p>
          <div role="group" aria-label="Jenis anggota dalam simulasi" class="flex items-center gap-1 rounded-xl bg-slate-100 p-1">
            <button id="scenario-new" type="button" class="rounded-lg bg-white px-3 py-2 text-xs font-bold text-brand shadow-sm" aria-pressed="true">Akun baru</button>
            <button id="scenario-existing" type="button" class="rounded-lg px-3 py-2 text-xs font-bold text-slate-600" aria-pressed="false">Akun sudah ada</button>
          </div>
        </div>

        <div id="prototype-login" class="pt-10 sm:pt-14">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand">Langkah pertama</p>
          <h3 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-950 sm:text-3xl">Masuk atau buat akun</h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">Satu email untuk mengikuti kegiatan atau mengajukan keanggotaan resmi.</p>
          <form id="prototype-login-form" class="mt-9 space-y-5">
            <label class="block">
              <span class="text-sm font-bold text-slate-800">Alamat email Anda</span>
              <input id="prototype-email" type="email" autocomplete="off" placeholder="nama@email.com" required class="ui-field mt-2" />
            </label>
            <button type="submit" class="ui-action-primary w-full">Lanjutkan dengan email <span aria-hidden="true">→</span></button>
          </form>
          <div class="mt-6 flex gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
            <span aria-hidden="true" class="text-lg text-brand">✦</span>
            <p class="text-xs leading-6 text-slate-600">Tidak perlu password atau status mahasiswa untuk membuat akun website. <strong>Simulasi ini tidak benar-benar mengirim email.</strong></p>
          </div>
        </div>

        <div id="prototype-email-sent" class="hidden pt-12 text-center sm:pt-16" aria-live="polite">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl border border-accent/30 bg-accent/10 text-4xl text-brand" aria-hidden="true">✉</div>
          <h3 class="mt-6 text-2xl font-extrabold text-slate-950">Periksa email Anda</h3>
          <p class="mx-auto mt-3 max-w-sm text-sm leading-7 text-slate-600">Dalam sistem asli, kami akan mengirim tautan sekali pakai ke <strong id="sent-email" class="break-all text-slate-900"></strong>.</p>
          <button id="prototype-open-link" type="button" class="ui-action-primary mt-8 w-full">Simulasikan membuka Magic Link <span aria-hidden="true">→</span></button>
          <button id="prototype-change-email" type="button" class="mt-4 w-full min-h-11 text-sm font-bold text-brand hover:underline">Gunakan email lain</button>
          <p class="mt-6 text-xs text-slate-500">Mode demo: tidak ada email yang dikirim, akun yang dibuat, atau informasi yang disimpan.</p>
        </div>

        <form id="prototype-wizard" class="hidden pt-8 sm:pt-10" novalidate>
          <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
            <p id="wizard-counter" class="text-xs font-bold uppercase tracking-[0.12em] text-brand">Pilih tujuan Anda</p>
            <span id="wizard-path-label" class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-bold text-slate-600">Akun website</span>
          </div>
          <div class="mb-9 flex gap-1.5" role="progressbar" id="wizard-progress" aria-label="Progres onboarding" aria-valuemin="1" aria-valuemax="7" aria-valuenow="1">
            {Array.from({length:7},(_,i)=><span data-progress={i} class:list={['h-1.5 flex-1 rounded-full',i===0?'bg-brand':'bg-slate-200']} aria-hidden="true"></span>)}
          </div>
          <p id="wizard-kicker" class="text-xs font-bold uppercase tracking-wider text-slate-500">Langkah awal · untuk semua pengguna</p>
          <h3 id="wizard-title" class="mt-3 text-2xl font-extrabold leading-snug tracking-tight text-slate-950 sm:text-3xl">Apa tujuanmu menggunakan website PPI?</h3>
          <p id="wizard-helper" class="mt-3 min-h-12 text-sm leading-7 text-slate-600">Pilih sesuai kebutuhan saat ini. Pilihan ini bisa berubah kemudian.</p>

          <div class="mt-7 min-h-36">
            <div data-wizard-step="intent">
              <fieldset class="space-y-3">
                <legend class="sr-only">Tujuan menggunakan website PPI</legend>
                <label class="wizard-choice flex cursor-pointer items-start gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 transition-colors hover:border-brand">
                  <input type="radio" name="intent" value="event" class="ui-check mt-1 shrink-0" />
                  <span>
                    <strong class="block text-base font-bold text-slate-950">Ikut kegiatan & webinar</strong>
                    <span class="mt-1 block text-sm leading-6 text-slate-600">Untuk peserta umum. Tidak perlu data akademik, tidak menjadi anggota PPI otomatis.</span>
                  </span>
                </label>
                <label class="wizard-choice flex cursor-pointer items-start gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 transition-colors hover:border-brand">
                  <input type="radio" name="intent" value="membership" class="ui-check mt-1 shrink-0" />
                  <span>
                    <strong class="block text-base font-bold text-slate-950">Ajukan keanggotaan PPI</strong>
                    <span class="mt-1 block text-sm leading-6 text-slate-600">Untuk pelajar atau peneliti yang memenuhi ketentuan. Memerlukan verifikasi pengurus.</span>
                  </span>
                </label>
              </fieldset>
            </div>
            <div data-wizard-step="name" class="hidden">
              <label class="sr-only" for="wizard-name">Nama lengkap</label>
              <input id="wizard-name" name="full_name" type="text" minlength="2" maxlength="120" autocomplete="name" placeholder="Contoh: Budi Santoso" class="ui-field text-base" required />
            </div>
            <div data-wizard-step="campus" class="hidden">
              <label class="sr-only" for="wizard-campus">Kampus atau institusi pendidikan</label>
              <select id="wizard-campus" name="campus_slug" class="ui-field text-base">
                <option value="">Pilih kampus atau institusi</option>
                {campuses.map(c=><option value={c.slug}>{c.shortName}</option>)}
              </select>
              <p class="mt-3 text-xs text-slate-500">Jika institusi Anda tidak ada, verifikasi kelayakan tetap dilakukan pengurus.</p>
            </div>
            <div data-wizard-step="program" class="hidden">
              <label class="sr-only" for="wizard-program">Program studi atau kegiatan riset</label>
              <input id="wizard-program" name="program" type="text" maxlength="160" placeholder="Contoh: Computer Science" class="ui-field text-base" />
            </div>
            <div data-wizard-step="level" class="hidden">
              <fieldset>
                <legend class="sr-only">Jenjang atau status studi</legend>
                <div class="grid grid-cols-2 gap-2.5">
                  {studyLevels.map((level)=>
                    <label class="wizard-level flex min-h-12 cursor-pointer items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-brand">
                      <input type="radio" name="study_level" value={level.value} class="ui-check shrink-0" />
                      <span>{level.label}</span>
                    </label>
                  )}
                </div>
              </fieldset>
            </div>
            <div data-wizard-step="consent" class="hidden">
              <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <input id="wizard-consent" name="consent" type="checkbox" class="ui-check mt-1 shrink-0" />
                <span id="wizard-consent-copy" class="text-sm leading-7 text-slate-700">Saya setuju data digunakan untuk administrasi akun website dan partisipasi kegiatan PPI Ishikawa.</span>
              </label>
              <p id="wizard-privacy-note" class="mt-3 text-xs leading-6 text-slate-500">Mengikuti kegiatan tidak sama dengan menjadi anggota organisasi.</p>
            </div>
            <div data-wizard-step="review" class="hidden">
              <div id="wizard-review" class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-slate-50 px-4" aria-label="Ringkasan data"></div>
              <p id="wizard-review-note" class="mt-3 text-xs leading-6 text-slate-500">Selesaikan untuk menyiapkan akun peserta. Pendaftaran ke webinar tertentu dilakukan terpisah.</p>
            </div>
          </div>
          <p id="wizard-error" class="min-h-6 text-sm font-semibold text-red-700" role="alert" aria-live="polite"></p>
          <div class="mt-4 grid grid-cols-[auto_1fr] gap-3">
            <button id="wizard-back" type="button" class="min-h-12 rounded-xl border border-slate-300 px-5 text-sm font-bold text-slate-700 hover:border-brand hover:text-brand">← Kembali</button>
            <button id="wizard-next" type="submit" class="ui-action-primary w-full">Lanjut <span aria-hidden="true">→</span></button>
          </div>
          <p class="mt-6 text-center text-xs text-slate-500">Email terverifikasi <span id="wizard-email" class="font-semibold text-slate-700"></span></p>
        </form>

        <div id="prototype-existing" class="hidden pt-12 text-center sm:pt-16">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl border border-accent/30 bg-accent/10 text-4xl text-brand" aria-hidden="true">✓</div>
          <h3 class="mt-6 text-2xl font-extrabold text-slate-950">Selamat datang kembali!</h3>
          <p class="mx-auto mt-3 max-w-sm text-sm leading-7 text-slate-600">Akun yang sudah ada langsung masuk ke dashboard sesuai hak aksesnya. Peserta kegiatan dapat mengajukan keanggotaan PPI jika nanti memenuhi syarat.</p>
          <button type="button" id="prototype-existing-upgrade" class="ui-action-primary mt-8 w-full">Simulasi ajukan keanggotaan PPI →</button>
          <button type="button" data-prototype-reset class="ui-action-secondary mt-3 w-full">Mulai ulang simulasi</button>
        </div>

        <div id="prototype-finished" class="hidden pt-12 text-center sm:pt-16">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl border border-accent/30 bg-accent/10 text-4xl text-brand" aria-hidden="true">✓</div>
          <h3 class="mt-6 text-2xl font-extrabold text-slate-950">Selesai, <span id="finished-name">teman PPI</span>!</h3>
          <p id="finished-description" class="mx-auto mt-3 max-w-sm text-sm leading-7 text-slate-600">Akun peserta siap digunakan untuk mendaftar kegiatan terbuka. Anda bukan otomatis anggota organisasi, dan webinar tertentu tetap memerlukan registrasi kegiatan terpisah.</p>
          <button id="prototype-upgrade" type="button" class="ui-action-primary mt-7 w-full">Ajukan keanggotaan PPI nanti →</button>
          <button type="button" data-prototype-reset class="ui-action-secondary mt-8 w-full">Ulangi dari awal</button>
        </div>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-start justify-between gap-3 text-xs text-slate-500">
      <p>Rancangan awal · Tanpa backend, tanpa email sungguhan, tanpa penyimpanan data.</p>
      <p>Alur produksi tidak berubah sampai desain disetujui.</p>
    </div>
  </section>
  <script>
    const views = {
      login: document.getElementById('prototype-login'),
      email: document.getElementById('prototype-email-sent'),
      wizard: document.getElementById('prototype-wizard'),
      existing: document.getElementById('prototype-existing'),
      finished: document.getElementById('prototype-finished'),
    } as const;
    type View = keyof typeof views;
    type Intent = 'event' | 'membership';
    type StepKey = 'intent' | 'name' | 'campus' | 'program' | 'level' | 'consent' | 'review';
    const tracks: Record<Intent, StepKey[]> = {
      event: ['intent','name','consent','review'],
      membership: ['intent','name','campus','program','level','consent','review'],
    };
    const titles: Record<StepKey,string> = {
      intent: 'Apa tujuanmu menggunakan website PPI?',
      name: 'Siapa nama lengkapmu?',
      campus: 'Kamu belajar atau meneliti di mana?',
      program: 'Apa program studi atau bidang risetmu?',
      level: 'Apa jenjang atau status studimu?',
      consent: 'Setujui penggunaan data',
      review: 'Periksa jawabanmu',
    };
    const helpers: Record<StepKey,string> = {
      intent: 'Pilih sesuai kebutuhan saat ini. Pilihan ini tidak mengunci akun selamanya.',
      name: 'Satu nama yang dipakai untuk akun dan sertifikat kegiatan.',
      campus: 'Pilih institusimu. Kelayakan sebagai anggota resmi tetap diverifikasi pengurus.',
      program: 'Cukup tulis jurusan atau bidang riset singkat.',
      level: 'Pilih kategori yang paling mendekati aktivitas akademik saat ini.',
      consent: 'Penggunaan data disesuaikan dengan tujuan yang kamu pilih.',
      review: 'Periksa kembali. Ini hanyalah simulasi; tidak ada data yang dikirim.',
    };
    const $ = (selector:string) => document.querySelector<HTMLElement>(selector);
    const nameField = document.querySelector<HTMLInputElement>('#wizard-name');
    const campusField = document.querySelector<HTMLSelectElement>('#wizard-campus');
    const programField = document.querySelector<HTMLInputElement>('#wizard-program');
    const consentField = document.querySelector<HTMLInputElement>('#wizard-consent');
    const loginField = document.querySelector<HTMLInputElement>('#prototype-email');
    const counter = $('#wizard-counter');
    const title = $('#wizard-title');
    const helper = $('#wizard-helper');
    const kicker = $('#wizard-kicker');
    const error = $('#wizard-error');
    const pathLabel = $('#wizard-path-label');
    const progress = Array.from(document.querySelectorAll<HTMLElement>('[data-progress]'));
    const next = document.querySelector<HTMLButtonElement>('#wizard-next');
    const back = document.querySelector<HTMLButtonElement>('#wizard-back');
    const review = $('#wizard-review');
    const scenarioNew = document.querySelector<HTMLButtonElement>('#scenario-new');
    const scenarioExisting = document.querySelector<HTMLButtonElement>('#scenario-existing');
    let scenario: 'new' | 'existing' = 'new';
    let stepIndex = 0;

    const selectedIntent=(): Intent | null => {
      const v=document.querySelector<HTMLInputElement>('input[name="intent"]:checked')?.value;
      return v==='event'||v==='membership'?v:null;
    };
    const currentTrack=(): Intent => selectedIntent()||'event';
    const currentSteps=(): StepKey[] => tracks[currentTrack()];
    const currentStep=(): StepKey => currentSteps()[stepIndex]||'intent';
    function show(view:View) {
      Object.entries(views).forEach(([name,element])=>element?.classList.toggle('hidden',name!==view));
    }
    function scenarioSet(value:'new'|'existing') {
      scenario=value;
      for(const [button,selected] of [[scenarioNew,value==='new'],[scenarioExisting,value==='existing']] as const){
        button?.setAttribute('aria-pressed',String(selected));
        button?.classList.toggle('bg-white',selected);
        button?.classList.toggle('text-brand',selected);
        button?.classList.toggle('shadow-sm',selected);
        button?.classList.toggle('text-slate-600',!selected);
      }
      reset();
    }
    function reset(){
      stepIndex=0;
      document.querySelector<HTMLFormElement>('#prototype-login-form')?.reset();
      document.querySelector<HTMLFormElement>('#prototype-wizard')?.reset();
      document.querySelectorAll('.wizard-choice,.wizard-level').forEach(el=>el.classList.remove('border-brand','bg-accent/10'));
      updateStep();
      show('login');
    }
    function selectChoiceAppearance(name:string) {
      document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach(input=>{
        const label=input.closest('label');
        label?.classList.toggle('border-brand',input.checked);
        label?.classList.toggle('bg-accent/10',input.checked);
      });
    }
    function reviewValue(label:string,value:string) {
      const row=document.createElement('div');
      row.className='flex flex-wrap items-start justify-between gap-2 py-3 text-sm';
      const key=document.createElement('span');
      key.className='font-medium text-slate-600';key.textContent=label;
      const val=document.createElement('strong');
      val.className='max-w-full break-words text-right font-semibold text-slate-900';val.textContent=value||'—';
      row.append(key,val);review?.append(row);
    }
    function fillReview(){
      review?.replaceChildren();
      const intent=currentTrack();
      reviewValue('Tujuan',intent==='event'?'Peserta kegiatan':'Calon anggota resmi PPI');
      reviewValue('Nama lengkap',nameField?.value.trim()||'');
      reviewValue('Email',loginField?.value.trim()||'');
      if(intent==='membership'){
        reviewValue('Institusi',campusField?.selectedOptions[0]?.textContent||'');
        reviewValue('Jurusan / riset',programField?.value.trim()||'');
        reviewValue('Jenjang',document.querySelector<HTMLInputElement>('input[name="study_level"]:checked')?.closest('label')?.querySelector('span')?.textContent||'');
      }
      reviewValue('Persetujuan',consentField?.checked?'Diberikan':'Belum diberikan');
      const note=$('#wizard-review-note');
      if(note)note.textContent=intent==='event'
        ? 'Akun peserta kegiatan bukan keanggotaan resmi. Registrasi webinar tertentu dilakukan kemudian di halaman event.'
        : 'Pengajuan keanggotaan baru akan menunggu pemeriksaan pengurus. Belum ada hak anggota terverifikasi.';
    }
    function updateStep(){
      const key=currentStep();
      const steps=currentSteps();
      document.querySelectorAll<HTMLElement>('[data-wizard-step]').forEach(el=>el.classList.toggle('hidden',el.dataset.wizardStep!==key));
      progress.forEach((bar,i)=>{
        bar.classList.toggle('hidden',i>=steps.length);
        bar.classList.toggle('bg-brand',i<=stepIndex);
        bar.classList.toggle('bg-slate-200',i>stepIndex);
      });
      const meter=$('#wizard-progress');
      meter?.setAttribute('aria-valuemin','1');
      meter?.setAttribute('aria-valuemax',String(steps.length));
      meter?.setAttribute('aria-valuenow',String(stepIndex+1));
      if(counter)counter.textContent=key==='intent'?'Pilih jalur pendaftaran':key==='review'?'Ringkasan · langkah terakhir':`Pertanyaan ${stepIndex+1} dari ${steps.length-1}`;
      if(title)title.textContent=titles[key];
      if(helper)helper.textContent=helpers[key];
      if(kicker)kicker.textContent=key==='intent'?'Satu akun, dua kemungkinan':currentTrack()==='event'?'Jalur peserta kegiatan':'Jalur keanggotaan resmi';
      if(pathLabel)pathLabel.textContent=selectedIntent()===null?'Tentukan tujuan':currentTrack()==='event'?'Peserta kegiatan':'Calon anggota PPI';
      const consentCopy=$('#wizard-consent-copy');
      if(consentCopy)consentCopy.textContent=currentTrack()==='event'
        ? 'Saya setuju data akun digunakan untuk administrasi akun dan kegiatan PPI Ishikawa. Akun ini bukan status keanggotaan resmi.'
        : 'Saya setuju data digunakan pengurus PPI Ishikawa untuk memeriksa permohonan keanggotaan sesuai ketentuan organisasi.';
      const privacy=$('#wizard-privacy-note');
      if(privacy)privacy.textContent=currentTrack()==='event'
        ? 'Tidak perlu nama kampus, jurusan, atau jenjang studi. Daftar webinar tertentu dilakukan pada halaman acara.'
        : 'Informasi akademik hanya untuk pengajuan. Profil tetap privat hingga Anda memilih untuk tampil di direktori.';
      if(error)error.textContent='';
      if(next)next.innerHTML=key==='review'?'Selesaikan simulasi <span aria-hidden="true">✓</span>':'Lanjut <span aria-hidden="true">→</span>';
      if(back)back.textContent=stepIndex===0?'← Kembali ke email':'← Kembali';
      if(key==='review')fillReview();
      const target=document.querySelector<HTMLElement>(`[data-wizard-step="${key}"] input, [data-wizard-step="${key}"] select`);
      if(target && key!=='intent')requestAnimationFrame(()=>target.focus({preventScroll:true}));
    }
    function validStep(): string {
      switch(currentStep()){
        case 'intent': return selectedIntent()?'':'Pilih tujuan pendaftaran terlebih dahulu.';
        case 'name': return (nameField?.value.trim().length||0)>=2?'':'Nama lengkap minimal 2 karakter.';
        case 'campus': return campusField?.value?'':'Pilih institusi pendidikan atau risetmu.';
        case 'program': return programField?.value.trim()?'':'Tuliskan jurusan atau bidang risetmu.';
        case 'level': return document.querySelector<HTMLInputElement>('input[name="study_level"]:checked')?'':'Pilih jenjang atau status studi.';
        case 'consent': return consentField?.checked?'':'Persetujuan penggunaan data diperlukan.';
        default: return '';
      }
    }
    function startUpgrade(){
      const preservedEmail=loginField?.value||'';
      const preservedName=nameField?.value||'';
      scenarioSet('new');
      if(loginField)loginField.value=preservedEmail;
      if(nameField)nameField.value=preservedName;
      const emailLabel=$('#wizard-email');
      if(emailLabel)emailLabel.textContent=preservedEmail;
      const field=document.querySelector<HTMLInputElement>('input[name="intent"][value="membership"]');
      if(field)field.checked=true;
      selectChoiceAppearance('intent');
      stepIndex=0;
      updateStep();
      show('wizard');
    }
    document.getElementById('prototype-login-form')?.addEventListener('submit',event=>{
      event.preventDefault();
      if(!loginField?.validity.valid){loginField?.reportValidity();return;}
      const email=loginField.value.trim();
      const emailSent=$('#sent-email');
      const wizardEmail=$('#wizard-email');
      if(emailSent)emailSent.textContent=email;
      if(wizardEmail)wizardEmail.textContent=email;
      show('email');
    });
    document.getElementById('prototype-open-link')?.addEventListener('click',()=>{
      if(scenario==='existing')show('existing');
      else{stepIndex=0;updateStep();show('wizard');}
    });
    document.getElementById('prototype-change-email')?.addEventListener('click',()=>show('login'));
    document.getElementById('prototype-wizard')?.addEventListener('submit',event=>{
      event.preventDefault();
      const problem=validStep();
      if(problem){if(error)error.textContent=problem;return;}
      if(currentStep()==='review'){
        const finish=$('#finished-name');
        if(finish)finish.textContent=(nameField?.value.trim()||'teman PPI').split(' ')[0];
        const description=$('#finished-description');
        const upgrade=$('#prototype-upgrade');
        if(currentTrack()==='event'){
          if(description)description.textContent='Akun peserta siap digunakan untuk mendaftar kegiatan terbuka. Anda tidak otomatis menjadi anggota PPI; registrasi webinar tertentu tetap dilakukan terpisah.';
          upgrade?.classList.remove('hidden');
        }else{
          if(description)description.textContent='Pengajuan keanggotaan PPI tercatat dalam simulasi dan masih perlu diperiksa pengurus. Hak anggota resmi belum aktif.';
          upgrade?.classList.add('hidden');
        }
        show('finished');
      }else{
        stepIndex+=1;
        updateStep();
      }
    });
    back?.addEventListener('click',()=>{
      if(stepIndex===0){show('email');return;}
      stepIndex-=1;updateStep();
    });
    scenarioNew?.addEventListener('click',()=>scenarioSet('new'));
    scenarioExisting?.addEventListener('click',()=>scenarioSet('existing'));
    document.querySelectorAll<HTMLInputElement>('input[name="intent"],input[name="study_level"]').forEach(input=>input.addEventListener('change',()=>{
      selectChoiceAppearance(input.name);
      if(input.name==='intent'){
        if(consentField)consentField.checked=false;
        stepIndex=0;
        updateStep();
      }
    }));
    $('#prototype-upgrade')?.addEventListener('click',startUpgrade);
    $('#prototype-existing-upgrade')?.addEventListener('click',startUpgrade);
    document.querySelectorAll('[data-prototype-reset]').forEach(button=>button.addEventListener('click',reset));
    updateStep();
  </script>
</BaseLayout>
