---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { departments } from '../data/organization';
---
<BaseLayout title="Program & Kegiatan">
  <PageIntro
    title="Program & kegiatan"
    description="Program PPI Ishikawa dikembangkan dari kebutuhan anggota, mandat tiap departemen, dan kapasitas organisasi—bukan sekadar daftar kegiatan."
  />

  <section class="mx-auto max-w-7xl px-5 pb-10 lg:px-8">
    <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-amber-800">Status 2026/27</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Program kerja belum dipublikasikan sebagai daftar final.</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-700">Saat ini halaman ini menampilkan fokus kerja tiap departemen. Nama program, jadwal, PIC, dan target akan ditambahkan setelah kepengurusan menetapkannya.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-8 lg:px-8">
    <div class="grid gap-4 md:grid-cols-2">
      {departments.map((department, index) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand">Departemen {String(index + 1).padStart(2, '0')}</p>
              <h2 class="mt-2 text-xl font-semibold text-slate-950">{department.name}</h2>
            </div>
          </div>
          <p class="mt-4 text-sm leading-6 text-slate-600">{department.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
