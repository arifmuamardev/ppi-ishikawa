---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { departments } from '../data/organization';
import { withBase } from '../utils/paths';
import { generalRelatedContent } from '../data/related-content';
---
<BaseLayout title="Program & Kegiatan">
  <PageIntro
    title="Program & kegiatan"
    description="Kenali fokus kerja tujuh departemen PPI Ishikawa dan bidang layanan yang ditangani pada periode 2026/27."
  />

  <section class="mx-auto max-w-7xl px-5 pb-10 lg:px-8">
    <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-amber-800">Status 2026/27</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-950">Kenali fokus kerja setiap departemen.</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-700">Lihat bidang tanggung jawab masing-masing departemen. Program dan jadwal resmi akan ditampilkan ketika sudah ditetapkan.</p>
      <a href={withBase('/about/#struktur-organisasi')} class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Lihat struktur organisasi →</a>
    </div>
  </section>

  <nav class="mx-auto max-w-7xl px-5 pb-2 lg:px-8" aria-label="Navigasi departemen">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Lompat ke departemen</p>
    <div class="flex flex-wrap gap-2">
      {departments.map((department, index) => (
        <a
          href={`#departemen-${String(index + 1).padStart(2, '0')}`}
          class="rounded-full border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 transition hover:border-amber-200 hover:bg-amber-50 hover:text-brand"
        >
          {department.name}
        </a>
      ))}
    </div>
  </nav>

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-8 lg:px-8">
    <div class="grid gap-4 md:grid-cols-2">
      {departments.map((department, index) => (
        <article id={`departemen-${String(index + 1).padStart(2, '0')}`} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand">Departemen {String(index + 1).padStart(2, '0')}</p>
              <h2 class="mt-2 text-xl font-semibold text-slate-950">{department.name}</h2>
            </div>
          </div>
          <p class="mt-4 text-sm leading-6 text-slate-600">{department.description}</p>
        </article>
      ))}
    </div>
  </section>
  <RelatedLinks items={generalRelatedContent.programs} title="Lihat konteks organisasi di balik program" />
</BaseLayout>
