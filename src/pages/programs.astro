---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/LandingHeader.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import ScrollPillNav from '../components/ScrollPillNav.astro';
import { departments } from '../data/organization';
import { withBase } from '../utils/paths';
import { generalRelatedContent } from '../data/related-content';
import { site } from '../data/site';
---
<BaseLayout title="Program & Kegiatan">
  <LandingHeader
    title="Program & kegiatan"
    description={`Kenali fokus kerja tujuh departemen PPI Ishikawa dan bidang layanan yang ditangani pada periode ${site.period}.`}
  />

  <section class="mx-auto max-w-7xl px-5 pb-10 lg:px-8">
    <div class="border-y border-accent/35 bg-accent/10 px-6 py-5 sm:px-8">
      <p class="type-eyebrow text-secondary-dark">Status {site.period}</p>
      <h2 class="type-section mt-3 text-slate-950">Kenali fokus kerja setiap departemen.</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-700">Lihat bidang tanggung jawab masing-masing departemen. Program dan jadwal resmi akan ditampilkan ketika sudah ditetapkan.</p>
      <a href={withBase('/about/#struktur-organisasi')} class="mt-4 inline-flex text-sm font-bold text-brand hover:underline">Lihat struktur organisasi →</a>
    </div>
  </section>

  <div class="pb-2">
    <p class="mx-auto mb-3 max-w-7xl px-5 text-xs font-bold uppercase tracking-[0.14em] text-slate-500 lg:px-8">Lompat ke departemen</p>
    <ScrollPillNav
      ariaLabel="Navigasi departemen"
      items={departments.map((department) => [department.name, `#${department.slug}`] as [string, string])}
    />
  </div>

  <section class="mx-auto max-w-7xl px-5 pb-20 pt-8 lg:px-8">
    <div class="grid gap-4 md:grid-cols-2">
      {departments.map((department, index) => (
        <article id={department.slug} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6">
          <span id={`departemen-${String(index + 1).padStart(2, '0')}`} class="sr-only" aria-hidden="true"></span>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand">Departemen {String(index + 1).padStart(2, '0')}</p>
              <h2 class="type-card-title mt-2 text-slate-950">{department.name}</h2>
            </div>
          </div>
          <p class="mt-4 text-sm leading-6 text-slate-600">{department.description}</p>
        </article>
      ))}
    </div>
  </section>
  <RelatedLinks items={generalRelatedContent.programs} title="Lihat konteks organisasi di balik program" />
</BaseLayout>
