---
import { institutionLogos } from '../data/institution-logos';

interface Props {
  id: keyof typeof institutionLogos;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { id, size = 'md', class: className = '' } = Astro.props;
const logo = institutionLogos[id];

const sizes = {
  sm: 'h-10 w-14 rounded-xl p-1.5',
  md: 'h-12 w-16 rounded-2xl p-2',
  lg: 'h-16 w-20 rounded-2xl p-2.5'
};
---

<span
  class={`inline-flex items-center justify-center border border-slate-200 bg-white shadow-sm ${sizes[size]} ${className}`}
  aria-label={`${logo.name} official identity`}
  title={logo.name}
>
  <img
    src={logo.imageUrl}
    alt={`${logo.name} logo`}
    class="max-h-full max-w-full object-contain"
    loading="lazy"
    referrerpolicy="no-referrer"
  />
</span>
