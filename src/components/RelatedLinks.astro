---
import TopicIcon from './TopicIcon.astro';
import { withBase } from '../utils/paths';
import type { RelatedContentItem } from '../data/related-content';

interface Props {
  items: RelatedContentItem[];
  title?: string;
  eyebrow?: string;
  class?: string;
}

const {
  items,
  title = 'Lanjutkan dari sini',
  eyebrow = 'Baca juga',
  class: className = ''
} = Astro.props;
---

<section class={`mx-auto max-w-5xl px-5 py-10 lg:px-8 ${className}`}>
  <div class="rounded-[2rem] border border-slate-200 bg-slate-50 p-6 sm:p-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">{eyebrow}</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">{title}</h2>
    <div class="mt-6 grid gap-3 md:grid-cols-3">
      {items.map((item) => (
        <a href={withBase(item.href)} class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-amber-200 hover:shadow-sm">
          <span class="grid size-10 place-items-center rounded-xl bg-amber-50 text-accent-dark">
            <TopicIcon name={item.icon as any} class="size-5" />
          </span>
          <h3 class="mt-4 font-bold text-slate-950 group-hover:text-brand">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
          <p class="mt-4 text-sm font-bold text-brand">Lihat {item.title} →</p>
        </a>
      ))}
    </div>
  </div>
</section>
