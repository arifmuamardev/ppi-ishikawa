---
import TopicIcon from './TopicIcon.astro';
import { campusScholarships } from '../data/campus-scholarships';
import { withBase } from '../utils/paths';

interface Props {
  campusSlug: string;
}

const { campusSlug } = Astro.props;
const profile = campusScholarships[campusSlug];
---

{profile && (
  <section id="beasiswa" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <div class="rounded-[2rem] border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex items-start gap-3">
        <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-amber-50 text-brand">
          <TopicIcon name="scholarship" class="size-6" />
        </span>
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Beasiswa di kampus ini</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950">{profile.heading}</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{profile.intro}</p>
        </div>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {profile.items.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noreferrer"
            class="group rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:border-amber-200 hover:bg-amber-50/50"
          >
            <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent-dark">{item.type}</p>
            <h3 class="mt-2 font-bold text-slate-950 group-hover:text-brand">{item.title} ↗</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{item.summary}</p>
          </a>
        ))}
      </div>

      <div class="mt-6 grid gap-4 lg:grid-cols-[1fr_auto] lg:items-center">
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
          <div class="flex gap-3">
            <TopicIcon name="info" class="mt-0.5 size-5 shrink-0 text-accent-dark" />
            <div>
              <p class="font-bold text-slate-950">Untuk scholarship di luar kampus, gunakan Scholarship Hub.</p>
              <p class="mt-2 text-sm leading-6 text-slate-700">{profile.caution}</p>
            </div>
          </div>
        </div>

        <a href={withBase(`/beasiswa/?campus=${campusSlug}#finder`)} class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white transition hover:opacity-90">
          <TopicIcon name="scholarship" class="size-4" />
          Cari beasiswa untuk kampus ini →
        </a>
      </div>

      <p class="mt-4 text-xs leading-5 text-slate-500">Informasi kampus terakhir diperiksa: {profile.lastChecked}. Detail yang berubah per siklus tetap harus dicek pada sumber resmi.</p>
    </div>
  </section>
)}
