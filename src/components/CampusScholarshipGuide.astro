---
import TopicIcon from './TopicIcon.astro';
import { campusScholarships } from '../data/campus-scholarships';
import { withBase } from '../utils/paths';

interface Props {
  campusSlug: string;
}

const { campusSlug } = Astro.props;
const profile = campusScholarships[campusSlug];
---

{profile && (
  <section id="beasiswa" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Beasiswa & dukungan biaya</p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">{profile.heading}</h2>
    <p class="mt-4 max-w-3xl leading-7 text-slate-600">{profile.intro}</p>

    <div class="mt-7 grid gap-5 lg:grid-cols-2">
      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <div class="flex items-center gap-2 text-brand">
          <TopicIcon name="arrival" class="size-5" />
          <h3 class="font-bold text-slate-950">Sebelum datang ke Jepang</h3>
        </div>
        <ul class="mt-4 space-y-3">
          {profile.beforeArrival.map((item) => (
            <li class="flex gap-3 text-sm leading-6 text-slate-700">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-3xl border border-slate-200 bg-white p-6">
        <div class="flex items-center gap-2 text-brand">
          <TopicIcon name="scholarship" class="size-5" />
          <h3 class="font-bold text-slate-950">Setelah menjadi mahasiswa</h3>
        </div>
        <ul class="mt-4 space-y-3">
          {profile.afterArrival.map((item) => (
            <li class="flex gap-3 text-sm leading-6 text-slate-700">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {profile.items.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noreferrer"
          class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-amber-200 hover:shadow-sm"
        >
          <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-accent-dark">{item.type}</p>
          <h3 class="mt-2 font-bold text-slate-950 group-hover:text-brand">{item.title} ↗</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{item.summary}</p>
        </a>
      ))}
    </div>

    <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-5">
      <div class="flex gap-3">
        <TopicIcon name="info" class="mt-0.5 size-5 shrink-0 text-accent-dark" />
        <div>
          <p class="font-bold text-slate-950">Jangan membuat budget dengan asumsi scholarship pasti diterima.</p>
          <p class="mt-2 text-sm leading-6 text-slate-700">{profile.caution}</p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a href={withBase(`/beasiswa/?campus=${campusSlug}#finder`)} class="inline-flex items-center gap-2 rounded-xl bg-brand px-4 py-3 text-sm font-bold text-white transition hover:opacity-90">
        <TopicIcon name="scholarship" class="size-4" />
        Lihat semua beasiswa untuk kampus ini →
      </a>
      <p class="text-xs leading-5 text-slate-500">Scholarship Hub menggabungkan sumber kampus, JASSO, pemerintah daerah, dan foundation.</p>
    </div>

    <p class="mt-4 text-xs leading-5 text-slate-500">Informasi beasiswa terakhir diperiksa: {profile.lastChecked}. Nominal, kuota, eligibility, dan deadline dapat berubah.</p>
  </section>
)}
