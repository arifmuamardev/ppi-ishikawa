---
import TopicIcon from './TopicIcon.astro';
import { campusScholarships } from '../data/campus-scholarships';
import { withBase } from '../utils/paths';

interface Props {
  campusSlug: string;
}

const { campusSlug } = Astro.props;
const profile = campusScholarships[campusSlug];
const previewItems = profile?.items.slice(0, 2) ?? [];
---

{profile && (
  <section id="beasiswa" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-8 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2">
            <span class="grid size-9 place-items-center rounded-xl bg-amber-50 text-brand">
              <TopicIcon name="scholarship" class="size-5" />
            </span>
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">Beasiswa</p>
          </div>
          <h2 class="mt-3 text-xl font-bold text-slate-950">{profile.heading}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">Untuk opsi lintas kampus, cek juga JASSO, MEXT, pemerintah daerah, foundation, dan sumber lain di halaman Beasiswa.</p>

          {previewItems.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {previewItems.map((item) => (
                <a href={item.url} target="_blank" rel="noreferrer" class="rounded-full border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-bold text-slate-700 hover:border-amber-200 hover:bg-amber-50 hover:text-brand">
                  {item.title} ↗
                </a>
              ))}
            </div>
          )}
        </div>

        <a href={withBase(`/beasiswa/?campus=${campusSlug}#finder`)} class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white">
          <TopicIcon name="scholarship" class="size-4" />
          Cari beasiswa untuk kampus ini →
        </a>
      </div>

      <p class="mt-4 border-t border-slate-100 pt-4 text-xs leading-5 text-slate-500">Terakhir diperiksa: {profile.lastChecked}. Detail per siklus tetap mengikuti sumber resmi.</p>
    </div>
  </section>
)}
