---
import { getGuide } from '../data/survival';

interface Props {
  code: string;
}

const { code } = Astro.props;
const guide = getGuide(code);

if (!guide) {
  throw new Error(`Unknown Survival Guide code: ${code}`);
}
---
<div class="mt-7 border-y border-slate-200 py-4" aria-label="Metadata panduan">
  <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-600">
    <span><strong class="font-semibold text-slate-900">Untuk</strong> · {guide.audience}</span>
    <span><strong class="font-semibold text-slate-900">Cakupan</strong> · {guide.appliesTo}</span>
    <span><strong class="font-semibold text-slate-900">Diverifikasi</strong> · {guide.lastVerified}</span>
  </div>

  <details class="mt-3 text-xs text-slate-500">
    <summary class="cursor-pointer font-semibold text-slate-600 hover:text-brand">Detail verifikasi</summary>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
      <span>Perubahan: {guide.volatility}</span>
      <span>Registry: {guide.sourceIds.join(' · ')}</span>
    </div>
  </details>
</div>
