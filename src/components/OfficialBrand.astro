---
interface Props {
  brand: {
    name: string;
    role: string;
    imageUrl: string;
    sourceUrl: string;
    href: string;
    alt: string;
    note: string;
  };
  compact?: boolean;
  class?: string;
}
const { brand, compact = false, class: className = '' } = Astro.props;
---

<div class={`rounded-2xl border border-slate-200 bg-white p-3 shadow-sm ${className}`}>
  <a href={brand.href} target="_blank" rel="noreferrer" class="block">
    <img
      src={brand.imageUrl}
      alt={brand.alt}
      class={compact ? 'mx-auto max-h-14 w-auto object-contain' : 'mx-auto max-h-24 w-auto object-contain'}
      loading="lazy"
      referrerpolicy="no-referrer"
    />
  </a>
  {!compact && (
    <div class="mt-3 border-t border-slate-100 pt-3">
      <p class="text-xs font-bold text-slate-700">{brand.name}</p>
      <p class="mt-1 text-[11px] leading-5 text-slate-500">{brand.role}</p>
      <a href={brand.sourceUrl} target="_blank" rel="noreferrer" class="mt-1 inline-flex text-[11px] font-semibold text-brand hover:underline">Usage/source ↗</a>
    </div>
  )}
</div>
