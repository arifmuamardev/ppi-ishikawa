---
interface Props {
  id: 'kanazawa' | 'nonoichi' | 'hakusan' | 'komatsu' | 'kahoku' | 'nomi' | 'kaga';
  size?: 'sm' | 'md';
  class?: string;
}

const { id, size = 'md', class: className = '' } = Astro.props;
const marks = {
  kanazawa: { jp: '金沢', en: 'Kanazawa' },
  nonoichi: { jp: '野々市', en: 'Nonoichi' },
  hakusan: { jp: '白山', en: 'Hakusan' },
  komatsu: { jp: '小松', en: 'Komatsu' },
  kahoku: { jp: 'かほく', en: 'Kahoku' },
  nomi: { jp: '能美', en: 'Nomi' },
  kaga: { jp: '加賀', en: 'Kaga' }
} as const;
const mark = marks[id];
const sizes = {
  sm: 'min-w-11 h-11 rounded-xl px-2 text-[11px]',
  md: 'min-w-14 h-14 rounded-2xl px-3 text-xs'
};
---

<span
  class={`inline-flex flex-col items-center justify-center border border-slate-200 bg-white font-bold leading-tight text-slate-800 shadow-sm ${sizes[size]} ${className}`}
  aria-label={mark.en}
  title={mark.en}
>
  <span>{mark.jp}</span>
  <span class="mt-0.5 text-[9px] font-semibold uppercase tracking-wide text-slate-400">{mark.en}</span>
</span>
