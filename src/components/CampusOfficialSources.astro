---
interface Props {
  sources: [string, string][];
  lastVerified: string;
  note?: string;
}

const {
  sources,
  lastVerified,
  note = 'Jadwal, biaya, eligibility, layanan, dan informasi per siklus dapat berubah. Gunakan sumber resmi untuk keputusan aktual.'
} = Astro.props;
---

<section class="mx-auto max-w-5xl px-5 pb-16 pt-6 lg:px-8">
  <details class="rounded-2xl border border-accent/35 bg-accent/10 p-5 sm:p-6">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Sumber resmi & verifikasi</p>
        <p class="mt-1 text-sm font-bold text-slate-950">Terakhir diverifikasi: {lastVerified}</p>
      </div>
      <span class="text-xs font-semibold text-slate-600">Buka sumber ↓</span>
    </summary>
    <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-700">{note}</p>
    <div class="mt-4 grid gap-2 sm:grid-cols-2">
      {sources.map(([label, url]) => (
        <a href={url} target="_blank" rel="noreferrer" class="rounded-xl border border-accent/35 bg-white px-4 py-3 text-sm font-bold text-slate-800 transition hover:border-accent/50">
          {label} ↗
        </a>
      ))}
    </div>
  </details>
</section>
