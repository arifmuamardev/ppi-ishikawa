---
import TopicIcon from './TopicIcon.astro';
import { campusCareerProfiles } from '../data/career';
import { withBase } from '../utils/paths';

interface Props {
  campusSlug: string;
}

const { campusSlug } = Astro.props;
const profile = campusCareerProfiles[campusSlug];
---

{profile && (
  <section id="karier" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-8 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2">
            <span class="grid size-9 place-items-center rounded-xl bg-accent/10 text-brand">
              <TopicIcon name="career" class="size-5" />
            </span>
            <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand">Karier</p>
          </div>
          <h2 class="mt-3 text-xl font-bold text-slate-950">{profile.heading}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">{profile.description}</p>
          {profile.note && <p class="mt-3 text-xs leading-5 text-slate-500">{profile.note}</p>}

          <div class="mt-4 flex flex-wrap gap-2">
            <a href={profile.primaryUrl} target="_blank" rel="noreferrer" class="rounded-full border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-bold text-slate-700 hover:border-accent/35 hover:bg-accent/10 hover:text-brand">
              {profile.primaryLabel} ↗
            </a>
            {profile.secondaryUrl && profile.secondaryLabel && (
              <a href={profile.secondaryUrl} target="_blank" rel="noreferrer" class="rounded-full border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-bold text-slate-700 hover:border-accent/35 hover:bg-accent/10 hover:text-brand">
                {profile.secondaryLabel} ↗
              </a>
            )}
          </div>
        </div>

        <a href={withBase(`/career/#campus-${campusSlug}`)} class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-bold text-white">
          <TopicIcon name="career" class="size-4" />
          Lihat karier & peluang →
        </a>
      </div>

      <p class="mt-4 border-t border-slate-100 pt-4 text-xs leading-5 text-slate-500">Sumber kampus diperiksa {profile.lastChecked}. Lowongan dan jadwal rekrutmen tetap mengikuti situs resmi masing-masing penyedia.</p>
    </div>
  </section>
)}
