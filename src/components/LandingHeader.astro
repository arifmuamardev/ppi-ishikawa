---
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const {
  title,
  description,
  eyebrow = `${site.name} ${site.period}`
} = Astro.props;

const hasMeta = Astro.slots.has('meta');
const hasVisual = Astro.slots.has('visual');
---
<section class="mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
  <div class:list={['grid gap-10', hasVisual ? 'items-center lg:grid-cols-[1.05fr_.95fr]' : 'max-w-4xl']}>
    <div>
      {eyebrow && <p class="type-eyebrow text-brand">{eyebrow}</p>}
      <h1 class="type-display mt-4 text-slate-950">{title}</h1>
      <p class="type-lead mt-5 max-w-3xl text-slate-600">{description}</p>
      {hasMeta && <div class="mt-6"><slot name="meta" /></div>}
    </div>

    {hasVisual && (
      <div>
        <slot name="visual" />
      </div>
    )}
  </div>
</section>
