---
import PublicPageHeader from './PublicPageHeader.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---
<PublicPageHeader title={title} description={description} eyebrow={eyebrow}>
  {Astro.slots.has('meta') && <Fragment slot="meta"><slot name="meta" /></Fragment>}
  {Astro.slots.has('visual') && <Fragment slot="visual"><slot name="visual" /></Fragment>}
</PublicPageHeader>
