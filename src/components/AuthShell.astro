---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  size?: 'sm' | 'md';
}

const {
  eyebrow = 'Area Anggota',
  title,
  description,
  size = 'sm'
} = Astro.props;

const width = size === 'md' ? 'max-w-3xl' : 'max-w-xl';
---
<section class:list={['mx-auto px-5 py-14 lg:px-8 lg:py-16', width]}>
  <div class="rounded-2xl border border-slate-200 bg-white p-7 sm:p-9">
    <header>
      <p class="type-eyebrow text-brand">{eyebrow}</p>
      <h1 class="type-section mt-3 text-slate-950">{title}</h1>
      <p class="mt-3 leading-7 text-slate-600">{description}</p>
    </header>
    <slot />
  </div>
</section>
