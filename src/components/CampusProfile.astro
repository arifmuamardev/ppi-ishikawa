---
import type { CampusProfileDetail } from '../data/campuses';
import TopicIcon from './TopicIcon.astro';
import { campuses } from '../data/campuses';

interface Props {
  profile: CampusProfileDetail;
}

const { profile } = Astro.props;
const campus = campuses.find((item) => item.slug === profile.slug);
const officialWebsite = campus?.officialLinks.find((item) => /official website/i.test(item.label)) ?? campus?.officialLinks[0];
const internationalLink = campus?.officialLinks.find((item) => /international|study at/i.test(item.label));
const accessLink = campus?.officialLinks.find((item) => /access|campus/i.test(item.label));
const housingLink = campus?.officialLinks.find((item) => /living|housing|dorm/i.test(item.label));

const quickLinks = [
  officialWebsite && { label: 'Website resmi', url: officialWebsite.url, icon: 'campus' },
  internationalLink && { label: 'International', url: internationalLink.url, icon: 'collaboration' },
  accessLink && { label: 'Akses kampus', url: accessLink.url, icon: 'transport' },
  housingLink && { label: 'Housing resmi', url: housingLink.url, icon: 'housing' },
  { label: 'Google Maps', url: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(profile.mapOverviewQuery)}`, icon: 'map' }
].filter(Boolean) as { label: string; url: string; icon: any }[];

const glanceIcon = (label: string) => {
  const key = label.toLowerCase();
  if (key.includes('mahasiswa') || key.includes('international')) return 'collaboration';
  if (key.includes('struktur') || key.includes('faculty') || key.includes('graduate')) return 'academic';
  if (key.includes('luas') || key.includes('kampus')) return 'building';
  if (key.includes('sejarah') || key.includes('didirikan') || key.includes('berdiri')) return 'info';
  return 'campus';
};
---

<section class="mx-auto max-w-5xl px-5 py-10 lg:px-8">
  <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">Ringkasan kampus</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">Kenali kampus sebelum masuk ke panduan praktisnya.</h2>
      <p class="mt-3 leading-7 text-slate-600">Bagian ini hanya memuat profil inti. Housing, transportasi, dukungan, akademik, dan kehidupan sehari-hari dibahas pada section khusus di bawah.</p>
    </div>

    <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {profile.glance.map((item) => (
        <a href={item.sourceUrl} target="_blank" rel="noreferrer" class="rounded-2xl border border-slate-200 bg-slate-50 p-4 transition hover:border-amber-200 hover:bg-amber-50">
          <div class="flex items-center gap-2">
            <span class="grid size-9 place-items-center rounded-xl bg-white text-brand">
              <TopicIcon name={glanceIcon(item.label) as any} class="size-5" />
            </span>
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500">{item.label}</p>
          </div>
          <p class="mt-2 text-xl font-bold tracking-tight text-slate-950">{item.value}</p>
          {item.note && <p class="mt-2 text-xs leading-5 text-slate-600">{item.note}</p>}
        </a>
      ))}
    </div>

    <div class="mt-5 rounded-3xl border border-amber-200 bg-amber-50 p-5 sm:p-6">
      <div class="flex items-center gap-2">
        <span class="grid size-9 place-items-center rounded-xl bg-white text-accent-dark">
          <TopicIcon name="guide" class="size-5" />
        </span>
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-dark">Orientasi cepat</p>
      </div>
      <p class="mt-2 text-lg font-bold leading-7 text-slate-950">{profile.orientation}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {profile.studyAreas.map((area) => (
          <span class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-slate-700">{area}</span>
        ))}
      </div>
    </div>

    <div class="mt-5 grid gap-4 lg:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <div class="flex items-center gap-2">
          <TopicIcon name="info" class="size-5 text-brand" />
          <h3 class="font-bold text-slate-950">Karakter kampus</h3>
        </div>
        <p class="mt-3 text-sm leading-6 text-slate-700">{profile.academicCharacter}</p>
        <ul class="mt-4 space-y-2">
          {profile.distinctive.slice(0, 3).map((item) => (
            <li class="flex gap-3 text-sm leading-6 text-slate-600">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <div class="flex items-center gap-2">
          <TopicIcon name="collaboration" class="size-5 text-brand" />
          <h3 class="font-bold text-slate-950">Mahasiswa internasional</h3>
        </div>
        <dl class="mt-3 space-y-3 text-sm">
          <div>
            <dt class="font-bold text-slate-900">Jalur masuk</dt>
            <dd class="mt-1 leading-6 text-slate-600">{profile.internationalStudent.admission}</dd>
          </div>
          <div>
            <dt class="font-bold text-slate-900">Bahasa</dt>
            <dd class="mt-1 leading-6 text-slate-600">{profile.internationalStudent.language}</dd>
          </div>
          <div>
            <dt class="font-bold text-slate-900">Kontak pertama</dt>
            <dd class="mt-1 leading-6 text-slate-600">{profile.internationalStudent.firstContact}</dd>
          </div>
        </dl>
        <a href={profile.internationalStudent.sourceUrl} target="_blank" rel="noreferrer" class="mt-4 inline-flex text-xs font-bold text-brand hover:underline">Sumber internasional resmi ↗</a>
      </article>
    </div>

    <div class="mt-5 rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Quick links</p>
          <p class="mt-1 text-sm text-slate-600">Sumber resmi yang paling sering dibutuhkan.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          {quickLinks.map((item) => (
            <a href={item.url} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-700 transition hover:border-amber-200 hover:text-brand">
              <TopicIcon name={item.icon} class="size-4" />
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      {campus?.censusDate && (
        <div class="mt-4 flex items-center gap-2 border-t border-slate-200 pt-4 text-xs text-slate-500">
          <TopicIcon name="info" class="size-4" />
          <span>Informasi kampus terakhir diperiksa: <strong class="font-semibold text-slate-700">{campus.censusDate}</strong></span>
        </div>
      )}
    </div>
  </div>
</section>
