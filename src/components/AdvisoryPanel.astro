---
/**
 * Contextual advisory / status information. role=note is intentionally
 * non-interruptive: ordinary advisory text must not act as a live alert.
 * Major calls to action/vision belong in HighlightPanel instead.
 */
interface Props {
  tone?: 'info' | 'caution';
}
const { tone = 'info' } = Astro.props;
---
<div
  role="note"
  data-ui-panel="advisory"
  data-tone={tone}
  class:list={[
    tone === 'info'
      ? 'border-y border-accent/35 bg-accent/10 px-6 py-5 sm:px-8'
      : 'rounded-2xl border border-brand/35 bg-brand/5 p-6 sm:p-8'
  ]}
>
  <slot />
</div>
