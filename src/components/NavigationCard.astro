---
import TopicIcon from './TopicIcon.astro';
import { withBase } from '../utils/paths';

interface Props {
  href: string;
  title: string;
  description: string;
  icon?: string;
  action?: string;
  density?: 'comfortable' | 'compact';
}

const { href, title, description, icon, action, density = 'comfortable' } = Astro.props;
const link = href.startsWith('/') ? withBase(href) : href;
const compact = density === 'compact';
---
<a
  href={link}
  data-ui-card="navigation"
  class:list={[
    'group block ui-radius-card ui-border-subtle border-slate-200 bg-white transition-colors',
    'hover:border-accent/35 hover:bg-accent/5',
    compact ? 'p-5' : 'ui-card-space-balanced',
  ]}
>
  {icon && (
    <span class="grid size-11 place-items-center rounded-2xl bg-accent/10 text-accent-dark">
      <TopicIcon name={icon as any} class="size-6" />
    </span>
  )}
  <h3 class:list={[
    'font-bold text-slate-950 group-hover:text-brand',
    icon && 'mt-4',
    compact ? 'type-card-title' : 'text-lg',
  ]}>
    {title}
  </h3>
  <p class:list={[
    'mt-2 text-slate-600',
    compact ? 'text-xs leading-5' : 'text-sm leading-6',
  ]}>
    {description}
  </p>
  {action && <p class="mt-3 text-xs font-bold text-brand">{action}</p>}
  <slot />
</a>
