---
interface SectionItem {
  label: string;
  title: string;
}

interface Props {
  sections: SectionItem[];
}

const { sections } = Astro.props;
---
<nav class="mx-auto max-w-5xl px-5 pb-2 lg:px-8" aria-label="Daftar isi panduan">
  <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" open>
    <summary class="cursor-pointer font-bold text-slate-950">Di halaman ini</summary>
    <div class="mt-4 grid gap-2 sm:grid-cols-2">
      {sections.map((section) => (
        <a
          href={`#bagian-${section.label}`}
          class="rounded-xl bg-slate-50 px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-100 hover:text-brand"
        >
          <span class="mr-2 text-xs font-bold text-brand">{section.label}</span>
          {section.title}
        </a>
      ))}
    </div>
  </details>
</nav>
