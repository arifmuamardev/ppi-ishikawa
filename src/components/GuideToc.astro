---
interface SectionItem {
  id?: string;
  label: string;
  title: string;
}

interface Props {
  sections: SectionItem[];
}

const { sections } = Astro.props;
---
<nav class="mx-auto max-w-5xl px-5 pb-2 lg:px-8" aria-label="Daftar isi panduan">
  <details class="group rounded-2xl border border-slate-200 bg-white p-4">
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 rounded-xl font-bold text-slate-950">
      <span class="min-w-0">Di halaman ini</span>
      <span class="ml-auto shrink-0 text-xs font-semibold text-slate-500 group-open:hidden">Lihat bagian ↓</span>
      <span class="ml-auto hidden shrink-0 text-xs font-semibold text-slate-500 group-open:inline">Tutup bagian ↑</span>
    </summary>
    <div class="mt-4 flex flex-wrap gap-2">
      {sections.map((section) => (
        <a
          href={`#${section.id ?? `bagian-${section.label}`}`}
          class="inline-flex min-h-11 items-center rounded-xl border border-slate-200 bg-slate-50 px-3.5 text-xs font-semibold text-slate-700 transition-colors hover:border-accent/35 hover:bg-accent/10 hover:text-brand"
        >
          <span class="mr-1.5 font-bold text-brand">{section.label}</span>
          {section.title}
        </a>
      ))}
    </div>
  </details>
</nav>
