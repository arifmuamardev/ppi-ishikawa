<button
  type="button"
  data-theme-toggle
  class="grid size-10 shrink-0 place-items-center rounded-full border border-slate-300 bg-white text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
  aria-label="Gunakan mode gelap"
  title="Gunakan mode gelap"
  aria-pressed="false"
>
  <svg data-theme-icon="moon" viewBox="0 0 24 24" aria-hidden="true" class="size-4.5" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M20.5 14.2A8.3 8.3 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path>
  </svg>
  <svg data-theme-icon="sun" viewBox="0 0 24 24" aria-hidden="true" class="size-4.5" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <span class="sr-only" data-theme-label>Mode tampilan</span>
</button>

<script>
  const storageKey = 'ppi-ishikawa-theme';
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const getTheme = () => document.documentElement.classList.contains('dark') ? 'dark' : 'light';

  const syncToggle = () => {
    if (!toggle) return;
    const dark = getTheme() === 'dark';
    const nextLabel = dark ? 'Gunakan mode terang' : 'Gunakan mode gelap';
    toggle.setAttribute('aria-label', nextLabel);
    toggle.setAttribute('title', nextLabel);
    toggle.setAttribute('aria-pressed', String(dark));
    if (themeMeta) themeMeta.content = dark ? '#020617' : '#ffffff';
  };

  const setTheme = (theme: 'light' | 'dark', persist = true) => {
    document.documentElement.classList.toggle('dark', theme === 'dark');
    document.documentElement.dataset.theme = theme;
    if (persist) localStorage.setItem(storageKey, theme);
    syncToggle();
  };

  syncToggle();

  toggle?.addEventListener('click', () => {
    setTheme(getTheme() === 'dark' ? 'light' : 'dark');
  });

  const media = window.matchMedia('(prefers-color-scheme: dark)');
  media.addEventListener('change', (event) => {
    if (!localStorage.getItem(storageKey)) {
      setTheme(event.matches ? 'dark' : 'light', false);
    }
  });
</script>
