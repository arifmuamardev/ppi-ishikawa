---
import { withBase } from '../utils/paths';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav class={`flex items-center gap-x-2 overflow-x-auto whitespace-nowrap pb-1 text-sm [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:flex-wrap sm:gap-y-1 sm:overflow-visible sm:whitespace-normal sm:pb-0 ${className}`} aria-label="Breadcrumb">
  {items.map((item, index) => (
    <>
      {index > 0 && <span class="shrink-0 text-slate-300" aria-hidden="true">/</span>}
      {item.href ? (
        <a href={withBase(item.href)} class="shrink-0 font-semibold text-slate-500 transition hover:text-brand hover:underline sm:shrink">{item.label}</a>
      ) : (
        <span class="shrink-0 font-semibold text-slate-700 sm:shrink" aria-current="page">{item.label}</span>
      )}
    </>
  ))}
</nav>
