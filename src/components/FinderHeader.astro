---
import PublicPageHeader from './PublicPageHeader.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  breadcrumbs?: BreadcrumbItem[];
  lastVerified?: string;
}

const { title, description, eyebrow, breadcrumbs, lastVerified } = Astro.props;
---
<PublicPageHeader
  title={title}
  description={description}
  eyebrow={eyebrow}
  breadcrumbs={breadcrumbs}
  lastVerified={lastVerified}
>
  {Astro.slots.has('meta') && <Fragment slot="meta"><slot name="meta" /></Fragment>}
</PublicPageHeader>
