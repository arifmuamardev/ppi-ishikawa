---
import BaseLayout from '../layouts/BaseLayout.astro';
import FamilyGuideHeader from './FamilyGuideHeader.astro';
import GuideToc from './GuideToc.astro';
import OfficialSources from './OfficialSources.astro';
import { withBase } from '../utils/paths';

interface Section {
  title: string;
  intro?: string;
  points?: string[];
  note?: string;
}

interface Source {
  owner: string;
  title: string;
  note: string;
  url: string;
}

interface Props {
  title: string;
  code: string;
  description: string;
  intro: string;
  sections: Section[];
  sources: Source[];
  currentNote?: string;
}

const { title, code, description, intro, sections, sources, currentNote } = Astro.props;

const sectionItems = sections.map((section, index) => ({
  ...section,
  id: `bagian-${index + 1}`,
  label: String(index + 1).padStart(2, '0')
}));

const officialSources = sources.map((source) => ({
  owner: source.owner,
  title: source.title,
  description: source.note,
  url: source.url
}));
---

<BaseLayout title={title} description={description}>
  <FamilyGuideHeader code={code} title={title} intro={intro} />

  {sectionItems.length >= 4 && (
    <GuideToc
      sections={sectionItems.map((section) => ({
        id: section.id,
        label: section.label,
        title: section.title
      }))}
    />
  )}

  {currentNote && (
    <section class="mx-auto max-w-5xl px-5 pb-8 pt-6 lg:px-8">
      <div class="rounded-2xl border border-accent/35 bg-accent/10 p-6">
        <p class="type-eyebrow text-secondary-dark">Catatan saat ini</p>
        <p class="mt-3 text-sm leading-7 text-slate-700">{currentNote}</p>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-5xl px-5 py-8 lg:px-8">
    <div class="divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-white">
      {sectionItems.map((section) => (
        <article id={section.id} class="scroll-mt-24 p-6 sm:p-8">
          <div class="flex gap-4">
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xs font-bold text-slate-600">{section.label}</span>
            <div class="min-w-0 flex-1">
              <h2 class="type-section text-slate-950">{section.title}</h2>
              {section.intro && <p class="mt-3 leading-7 text-slate-600">{section.intro}</p>}
              {section.points && (
                <ul class="mt-5 space-y-3">
                  {section.points.map((point) => (
                    <li class="flex gap-3 text-sm leading-6 text-slate-700">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              )}
              {section.note && <p class="mt-5 rounded-2xl bg-slate-50 p-4 text-xs leading-6 text-slate-600">{section.note}</p>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pt-6 lg:px-8">
    <div class="flex flex-col gap-4 border-y border-slate-200 py-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="type-eyebrow text-brand">Layanan lokal</p>
        <p class="mt-1 text-sm leading-6 text-slate-600">Childcare, school, allowance, medical support, dan consultation mengikuti municipality tempat alamat Anda terdaftar.</p>
      </div>
      <a href={withBase('/life-in-ishikawa/family/municipality/')} class="type-ui inline-flex min-h-11 shrink-0 items-center rounded-xl bg-slate-950 px-4 text-white transition-colors hover:bg-slate-800">Pilih municipality →</a>
    </div>
  </section>

  <OfficialSources
    sources={officialSources}
    title="Gunakan sumber asli untuk syarat, nominal, dan jadwal terbaru."
  />

  <section class="mx-auto max-w-5xl px-5 pb-24 pt-4 lg:px-8">
    <a href={withBase('/life-in-ishikawa/family-anak/')} class="type-ui inline-flex min-h-11 items-center rounded-xl border border-slate-300 bg-white px-5 text-slate-800 transition-colors hover:border-accent/35 hover:bg-accent/5">← Kembali ke Keluarga</a>
  </section>
</BaseLayout>
