---
import { nav, site } from '../data/site';
import { withBase } from '../utils/paths';
---
<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 lg:grid-cols-[1.4fr_1fr] lg:px-8">
    <div>
      <a href={withBase('/')} class="brand-logo-shell rounded-xl px-3 py-2" aria-label={`${site.name} — Beranda`}>
        <img
          src={withBase('/brand/ppi-ishikawa-logo.webp')}
          alt="PPI Ishikawa"
          width="469"
          height="426"
          class="h-24 w-auto"
        />
      </a>
      <div class="brand-gold-rule mt-5 max-w-xs"></div>
      <p class="mt-4 max-w-xl text-sm leading-6 text-slate-600">{site.description}</p>
      <p class="mt-6 text-xs text-secondary">PPI Ishikawa · Periode {site.period}</p>
    </div>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Navigasi</p>
      <div class="mt-4 grid grid-cols-2 gap-3 text-sm">
        {nav.map((item) => <a class="text-slate-600 hover:text-brand" href={withBase(item.href)}>{item.label}</a>)}
      </div>
      <div class="mt-6 border-t border-slate-100 pt-4">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-400">Lainnya</p>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs">
          <a class="text-slate-500 hover:text-brand" href={withBase('/programs/')}>Program</a>
          <a class="text-slate-500 hover:text-brand" href={withBase('/resources/')}>Direktori</a>
          <a class="text-slate-500 hover:text-brand" href={withBase('/contact/')}>Hubungi Kami</a>
        </div>
      </div>
    </div>
  </div>
</footer>
