---
import TopicIcon from './TopicIcon.astro';
import ResultCard from './ResultCard.astro';
import { withBase } from '../utils/paths';
import { campuses } from '../data/campuses';
import { storyTopicLabels, type Story } from '../data/stories';

interface Props {
  story: Story;
}

const { story } = Astro.props;
const campus = campuses.find((item) => item.slug === story.campusSlug);
---

<ResultCard interactive clip>
  {story.imageUrl ? (
    <img
      src={story.imageUrl}
      alt={story.imageAlt || story.title}
      class="aspect-[16/9] w-full object-cover"
      loading="lazy"
    />
  ) : (
    <div class="grid aspect-[16/9] place-items-center bg-slate-100 text-slate-400">
      <TopicIcon name="stories" class="size-10" />
    </div>
  )}

  <div class="p-6">
    <div class="flex flex-wrap gap-2">
      {campus && <span class="rounded-full bg-accent/10 px-3 py-1 text-[11px] font-bold text-accent-dark">{campus.shortName}</span>}
      <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-bold text-slate-600">{story.status}</span>
      {story.topics.slice(0, 2).map((topic) => (
        <span class="rounded-full border border-slate-200 px-3 py-1 text-[11px] font-semibold text-slate-500">{storyTopicLabels[topic]}</span>
      ))}
    </div>

    <h3 class="type-card-title mt-4 text-slate-950 group-hover:text-brand">{story.title}</h3>
    <p class="mt-3 text-sm leading-6 text-slate-600">{story.excerpt}</p>

    <div class="mt-5 flex items-center justify-between gap-4 border-t border-slate-100 pt-4">
      <div>
        <p class="text-sm font-bold text-slate-950">{story.personName}</p>
        {story.currentActivity && <p class="mt-1 text-xs text-slate-500">{story.currentActivity}</p>}
      </div>
      <a href={withBase(`/stories/${story.slug}/`)} class="shrink-0 text-sm font-bold text-brand hover:underline">Baca cerita →</a>
    </div>
  </div>
</ResultCard>
