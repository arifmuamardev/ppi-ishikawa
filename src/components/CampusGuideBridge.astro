---
import TopicIcon from './TopicIcon.astro';
import { withBase } from '../utils/paths';

interface LinkItem {
  label: string;
  href: string;
  icon?: string;
}

interface Props {
  id: string;
  number: string;
  eyebrow: string;
  title: string;
  summary: string;
  campusNote?: string;
  links: LinkItem[];
}

const { id, number, eyebrow, title, summary, campusNote, links } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl scroll-mt-24 px-5 py-10 lg:px-8">
  <span id={`bagian-${number}`} class="sr-only" aria-hidden="true"></span>
  <div class="rounded-[2rem] border border-slate-200 bg-white p-6 sm:p-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand">{number} · {eyebrow}</p>
    <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">{title}</h2>
    <p class="mt-3 max-w-3xl leading-7 text-slate-600">{summary}</p>

    {campusNote && (
      <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-5">
        <p class="text-xs font-bold uppercase tracking-[0.12em] text-accent-dark">Yang spesifik untuk kampus ini</p>
        <p class="mt-2 text-sm leading-6 text-slate-700">{campusNote}</p>
      </div>
    )}

    <div class="mt-5 flex flex-wrap gap-3">
      {links.map((item) => (
        <a href={withBase(item.href)} class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-bold text-slate-800 transition hover:border-amber-200 hover:bg-amber-50 hover:text-brand">
          <TopicIcon name={(item.icon ?? 'guide') as any} class="size-4" />
          {item.label} →
        </a>
      ))}
    </div>
  </div>
</section>
