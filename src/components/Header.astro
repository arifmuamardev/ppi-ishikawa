---
import { nav, site } from '../data/site';
import { withBase } from '../utils/paths';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 lg:px-8">
    <a href={withBase('/')} class="flex items-center gap-3 font-semibold tracking-tight text-slate-950">
      <span class="grid size-10 place-items-center rounded-xl bg-brand text-sm font-bold text-white">PPI</span>
      <span>
        <span class="block leading-none">{site.name}</span>
        <span class="mt-1 block text-xs font-medium text-slate-500">Periode {site.period}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-5 text-sm font-medium text-slate-600 lg:flex" aria-label="Navigasi utama">
      {nav.map((item) => (
        <a
          class={`transition hover:text-brand ${isActive(item.href) ? 'font-bold text-brand' : ''}`}
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href={withBase('/contact')} class="hidden rounded-full bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand sm:inline-flex">
        Hubungi Kami
      </a>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800">Menu</summary>
        <div class="absolute right-0 mt-3 w-64 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
          {nav.map((item) => (
            <a
              class={`block rounded-xl px-4 py-3 text-sm font-medium hover:bg-slate-50 hover:text-brand ${isActive(item.href) ? 'bg-red-50 text-brand' : 'text-slate-700'}`}
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
