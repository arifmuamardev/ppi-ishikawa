---
import { nav, site } from '../data/site';
import { withBase } from '../utils/paths';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  const campusTarget = withBase('/community/kampus').replace(/\/$/, '');

  // Campus is a top-level information domain even though its legacy URL
  // still lives under /community/kampus.
  if (href === '/community') {
    return (currentPath === target || currentPath.startsWith(`${target}/`))
      && !(currentPath === campusTarget || currentPath.startsWith(`${campusTarget}/`));
  }

  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 lg:px-8 lg:py-4">
    <a href={withBase('/')} class="flex items-center gap-3" aria-label={`${site.name} — Beranda`}>
      <span class="brand-logo-shell rounded-xl px-2 py-1 sm:px-2.5 sm:py-1.5">
        <img
          src={withBase('/brand/ppi-ishikawa-logo.webp')}
          alt="PPI Ishikawa"
          width="469"
          height="426"
          class="h-10 w-auto sm:h-12 lg:h-14"
        />
      </span>
      <span class="hidden text-xs font-semibold text-secondary xl:block">Periode {site.period}</span>
    </a>

    <nav class="type-ui hidden items-center gap-5 text-slate-600 lg:flex" aria-label="Navigasi utama">
      {nav.map((item) => (
        <a
          class={`transition hover:text-brand ${isActive(item.href) ? 'font-bold text-brand' : ''}`}
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href={withBase('/member/')} class="type-ui hidden min-h-11 items-center rounded-xl border border-slate-300 bg-white px-4 text-slate-800 transition-colors hover:border-accent/50 hover:bg-accent/5 hover:text-brand sm:inline-flex">
        Area Anggota
      </a>
      <a href={withBase('/contact')} class="type-ui hidden min-h-11 items-center rounded-xl bg-ink px-4 text-white transition-colors hover:bg-brand xl:inline-flex">
        Hubungi Kami
      </a>
      <details class="group relative lg:hidden">
        <summary class="type-ui inline-flex min-h-11 cursor-pointer list-none items-center rounded-xl border border-slate-300 bg-white px-4 text-slate-800 transition-colors hover:border-accent/50 hover:bg-accent/5">
            <span class="group-open:hidden">Menu</span>
            <span class="hidden group-open:inline">Tutup</span>
          </summary>
        <div class="absolute right-0 mt-3 max-h-[calc(100dvh-6rem)] w-[min(18rem,calc(100vw-2rem))] overflow-y-auto rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
          {nav.map((item) => (
            <a
              class={`block rounded-xl px-4 py-3 text-sm font-medium hover:bg-accent/10 hover:text-brand ${isActive(item.href) ? 'bg-brand/10 text-brand' : 'text-slate-700'}`}
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <div class="my-2 border-t border-slate-100"></div>
          <a
            class={`block rounded-xl px-4 py-3 text-sm font-bold ${isActive('/member') ? 'bg-brand/10 text-brand' : 'text-slate-900 hover:bg-accent/10 hover:text-brand'}`}
            href={withBase('/member/')}
            aria-current={isActive('/member') ? 'page' : undefined}
          >
            Area Anggota
          </a>
          <a
            class={`block rounded-xl px-4 py-3 text-sm font-bold ${isActive('/contact') ? 'bg-brand/10 text-brand' : 'text-slate-900 hover:bg-accent/10 hover:text-brand'}`}
            href={withBase('/contact')}
            aria-current={isActive('/contact') ? 'page' : undefined}
          >
            Hubungi PPI
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
