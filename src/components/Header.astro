---
import { visibleNav, site } from '../data/site';
import { showFeature } from '../config/features.mjs';
import { withBase } from '../utils/paths';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  const campusTarget = withBase('/community/kampus').replace(/\/$/, '');

  // Campus is a top-level information domain even though its legacy URL
  // still lives under /community/kampus.
  if (href === '/community') {
    return (currentPath === target || currentPath.startsWith(`${target}/`))
      && !(currentPath === campusTarget || currentPath.startsWith(`${campusTarget}/`));
  }

  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---
<header class="site-header sticky top-0 z-50" data-site-header>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 lg:px-8 lg:py-4">
    <a href={withBase('/')} class="flex items-center gap-3" aria-label={`${site.name} — Beranda`}>
      <span class="brand-logo-shell rounded-xl px-2 py-1 sm:px-2.5 sm:py-1.5">
        <img
          src={withBase('/brand/ppi-ishikawa-logo.webp')}
          alt="PPI Ishikawa"
          width="469"
          height="426"
          class="h-10 w-auto sm:h-12 lg:h-14"
        />
      </span>
      <span class="site-header__period hidden text-xs font-semibold xl:block">Periode {site.period}</span>
    </a>

    <nav class="site-header__nav type-ui hidden items-center gap-5 lg:flex" aria-label="Navigasi utama">
      {visibleNav.map((item) => (
        <a
          class={`site-header__nav-link ui-motion-color ${isActive(item.href) ? 'site-header__nav-link--active font-bold' : ''}`}
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      {showFeature('membership') && (
        <a href={withBase('/member/')} class="site-header__member type-ui hidden min-h-11 items-center rounded-xl px-4 ui-motion-color sm:inline-flex">
          Area Anggota
        </a>
      )}
      <a href={withBase('/contact')} class="site-header__contact type-ui hidden min-h-11 items-center rounded-xl px-4 ui-motion-color xl:inline-flex">
        Hubungi Kami
      </a>
      <details class="group relative lg:hidden">
        <summary class="site-header__menu-trigger type-ui inline-flex min-h-11 cursor-pointer list-none items-center rounded-xl px-4 ui-motion-color">
            <span class="group-open:hidden">Menu</span>
            <span class="hidden group-open:inline">Tutup</span>
          </summary>
        <div class="site-header__dropdown absolute right-0 mt-3 max-h-[calc(100dvh-6rem)] w-[min(18rem,calc(100vw-2rem))] overflow-y-auto rounded-2xl p-2">
          {visibleNav.map((item) => (
            <a
              class="site-header__dropdown-link block rounded-xl px-4 py-3 text-sm font-medium ui-motion-color"
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          {showFeature('membership') && (
            <a
              class="site-header__dropdown-link block rounded-xl px-4 py-3 text-sm font-bold ui-motion-color"
              href={withBase('/member/')}
              aria-current={isActive('/member') ? 'page' : undefined}
            >
              Area Anggota
            </a>
          )}
          <div class="site-header__dropdown-divider my-2 border-t"></div>
          <a
            class="site-header__dropdown-link block rounded-xl px-4 py-3 text-sm font-bold ui-motion-color"
            href={withBase('/contact')}
            aria-current={isActive('/contact') ? 'page' : undefined}
          >
            Hubungi PPI
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
