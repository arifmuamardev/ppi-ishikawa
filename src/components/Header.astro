---
import { nav, site } from '../data/site';
import { withBase } from '../utils/paths';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  const campusTarget = withBase('/community/kampus').replace(/\/$/, '');

  // Campus is a top-level information domain even though its legacy URL
  // still lives under /community/kampus.
  if (href === '/community') {
    return (currentPath === target || currentPath.startsWith(`${target}/`))
      && !(currentPath === campusTarget || currentPath.startsWith(`${campusTarget}/`));
  }

  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 lg:px-8">
    <a href={withBase('/')} class="flex items-center gap-3" aria-label={`${site.name} — Beranda`}>
      <span class="brand-logo-shell rounded-xl px-2.5 py-1.5">
        <img
          src={withBase('/brand/ppi-ishikawa-logo.webp')}
          alt="PPI Ishikawa"
          width="469"
          height="426"
          class="h-12 w-auto sm:h-14"
        />
      </span>
      <span class="hidden text-xs font-semibold text-accent-dark xl:block">Periode {site.period}</span>
    </a>

    <nav class="hidden items-center gap-5 text-sm font-medium text-slate-600 lg:flex" aria-label="Navigasi utama">
      {nav.map((item) => (
        <a
          class={`transition hover:text-brand ${isActive(item.href) ? 'font-bold text-brand' : ''}`}
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a href={withBase('/contact')} class="hidden rounded-full bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand sm:inline-flex">
        Hubungi Kami
      </a>
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-800">Menu</summary>
        <div class="absolute right-0 mt-3 w-64 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
          {nav.map((item) => (
            <a
              class={`block rounded-xl px-4 py-3 text-sm font-medium hover:bg-slate-50 hover:text-brand ${isActive(item.href) ? 'bg-red-50 text-brand' : 'text-slate-700'}`}
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          <div class="my-2 border-t border-slate-100"></div>
          <a
            class={`block rounded-xl px-4 py-3 text-sm font-bold ${isActive('/contact') ? 'bg-red-50 text-brand' : 'text-slate-900 hover:bg-slate-50 hover:text-brand'}`}
            href={withBase('/contact')}
            aria-current={isActive('/contact') ? 'page' : undefined}
          >
            Hubungi PPI
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
