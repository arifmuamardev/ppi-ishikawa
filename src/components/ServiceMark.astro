---
import { serviceLogos } from '../data/service-logos';

interface Props {
  id: keyof typeof serviceLogos;
  size?: 'sm' | 'md';
  class?: string;
}

const { id, size = 'md', class: className = '' } = Astro.props;
const logo = serviceLogos[id];

const fallback = {
  ir: { short: 'IR', long: 'IR Ishikawa Railway' },
  hokutetsu: { short: '北鉄', long: 'Hokutetsu' },
  jr: { short: 'JR', long: 'JR' },
  ifie: { short: 'IFIE', long: 'Ishikawa Foundation for International Exchange' },
  jma: { short: 'JMA', long: 'Japan Meteorological Agency' },
  isa: { short: 'ISA', long: 'Immigration Services Agency' },
  police: { short: '110', long: 'Police' },
  fire: { short: '119', long: 'Ambulance / Fire' }
} as const;

const mark = fallback[id];
const classes = logo?.shape === 'wide'
  ? {
      sm: 'h-10 w-24 rounded-xl p-1.5',
      md: 'h-12 w-32 rounded-2xl p-2'
    }
  : {
      sm: 'h-10 min-w-10 rounded-xl px-2',
      md: 'h-12 min-w-12 rounded-2xl px-3'
    };
---

<span
  class={`inline-flex items-center justify-center border border-slate-200 bg-white text-xs font-black tracking-tight text-slate-800 shadow-sm ${classes[size]} ${className}`}
  aria-label={logo?.name ?? mark.long}
  title={logo?.name ?? mark.long}
>
  {logo ? (
    <img
      src={logo.imageUrl}
      alt={`${logo.name} logo`}
      class="max-h-full max-w-full object-contain"
      loading="lazy"
      referrerpolicy="no-referrer"
    />
  ) : (
    mark.short
  )}
</span>
