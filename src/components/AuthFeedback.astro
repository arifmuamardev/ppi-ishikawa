---
/** Pre-mounted live regions: visually hidden while empty, never display:none. */
interface Props { id: string; }
const { id } = Astro.props;
---
<p
  id={`${id}-status`}
  role="status"
  aria-live="polite"
  aria-atomic="true"
  class="mt-6 empty:sr-only ui-radius-card ui-border-subtle border-accent/35 bg-accent/10 p-4 text-sm leading-6 text-slate-700"
></p>
<p
  id={`${id}-error`}
  role="alert"
  aria-atomic="true"
  class="mt-6 empty:sr-only ui-radius-card ui-border-subtle border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-800"
></p>
