---
import { site } from '../data/site';
import PageHeader from './PageHeader.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow = `${site.name} ${site.period}`, title, description } = Astro.props;
---
<PageHeader eyebrow={eyebrow} title={title} description={description} />
