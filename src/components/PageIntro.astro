---
import { site } from '../data/site';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}
const { eyebrow = `${site.name} ${site.period}`, title, description } = Astro.props;
---
<section class="mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
  <p class="type-eyebrow text-brand">{eyebrow}</p>
  <h1 class="type-display mt-4 max-w-4xl text-slate-950">{title}</h1>
  <p class="type-lead mt-5 max-w-3xl text-slate-600">{description}</p>
</section>
