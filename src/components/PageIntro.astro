---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}
const { eyebrow = 'PPI Ishikawa 2026/27', title, description } = Astro.props;
---
<section class="mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
  <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand">{eyebrow}</p>
  <h1 class="mt-4 max-w-4xl text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">{title}</h1>
  <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{description}</p>
</section>
