---
import Breadcrumbs from './Breadcrumbs.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  breadcrumbs?: BreadcrumbItem[];
  lastVerified?: string;
}

const { title, description, eyebrow, breadcrumbs, lastVerified } = Astro.props;
const hasBreadcrumbs = Boolean(breadcrumbs?.length);
const hasMeta = Astro.slots.has('meta');
const hasVisual = Astro.slots.has('visual');
---
<section class="mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
  {hasBreadcrumbs && <Breadcrumbs items={breadcrumbs!} />}

  <div class:list={['grid gap-10', hasBreadcrumbs && 'mt-8', hasVisual && 'items-center lg:grid-cols-[1.05fr_.95fr]']}>
    <div class="max-w-4xl">
      {eyebrow && <p class="type-eyebrow text-brand">{eyebrow}</p>}
      <h1 class:list={['type-display text-slate-950', eyebrow && 'mt-4']}>{title}</h1>
      <p class="type-lead mt-5 max-w-3xl text-slate-600">{description}</p>
      {lastVerified && <p class="type-meta mt-4 text-slate-500">Diverifikasi · {lastVerified}</p>}
      {hasMeta && <div class="mt-6"><slot name="meta" /></div>}
    </div>

    {hasVisual && (
      <div>
        <slot name="visual" />
      </div>
    )}
  </div>
</section>
