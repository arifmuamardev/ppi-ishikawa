---
import PublicPageHeader from './PublicPageHeader.astro';
import { nav } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  parentLabel: string;
  parentHref: string;
  title: string;
  description: string;
  eyebrow?: string;
  lastVerified?: string;
}

const {
  parentLabel,
  parentHref,
  title,
  description,
  eyebrow,
  lastVerified
} = Astro.props;

// Menu placement, not URL depth, determines whether a page has a breadcrumb.
// /community/kampus/ is a primary navigation destination. Keluarga is not.
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const isPrimaryNavigation = nav.some(
  (item) => withBase(item.href).replace(/\/+$/, '') === currentPath
);
const breadcrumbs = isPrimaryNavigation ? undefined : [
  { label: 'Beranda', href: '/' },
  { label: parentLabel, href: parentHref },
  { label: title }
];
---
<PublicPageHeader
  title={title}
  description={description}
  eyebrow={eyebrow}
  lastVerified={lastVerified}
  breadcrumbs={breadcrumbs}
>
  {Astro.slots.has('visual') && <Fragment slot="visual"><slot name="visual" /></Fragment>}
</PublicPageHeader>
