---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  parentLabel: string;
  parentHref: string;
  title: string;
  description: string;
  eyebrow?: string;
  lastVerified?: string;
}

const {
  parentLabel,
  parentHref,
  title,
  description,
  eyebrow,
  lastVerified
} = Astro.props;

const hasVisual = Astro.slots.has('visual');
---
<section class="mx-auto max-w-7xl px-5 pb-10 pt-16 lg:px-8 lg:pt-24">
  <Breadcrumbs
    items={[
      { label: 'Beranda', href: '/' },
      { label: parentLabel, href: parentHref },
      { label: title }
    ]}
  />

  <div class:list={['mt-8 grid gap-10', hasVisual ? 'items-center lg:grid-cols-[1.05fr_.95fr]' : 'max-w-4xl']}>
    <div>
      {eyebrow && <p class="type-eyebrow text-brand">{eyebrow}</p>}
      <h1 class="type-display mt-4 text-slate-950">{title}</h1>
      <p class="type-lead mt-5 max-w-3xl text-slate-600">{description}</p>
      {lastVerified && (
        <p class="type-meta mt-4 text-slate-500">Diverifikasi · {lastVerified}</p>
      )}
    </div>

    {hasVisual && (
      <div>
        <slot name="visual" />
      </div>
    )}
  </div>
</section>
