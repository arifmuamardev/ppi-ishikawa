---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
  requireApproved?: boolean;
  requireAdmin?: boolean;
}

const {
  title,
  description = 'Area anggota PPI Ishikawa.',
  requireApproved = false,
  requireAdmin = false,
} = Astro.props;

const navGroups = [
  {
    label: 'Akun',
    items: [
      ['Dashboard', '/member/'],
      ['Profil saya', '/member/profile/'],
      ['Direktori anggota', '/member/directory/'],
    ],
  },
  {
    label: 'Layanan',
    items: [
      ['Kartu anggota', '/member/card/'],
      ['Sertifikat', '/member/certificates/'],
      ['Dokumen anggota', '/member/documents/'],
    ],
  },
  {
    label: 'Komunitas',
    items: [
      ['Agenda & RSVP', '/member/events/'],
      ['Kalender', '/member/calendar/'],
      ['Pengumuman', '/member/announcements/'],
      ['Minat & skills', '/member/interests/'],
      ['Aspirasi', '/member/aspirations/'],
    ],
  },
  {
    label: 'Organisasi',
    items: [
      ['Struktur', '/member/organization/'],
      ['Program kerja', '/member/programs/'],
      ['Volunteer', '/member/volunteer/'],
    ],
  },
  {
    label: 'Pengembangan',
    items: [
      ['Untuk Anda', '/member/opportunities/'],
      ['Mentoring', '/member/mentoring/'],
      ['Alumni Network', '/member/alumni/'],
      ['Berbagi cerita', '/member/stories/'],
    ],
  },
] as const;

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const target = withBase(href).replace(/\/$/, '');
  return currentPath === target || (target !== withBase('/member').replace(/\/$/, '') && currentPath.startsWith(`${target}/`));
};

const navLinkClass = (href: string) =>
  `block min-h-11 rounded-xl px-3 py-2.5 text-sm font-semibold transition-colors ${isActive(href)
    ? 'bg-brand/10 text-brand'
    : 'text-slate-700 hover:bg-accent/10 hover:text-brand'}`;
---

<BaseLayout title={title} description={description}>
  <section
    id="member-area"
    data-require-approved={requireApproved ? '1' : '0'}
    data-require-admin={requireAdmin ? '1' : '0'}
    class="mx-auto max-w-7xl px-5 py-8 lg:px-8 lg:py-10"
  >
    <details class="group mb-5 rounded-2xl border border-slate-200 bg-white lg:hidden">
      <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 px-4 py-3">
        <div class="min-w-0">
          <p class="type-eyebrow text-brand">Area Anggota</p>
          <p data-member-nav-name class="mt-1 truncate font-bold text-slate-950">PPI Ishikawa</p>
          <p data-member-nav-status class="mt-0.5 text-xs text-slate-500">Memuat keanggotaan…</p>
        </div>
        <span class="shrink-0 rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700">
          <span class="group-open:hidden">Menu ↓</span>
          <span class="hidden group-open:inline">Tutup ↑</span>
        </span>
      </summary>

      <div class="max-h-[65dvh] overflow-y-auto border-t border-slate-100 p-3">
        <nav class="space-y-4" aria-label="Navigasi anggota mobile">
          {navGroups.map((group) => (
            <div>
              <p class="px-3 pb-1 type-meta uppercase tracking-[0.12em] text-slate-400">{group.label}</p>
              <div class="space-y-1">
                {group.items.map(([label, href]) => (
                  <a
                    href={withBase(href)}
                    class={navLinkClass(href)}
                    aria-current={isActive(href) ? 'page' : undefined}
                  >
                    {label}
                  </a>
                ))}
              </div>
            </div>
          ))}

          <div data-member-admin-tools class="hidden border-t border-slate-100 pt-3">
            <p class="px-3 pb-1 type-meta uppercase tracking-[0.12em] text-slate-400">Admin</p>
            <a
              href={withBase('/member/admin/')}
              class={navLinkClass('/member/admin/')}
              aria-current={isActive('/member/admin/') ? 'page' : undefined}
            >
              Admin Center
            </a>
          </div>
        </nav>

        <button
          data-member-signout
          type="button"
          class="mt-4 min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-left text-sm font-bold text-slate-700 hover:border-accent/35 hover:text-brand"
        >
          Keluar
        </button>
      </div>
    </details>

    <div class="grid gap-6 lg:grid-cols-[240px_minmax(0,1fr)]">
      <aside class="hidden h-fit rounded-2xl border border-slate-200 bg-white p-4 lg:sticky lg:top-28 lg:block">
        <div class="border-b border-slate-100 px-3 pb-4">
          <p class="type-eyebrow text-brand">Area Anggota</p>
          <p data-member-nav-name class="mt-2 font-bold text-slate-950">PPI Ishikawa</p>
          <p data-member-nav-status class="mt-1 text-xs text-slate-500">Memuat keanggotaan…</p>
        </div>

        <nav class="mt-3 max-h-[68vh] space-y-4 overflow-y-auto pr-1" aria-label="Navigasi anggota">
          {navGroups.map((group) => (
            <div>
              <p class="px-3 pb-1 type-meta uppercase tracking-[0.12em] text-slate-400">{group.label}</p>
              <div class="space-y-1">
                {group.items.map(([label, href]) => (
                  <a
                    href={withBase(href)}
                    class={navLinkClass(href)}
                    aria-current={isActive(href) ? 'page' : undefined}
                  >
                    {label}
                  </a>
                ))}
              </div>
            </div>
          ))}

          <div data-member-admin-tools class="hidden border-t border-slate-100 pt-3">
            <p class="px-3 pb-1 type-meta uppercase tracking-[0.12em] text-slate-400">Admin</p>
            <a
              href={withBase('/member/admin/')}
              class={navLinkClass('/member/admin/')}
              aria-current={isActive('/member/admin/') ? 'page' : undefined}
            >
              Admin Center
            </a>
          </div>
        </nav>

        <div class="mt-4 border-t border-slate-100 pt-4">
          <button
            data-member-signout
            type="button"
            class="min-h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-left text-sm font-bold text-slate-700 hover:border-accent/35 hover:text-brand"
          >
            Keluar
          </button>
        </div>
      </aside>

      <div class="min-w-0">
        <div id="member-loading" class="rounded-2xl border border-slate-200 bg-white p-8" role="status" aria-live="polite">
          <p class="font-bold text-slate-950">Memuat area anggota…</p>
          <p class="mt-2 text-sm text-slate-600">Memeriksa sesi dan status keanggotaan Anda.</p>
        </div>

        <div id="member-demo-banner" class="mb-6 hidden rounded-2xl border border-accent/35 bg-accent/10 p-4 text-sm leading-6 text-slate-700">
          <strong class="text-slate-950">Mode demo.</strong> Data pada Area Anggota saat ini hanya tersimpan di browser ini dan tidak menjadi data membership resmi.
        </div>

        <div id="member-content" class="hidden">
          <slot />
        </div>
      </div>
    </div>
  </section>

  <script>
    import { isMembershipDemoMode, requireMember, signOutMember } from '../lib/member';

    const area = document.getElementById('member-area');
    const loading = document.getElementById('member-loading');
    const demoBanner = document.getElementById('member-demo-banner');
    const content = document.getElementById('member-content');
    const names = document.querySelectorAll('[data-member-nav-name]');
    const statuses = document.querySelectorAll('[data-member-nav-status]');
    const adminTools = document.querySelectorAll('[data-member-admin-tools]');
    const signoutButtons = document.querySelectorAll('[data-member-signout]');

    const statusLabels = {
      incoming: 'Incoming',
      active: 'Anggota aktif',
      alumni: 'Alumni',
      inactive: 'Tidak aktif',
    };

    const approved = area?.dataset.requireApproved === '1';
    const admin = area?.dataset.requireAdmin === '1';
    const member = await requireMember({ approved, admin });

    if (member?.profile) {
      const displayName = member.profile.full_name || 'Anggota PPI Ishikawa';
      names.forEach((node) => { node.textContent = displayName; });

      const membershipLabel = member.profile.verification_status === 'approved'
        ? (statusLabels[member.profile.membership_status] || member.profile.membership_status)
        : 'Menunggu verifikasi';
      statuses.forEach((node) => { node.textContent = membershipLabel; });

      if (member.profile.role === 'admin') {
        adminTools.forEach((node) => node.classList.remove('hidden'));
      }
      if (isMembershipDemoMode) demoBanner?.classList.remove('hidden');

      loading?.classList.add('hidden');
      content?.classList.remove('hidden');
    }

    signoutButtons.forEach((button) => {
      button.addEventListener('click', signOutMember);
    });
  </script>
</BaseLayout>
