---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { brandTheme } from '../data/brand';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} ${site.period}`;
const themeStyle = [
  `--theme-primary:${brandTheme.colors.primary}`,
  `--theme-secondary:${brandTheme.colors.secondary}`,
  `--theme-accent:${brandTheme.colors.accent}`,
  `--theme-surface:${brandTheme.colors.surface}`,
  `--theme-ink:${brandTheme.colors.ink}`
].join(';');
---
<!doctype html>
<html
  lang="id"
  style={themeStyle}
  data-brand-theme={brandTheme.name}
  data-theme-color-light={brandTheme.colors.surface}
  data-theme-color-dark={brandTheme.colors.ink}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="theme-color" content={brandTheme.colors.surface} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const key = 'ppi-ishikawa-theme';
        let theme;
        try {
          const saved = localStorage.getItem(key);
          theme = saved === 'dark' || saved === 'light'
            ? saved
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        } catch {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.dataset.theme = theme;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) {
          const root = document.documentElement;
          const nextThemeColor = theme === 'dark'
            ? root.dataset.themeColorDark
            : root.dataset.themeColorLight;
          if (nextThemeColor) themeColor.setAttribute('content', nextThemeColor);
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <a href="#main-content" class="sr-only fixed left-4 top-4 z-[100] rounded-lg bg-ink px-4 py-2 text-sm font-bold text-white focus:not-sr-only">
      Lewati ke konten utama
    </a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
